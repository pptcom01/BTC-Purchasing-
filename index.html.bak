                    <input id="vendorBillingDate" type="date" class="ui-input">
                    <div class="flex gap-2"><input id="vendorBillingAmount" type="number" step="0.01" placeholder="ยอดใบวางบิล" class="ui-input min-w-0 flex-1"><button type="button" onclick="createVendorBillingAction()" class="shrink-0 px-3 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg text-xs font-semibold">สร้างใบวางบิล</button></div>
                </div>
                <div id="vendorBillingCandidates" class="p-3 border-b border-slate-100 max-h-56 overflow-y-auto custom-scrollbar"></div>
                <div id="vendorBillingList" class="flex-1 min-h-0 overflow-y-auto custom-scrollbar p-3 space-y-2"></div>
            </div>
        </div>

    </main>
