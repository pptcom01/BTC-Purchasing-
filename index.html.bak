    <!-- Edit Receipt Modal (แก้ไขข้อมูลบิลที่ AI อ่านไม่ตรง) -->
    <div id="editModal"
        class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div
            class="bg-white rounded-2xl shadow-2xl max-w-6xl w-full overflow-hidden flex flex-col max-h-[92vh] transition-all">

            <div class="bg-white border-b border-slate-200 p-4 px-6 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <span class="bg-btc-green text-white text-xs px-2.5 py-1 rounded-md font-bold tracking-wide">BTC
                        แก้ไขบิล</span>
                    <h3 class="font-bold text-base text-slate-800 truncate max-w-xs sm:max-w-md">แก้ไขข้อมูลบิลจัดซื้อ</h3>
                </div>
                <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-900 p-1.5 rounded-lg transition">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <div class="flex-1 flex flex-col lg:flex-row overflow-hidden min-h-0">
                <!-- ซ้าย: รูปบิลอ้างอิง + แผงแก้ไขรูป (แก้รูปได้ทันทีพร้อมกับฟอร์มข้อมูลด้านขวา) -->
                <div class="lg:w-[38%] shrink-0 bg-slate-50 border-b lg:border-b-0 lg:border-r border-slate-200 p-3 flex flex-col gap-2">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-semibold text-slate-600"><i class="fa-regular fa-image text-btc-green mr-1"></i>รูปบิลอ้างอิง</span>
                        <div class="flex items-center gap-2">
                            <span id="emStatus" class="text-[10px] text-slate-400"></span>
                            <a href="#" onclick="emZoomReset();return false;" class="text-[11px] font-semibold text-btc-green hover:underline flex items-center gap-1 whitespace-nowrap"><i class="fa-solid fa-compress"></i> พอดีจอ</a>
                        </div>
                    </div>

                    <!-- กล่องรูปพื้นขาว แบบเดียวกับ "ดูบิลเต็ม" (ล้อเมาส์ซูมบนรูป + หมุน/พลิก/ความสว่าง/ครอป/บันทึกทับได้ด้วย toolbar ด้านล่าง) -->
                    <div class="flex-1 min-h-0 bg-white border border-slate-200 rounded-xl overflow-hidden flex items-center justify-center">
                        <div id="emImageStage" class="relative inline-block leading-none m-auto">
                            <canvas id="editModalCanvas" class="hidden" style="max-width:100%;max-height:52vh;object-fit:contain;display:block"></canvas>
                            <!-- แผ่นครอปในแผงแก้ไข (เลือกพื้นที่ที่ต้องการเก็บเหมือนตัวแก้ไขเต็มรูปแบบ) -->
                            <div id="emCropOverlay" class="hidden absolute inset-0 bg-slate-900/40 cursor-crosshair touch-none">
                                <div id="emCropBox"
                                    class="absolute border-2 border-white touch-none cursor-move"
                                    style="left:10%;top:10%;width:80%;height:80%;box-shadow:0 0 0 9999px rgba(15,23,42,0.55)">
                                    <span data-handle="nw"
                                        class="absolute -left-1.5 -top-1.5 w-4 h-4 bg-white rounded-full border border-slate-400 cursor-nwse-resize touch-none"></span>
                                    <span data-handle="ne"
                                        class="absolute -right-1.5 -top-1.5 w-4 h-4 bg-white rounded-full border border-slate-400 cursor-nesw-resize touch-none"></span>
                                    <span data-handle="sw"
                                        class="absolute -left-1.5 -bottom-1.5 w-4 h-4 bg-white rounded-full border border-slate-400 cursor-nesw-resize touch-none"></span>
                                    <span data-handle="se"
                                        class="absolute -right-1.5 -bottom-1.5 w-4 h-4 bg-white rounded-full border border-slate-400 cursor-nwse-resize touch-none"></span>
                                </div>
                            </div>
                        </div>
                        <div id="emPlaceholder" class="text-slate-400 text-xs py-10 text-center leading-relaxed">กำลังโหลดรูปบิล...</div>
                    </div>

                    <div class="flex flex-wrap items-center gap-1.5">
                        <button type="button" onclick="emRotate('left')" class="ui-btn ui-btn--sm ui-btn--ghost" title="หมุนซ้าย 90 องศา"><i class="fa-solid fa-rotate-left"></i>หมุนซ้าย</button>
                        <button type="button" onclick="emRotate('right')" class="ui-btn ui-btn--sm ui-btn--ghost" title="หมุนขวา 90 องศา"><i class="fa-solid fa-rotate-right"></i>หมุนขวา</button>
                        <button type="button" onclick="emFlip('h')" class="ui-btn ui-btn--sm ui-btn--ghost" title="พลิกแนวนอน"><i class="fa-solid fa-left-right"></i>พลิก</button>
                        <button type="button" onclick="emToggleCrop()" class="ui-btn ui-btn--sm ui-btn--ghost" title="เลือกพื้นที่ที่ต้องการเก็บ แล้วกดยืนยันครอป"><i class="fa-solid fa-crop-simple"></i><span id="emCropToggleLabel">ครอป</span></button>
                        <button type="button" onclick="emZoomReset()" class="ui-btn ui-btn--sm ui-btn--ghost" title="คืนขนาดพอดีกล่อง"><i class="fa-solid fa-compress"></i>พอดีจอ</button>
                        <div class="flex items-center gap-1.5 bg-white px-2 py-1.5 rounded-lg border border-slate-200">
                            <i class="fa-solid fa-sun text-amber-500 text-xs"></i>
                            <span class="text-[10px] text-slate-600 font-semibold">ความสว่าง</span>
                            <input type="range" id="emBrightness" min="-80" max="100" value="0" oninput="emSetBrightness(this.value)" class="w-20 accent-btc-green">
                        </div>
                        <button type="button" onclick="emReset()" class="ui-btn ui-btn--sm ui-btn--ghost" title="โหลดรูปเดิมกลับมา"><i class="fa-solid fa-rotate"></i>รีเซ็ต</button>
                    </div>

                    <div class="bg-sky-50 border border-sky-200 rounded-lg p-2 text-[11px] text-sky-800 leading-relaxed">
                        <i class="fa-solid fa-circle-info mr-1"></i>แก้รูปได้ทันทีโดยไม่ต้องปิดฟอร์มนี้ — หมุน/พลิก/ปรับความสว่าง/ครอป แล้วกดปุ่ม <b>"บันทึกการแก้ไข"</b> ด้านล่าง (บันทึกทั้งรูปและข้อมูลด้วยปุ่มเดียว) · ต้องการ <b>ครอป/ตัดขอบ</b> ที่ละเอียดขึ้น ใช้
                        <a href="#" onclick="openImageEditorFromEditModal();return false;" class="underline font-semibold">ตัวแก้ไขเต็มรูปแบบ</a>
                    </div>
                    <p class="text-[10px] text-slate-400 leading-relaxed">ล้อเมาส์บนรูปเพื่อซูมเข้าออก · ลากเพื่อเลื่อน · ดับเบิลคลิกหรือกด "พอดีจอ" เพื่อคืนขนาด — แก้ข้อมูลทางขวาให้ตรงกับที่เห็นบนรูป</p>
                </div>
                <!-- ขวา: ฟอร์มแก้ไข — เลย์เอาต์แบบเดียวกับ "ดูบิลเต็ม" (หัวบิล + กริดข้อมูลหลัก) แต่ทุกช่องยังแก้ไขได้ -->
                <div class="flex-1 min-w-0 flex flex-col min-h-0">
                    <div class="flex-1 min-w-0 p-4 sm:p-6 overflow-y-auto space-y-6 custom-scrollbar">

                        <!-- หัวการ์ดบริษัท (เหมือน ดูบิลเต็ม) -->
                        <div class="bg-emerald-50/50 border border-emerald-200 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                            <div class="flex items-center space-x-3">
                                <div class="w-14 h-14 bg-white p-1 rounded-xl shadow-sm border border-emerald-200 flex items-center justify-center shrink-0">
                                    <img src="https://img2.pic.in.th/pic/Screenshot-2025-03-03-132721e6cc77cbcea28f01.png" alt="BTC Logo" class="max-h-full max-w-full object-contain">
                                </div>
                                <div>
                                    <h4 class="font-bold text-slate-900 text-sm">บริษัท บุรีรัมย์ธงชัยก่อสร้าง จำกัด</h4>
                                    <p class="text-xs text-slate-600 leading-relaxed mt-0.5">31/2 ถนนอินจันทร์ณรงค์ ต.ในเมือง อ.เมือง จ.บุรีรัมย์ 31000</p>
                                    <p class="text-[11px] text-slate-500 mt-0.5">
                                        <span class="font-semibold text-slate-700">เลขประจำตัวผู้เสียภาษี:</span> 0315559001144 |
                                        <span class="font-semibold text-slate-700">โทร:</span> 044-611134
                                    </p>
                                </div>
                            </div>
                            <div class="text-left sm:text-right border-t sm:border-t-0 border-emerald-200/60 pt-2 sm:pt-0 w-full sm:w-auto">
                                <span class="bg-btc-green text-white text-[10px] uppercase font-bold px-2.5 py-0.5 rounded">เอกสารตรวจสอบการจัดซื้อ</span>
                                <p class="text-xs text-slate-500 mt-1">ฝ่ายจัดซื้อและควบคุมสต็อก</p>
                            </div>
                        </div>

                        <!-- กริดข้อมูลหลัก (เหมือน ดูบิลเต็ม) — ช่องหลักอ่านได้และแก้ไขได้ทันที -->
                        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 bg-slate-50 p-4 rounded-xl border border-slate-200 text-xs">
                            <div>
                                <span class="text-slate-400 font-medium block">เลขที่เอกสาร:</span>
                                <!-- v3.15.2: รวม เล่มที่/เลขที่ เป็นช่องเดียว — ป้องกัน AI อ่านเห็นเลขที่แต่ไม่มีเล่มที่ แล้วถูกมองเป็นคนละเอกสาร -->
                                <input type="text" id="editDocNoInput" placeholder="เช่น 5/2680 (เล่มที่/เลขที่) หรือ 12345" oninput="refreshEditDocNoVisibility()" class="ui-input w-full font-mono mt-1">
                                <span class="text-slate-400 font-medium block mt-2">เลขที่ PO:</span>
                                <input type="text" id="editPoInput" placeholder="PO-XXXX" class="ui-input w-full font-mono mt-1">
                                <span class="text-slate-400 font-medium block mt-2">เลขที่รายการระบบ:</span>
                                <span id="editSystemRecordNo" class="font-mono font-semibold text-sky-700 text-xs">-</span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">วันที่ในบิล:</span>
                                <input type="date" id="editDateInput" class="ui-input w-full mt-1">
                                <span class="text-slate-400 font-medium block mt-2">หมวดหมู่:</span>
                                <select id="editCategorySelect" class="ui-input w-full mt-1">
                                    <option value="ทั่วไป">ทั่วไป</option>
                                    <option value="วัสดุก่อสร้าง">วัสดุก่อสร้าง</option>
                                    <option value="น้ำมันเชื้อเพลิง">น้ำมันเชื้อเพลิง</option>
                                    <option value="อุปกรณ์ช่าง">อุปกรณ์ช่าง</option>
                                    <option value="ค่าแรง/บริการ">ค่าแรง/บริการ</option>
                                </select>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">ชื่อร้านค้า / ผู้ขาย:</span>
                                <input type="text" id="editStoreInput" list="editStoreList" placeholder="ชื่อร้านค้า" class="ui-input w-full mt-1">
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">ผู้ส่งบิล (LINE):</span>
                                <span id="editSender" class="font-semibold text-slate-800 text-sm inline-flex items-center gap-1.5 mt-1"><i class="fa-solid fa-user text-btc-green text-[10px]"></i><span>-</span></span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">แหล่งที่มา:</span>
                                <span id="editSource" class="font-medium text-slate-700 text-xs">-</span>
                            </div>
                        </div>

                <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 flex items-start gap-3">
                    <i class="fa-solid fa-circle-info text-amber-500 mt-0.5"></i>
                    <p class="text-xs text-amber-800 leading-relaxed">
                        ใช้กรณี AI อ่านข้อมูลจากบิลไม่ตรง — แก้ไขแล้วกด <strong>บันทึกการแก้ไข</strong>
                        ระบบจะเขียนทับข้อมูลใน Google Sheets
                        (เลขที่ PO / วันที่ / ร้านค้า / หมวดหมู่ / รายการสินค้า / ยอดรวม) โดยไฟล์รูปบิลเดิมยังคงอยู่
                    </p>
                </div>

                <!-- การ์ดข้อมูลเอกสาร (ประเภท/เล่ม/เลขที่กำกับภาษี/เลขอ้างอิง) -->
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">ประเภทเอกสาร:</label>
                        <select id="editDocTypeSelect" onchange="toggleScaleFields(this.value)"
                            class="ui-input w-full">
                            <option value="">- ไม่ระบุ -</option>
                            <option value="ใบกำกับภาษี">ใบกำกับภาษี</option>
                            <option value="ใบเสร็จรับเงิน">ใบเสร็จรับเงิน</option>
                            <option value="ใบส่งของ">ใบส่งของ</option>
                            <option value="ใบสั่งซื้อ">ใบสั่งซื้อ</option>
                            <option value="ใบวางบิล/ใบแจ้งหนี้">ใบวางบิล / ใบแจ้งหนี้</option>
                            <option value="ใบชั่ง">ใบชั่งน้ำหนัก</option>
                            <option value="อื่นๆ">อื่นๆ</option>
                            <option value="__ADD_NEW__" class="font-semibold text-btc-green">+ เพิ่มประเภทใหม่…</option>
                        </select>
                        <!-- ประเภทเอกสารเฉพาะขององค์กร (doc_types) เติมเข้า select อัตโนมัติตอนโหลดหน้า -->
                    </div>
                    <div id="editDocTypeAddBox" class="hidden sm:col-span-2 lg:col-span-4 bg-emerald-50 border border-emerald-200 rounded-xl p-3">
                        <label class="block text-xs font-semibold text-emerald-800 mb-1">เพิ่มประเภทเอกสารขององค์กร (ตัวอย่าง: ใบขนส่งรถสิบล้อ, ใบรับเงินมัดจำ):</label>
                        <div class="flex flex-col sm:flex-row gap-2">
                            <input type="text" id="newDocTypeName" placeholder="ชื่อประเภทเอกสาร (ตามที่พิมพ์บนหัวใบ)" maxlength="60"
                                class="flex-1 px-3 py-2 border border-emerald-300 rounded-xl text-xs focus:ring-2 focus:ring-btc-green focus:outline-none">
                            <input type="text" id="newDocTypeAliases" placeholder="คำที่พิมพ์บนใบ (คั่นด้วย , เช่น ใบขนส่ง, ใบรับของ) — ใส่ได้หรือเว้นว่าง"
                                class="flex-1 px-3 py-2 border border-emerald-300 rounded-xl text-xs focus:ring-2 focus:ring-btc-green focus:outline-none">
                            <label class="flex items-center gap-1.5 text-xs text-slate-700 whitespace-nowrap bg-white px-3 rounded-xl border border-emerald-200 cursor-pointer">
                                <input type="checkbox" id="newDocTypeScale" class="accent-btc-green"> ใช้ช่องใบชั่ง
                            </label>
                            <button type="button" onclick="submitNewDocType()"
                                class="ui-btn ui-btn--primary whitespace-nowrap">
                                <i class="fa-solid fa-plus mr-1"></i>เพิ่ม
                            </button>
                        </div>
                        <p class="text-[11px] text-emerald-700 mt-1.5"><i class="fa-solid fa-lightbulb mr-1"></i>เพิ่มแล้ว AI จะใช้ประเภทนี้จำแนกบิลใหม่ทันที — ติ๊ก "ใช้ช่องใบชั่ง" เฉพาะประเภทที่ไม่เน้นยอดเงิน (แสดงช่องทะเบียน/น้ำหนัก)</p>
                    </div>
                    <div id="editBookBox">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">เล่มที่ <span class="font-normal text-slate-400">(บิลเก่า — ใหม่ให้รวมในช่องเลขที่เอกสารเป็น เล่มที่/เลขที่)</span>:</label>
                        <input type="text" id="editBookInput" placeholder="เช่น 2"
                            class="ui-input w-full font-mono">
                    </div>
                    <div id="editTaxInvoiceBox">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">เลขที่ใบกำกับภาษี:</label>
                        <input type="text" id="editTaxInvoiceInput" placeholder="ถ้ามี"
                            class="ui-input w-full font-mono">
                    </div>
                    <div id="editRefNoBox">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">เลขอ้างอิงอื่น:</label>
                        <input type="text" id="editRefNoInput" placeholder="เช่น เลขที่สัญญา / เลขใบวางบิล"
                            class="ui-input w-full font-mono">
                    </div>
                    <div id="editRefLabelBox">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">ชื่อเรียกเลขอ้างอิง:</label>
                        <input type="text" id="editRefLabelInput" placeholder="เช่น เลขที่สัญญา"
                            class="ui-input w-full">
                    </div>
                </div>

                <!-- การ์ดข้อมูลสั่งซื้อ/งาน (เหมือน ดูบิลเต็ม แถบข้อมูลสั่งซื้อ/งาน) — 🎯 โชว์ตามประเภทเอกสาร (ใบสั่งซื้อ/ใบขอซื้อ) หรือเมื่อมีค่าอยู่แล้ว -->
                <div id="editPoFieldsCard" class="bg-amber-50/70 border border-amber-200 rounded-xl p-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">🏢 ชื่อบริษัท (ผู้สั่งซื้อ):</label>
                        <input type="text" id="editCompanyInput" list="editCompanyList" placeholder="ชื่อบริษัทบนใบสั่งซื้อ"
                            class="ui-input w-full">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">🚧 งาน / โครงการ:</label>
                        <input type="text" id="editJobInput" list="editJobList" placeholder="เช่น งานบ้านจัดสรรคลอง 5"
                            class="ui-input w-full">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">🙋 ผู้เบิก:</label>
                        <input type="text" id="editRequesterInput" list="editRequesterList" placeholder="ชื่อผู้ขอเบิก/สั่งซื้อ"
                            class="ui-input w-full">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">💳 ผู้สั่งจ่าย:</label>
                        <input type="text" id="editPayApproverInput" list="editPayApproverList" placeholder="ชื่อผู้มีอำนาจสั่งจ่าย"
                            class="ui-input w-full">
                    </div>
                </div>

                <!-- บัตรใบชั่ง (แสดงเฉพาะประเภทใบชั่ง) — สไตล์เดียวกับ ดูบิลเต็ม -->
                <div id="editScaleFields" class="hidden bg-sky-50 border border-sky-200 rounded-xl p-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">🚚 ทะเบียนรถ:</label>
                        <input type="text" id="editVehicleInput" list="editVehicleList" placeholder="เช่น บบ 1234 บุรีรัมย์"
                            class="ui-input w-full">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">⬇️ น้ำหนักเข้า (ตัน):</label>
                        <input type="number" step="0.01" id="editWeightInInput" placeholder="-"
                            class="ui-input w-full font-mono">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">⬆️ น้ำหนักออก (ตัน):</label>
                        <input type="number" step="0.01" id="editWeightOutInput" placeholder="-"
                            class="ui-input w-full font-mono">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">⚖️ น้ำหนักสินค้า (ตัน):</label>
                        <input type="number" step="0.01" id="editWeightNetInput" placeholder="-"
                            class="ui-input w-full font-mono">
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-2.5">
                        <h5 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-list-check text-btc-green"></i>
                            แก้ไขรายการสินค้า / วัสดุ
                        </h5>
                        <div class="flex items-center gap-2">
                            <span id="editItemBadge"
                                class="ui-badge ui-badge--ok">0 รายการ</span>
                            <button onclick="addEditItemRow()"
                                class="ui-btn ui-btn--primary">
                                <i class="fa-solid fa-plus mr-1"></i>เพิ่มรายการ
                            </button>
                        </div>
                    </div>

                    <div
                        class="border border-slate-200 rounded-xl overflow-hidden shadow-sm max-h-[280px] overflow-y-auto custom-scrollbar">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead
                                class="sticky top-0 z-10 bg-slate-50 text-slate-600 text-xs font-semibold border-b border-slate-200">
                                <tr>
                                    <th class="p-2.5 w-12 text-center">ลำดับ</th>
                                    <th class="p-2.5">รายการสินค้า / วัสดุ</th>
                                    <th class="p-2.5 text-center w-24">จำนวน</th>
                                    <th class="p-2.5 text-center w-24">หน่วย</th>
                                    <th class="p-2.5 text-right w-28">ราคา/หน่วย</th>
                                    <th class="p-2.5 text-right w-32">ราคารวม</th>
                                    <th class="p-2.5 text-center w-12"></th>
                                </tr>
                            </thead>
                            <tbody id="editItemsBody" class="divide-y divide-slate-100 bg-white">
                                <!-- Editable Rows inserted via JS -->
                            </tbody>
                        </table>
                    </div>

                    <div
                        class="mt-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-emerald-50 border border-emerald-200 rounded-xl p-3">
                        <div class="flex items-center gap-2 text-xs text-slate-600">
                            <i class="fa-solid fa-calculator text-btc-green"></i>
                            <span>ยอดรวมสุทธิ (แก้ไขได้เอง หากในบิลไม่ตรงกับผลรวมรายการ)</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold text-slate-700">฿</span>
                            <input type="number" step="0.01" id="editTotalInput" oninput="editTotalManual = true"
                                class="w-40 px-3 py-2 border border-emerald-300 rounded-xl text-sm font-bold text-right text-btc-green focus:ring-2 focus:ring-btc-green focus:outline-none bg-white">
                        </div>
                    </div>
                </div>

                </div><!-- /ฟอร์มแก้ไข เนื้อหา (คอลัมน์ขวา) -->
                </div><!-- /คอลัมน์ขวา (flex column) -->
            </div><!-- /สองคอลัมน์: รูปซ้าย + ฟอร์มขวา (ปิด flex row) -->

            <div
                class="bg-slate-50 px-6 py-3 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-500">
                <span id="editOriginInfo">แก้ไขบิล: -</span>
                <div class="flex items-center gap-2">
                    <button onclick="closeEditModal()"
                        class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg transition">
                        ยกเลิก
                    </button>
                    <button id="btnSaveEdit" onclick="saveEditReceipt()"
                        class="ui-btn ui-btn--primary flex items-center gap-1.5">
                        <i class="fa-solid fa-floppy-disk"></i> บันทึกการแก้ไข
                    </button>
                </div>
            </div>
        </div>
    </div>

