                        <span id="modalDate" class="font-semibold text-slate-800 text-sm">-</span>
                        <!-- v3.15.5: ป้ายเตือนวันที่เป็นตัวเติม (เดือน/ปีปัจจุบัน) — แก้ไขได้ที่ปุ่มแก้ไขข้อมูลบิล -->
                        <span id="modalDateFallbackBadge" class="ui-badge ui-badge--orange hidden mt-1 inline-flex items-center gap-1 border-orange-300" title="AI อ่านวันที่ในบิลไม่ชัด — ระบบเติมเดือน/ปีปัจจุบันแทน (วันที่จริงต้องอ่านจากใบ) กรุณาแก้ไขให้ตรงใบ"><i class="fa-regular fa-calendar"></i> วันที่รอตรวจ</span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">หมวดหมู่:</span>
                        <span id="modalCategory"
                            class="inline-block mt-0.5 bg-emerald-100 text-emerald-800 px-2.5 py-0.5 rounded font-medium text-xs border border-emerald-200">-</span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">ผู้ส่งบิล (LINE):</span>
                        <span id="modalSender"
                            class="font-semibold text-slate-800 text-sm inline-flex items-center gap-1.5">
                            <i class="fa-solid fa-user text-btc-green text-[10px]"></i><span>-</span>
                        </span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">แหล่งที่มา:</span>
                        <span id="modalSource" class="font-medium text-slate-700 text-xs">-</span>
                    </div>
                </div>

                <!-- ถังเก็บข้อมูลสั่งซื้อ/งาน: ชื่อบริษัท / งาน / ผู้เบิก / ผู้สั่งจ่าย (โชว์เมื่อ doc_type = ใบสั่งซื้อ หรือมีค่าอย่างน้อย 1 ช่อง อ่านจากใบจริง) -->
                <div id="modalAccountingInfo" class="hidden bg-amber-50/70 border border-amber-200 rounded-xl p-4 text-xs">
                    <div class="flex flex-wrap items-center gap-2 mb-1.5">
