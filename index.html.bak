    <!-- Receipt Detail Modal -->
    <div id="detailModal"
        class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div
            class="bg-white rounded-2xl shadow-2xl max-w-6xl w-full overflow-hidden flex flex-col max-h-[92vh] transition-all">

            <div class="bg-white border-b border-slate-200 p-4 px-6 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <span class="bg-btc-green text-white text-xs px-2.5 py-1 rounded-md font-bold tracking-wide">BTC
                        รายละเอียดบิล</span>
                    <h3 id="modalSupplierTitle" class="font-bold text-base text-slate-800 truncate max-w-xs sm:max-w-md">
