                    <div
                        class="border border-slate-200 rounded-xl overflow-hidden shadow-sm max-h-[300px] overflow-y-auto custom-scrollbar relative">
                        <table class="w-full text-left border-collapse text-xs">
<thead
                            class="ui-th sticky top-0 z-10 border-b border-slate-200">
                            <tr>
                                <th class="p-3 w-12 text-center">ลำดับ</th>
                                <th class="p-3">รายการสินค้า / วัสดุก่อสร้าง</th>
                                <th class="p-3 text-center">จำนวน</th>
