                                <th class="p-3 text-right">ราคารวม (บาท)</th>
                            </tr>
                        </thead>
                            <tbody id="modalItemsTableBody" class="divide-y divide-slate-100 bg-white">
                                <!-- Detailed Rows inserted via JS -->
                            </tbody>
                            <tfoot
                                class="sticky bottom-0 bg-emerald-50/60 border-t-2 border-emerald-200 font-bold text-slate-900">
                                <tr>
                                    <td colspan="5" class="p-3 text-right text-xs">ยอดรวมสุทธิ (Grand Total):</td>
                                    <td id="modalTotalAmountTable" class="p-3 text-right text-btc-green text-sm">฿0.00
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                </div>
                <div id="modalTabMatch"
                    class="hidden flex-1 min-w-0 p-4 sm:p-6 overflow-y-auto space-y-4 custom-scrollbar">
