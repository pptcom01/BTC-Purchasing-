                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">                    ⬇️ น้ำหนักเข้า (ตัน):</span>
                        <span id="modalWeightIn" class="font-bold text-slate-800 text-sm">-</span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">                    ⬆️ น้ำหนักออก (ตัน):</span>
                        <span id="modalWeightOut" class="font-bold text-slate-800 text-sm">-</span>
                    </div>                    <div>
                        <span class="text-slate-400 font-medium block">⚖️ น้ำหนักสินค้า (ตัน):</span>
                        <span id="modalWeightNet" class="font-bold text-sky-700 text-sm">-</span>
                    </div>
                </div>

                <!-- กล่องเทียบน้ำหนักตอนรับของจริง (โชว์เฉพาะบิลที่มีใบรับของ/ใบชั่งแนบ) -->
                <div id="modalCompareBox" class="hidden"></div>

                <div>
                    <div class="flex items-center justify-between mb-2.5">
                        <h5 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-list-check text-btc-green"></i>
                            ตารางรายละเอียดสินค้า / วัสดุ (แบบละเอียด)
                        </h5>
