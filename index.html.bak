            <!-- สองคอลัมน์: รูปบิลซ้าย + ข้อมูลขวา (แบบเดียวกับหน้าแก้ไข) -->
            <div class="flex-1 flex flex-col lg:flex-row overflow-hidden min-h-0">
                <!-- ซ้าย: รูปบิลต้นฉบับ -->
                <div class="lg:w-[38%] shrink-0 bg-slate-50 border-b lg:border-b-0 lg:border-r border-slate-200 p-3 flex flex-col gap-2">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-semibold text-slate-600"><i class="fa-regular fa-image text-btc-green mr-1"></i>ภาพถ่ายบิลต้นฉบับ</span>
                        <a id="modalImageExternal" href="#" onclick="detailImageZoomReset();return false;"
