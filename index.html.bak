    <!-- API Config Modal -->
    <div id="apiModal"
        class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="font-bold text-slate-800 text-base flex items-center gap-2">
                    <i class="fa-solid fa-gears text-btc-green"></i> ตั้งค่าการเชื่อมต่อ Google Sheets API
                </h3>
                <button onclick="closeApiModal()" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
                นำ Web App URL ที่ได้จากการ Deploy Google Apps Script มาใส่เพื่อดึงข้อมูลบิลจริง
            </p>
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Google Apps Script Web App URL</label>
                <input type="url" id="apiUrlInput" placeholder="https://script.google.com/macros/s/.../exec"
                    class="ui-input w-full">
            </div>
            <div class="flex items-center justify-end space-x-2 pt-2">
                <button onclick="closeApiModal()"
                    class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium rounded-lg">ยกเลิก</button>
                <button onclick="saveApiUrl()"
                    class="ui-btn ui-btn--primary">บันทึกการตั้งค่า</button>
            </div>
        </div>
    </div>

    <!-- Settings Modal (ตั้งค่าระบบ — ต้องรหัสผ่านก่อนถึงเข้าหน้าตั้งค่า) -->
    <div id="settingsModal"
        class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full flex flex-col max-h-[92vh] overflow-hidden">
            <div class="px-5 py-3.5 border-b border-slate-200 flex items-center justify-between shrink-0">
                <h3 class="font-bold text-slate-800 text-base flex items-center gap-2">
                    <i class="fa-solid fa-gear text-btc-green"></i> ตั้งค่าระบบ
                    <span id="cfgTitleBadge" class="text-[11px] font-normal text-slate-400">(ต้องใช้รหัสผ่าน)</span>
                </h3>
                <button onclick="closeSettingsModal()"
                    class="text-slate-400 hover:text-slate-900 p-1.5 rounded-lg transition">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <div class="p-6 overflow-y-auto custom-scrollbar flex-1">
                <!-- Step 1: เข้าระบบด้วยรหัสผ่าน -->
                <div id="cfgLoginPanel" class="space-y-4">
                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col items-center justify-center text-center space-y-3">
                        <div class="w-12 h-12 bg-white rounded-full border border-slate-200 flex items-center justify-center text-btc-green text-xl shadow-sm">
                            <i class="fa-solid fa-lock"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-800 text-sm">ข้อมูลส่วนนี้ถูกจำกัด</h4>
                            <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                                กรอกรหัสผ่านเพื่อเข้าสู่หน้าตั้งค่าระบบ<br>
                                (LINE Token / Gemini Key / โฟลเดอร์ Drive / Spreadsheet ID)
                            </p>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">รหัสผ่าน</label>
                        <input type="password" id="cfgPasswordInput" autocomplete="current-password"
                            class="ui-input w-full"
                            onkeydown="if(event.key==='Enter')loginSettings()">
                    </div>
                    <button onclick="loginSettings()"
                        class="ui-btn ui-btn--primary w-full items-center justify-center inline-flex gap-1.5">
                        <i class="fa-solid fa-unlock-keyhole"></i> เข้าระบบเพื่อตั้งค่า
                    </button>
                </div>

                <!-- Step 2: ฟอร์มตั้งค่า (เปิดหลังตรวจรหัสผ่านผ่าน) -->
                <div id="cfgFormPanel" class="hidden space-y-4">
                    <div id="cfgLoadedNotice"
                        class="bg-emerald-50 border border-emerald-200 rounded-xl p-3 text-[11px] text-emerald-800 space-y-1 hidden">
                        <p><i class="fa-solid fa-circle-check mr-1"></i><span id="cfgLoadedMsg">โหลดค่าปัจจุบันแล้ว — ช่องที่เป็น <span class="font-mono">****</span> แปลว่าไม่ได้แก้ ระบบจะคงค่าเดิมไว้</span></p>
                    </div>
                    <div class="flex items-center justify-between gap-2 bg-slate-50 border border-slate-200 rounded-xl p-3">
                        <span class="text-[11px] text-slate-500 leading-relaxed">
                            <i class="fa-solid fa-shield-halved mr-1 text-btc-green"></i>ค่าเชื่อมต่อถูกซ่อนไว้เพื่อความปลอดภัย
                        </span>
                        <button type="button" id="btnRevealCfg" onclick="toggleRevealConfig()"
                            class="ui-btn ui-btn--sm ui-btn--ghost shrink-0">
                            <i class="fa-solid fa-eye"></i> <span id="btnRevealCfgLabel">แสดงค่าจริง</span>
                        </button>
                    </div>
                    <div class="grid grid-cols-1 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">LINE Channel Access Token</label>
                            <div class="flex gap-2">
                                <input type="password" id="cfgLineTokenInput" autocomplete="off"
                                    class="ui-input flex-1 min-w-0 font-mono">
                                <button type="button" onclick="toggleCfgVisibility('cfgLineTokenInput', this)"
                                    class="shrink-0 w-11 border border-slate-300 rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition"
                                    title="แสดง/ซ่อนค่า"><i class="fa-solid fa-eye"></i></button>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Gemini API Key</label>
                            <div class="flex gap-2">
                                <input type="password" id="cfgGeminiInput" autocomplete="off"
                                    class="ui-input flex-1 min-w-0 font-mono">
                                <button type="button" onclick="toggleCfgVisibility('cfgGeminiInput', this)"
                                    class="shrink-0 w-11 border border-slate-300 rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition"
                                    title="แสดง/ซ่อนค่า"><i class="fa-solid fa-eye"></i></button>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">ชื่อโฟลเดอร์ Drive</label>
                            <input type="text" id="cfgFolderInput"
                                class="ui-input w-full font-mono">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Spreadsheet ID</label>
                            <div class="flex gap-2">
                                <input type="password" id="cfgSheetIdInput" autocomplete="off"
                                    class="ui-input flex-1 min-w-0 font-mono">
                                <button type="button" onclick="toggleCfgVisibility('cfgSheetIdInput', this)"
                                    class="shrink-0 w-11 border border-slate-300 rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition"
                                    title="แสดง/ซ่อนค่า"><i class="fa-solid fa-eye"></i></button>
                            </div>
                        </div>
                        <div id="cfgApiUrlRow" class="hidden">
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Google Sheets API URL <span class="text-slate-400">(เลิกใช้แล้ว — ระบบใช้ GAS Web App เป็นโฮสต์เดียว)</span></label>
                            <input type="url" id="cfgApiUrlInput" autocomplete="off" placeholder="https://script.google.com/macros/s/.../exec"
                                class="ui-input w-full font-mono">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Supabase URL <span class="text-slate-400">(ฐานข้อมูลใหม่ของบิล — เช่น https://xxxx.supabase.co)</span></label>
                            <input type="text" id="cfgSupabaseUrlInput" autocomplete="off" placeholder="https://xxxx.supabase.co"
                                class="ui-input w-full font-mono">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Supabase Service Key <span class="text-slate-400">(service_role — ระบบย้ายข้อมูล/บันทึกบิลใช้ key นี้)</span></label>
                            <div class="flex gap-2">
                                <input type="password" id="cfgSupabaseKeyInput" autocomplete="off"
                                    class="ui-input flex-1 min-w-0 font-mono">
                                <button type="button" onclick="toggleCfgVisibility('cfgSupabaseKeyInput', this)"
                                    class="shrink-0 w-11 border border-slate-300 rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition"
                                    title="แสดง/ซ่อนค่า"><i class="fa-solid fa-eye"></i></button>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Supabase Anon Key <span class="text-slate-400">(public — ให้หน้าเว็บอ่านบิลตรงจาก Supabase ข้าม API)</span></label>
                            <input type="text" id="cfgSupabaseAnonInput" autocomplete="off" placeholder="eyJhbGciOi..."
                                class="ui-input w-full font-mono">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">รหัสผ่านใหม่ (เว้นว่างถ้าไม่เปลี่ยน — อย่างน้อย 8 ตัว)</label>
                            <input type="password" id="cfgNewPasswordInput" autocomplete="new-password"
                                class="ui-input w-full">
                        </div>
                    </div>
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-xl p-3 flex flex-col sm:flex-row items-center justify-between gap-3 shrink-0">
                        <span class="text-[11px] text-slate-400">มีผลทันทีกับบิลถัดไป (LINE / Gemini / โฟลเดอร์ / สเปรดชีต / Supabase)</span>
                        <div class="flex items-center gap-2">
                            <button onclick="resetSettingsToLogin()"
                                class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-medium rounded-lg transition">ออกจากโหมดตั้งค่า</button>
                            <button id="btnReloadCfg" onclick="loadSettingsConfig(cfgRevealed)"
                                class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium rounded-lg transition">โหลดค่า</button>
                            <button id="btnSaveCfg" onclick="saveSettingsConfig()"
                                class="ui-btn ui-btn--primary flex items-center gap-1.5">
                                <i class="fa-solid fa-floppy-disk"></i> บันทึก
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Image Editor Modal (หมุน / พลิก / ครอป / ปรับความสว่าง รูปบิล) -->
    <div id="imageEditorModal"
        class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-2 sm:p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-5xl max-h-[96vh] flex flex-col overflow-hidden">
            <div class="px-5 py-3 border-b border-slate-200 flex items-center justify-between shrink-0">
                <h3 class="font-bold text-slate-800 text-base flex items-center gap-2">
                    <i class="fa-solid fa-image text-btc-green"></i> แก้ไขรูปบิล
                    <span class="text-[11px] font-normal text-slate-400">(หมุน / พลิก / ครอป / ปรับความสว่าง)</span>
                </h3>
                <button onclick="closeImageEditor()"
                    class="text-slate-400 hover:text-slate-900 p-1.5 rounded-lg transition">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <div class="px-5 py-3 border-b border-slate-100 flex flex-wrap items-center gap-2 shrink-0 bg-slate-50">
                <button type="button" onclick="editorRotate('left')"
                    class="px-3 py-2 bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold rounded-lg border border-slate-200 transition">
                    <i class="fa-solid fa-rotate-left mr-1"></i>หมุนซ้าย
                </button>
                <button type="button" onclick="editorRotate('right')"
                    class="px-3 py-2 bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold rounded-lg border border-slate-200 transition">
                    <i class="fa-solid fa-rotate-right mr-1"></i>หมุนขวา
                </button>
                <button type="button" onclick="editorFlip('h')"
                    class="px-3 py-2 bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold rounded-lg border border-slate-200 transition">
                    <i class="fa-solid fa-left-right mr-1"></i>พลิกแนวนอน
                </button>
                <button type="button" onclick="editorFlip('v')"
                    class="px-3 py-2 bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold rounded-lg border border-slate-200 transition">
                    <i class="fa-solid fa-up-down mr-1"></i>พลิกแนวตั้ง
                </button>
                <button type="button" id="btnCropToggle" onclick="editorToggleCrop()"
                    class="px-3 py-2 bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold rounded-lg border border-slate-200 transition">
                    <i class="fa-solid fa-crop-simple mr-1"></i><span id="cropToggleLabel">เริ่มครอป</span>
                </button>
                <div class="flex items-center gap-2 bg-white px-3 py-2 rounded-lg border border-slate-200">
                    <i class="fa-solid fa-sun text-amber-500 text-xs"></i>
                    <span class="text-xs text-slate-600 font-semibold">ความสว่าง</span>
                    <input type="range" id="brightnessRange" min="-80" max="100" value="0"
                        oninput="editorSetBrightness(this.value)" class="w-28 accent-btc-green">
                    <span id="brightnessValue" class="text-xs font-mono text-slate-500 w-8 text-right">0</span>
                </div>
                <button type="button" onclick="editorReset()"
                    class="px-3 py-2 bg-white hover:bg-slate-100 text-slate-500 text-xs font-semibold rounded-lg border border-slate-200 transition ml-auto">
                    <i class="fa-solid fa-rotate mr-1"></i>รีเซ็ต
                </button>
            </div>

            <div class="flex-1 min-h-0 overflow-auto bg-slate-800 flex items-center justify-center p-3">
                <div id="editorStage" class="relative inline-block leading-none">
                    <canvas id="editorCanvas" class="block max-w-full max-h-[62vh]"></canvas>
                    <div id="cropOverlay" class="hidden absolute inset-0 bg-slate-900/40 cursor-crosshair touch-none">
                        <div id="cropBox"
                            class="absolute border-2 border-white touch-none cursor-move"
                            style="left:10%;top:10%;width:80%;height:80%;box-shadow:0 0 0 9999px rgba(15,23,42,0.55)">
                            <span data-handle="nw"
                                class="absolute -left-1.5 -top-1.5 w-4 h-4 bg-white rounded-full border border-slate-400 cursor-nwse-resize touch-none"></span>
                            <span data-handle="ne"
                                class="absolute -right-1.5 -top-1.5 w-4 h-4 bg-white rounded-full border border-slate-400 cursor-nesw-resize touch-none"></span>
                            <span data-handle="sw"
                                class="absolute -left-1.5 -bottom-1.5 w-4 h-4 bg-white rounded-full border border-slate-400 cursor-nesw-resize touch-none"></span>
                            <span data-handle="se"
                                class="absolute -right-1.5 -bottom-1.5 w-4 h-4 bg-white rounded-full border border-slate-400 cursor-nwse-resize touch-none"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div
                class="px-5 py-3 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shrink-0">
                <span id="editorHint" class="text-[11px] text-slate-400">หมุน/พลิก/ปรับความสว่างได้ทันที — กด
                    "เริ่มครอป" เพื่อเลือกพื้นที่ที่ต้องการเก็บ</span>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="closeImageEditor()"
                        class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium rounded-lg transition">ยกเลิก</button>
                    <button type="button" id="btnEditorSave" onclick="saveImageEdit()"
                        class="ui-btn ui-btn--primary flex items-center gap-1.5">
                        <i class="fa-solid fa-floppy-disk"></i> บันทึกรูป
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Custom Notification Toast -->
    <div id="toast"
        class="fixed bottom-5 right-5 z-50 bg-white text-slate-700 px-4 py-3 rounded-xl shadow-lg border border-slate-200 text-xs flex items-center space-x-3 transition-all duration-300 transform translate-y-20 opacity-0 pointer-events-none">
        <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
        <span id="toastMessage">ข้อความแจ้งเตือน</span>
    </div>

    <!-- AI Re-Read Preview Modal: แสดงผลอ่านใหม่ให้ดู + ติ๊กช่องก่อนบันทึก -->
    <div id="reanalyzePreviewModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/50" onclick="closeReanalyzePreview()"></div>
        <div class="relative bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-slate-200 flex flex-col max-h-[85vh]">
            <div class="px-4 sm:px-6 pt-4 pb-3 border-b border-slate-100 flex items-center justify-between gap-3">
                <div class="min-w-0">
                    <h4 class="font-bold text-slate-900 text-sm">🔍 ผลการอ่านภาพใหม่ (AI)</h4>
                    <p id="reanalyzePreviewTitle" class="text-[11px] text-slate-500 truncate"></p>
                </div>
                <button onclick="closeReanalyzePreview()" class="shrink-0 w-8 h-8 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition text-sm flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div id="reanalyzePreviewBody" class="flex-1 min-h-0 overflow-y-auto p-4 sm:p-5 custom-scrollbar space-y-1.5"></div>
            <div class="px-4 sm:px-6 py-3 border-t border-slate-100 flex items-center justify-end gap-2 shrink-0">
                <button onclick="closeReanalyzePreview()" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100 border border-slate-200 transition">
                    <i class="fa-solid fa-xmark mr-1"></i>ยกเลิก
                </button>
                <button id="reanalyzeSaveBtn" onclick="saveReanalyzedData()" class="ui-btn ui-btn--sm ui-btn--primary">
                    <i class="fa-solid fa-floppy-disk mr-1"></i>บันทึกที่เลือก
                </button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-white text-slate-500 text-xs border-t border-slate-200 py-4 shrink-0">
        <div
            class="w-full px-2 sm:px-4 lg:px-6 xl:px-8 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
            <div class="flex items-center space-x-3">
                <div class="w-8 h-8 bg-white p-0.5 rounded-lg flex items-center justify-center shrink-0">
                    <img src="https://img2.pic.in.th/pic/Screenshot-2025-03-03-132721e6cc77cbcea28f01.png"
                        alt="BTC Logo" class="max-h-full max-w-full object-contain">
                </div>
                <div>
                    <h5 class="text-slate-900 font-bold">บริษัท บุรีรัมย์ธงชัยก่อสร้าง จำกัด</h5>
                    <p class="text-slate-400 text-[11px]">31/2 ถนนอินจันทร์ณรงค์ ต.ในเมือง อ.เมือง จ.บุรีรัมย์ 31000 |
                        เลขประจำตัวผู้เสียภาษี: 0315559001144</p>
                </div>
            </div>
            <div class="text-slate-400 text-[11px] space-y-1">
                <p><i class="fa-solid fa-phone mr-1"></i> โทร. 044-611134 &nbsp;|&nbsp; <i
                        class="fa-solid fa-envelope mr-1"></i> E-mail: brtc2024@gmail.com</p>
                <p class="text-slate-500">© 2026 Buriram Thongchai Construction Co., Ltd. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        let allData = [];
        let filteredData = [];
        let currentView = 'table';
        let expandedRowIds = new Set();
        let currentDetailIndex = null;   // index ของบิลที่เปิดใน Modal รายละเอียด (ใช้อ้างอิงตอนกด "แก้ไขข้อมูลบิล")
        let currentDetailItem = null;    // ตัว item ที่กำลังเปิดใน Modal รายละเอียด (รองรับการเปิดจากมุมมองจับคู่ที่ไม่อยู่ใน filteredData)
        let reanalyzeRunning = false;    // กันปุ่ม "อ่านใหม่ (AI)" ทำงานซ้อนกัน (ปุ่มใบเดียว + ทั้งระบบ)
        let billTab = 'other';           // แท็บตารางบิล: 'other' (บิลทั้งหมด — ไม่ใช่ PO และยังไม่ถูกจับคู่) | 'po' (ใบสั่งซื้อ) | 'matched' (บิลที่จับคู่แล้ว)
        let receiptLinks = [];           // ข้อมูลจับคู่ใบสั่งซื้อ↔บิลรับของ จาก Supabase/GAS: [{po_doc_key, link_doc_key, status, ...}]
        let lastLinksFetchAt = 0;        // throttle โหลด receipt_links (60 วินาที)
        let weightVariancesMap = {};     // keyed by bill_doc_key -> {qty_variance_pct, scale_weight_kg, severity} จาก Weight & Unit Variance Engine
        let weightVariancesLoadedAt = 0; // throttle โหลด weight_variances (120 วินาที)
        let lastLinksAutoAt = 0;         // ระยะล่าสุดที่ auto-refresh ไปบังคับรีเฟรช receipt_links (30 วินาที) — กันสแปม
        let detailTab = 'info';          // แท็บในหน้าดูบิลเต็ม: 'info' (ข้อมูล) | 'match' (จับคู่)
        let maxShownPOs = 50;            // จำกัดคู่ที่แสดงในแท็บ "บิลที่จับคู่แล้ว" ต่อการวาดครั้ง (คลิก "แสดงเพิ่มเติม")
        let shownPOs = 50;               // จำนวนที่กำลังแสดงจริง
        let linkSaving = false;          // กันกดปุ่มจับคู่/ยืนยัน/ลบ พร้อมกันซ้ำซ้อน
        let editTarget = null;           // ข้อมูลบิลเป้าหมายที่กำลังแก้ไข { id, timestamp, old_po_number }
        let editTotalManual = false;     // ผู้ใช้แก้ยอดรวมเองหรือไม่ (true = ไม่ให้ระบบคำนวณทับ)

        // ทะเบียนกลางประเภทเอกสารบัญชี: ค่า name ตรงกับ Code.gs/Supabase เพื่อให้บิลเก่ายังเปิดและค้นหาได้
        const ACCOUNTING_DOC_TYPES = [
            { name: 'ใบกำกับภาษี', code: 'TAX', group: 'เอกสารภาษีและหลักฐานรับชำระเงิน', vat: 'พิจารณาเครดิตภาษีซื้อได้เมื่อเอกสารถูกต้องครบถ้วน', legal: 'ม.86/4' },
            { name: 'ใบกำกับภาษีอย่างย่อ', code: 'ABB', group: 'เอกสารภาษีและหลักฐานรับชำระเงิน', vat: 'ห้ามใช้เครดิตภาษีซื้อ (ลงเป็นรายจ่ายได้) — ไม่มีชื่อ/เลขภาษีผู้ซื้อ', legal: 'ม.86/6, ม.82/5(6)' },
            { name: 'ใบเสร็จกรมศุลกากร', code: 'CUSTOMS', group: 'เอกสารภาษีและหลักฐานรับชำระเงิน', vat: 'ใช้เครดิตภาษีซื้อได้ (VAT นำเข้า)', legal: 'ม.86/14' },
            { name: 'Commercial Invoice', code: 'CI', group: 'เอกสารจัดซื้อและการค้า', vat: 'ไม่มี VAT ไทย (พิจารณายื่น ภ.พ.36 / ภ.ง.ด.54)', legal: 'ม.83/6 (ภ.พ.36)' },
            { name: 'ใบเสร็จรับเงิน', code: 'REC', group: 'เอกสารภาษีและหลักฐานรับชำระเงิน', vat: 'หลักฐานรับชำระเงิน ไม่ใช่เครดิต VAT โดยลำพัง', legal: 'ม.105' },
            { name: 'ใบเสร็จรับเงิน/ใบกำกับภาษี', code: 'REC/TAX', group: 'เอกสารภาษีและหลักฐานรับชำระเงิน', vat: 'พิจารณาเครดิตภาษีซื้อได้เมื่อเอกสารถูกต้องครบถ้วน', legal: 'ม.86/4, ม.105' },
            { name: 'ใบลดหนี้', code: 'CN', group: 'เอกสารภาษีและหลักฐานรับชำระเงิน', vat: 'ปรับลดภาษีซื้อและยอดซื้อตามเอกสารที่ถูกต้อง', legal: 'ม.86/10' },
            { name: 'ใบเพิ่มหนี้', code: 'DN', group: 'เอกสารภาษีและหลักฐานรับชำระเงิน', vat: 'ปรับเพิ่มภาษีซื้อและยอดซื้อตามเอกสารที่ถูกต้อง', legal: 'ม.86/9' },
            { name: 'หนังสือรับรองการหักภาษี ณ ที่จ่าย (50 ทวิ)', code: 'WHT', group: 'เอกสารภาษีและหลักฐานรับชำระเงิน', vat: 'หลักฐานภาษีหัก ณ ที่จ่าย ไม่ใช่เครดิต VAT', legal: 'ม.50 ทวิ' },
            { name: 'ใบส่งของ/ใบกำกับภาษี', code: 'DO/TAX', group: 'เอกสารการส่งมอบและหน้างานก่อสร้าง', vat: 'พิจารณาเครดิตภาษีซื้อได้เมื่อส่วนใบกำกับภาษีถูกต้องครบถ้วน', legal: 'ม.86/4' },
            { name: 'ใบส่งของ', code: 'DO', group: 'เอกสารการส่งมอบและหน้างานก่อสร้าง', vat: 'หลักฐานส่งมอบ ไม่ใช่เครดิต VAT โดยลำพัง', legal: '' },
            { name: 'ใบชั่ง', display_name: 'ใบชั่งน้ำหนัก', code: 'WT', group: 'เอกสารการส่งมอบและหน้างานก่อสร้าง', vat: 'หลักฐานน้ำหนักหน้างาน ไม่ใช่เครดิต VAT', legal: '', scale: true },
            { name: 'ใบตรวจรับพัสดุ/งานจ้าง', code: 'WR', group: 'เอกสารการส่งมอบและหน้างานก่อสร้าง', vat: 'หลักฐานตรวจรับภายใน ไม่ใช่เครดิต VAT โดยลำพัง', legal: '' },
            { name: 'ใบสั่งซื้อ', code: 'PO', group: 'เอกสารจัดซื้อและการค้า', vat: 'เอกสารสั่งซื้อ ไม่ใช่เครดิต VAT', legal: '' },
            { name: 'ใบขอซื้อ/ใบขอเบิก', code: 'PR', group: 'เอกสารจัดซื้อและการค้า', vat: 'เอกสารคำขอภายใน ไม่ใช่เครดิต VAT', legal: '' },
            { name: 'ใบวางบิล/ใบแจ้งหนี้', code: 'INV/BILL', group: 'เอกสารจัดซื้อและการค้า', vat: 'เอกสารเรียกเก็บเงิน ต้องติดตามหลักฐานภาษี/รับชำระประกอบ', legal: '' },
            { name: 'ใบเสนอราคา', code: 'QT', group: 'เอกสารจัดซื้อและการค้า', vat: 'เอกสารเสนอราคา ไม่ใช่เครดิต VAT', legal: '' },
            { name: 'ใบสำคัญจ่าย', code: 'PV', group: 'เอกสารบันทึกบัญชีภายใน', vat: 'เอกสารภายใน ต้องมีหลักฐานภาษีภายนอกประกอบ', legal: '' },
            { name: 'ใบสำคัญรับ', code: 'RV', group: 'เอกสารบันทึกบัญชีภายใน', vat: 'เอกสารภายใน ไม่ใช่เครดิต VAT โดยลำพัง', legal: '' },
            { name: 'ใบเบิกเงินสดย่อย', code: 'PC', group: 'เอกสารบันทึกบัญชีภายใน', vat: 'เอกสารภายใน ต้องมีหลักฐานภาษีภายนอกประกอบ', legal: '' },
            { name: 'ใบขอเบิกเงินทดรองจ่าย', code: 'ADV', group: 'เอกสารบันทึกบัญชีภายใน', vat: 'เอกสารขอสำรองจ่าย/เคลม ไม่ใช่เครดิต VAT โดยลำพัง', legal: '' }
        ];

        function getAccountingDocType(type) {
            const value = String(type || '').trim();
            return ACCOUNTING_DOC_TYPES.find(function (item) { return item.name === value; }) || null;
        }

        // 🎯 v3.17.1: ชื่อโชว์ของประเภทเอกสาร — ใช้ display_name ถ้ามี (เช่น ใบชั่ง → ใบชั่งน้ำหนัก) ไม่งั้นใช้ name เดิม
        // (ชื่อเก็บใน DB/doc_key ยังเป็นชื่อเดิม — เปลี่ยนแค่สิ่งที่ผู้ใช้เห็น ไม่กระทบตัวตนบิลเก่า)
        function displayDocTypeName(type) {
            const meta = getAccountingDocTypeLoose(type);
            return (meta && meta.display_name) ? meta.display_name : String(type || '');
        }

        // รองรับชื่อย่อ/คำพ้องที่พิมพ์บนใบ (เช่น 50 ทวิ) → หา meta มาตรฐานให้เจอ (ไม่เปลี่ยนชื่อ canonical ในข้อมูลบิลเดิม)
        function getAccountingDocTypeLoose(type) {
            const value = String(type || '').trim();
            if (!value) return null;
            const direct = getAccountingDocType(value);
            if (direct) return direct;
            if (/หักภาษี\s*ณ\s*ที่จ่าย|50\s*(ทวิ|bis)/i.test(value)) return getAccountingDocType('หนังสือรับรองการหักภาษี ณ ที่จ่าย (50 ทวิ)');
            if (/เสร็จรับเงิน.*กำกับภาษี|กำกับภาษี.*เสร็จรับเงิน/.test(value)) return getAccountingDocType('ใบเสร็จรับเงิน/ใบกำกับภาษี');
            if (/ส่งของ.*กำกับภาษี|กำกับภาษี.*ส่งของ/.test(value)) return getAccountingDocType('ใบส่งของ/ใบกำกับภาษี');
            return null;
        }

        function accountingDocTypeOptions(emptyLabel, extraTypes) {
            const groups = {};
            ACCOUNTING_DOC_TYPES.forEach(function (item) { (groups[item.group] = groups[item.group] || []).push(item); });
            let html = emptyLabel === null ? '' : '<option value="">' + escapeHtml(emptyLabel || 'เลือกประเภทเอกสาร...') + '</option>';
            Object.keys(groups).forEach(function (group) {
                html += '<optgroup label="' + escapeAttr(group) + '">' + groups[group].map(function (item) {
                    return '<option value="' + escapeAttr(item.name) + '">[' + escapeHtml(item.code) + '] ' + escapeHtml(item.display_name || item.name) + '</option>';
                }).join('') + '</optgroup>';
            });
            (extraTypes || []).filter(function (name) { return name && !getAccountingDocType(name); }).forEach(function (name) {
                html += '<option value="' + escapeAttr(name) + '">[CUSTOM] ' + escapeHtml(name) + '</option>';
            });
            return html;
        }

        function docTypeDisplay(type) {
            const meta = getAccountingDocTypeLoose(type);
            return meta ? '[' + meta.code + '] ' + (meta.display_name || meta.name) : (type || '-');
        }

        function docTypeBadge(type) {
            const meta = getAccountingDocTypeLoose(type);
            if (!meta) return type ? '<span class="inline-flex items-center text-[10px] font-semibold px-2 py-0.5 rounded border bg-slate-100 text-slate-600 border-slate-200">' + escapeHtml(type) + '</span>' : '';
            const taxLike = /เครดิตภาษีซื้อ|ปรับลดภาษีซื้อ|ปรับเพิ่มภาษีซื้อ/.test(meta.vat);
            return '<span class="inline-flex items-center text-[10px] font-bold px-2 py-0.5 rounded border ' + (taxLike ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-slate-100 text-slate-600 border-slate-200') + '" title="' + escapeAttr(meta.vat + (meta.legal ? ' · ' + meta.legal : '')) + '">[' + escapeHtml(meta.code) + ']</span>';
        }

        function renderAccountingDocTypeSelects() {
            const sel = document.getElementById('editDocTypeSelect');
            if (!sel) return;
            sel.innerHTML = accountingDocTypeOptions('- ไม่ระบุ -') + '<option value="__ADD_NEW__" class="font-semibold text-btc-green">+ เพิ่มประเภทใหม่…</option>';
            sel.onchange = function () { toggleScaleFields(this.value); updateEditDocTypeTaxHint(this.value); applyEditDocTypeVisibility(this.value); };
            updateEditDocTypeTaxHint(sel.value);
        }

        function renderAccountingDocTypeFilter() {
            const sel = document.getElementById('docTypeFilter');
            if (!sel) return;
            sel.innerHTML = accountingDocTypeOptions('ทุกประเภทเอกสาร');
        }

        function updateEditDocTypeTaxHint(type) {
            const sel = document.getElementById('editDocTypeSelect');
            if (!sel) return;
            let hint = document.getElementById('editDocTypeTaxHint');
            if (!hint) {
                hint = document.createElement('p');
                hint.id = 'editDocTypeTaxHint';
                hint.className = 'mt-1.5 text-[10px] leading-relaxed text-slate-500';
                sel.insertAdjacentElement('afterend', hint);
            }
            const meta = getAccountingDocType(type);
            hint.textContent = meta ? ('[' + meta.code + '] ' + meta.vat + (meta.legal ? ' · อ้างอิง ' + meta.legal : '')) : (type ? 'ประเภทเอกสารขององค์กร — ตรวจนโยบายภาษีกับฝ่ายบัญชีก่อนบันทึก' : 'เลือกประเภทเพื่อดูผลต่อเอกสารและภาษี');
        }

        // 🎯 v3.15.1: นโยบายส่วนที่โชว์ตามประเภทเอกสาร (ฟอร์มแก้ไข + ดูบิลเต็ม ใช้แหล่งเดียวกัน)
        // กฎเหล็ก: ช่องไหนมีค่าอยู่แล้ว ต้องโชว์เสมอ กันข้อมูลหายจากสายตา — ประเภทเป็นตัวกำหนดแค่ "ส่วนที่ว่างแสดงเพิ่ม"
        function docTypeRelevantFieldKeys(type) {
            const t = String(type || '').trim();
            const meta = (typeof getAccountingDocTypeLoose === 'function') ? getAccountingDocTypeLoose(t) : null;
            const code = meta ? String(meta.code || '') : '';
            const isIn = /เครดิตภาษีซื้อ|ปรับลดภาษีซื้อ|ปรับเพิ่มภาษีซื้อ/.test(String(meta && meta.vat || ''));
            const keys = {
                taxInvoice: false,   // เลขที่ใบกำกับภาษี
                book: false,         // เล่มที่
                ref: false,          // เลขอ้างอิงอื่น (+ ชื่อเรียกเลขอ้างอิง)
                po: false            // การ์ดข้อมูลสั่งซื้อ/งาน
            };
            if (isIn) { keys.taxInvoice = true; keys.book = true; keys.ref = true; }
            if (code === 'T1' || code === 'T2') { keys.taxInvoice = true; keys.book = true; keys.ref = true; }
            if (code === 'T3') { keys.ref = true; }
            if (code === 'T4' || code === 'T5') { keys.book = true; keys.ref = true; }
            if (code === 'D1' || code === 'D2') { keys.ref = true; }
            if (code === 'O1' || code === 'O2') { keys.po = true; }
            return keys;
        }

        // ปรับการ์ด/ช่องในฟอร์มแก้ไขให้เหลือเฉพาะส่วนที่เกี่ยวข้องกับประเภทเอกสาร (บิลจริงเป็นตัวตั้ง: มีค่า = โชว์เสมอ)
        function applyEditDocTypeVisibility(type) {
            const get = (id) => document.getElementById(id);
            const boxVisible = (el, on) => { if (el) el.classList.toggle('hidden', !on); };
            const val = (el) => el ? String(el.value || '').trim() : '';
            const keys = docTypeRelevantFieldKeys(type);
            // บัตรประจำตัวเอกสาร (เล่มที่ / เลขกำกับ / เลขอ้างอิง)
            // v3.15.2: เล่มที่รวมอยู่ในช่องเลขที่เอกสารแล้ว (รูปแบบ เล่มที่/เลขที่) — โชว์ช่องเล่มที่แยกเฉพาะบิลเก่าที่มีค้างอยู่เท่านั้น
            const docNoVal = val(get('editDocNoInput'));
            const bookVal = val(get('editBookInput'));
            const bookInsideDocNo = !!(bookVal && docNoVal && docNoVal.indexOf(bookVal + '/') === 0);
            const showBook = (keys.book || bookVal !== '') && !bookInsideDocNo;
            const showTax = keys.taxInvoice || val(get('editTaxInvoiceInput')) !== '';
            const showRef = keys.ref || val(get('editRefNoInput')) !== '' || val(get('editRefLabelInput')) !== '';
            boxVisible(get('editBookBox'), showBook);
            boxVisible(get('editTaxInvoiceBox'), showTax);
            boxVisible(get('editRefNoBox'), showRef);
            boxVisible(get('editRefLabelBox'), showRef);
            // การ์ดข้อมูลสั่งซื้อ/งาน
            const poOn = keys.po || val(get('editPoInput')) !== '' || val(get('editJobInput')) !== '' || val(get('editRequesterInput')) !== '' || val(get('editPayApproverInput')) !== '';
            boxVisible(get('editPoFieldsCard'), poOn);
            // ส่วนใบชั่ง (โครงเดิม: โชว์เฉพาะใบชั่ง — คงไว้ที่นี่เป็นจุดเดียว)
            const tTrim = String(type || '').trim();
            const isScale = tTrim === 'ใบชั่ง' || tTrim === 'ใบชั่งน้ำหนัก' || (typeof customScaleDocTypes !== 'undefined' && customScaleDocTypes.indexOf(type) !== -1);
            boxVisible(get('editScaleFields'), isScale);
        }

        // v3.15.2: พิมพ์ในช่องเลขที่เอกสาร (เช่นกรอก เล่มที่/เลขที่ ทับ) → รีเฟรชการซ่อน/โชว์ช่องเล่มที่แยก
        function refreshEditDocNoVisibility() {
            const sel = document.getElementById('editDocTypeSelect');
            applyEditDocTypeVisibility(sel ? sel.value : '');
        }

        function renderDetailAccountingInfo(type, item) {
            const box = document.getElementById('modalAccountingInfo');
            const meta = getAccountingDocTypeLoose(type);
            if (!box) return;
            if (!meta) { box.classList.add('hidden'); return; }
            document.getElementById('modalDocTypeCode').textContent = '[' + meta.code + ']';
            document.getElementById('modalDocTypeName').textContent = meta.display_name || meta.name;
            document.getElementById('modalDocTypeGroup').textContent = meta.group;
            document.getElementById('modalTaxTreatment').textContent = meta.vat;
            const legal = document.getElementById('modalLegalReference');
            legal.textContent = meta.legal ? 'อ้างอิง ' + meta.legal + ' แห่งประมวลรัษฎากร' : '';
            legal.classList.toggle('hidden', !meta.legal);
            // 🎯 v3.17.0: ชื่อเอกสารที่ AI อ่านจากใบ + ธงชื่อไม่ชัด (เดาจากองค์ประกอบ)
            const titleEl = document.getElementById('modalDocTitleText');
            const titleWrap = document.getElementById('modalDocTitleRow');
            if (titleEl && titleWrap) {
                const t = String((item && item.doc_title_text) || '').trim();
                const guessed = item && item.is_title_explicit === false;
                titleEl.textContent = t || '-';
                titleWrap.classList.toggle('hidden', !t && !guessed);
                const guessEl = document.getElementById('modalDocTitleGuess');
                if (guessEl) guessEl.classList.toggle('hidden', !guessed);
            }
            box.classList.remove('hidden');
        }

        // === GLOBAL STATE: รองรับ 3 โหมด — GAS โดยตรง (./exec) / GitHub Pages ผ่าน REST API / Supabase อ่านตรง ===
        let GAS_MODE = (typeof google !== 'undefined' && google.script && google.script.run);
        let apiToken = '';               // session token เมื่อทำงานผ่าน REST API (GitHub Pages)
        let postLoginRetry = null;       // 🔄 งานที่ค้างอยู่ (callback) — ทำต่ออัตโนมัติหลังล็อกอินใหม่สำเร็จเมื่อ session หมดอายุ
        let supabaseClient = null;       // client อ่านบิลจาก Supabase โดยตรง (anon key + RLS)
        let supabaseReady = false;

        function getScriptApiBase() {
            const u = localStorage.getItem('btc_script_url');
            return u ? String(u).replace(/\/+$/, '') : '';
        }

        // เรียกฟังก์ชันฝั่งเซิร์ฟเวอร์แบบ unified — ทุกโหมดวิ่งเข้า handleApiRequest จุดเดียว (ตรวจสิทธิ์ที่เซิร์ฟเวอร์)
        // 🛡️ v3.13.0: โหมด GAS ก็ต้องมี session token เหมือน REST — ตัดทางลัด google.script.run[fn] ตรง ๆ
        //    (เดิม: ใครเปิดหน้าเว็บได้ก็เรียก google.script.run.deleteReceipt(...) ลบบิลได้โดยไม่ต้องล็อกอิน)
        function settleApiCall(fn, res, resolve, reject) {
            if (res && res.code === 'SESSION_EXPIRED') {
                apiToken = '';
                sessionStorage.removeItem('btc_api_token');
                reject(new Error('SESSION_EXPIRED'));
            } else if (res && res.success === false && fn !== 'getReceiptData') {
                reject(new Error(res.message || 'การทำงานไม่สำเร็จ'));
            } else {
                resolve(res);
            }
        }

        // 🔄 v3.14.2: จัดการ session หมดอายุแบบครบวงจร (เดิมโหมด GAS ไม่เปิดให้ล็อกอินใหม่ → ผู้ใช้ตันที่ข้อความ SESSION_EXPIRED)
        //    ทำงาน: แจ้งข้อความไทยชัดเจน → เปิดหน้าเข้าสู่ระบบ (ทั้ง GAS และ REST) → ล็อกอินสำเร็จแล้ว "ทำรายการที่ค้างต่อให้อัตโนมัติ"
        function handleSessionExpired(actionLabel, retryFn) {
            const label = actionLabel || 'ทำรายการ';
            showToast('⏰ เซสชันหมดอายุ (2 ชั่วโมง) — กรุณากรอกรหัสผ่านอีกครั้ง ระบบจะ' + label + 'ต่อให้อัตโนมัติ', 'error');
            postLoginRetry = (typeof retryFn === 'function') ? retryFn : null;
            try { openSettingsModal(); } catch (e) { /* ถ้าเปิดไม่ได้ (เช่นยังไม่ตั้งค่า API) ให้ผู้ใช้กดเมนูตั้งค่าเอง */ }
            setTimeout(function () {
                const el = document.getElementById('cfgPasswordInput');
                if (el && !document.getElementById('settingsModal').classList.contains('hidden')) el.focus();
            }, 80);
        }

        function scriptCall(fn, payload) {
            return new Promise(function (resolve, reject) {
                const body = { fn: fn, payload: payload === undefined ? {} : payload, token: apiToken };
                if (GAS_MODE && typeof google !== 'undefined' && google.script && google.script.run) {
                    google.script.run
                        .withSuccessHandler(function (res) { settleApiCall(fn, res, resolve, reject); })
                        .withFailureHandler(function (err) {
                            reject(new Error((err && err.message) ? err.message : String(err)));
                        })
                        .apiCall(body);
                } else {
                    const apiBase = getScriptApiBase();
                    if (!apiBase) { reject(new Error('ยังไม่ได้ตั้งค่า API URL ของระบบ (btc_script_url)')); return; }
                    fetch(apiBase + '?action=call', {
                        method: 'POST',
                        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                        body: JSON.stringify(body)
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (res) { settleApiCall(fn, res, resolve, reject); })
                        .catch(function (err) { reject(err); });
                }
            });
        }

        // โหลดคอนฟิกสาธารณะสำหรับ Supabase client (works ทั้ง GAS โฮสต์และ GitHub Pages)
        function initClientConfig() {
            return new Promise(function (resolve) {
                const finish = function (cfg) {
                    if (cfg && cfg.success && cfg.supabase_url && cfg.supabase_anon_key) {
                        try {
                            if (window.supabase) {
                                supabaseClient = window.supabase.createClient(cfg.supabase_url, cfg.supabase_anon_key);
                                supabaseReady = true;
                                console.log('[BTC] Supabase client พร้อมใช้งาน (อ่านตรงจาก Supabase)');
                            }
                        } catch (e) {
                            console.error('สร้าง Supabase client ไม่สำเร็จ', e);
                        }
                    }
                    resolve();
                };
                if (GAS_MODE) {
                    try {
                        google.script.run
                            .withSuccessHandler(finish)
                            .withFailureHandler(function () { resolve(); })
                            .getPublicClientConfig();
                    } catch (e) { resolve(); }
                } else {
                    const apiBase = getScriptApiBase();
                    if (!apiBase) { resolve(); return; }
                    fetch(apiBase + '?action=config')
                        .then(function (r) { return r.json(); })
                        .then(finish)
                        .catch(function (err) { console.warn('โหลด config ไม่สำเร็จ', err); resolve(); });
                }
            });
        }

        // ดึงข้อมูลบิล: Supabase โดยตรง > GAS (ชีต) > REST API (ชีต) > rejected (โหมดจำลอง)
        // ถ้า Supabase คืน error/ว่าง (เช่น anon ยังไม่ได้ RLS ให้อ่าน) → fallback ไป source สำรอง ไม่ให้หน้าเว็บว่างเงียบ
        function fetchReceiptsData() {
            if (supabaseClient) {
                return supabaseClient
                    .from('receipts')
                    .select('*')
                    .order('submitted_at', { ascending: false })
                    .then(function (res) {
                        if (res.error) throw new Error(res.error.message || 'Supabase query error');
                        if (!res.data || res.data.length === 0) {
                            if (supabaseHasRowsOnce) {
                                console.info('[BTC] Supabase คืน 0 แถว (เคยอ่านได้ข้อมูลมาก่อน — ถือว่าว่างจริง ไม่เด้งไป source สำรอง)');
                                return [];
                            }
                            console.warn('[BTC] Supabase คืน 0 แถวครั้งแรก — กันกรณี RLS ยังไม่ได้ตั้ง → fallback ไป source สำรอง (ถ้าฐานว่างจริง รอบถัดไปจะไม่ fallback อีก)');
                            return backupFetchReceiptsData();
                        }
                        supabaseHasRowsOnce = true;
                        return res.data.map(function (r) {
                            return Object.assign({}, r, { id: r.doc_key || r.id });
                        });
                    })
                    .catch(function (err) {
                        console.warn('[BTC] อ่าน Supabase ไม่สำเร็จ — fallback ไป source สำรอง:', err && err.message);
                        return backupFetchReceiptsData();
                    });
            }
            return backupFetchReceiptsData();
        }

        // อ่านข้อมูลสำรอง (เมื่ออ่าน Supabase ตรงไม่ได้) — วิ่งผ่าน scriptCall → handleApiRequest (ต้องมี session)
        // 🛡️ v3.13.0: เดิมโหมด GAS เรียก google.script.run.getReceiptData() ตรง ๆ และโหมด REST ยิง ?api=true
        //    โดยไม่แนบ token — ตอนนี้ backend บังคับ session ทั้งสองทาง จึงต้องพา token ไปเสมอ
        function backupFetchReceiptsData() {
            return scriptCall('getReceiptData').then(function (rows) {
                if (Array.isArray(rows)) return rows;
                if (rows && rows.code === 'SESSION_EXPIRED') throw new Error('SESSION_EXPIRED: กรุณาล็อกอินผ่านเมนู ตั้งค่าระบบ ก่อนดูข้อมูล');
                if (rows && rows.code === 'RATE_LIMITED') throw new Error(rows.message || 'เรียกถี่เกินไป กรุณารอสักครู่');
                throw new Error((rows && rows.message) || 'อ่านข้อมูลจาก backend ไม่สำเร็จ');
            });
        }

        // === SUPABASE REALTIME (hybrid): บิลใหม่/แก้ไข/ลบ โชว์ทันทีไม่ต้องรอ polling ===
        // ทำงานเฉพาะเมื่อเส้นทางหลัก Supabase-first พร้อม (supabaseClient ถูกสร้างแล้วเท่านั้น)
        // โหมด GAS/REST ยังใช้ autoRefreshLoop (ทุก 10 วิ) เดิม — ถ้า Realtime ยังไม่เปิดฝั่ง Supabase ก็ไม่พัง แค่ไม่มี event
        let realtimeChannel = null;
        // 🔄 v3.12.0 — Realtime-first: ถ้า channel ปกติ → ลด polling ทั้งตารางเหลือ fallback ทุก 5 นาที
        let realtimeConnected = false;   // channel SUBSCRIBED อยู่ไหม
        let lastRealtimeBeatAt = 0;      // สัญญาณชีวิตล่าสุดของ Realtime (subscribe สำเร็จ/มี event เข้า)
        let lastFullPollAt = 0;          // ยิง full-fetch ทั้งตารางครั้งล่าสุด (กัน polling ซ้ำถี่เกิน)
        const REALTIME_FALLBACK_POLL_MS = 5 * 60 * 1000; // Realtime ปกติ → fallback poll ทุก 5 นาที
        let supabaseHasRowsOnce = false; // เคยอ่านบิลจาก Supabase ได้ ≥1 แถว (ใช้แยก "ว่างจริง" ออกจาก "RLS ยังไม่ตั้ง")

        function setupReceiptsRealtime() {
            if (!supabaseClient || realtimeChannel) return;
            try {
                realtimeChannel = supabaseClient
                    .channel('btc-receipts-live')
                    .on('postgres_changes', { event: '*', schema: 'public', table: 'receipts' }, handleRealtimeChange)
                    .subscribe(function (status) {
                        if (status === 'SUBSCRIBED') {
                            realtimeConnected = true;
                            lastRealtimeBeatAt = Date.now();
                            console.log('[BTC] Realtime เชื่อมต่อสำเร็จ — บิลใหม่/แก้ไข/ลบอัปเดตทันที + polling ลดเหลือ fallback ทุก 5 นาที');
                        } else if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT' || status === 'CLOSED') {
                            realtimeConnected = false;
                            console.warn('[BTC] Realtime หลุด (' + status + ') — กลับไป polling ทุก 10 วิ อัตโนมัติ');
                        }
                    });
            } catch (e) {
                console.warn('[BTC] เปิด Realtime ไม่สำเร็จ (ยังใช้ auto-refresh ทุก 10 วิ ตามเดิม):', e);
            }
        }

        function handleRealtimeChange() {
            lastRealtimeBeatAt = Date.now(); // มี event เข้า = channel มีชีวิต (ใช้คำนวณ fallback polling)
            if (isAutoRefreshing) return; // กันชนกับ autoRefreshLoop ที่กำลังทำงาน
            fetchReceiptsData().then(function (data) {
                const normalized = normalizeData(data);
                const newSig = computeDataSignature(normalized);
                if (newSig === lastDataSignature) return; // ไม่เปลี่ยนจริง (echo จากการแก้ไขของเราเอง) — ไม่ต้องวาดใหม่
                lastDataSignature = newSig;
                bumpImageEpoch('realtime'); // v3.15.8: DB เปลี่ยน (บิลใหม่/แก้ไข/ลบ จากเครื่องอื่น) → รูปทุกรูปโหลดใหม่รอบหน้า
                allData = normalized;
                applyFilters();
                showToast('มีบิลเปลี่ยนแปลงแบบ Realtime — อัปเดตหน้าเว็บแล้ว');
            }).catch(function () { /* เงียบ ๆ — autoRefreshLoop รอบถัดไปจะจัดการ */ });
        }

        window.onload = function () {
            console.log('[BTC Dashboard] v3.14.0 — GAS Web App only: ตัดเส้นทาง GitHub Pages/REST ภายนอก + ทุกคำขอวิ่งผ่าน handleApiRequest พร้อม session token + ปุ่มแบนเนอร์พาไปล็อกอิน');
            GAS_MODE = (typeof google !== 'undefined' && google.script && google.script.run);
            apiToken = sessionStorage.getItem('btc_api_token') || '';
            switchPage('overview'); // ตั้งสถานะ sidebar/menu ให้ชี้ที่หน้าแรกตอนโหลด
            loadSavedApiUrl();
            renderAccountingDocTypeSelects();
            renderAccountingDocTypeFilter();
            // โจทย์มาตรฐานบัญชี: หน้าอัปโหลดภาพบิล (Upload Modal) ใช้ชุดมาตรฐานบัญชีเป็นตัวเลือกจำแนกเบื้องต้น (custom เติมทีหลังตอนเปิด modal)
            initClientConfig().then(function () {
                refreshData();
                loadCustomDocTypes(); // เติมประเภทเอกสารขององค์กร (doc_types) เข้า dropdown หน้าแก้ไข
                setupReceiptsRealtime(); // เปิด Realtime (ทำงานเฉพาะเมื่อ Supabase-first พร้อม — ถ้าไม่พร้อมข้ามอัตโนมัติ)
            }); // รอ config เสร็จก่อนโหลดข้อมูล (Supabase พร้อมจะอ่านตรง)
            setInterval(autoRefreshLoop, 10000); // ตรวจข้อมูลใหม่อัตโนมัติทุก 10 วินาที
        };

        // === AUTO REFRESH: ตรวจข้อมูลใหม่อัตโนมัติ — อัปเดตหน้าเว็บทันทีเมื่อข้อมูลในฐานเปลี่ยน ===
        let lastDataSignature = '';
        let isAutoRefreshing = false;

        function computeDataSignature(data) {
            return data.map(x => [x.id, x.timestamp, x.po_number, x.store_name, x.total_amount, x.items.length, x.sender_name].join('|')).join('||');
        }

        function autoRefreshLoop() {
            if (isAutoRefreshing) return; // กันเรียกซ้อนกันขณะรอผลลัพธ์
            const nowTick = Date.now();
            const rtHealthy = realtimeConnected && (nowTick - lastRealtimeBeatAt) < REALTIME_FALLBACK_POLL_MS;
            const fullDue = (nowTick - lastFullPollAt) >= (rtHealthy ? REALTIME_FALLBACK_POLL_MS : 10000);
            const linksDue = (nowTick - lastLinksAutoAt) > 30000;
            if (rtHealthy && !fullDue) {
                // 🔄 v3.12.0 Realtime-first: channel ปกติ → ข้าม full-fetch ทั้งตาราง (เหลือ fallback ทุก 5 นาที)
                //    แต่ยังรีเฟรช receipt_links ทุก ~30 วิ ต่อ (auto-matcher ทำงานหลังบ้าน เปลี่ยนลิงก์โดยไม่มี event บน channel receipts)
                if (linksDue) {
                    lastLinksAutoAt = nowTick;
                    loadReceiptLinks(true).then(function () { applyFilters(); });
                }
                return;
            }
            isAutoRefreshing = true;
            lastFullPollAt = Date.now();

            const finish = function (rawData) {
                const normalized = normalizeData(rawData);
                const newSig = computeDataSignature(normalized);
                if (lastDataSignature === '') {
                    lastDataSignature = newSig; // รอบแรก: จับภาพฐานข้อมูลไว้ก่อน (ยังไม่แจ้งเตือน)
                } else if (newSig !== lastDataSignature) {
                    lastDataSignature = newSig;
                    allData = normalized;
                    applyFilters(); // ข้อมูลเปลี่ยนจริง → วาดหน้าจอใหม่ทันที (คง filter/มุมมองเดิม)
                    showToast('ข้อมูลบิลเปลี่ยนแปลง — อัปเดตหน้าเว็บแล้ว');
                }
                isAutoRefreshing = false;
                // รีเฟรช receipt_links ให้สดตลอดแบบอัตโนมัติ (ทุก ~30 วิ) — แท็บ/ตัวกรองทุกรายการพร้อมเห็นข้อมูลใหม่ทันที โดยไม่ต้องกดเข้าแท็บ
                if (Date.now() - lastLinksAutoAt > 30000) {
                    lastLinksAutoAt = Date.now();
                    loadReceiptLinks(true).then(function () { applyFilters(); });
                }
            };
            const fail = function () {
                isAutoRefreshing = false; // เงียบ ๆ รอรอบถัดไป (ไม่สแปม error ตอนเน็ตกระตุก)
            };
            fetchReceiptsData().then(finish).catch(fail);
        }

        function refreshData() {
            const syncIcon = document.getElementById('syncIcon');
            syncIcon.classList.add('fa-spin');

            const finish = function (data) {
                hideNoSourceBanner(); // โหลดข้อมูลสำเร็จ → ซ่อนแบนเนอร์แจ้งเตือนให้เชื่อมต่อฐานข้อมูล (ถ้ากำลังแสดงอยู่)
                bumpImageEpoch('refresh-data'); // v3.15.8: โหลดจาก DB ใหม่ทั้งก้อน = ฐานข้อมูลอาจเปลี่ยน → รูปทุกรูปโหลดใหม่จากเครือข่าย
                allData = normalizeData(data);
                lastDataSignature = computeDataSignature(allData); // sync ฐานเทียบกับการรีเฟรชด้วยมือ
                applyFilters();
                loadReceiptLinks(true).then(function () { lastLinksAutoAt = Date.now(); if (billTab === 'matched') applyFilters(); });
                showToast(supabaseReady ? 'อัปเดตข้อมูลจาก Supabase เรียบร้อยแล้ว' : 'อัปเดตข้อมูลเรียบร้อยแล้ว');
                syncIcon.classList.remove('fa-spin');
            };
            const fail = function (err) {
                console.error("โหลดข้อมูลล้มเหลว:", err);
                allData = [];
                filteredData = [];
                applyFilters(); // วาดตารางใหม่ = ว่างเปล่า (ไม่มีข้อมูลจำลองแล้ว)
                showNoSourceBanner(err);
                syncIcon.classList.remove('fa-spin');
            };
            lastFullPollAt = Date.now(); // รีเฟรชมือ → เลื่อนกำหนด fallback poll ถัดไป
            fetchReceiptsData().then(finish).catch(fail);
        }

        // === แบนเนอร์แจ้งเตือน: โหลดข้อมูลไม่ได้ — ให้ผู้ใช้เชื่อมต่อฐานข้อมูล (ใช้แทนข้อมูลจำลองเดิม) ===
        function showNoSourceBanner(err) {
            let banner = document.getElementById('noSourceBanner');
            if (!banner) {
                banner = document.createElement('div');
                banner.id = 'noSourceBanner';
                banner.className = 'hidden mb-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-xs text-amber-800 shadow-sm';
                const msg = document.createElement('div');
                msg.className = 'flex items-start space-x-2';
                msg.innerHTML = '<i class="fa-solid fa-triangle-exclamation mt-0.5"></i>' +
                    '<span><b>ยังไม่ได้รับข้อมูลบิล</b> — โหลดข้อมูลไม่สำเร็จ หรือยังไม่ได้เข้าสู่ระบบ ' +
                    'กรุณาเข้าสู่ระบบผ่านเมนู "ตั้งค่าระบบ" แล้วลองใหม่' +
                    '<span id="noSourceDetail" class="block text-[11px] text-amber-600"></span></span>';
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'shrink-0 rounded-lg bg-amber-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-amber-700';
                btn.innerHTML = '<i class="fa-solid fa-right-to-bracket mr-1"></i> เข้าสู่ระบบ (ตั้งค่าระบบ)';
                // 🗑️ v3.14.0: ระบบใช้ GAS Web App เท่านั้น — ไม่มีช่องตั้ง API URL ภายนอกแล้ว ปุ่มนี้จึงพาไปล็อกอิน
                btn.onclick = openSettingsModal;
                banner.appendChild(msg);
                banner.appendChild(btn);
                // แทรกไว้บนสุดของ <main> (นอกหน้าทั้ง 4 — เห็นชัดทุกหน้าโดยไม่ต้อง scroll)
                const anchor = document.querySelector('main');
                if (anchor) {
                    anchor.insertBefore(banner, anchor.firstChild);
                } else {
                    document.body.appendChild(banner);
                }
            }
            const detail = document.getElementById('noSourceDetail');
            if (detail) {
                detail.textContent = (err && err.message) ? ('สาเหตุ: ' + err.message) : '';
            }
            banner.classList.remove('hidden');
        }

        function hideNoSourceBanner() {
            const banner = document.getElementById('noSourceBanner');
            if (banner) banner.classList.add('hidden');
        }

        // === DELETE RECEIPT: ลบบิล (แถวชีต + Supabase + ย้ายไฟล์รูปใน Drive ไปถังขยะ — ผ่าน backend) ===
        function deleteReceiptConfirm(index) {
            const item = filteredData[index];
            if (!item) return;

            if (!GAS_MODE && !getScriptApiBase()) {
                showToast('การลบต้องเปิดผ่าน Web App หรือตั้งค่า API URL ของระบบก่อน', 'error');
                return;
            }

            const ok = confirm('ยืนยันการลบบิล?\n\n' +
                'เลขที่ PO: ' + item.po_number + '\n' +
                'ร้าน: ' + item.store_name + '\n' +
                'ยอดรวม: ฿' + item.total_amount.toLocaleString('th-TH', { minimumFractionDigits: 2 }) + '\n\n' +
                '• ลบออกจากฐานข้อมูลบิล (Supabase) และ Google Sheets\n' +
                '• ไฟล์รูปบิลใน Drive จะถูกย้ายไปถังขยะ (กู้คืนได้ใน 30 วัน)\n' +
                '• กรุณาตรวจสอบข้อมูลให้ถูกต้องก่อนยืนยัน');
            if (!ok) return;

            scriptCall('deleteReceipt', { id: item.id, doc_key: item.doc_key, system_record_no: item.system_record_no, image_url: item.image_url || item.image_original_url || '', timestamp: item.timestamp, po_number: item.po_number })
                .then(function (res) {
                    if (res && res.success) {
                        showToast(res.message);
                        bumpImageEpoch('delete'); // v3.15.8: DB เปลี่ยน → รูปทุกรูปโหลดใหม่รอบหน้า
                        refreshData(); // โหลดข้อมูลใหม่ทันที (auto refresh จะ sync ฐานเทียบให้เอง)
                    } else {
                        showToast((res && res.message) ? res.message : 'ลบไม่สำเร็จ', 'error');
                    }
                })
                .catch(function (err) {
                    if (err && err.message === 'SESSION_EXPIRED') {
                        handleSessionExpired('ลบบิล', function () { deleteReceiptConfirm(index); });
                    } else {
                        showToast('ลบไม่สำเร็จ: ' + ((err && err.message) || err), 'error');
                    }
                });
        }

        // แปลง Timestamp จากชีต (yyyy-MM-dd HH:mm:ss) ให้เป็นรูปแบบไทยอ่านง่ายสำหรับแสดง "วันที่บันทึกข้อมูล"
        function formatRecordDateTime(timestamp) {
            if (!timestamp || timestamp === '-') return '-';
            const parts = String(timestamp).trim().split(' ');
            const datePart = parts[0] || '';
            const timePart = parts[1] || '';
            const dmy = datePart.split('-');
            const thaiDate = (dmy.length === 3) ? `${dmy[2]}/${dmy[1]}/${dmy[0]}` : datePart;
            const hm = timePart ? timePart.substring(0, 5) : '';
            return hm ? `${thaiDate} ${hm} น.` : thaiDate;
        }

        // แปลงลิงก์ Google Drive (หน้า view / HYPERLINK) → ลิงก์รูปที่เบราว์เซอร์โหลดใน <img> ได้โดยตรง
        function toDirectImageUrl(url) {
            if (!url) return '';
            let u = String(url).trim();
            const mHyper = u.match(/HYPERLINK\("([^"]+)/i);
            if (mHyper) u = mHyper[1];
            if (u.indexOf('http') !== 0) return '';
            // คงพารามิเตอร์ v= (cache-bust หลังแก้ไขรูป) ไว้ด้วย เพื่อไม่ให้เบราว์เซอร์ใช้รูปเก่าในแคช
            const mv = u.match(/[?&]v=([\w.]+)/);
            const vParam = mv ? '&v=' + mv[1] : '';
            // drive.google.com/file/d/{id}/... → thumbnail endpoint (โหลดเป็นรูปได้ ไม่ต้องเปิดหน้า Drive)
            let m = u.match(/drive\.google\.com\/file\/d\/([\w-]+)/);
            if (m) return 'https://drive.google.com/thumbnail?id=' + m[1] + '&sz=w1200' + vParam;
            // drive.google.com/uc?export=view&id={id} / open?id={id} / thumbnail?id={id}... → ใช้ id เดียวกัน
            // (รูปที่แก้แล้วถูกบันทึกเป็น "ไฟล์ใหม่" แล้ว → thumbnail ของไฟล์ใหม่คือภาพปัจจุบันเสมอ)
            m = u.match(/drive\.google\.com\/[^"']*[?&]id=([\w-]+)/);
            if (m) return 'https://drive.google.com/thumbnail?id=' + m[1] + '&sz=w1200' + vParam;
            return u; // ลิงก์อื่น (lh3 / ภายนอก) ใช้ได้ตามเดิม
        }

        // v3.15.8: รอบแคชรูปรวมของทั้งหน้า (global image epoch) — เพิ่มค่าทุกครั้งที่ฐานข้อมูลมีการเปลี่ยนแปลงสำเร็จ
        //     (บันทึกแก้ไข/ลบ/อ่านใหม่/จับคู่) → รูปทุกใบในตาราง/ดูบิลเต็ม จะต่อ v= รอบใหม่ = บังคับโหลดจาก Drive/เครือข่ายใหม่เสมอ ไม่ใช้แคชของรอบเก่า
        let imageEpoch = Date.now();
        function bumpImageEpoch(reason) {
            imageEpoch = Date.now();
            try { console.info('[BTC] 🖼️ image epoch bumped (' + (reason || 'db change') + ') → รูปทุกรูปจะโหลดใหม่จากเครือข่ายรอบหน้า'); } catch (e) { /* ไม่บล็อก */ }
        }

        // v3.15.7: ต่อ/ทำพารามิเตอร์ v= (cache-bust) ให้ URL รูป "ตัวเดียว" เสมอ — ห้าม v= ซ้อน 2 ตัว (เดิม emApplySavedImage ต่อทับ
        //     ทำให้ URL มี v=...&v=... เบราว์เซอร์/Drive แคชสับสน ภาพทั้ง 3 จุด (ตาราง/ดูบิลเต็ม/แผงแก้ไข) โชว์ไม่ตรงกัน)
        function withCacheBust(url, epoch) {
            const u = String(url || '').trim();
            if (!u || u.indexOf('http') !== 0) return u;
            // v3.15.8: ถ้าไม่ระบุ epoch มาเอง → ใช้รอบแคชรวมล่าสุด (bumpImageEpoch แล้วรูปทุกรูปเปลี่ยน v= พร้อมกัน)
            const v = 'v=' + (epoch !== undefined ? epoch : imageEpoch);
            if (/[?&]v=[\w.]+/.test(u)) return u.replace(/([?&])v=[\w.]+/, '$1' + v); // แทนตัวเดิม
            return u + (u.indexOf('?') !== -1 ? '&' : '?') + v; // ไม่มี → ต่อใหม่
        }

        // v3.15.7: เลือก "URL สดที่สุด" ของรูปบิลเดียวกัน — เทียบ file ID ก่อน ถ้าไฟล์เดียวกัน ให้ตัวที่มี v= ใหม่กว่าชนะเสมอ
        //     (ตาราง/ดูบิลเต็ม/แผงแก้ไข ต้องเห็นภาพเดียวกัน — จุดไหน URL เก่ากว่าจะถูกยกเป็นอันใหม่สุด)
        function freshestImageUrl(a, b) {
            const ua = String(a || ''); const ub = String(b || '');
            if (!ua) return ub; if (!ub) return ua;
            const idA = (ua.match(/[?&]id=([\w-]+)/) || [])[1] || '';
            const idB = (ub.match(/[?&]id=([\w-]+)/) || [])[1] || '';
            if (idA && idB && idA !== idB) return ua; // ไฟล์คนละไฟล์ = ใช้ตัวแรก (ตัวตนของแถวนั้น)
            const vA = Number((ua.match(/[?&]v=([\w.]+)/) || [])[1] || 0);
            const vB = Number((ub.match(/[?&]v=([\w.]+)/) || [])[1] || 0);
            return vB > vA ? ub : ua;
        }

        // ภาพลวงใช้เมื่อโหลดรูปไม่ได้ (รูปหาย / ไม่มีสิทธิ์ / เน็ตลิงก์นอกถูกบล็อก) — แสดงเป็น SVG ในตัว
        function imgPlaceholderSmall() {
            return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(
                '<svg xmlns="http://www.w3.org/2000/svg" width="56" height="68">' +
                '<rect fill="#e2e8f0" width="56" height="68"/>' +
                '<rect x="14" y="22" width="30" height="30" rx="6" fill="#cbd5e1"/>' +
                '<rect x="14" y="40" width="22" height="4" rx="2" fill="#94a3b8"/>' +
                '<rect x="14" y="48" width="28" height="4" rx="2" fill="#94a3b8"/>' +
                '</svg>');
        }

        function fallbackImg(el) {
            if (!el) return;
            el.onerror = null;
            el.src = 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(
                '<svg xmlns="http://www.w3.org/2000/svg" width="600" height="800">' +
                '<rect fill="#e2e8f0" width="600" height="800"/>' +
                '<g fill="#94a3b8" font-family="Kanit,Arial,sans-serif" text-anchor="middle">' +
                '<circle cx="300" cy="330" r="54" fill="#cbd5e1"/>' +
                '<rect x="230" y="210" width="140" height="140" rx="18" fill="#fee2e2"/>' +
                '<rect x="280" y="225" width="140" height="12" rx="6" fill="#fca5a5"/>' +
                '<rect x="280" y="245" width="100" height="12" rx="6" fill="#fca5a5"/>' +
                '<rect x="280" y="265" width="120" height="12" rx="6" fill="#fca5a5"/>' +
                '<text x="300" y="470" font-size="26" font-weight="600">รูปบิลไม่แสดง</text>' +
                '<text x="300" y="500" font-size="14">คลิกปุ่มเพื่อเปิดลิงก์ต้นฉบับ</text>' +
                '</g></svg>');
        }

        function normalizeData(rawData) {
            if (!Array.isArray(rawData)) return [];
            const asText = v => (v === null || v === undefined) ? '' : String(v);
            const isTrue = v => v === true || String(v).trim().toUpperCase() === 'TRUE' || String(v).trim() === '1';
            return rawData.map((item, index) => {
                const id = item.id || `item_${index}`;
                let itemsList = [];

                if (Array.isArray(item.items) && item.items.length > 0) {
                    itemsList = item.items;
                } else if (typeof item.items_json === 'string' && item.items_json.trim() !== '') {
                    try { itemsList = JSON.parse(item.items_json); } catch (e) { }
                }

                if (itemsList.length === 0 && typeof item.items_summary === 'string' && item.items_summary.trim() !== '') {
                    const lines = item.items_summary.split(/,|\n/);
                    itemsList = lines.map(line => {
                        return {
                            name: line.trim(),
                            quantity: 1,
                            unit: "รายการ",
                            price_per_unit: 0,
                            total: 0
                        };
                    });
                }

                itemsList = itemsList.map(sub => Object.assign({}, sub, {
                    name: asText(sub && sub.name),
                    unit: asText(sub && sub.unit)
                }));

                let rawImg = (typeof (item.image_url || item['Image URL']) === 'string')
                    ? (item.image_url || item['Image URL']) : '';
                // v3.15.7: image_url กับ Image URL ใน DB อาจคนละ v= (แก้รูปแล้ว DB เขียนช้า/โดน 0 แถว) — เลือก v= ใหม่สุดของไฟล์เดียวกัน
                //     เพื่อให้ตาราง/ดูบิลเต็ม/แผงแก้ไข โหลดภาพเดียวกันเสมอ (ป้องกันภาพเก่ากลับมาหลัง refreshData)
                // v3.15.8: ประทับ v= จาก imageEpoch ปัจจุบันทุกครั้งที่ normalize → หลัง DB เปลี่ยน (bumpImageEpoch แล้ว refresh) รูปทุกรูปโหลดใหม่จากเครือข่าย
                const rawImgB = (typeof item.image_original_url === 'string') ? item.image_original_url : '';
                if (rawImgB) rawImg = freshestImageUrl(rawImg, rawImgB);
                const imageOriginalUrl = withCacheBust(toDirectImageUrl(rawImg));
                const imagePreviewUrl = imageOriginalUrl || '';

                return {
                    id: id,
                    timestamp: item.timestamp || item.submitted_at || '-',
                    source: item.source || 'user',
                    sender_name: asText(item.sender_name || item['Sender Name'] || (item.sender_id ? 'ไม่ทราบชื่อ' : '-')),
                    sender_id: asText(item.sender_id || item['Sender ID'] || ''),
                    po_number: asText(item.po_number || item['po_no'] || item['PO No.'] || '-'),
                    date: item.date || item['Date'] || '-',
                    store_name: asText(item.store_name || item['supplier_name'] || item['Supplier Name'] || 'ไม่ระบุร้านค้า'),
                    category: asText(item.category || item['Category'] || 'ทั่วไป'),
                    items: itemsList,
                    total_amount: parseFloat(item.total_amount || item['Total Amount']) || 0,
                    doc_type: asText(item.doc_type || item['Doc Type'] || ''),
                    // 🎯 v3.17.0: ชื่อเอกสารบนใบ + ธง AI เดา + สิทธิ์ VAT (มาจาก AI อ่าน/คำนวณ backend)
                    doc_title_text: asText(item.doc_title_text || item['Doc Title Text'] || ''),
                    is_title_explicit: !(item.is_title_explicit === false || String(item.is_title_explicit).trim().toUpperCase() === 'FALSE'),
                    is_vat_eligible: (item.is_vat_eligible === true || String(item.is_vat_eligible).trim().toUpperCase() === 'TRUE') ? true : ((item.is_vat_eligible === false || String(item.is_vat_eligible).trim().toUpperCase() === 'FALSE') ? false : null),
                    ai_notes: asText(item.ai_notes || item['AI Notes'] || ''),
                    book_no: asText(item.book_no || item['Book No.'] || ''),
                    doc_no: asText(item.doc_no || item['Doc No.'] || ''),
                    tax_invoice_no: asText(item.tax_invoice_no || item['Tax Invoice No.'] || ''),
                    ref_no: asText(item.ref_no || item['Ref No.'] || ''),
                    ref_label: asText(item.ref_label || item['Ref Label'] || ''),
                    doc_key: asText(item.doc_key || item['Doc Key'] || ''),
                    system_record_no: (item.system_record_no === undefined || item.system_record_no === null || item.system_record_no === '') ? '' : Number(item.system_record_no),
                    running_number: asText(item.running_number || item['Running No.'] || ''),
                    image_md5: asText(item.image_md5 || item['Image MD5'] || ''),
                    scale_weight_in: (item.scale_weight_in === undefined || item.scale_weight_in === null || item.scale_weight_in === '' || item.scale_weight_in === '-') ? null : (Number(item.scale_weight_in) || null),
                    scale_weight_out: (item.scale_weight_out === undefined || item.scale_weight_out === null || item.scale_weight_out === '' || item.scale_weight_out === '-') ? null : (Number(item.scale_weight_out) || null),
                    scale_weight_net: (item.scale_weight_net === undefined || item.scale_weight_net === null || item.scale_weight_net === '' || item.scale_weight_net === '-') ? null : (Number(item.scale_weight_net) || null),
                    vehicle_registration: asText(item.vehicle_registration || item['Vehicle Registration'] || ''),
                    company_name: asText(item.company_name || item['Company Name'] || ''),
                    job_name: asText(item.job_name || item['Job/Work'] || item['Job Work'] || ''),
                    requester: asText(item.requester || item['Requester'] || ''),
                    pay_approver: asText(item.pay_approver || item['Pay Approver'] || ''),
                    needs_review: isTrue(item.needs_review !== undefined ? item.needs_review : item['Needs Review']),
                    review_reason: asText(item.review_reason || item['Review Reason'] || ''),
                    image_url: imagePreviewUrl,
                    image_original_url: rawImg ? toDirectImageUrl(rawImg) || rawImg : ''
                };
            });
        }

        // สร้างข้อความแสดง "ตัวตนบิล" จากฟิลด์เอกสาร (mirror ฝั่ง Code.gs buildDocLabel)
        function docLabel(item) {
            if (!item) return '-';
            const type = item.doc_type || '';
            const book = item.book_no || '';
            const no = item.doc_no || '';
            const tax = item.tax_invoice_no || '';
            const ref = item.ref_no || '';
            const refLabel = item.ref_label || 'เลขอ้างอิง';
            // v3.15.2: doc_no แบบรวม "เล่มที่/เลขที่" (เช่น 5/2680) → ไม่โชว์ เล่มที่ ซ้ำอีกช่อง (mirror ฝั่ง Code.gs buildDocLabel)
            const bookInNo = !!(book && no && String(no).indexOf(String(book) + '/') === 0);
            let label = '';
            if (tax) {
                label = type ? type + ' ' + tax : 'เลขใบกำกับภาษี ' + tax;
            } else if (no) {
                label = (type ? type + ' ' : '') + (book && !bookInNo ? book + '/' : '') + no;
            } else if (ref) {
                label = refLabel + ' ' + ref;
            }
            if (!label) return '-';
            if (tax && no) label += ' (เลขที่ ' + (book && !bookInNo ? book + '/' : '') + no + ')';
            return label;
        }

        function fmtDate(d) {
            const s = String(d || '').trim();
            const iso = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
            if (iso) return iso[3] + '/' + iso[2] + '/' + iso[1];
            const dmy = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})$/);
            if (dmy) {
                let y = +dmy[3];
                if (y < 100) y += 2000;
                return dmy[1].padStart(2, '0') + '/' + dmy[2].padStart(2, '0') + '/' + y;
            }
            return '-';
        }

        function formatMoney(v) {
            const n = Number(v) || 0;
            return '฿' + n.toLocaleString('th-TH', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function parseDateKey(dateStr, tsStr) {
            if (dateStr && dateStr !== '-') {
                const s = String(dateStr).trim();
                const iso = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
                if (iso) return Date.UTC(+iso[1], +iso[2] - 1, +iso[3]);
                const dmy = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})$/);
                if (dmy) {
                    let y = +dmy[3];
                    if (y < 100) y += 2000;
                    if (y > 2500) y -= 543;
                    return Date.UTC(y, +dmy[2] - 1, +dmy[1]);
                }
            }
            const t = Date.parse(tsStr || '');
            return isNaN(t) ? 0 : t;
        }

        // === บิลแนบ: ใบรับของ/ใบชั่งตอนรับของ ที่หมายเหตุ (ref_no) ชี้ไปที่เลขที่บิลส่งของ (doc_no) ===
        // จับคู่อัตโนมัติจากข้อมูลที่มีอยู่ — ทะเบียนรถตรงกันด้วย = คู่แน่นอน (ถ้ามี) — จับคู่ไม่ได้ = ไม่ถือเป็นบิลแนบ
        function buildAttachmentMap() {
            const map = {}; // docKey บิลส่งของ (doc_no) -> [ใบแนบ...]
            allData.forEach(item => {
                if (!item || !item.ref_no) return;
                const refNo = String(item.ref_no).trim();
                if (!refNo || refNo === '-') return;
                // ใบแนบต้องเป็นเอกสารไม่มียอดเงินเป็นตัวตนของตัวเอง (ใบรับของ/ใบชั่ง) และหมายเหตุชี้เลขเอกสารอื่น
                const isScaleLike = item.doc_type === 'ใบชั่ง' || /รับของ|รับสินค้า/.test(item.doc_type || '');
                if (!isScaleLike) return;
                const partner = allData.find(p => p && String(p.doc_no || '').trim() === refNo && p !== item);
                if (!partner) return; // ยังไม่มีบิลส่งของที่เลขตรง → ไม่จับคู่ (แสดงปกติ)
                // ถ้าทั้งคู่มีทะเบียนรถ ต้องตรงกัน (กันจับผิดเมื่อเลขเอกสารซ้ำข้ามร้าน)
                const vA = String(item.vehicle_registration || '').trim();
                const vB = String(partner.vehicle_registration || '').trim();
                if (vA && vB && vA !== vB) return;
                const key = String(partner.id) + '|' + String(partner.timestamp || '');
                if (!map[key]) map[key] = [];
                map[key].push(item);
            });
            return map;
        }

        function isAttachmentItem(item, attachMap) {
            if (!attachMap) attachMap = buildAttachmentMap();
            return Object.values(attachMap).some(list => list.some(a => a === item || (a.id !== undefined && a.id === item.id && a.timestamp === item.timestamp)));
        }

        // === จับคู่บิลรับของ/บิลส่งของ กับใบสั่งซื้อ (PO) — ระบบรับของตามสั่งซื้อ (receipt_links) ===
        function matchingKey(item) {
            if (!item) return '';
            return String(item.doc_key || item.id || '');
        }

        function isPOItem(item) {
            return !!(item && String(item.doc_type || '').trim() === 'ใบสั่งซื้อ');
        }

        // === พิมพ์เขียวโซ่จับคู่เอกสาร 3 ขั้น: ใบสั่งซื้อ (PO) → ใบส่งของ/ใบรับของ → ใบชั่ง (ใบชั่งห้ามติด PO ตรง) ===
        // เอกสาร "ใบชั่ง" (scale-like): ใบชั่ง + ประเภทที่องค์กรติ๊ก "ใช้ช่องใบชั่ง" (shared กับฝั่ง renderMatchPanel/
        // buildAttachmentMap เพื่อไม่ให้มี isScaleLike คนละนิยามวิ่งกันไปมา — เดิมมีแค่ const ภายใน function ทำให้ ReferenceError)
        function isScaleLike(item) {
            if (!item) return false;
            const t = String(item.doc_type || '').trim();
            if (!t) return false;
            if (t === 'ใบชั่ง' || t === 'ใบชั่งน้ำหนัก' || t === 'ใบชั่งสินค้า') return true;
            const customs = (typeof customScaleDocTypes !== 'undefined') ? customScaleDocTypes : [];
            return customs.indexOf(t) !== -1;
        }

        // ใบส่งของ/ใบรับของ (มีน้ำหนักชั่ง หรือหัวเอกสารบ่งบอกการส่ง/รับสินค้า) = ตัวเชื่อมโซ่ขั้น 2 ระหว่าง PO กับใบชั่ง
        // (ไม่นับ PO และใบชั่งซ้ำกันเอง — แต่ละบทบาทในโซ่ต้องชัดเจน)
        function isDeliveryLike(item) {
            if (!item || isPOItem(item) || isScaleLike(item)) return false;
            const hasWeight =
                (item.scale_weight_net !== null && item.scale_weight_net !== undefined && item.scale_weight_net !== '' && item.scale_weight_net !== '-') ||
                (item.scale_weight_in !== null && item.scale_weight_in !== undefined && item.scale_weight_in !== '' && item.scale_weight_in !== '-') ||
                (item.scale_weight_out !== null && item.scale_weight_out !== undefined && item.scale_weight_out !== '' && item.scale_weight_out !== '-');
            if (hasWeight) return true;
            return /ส่งของ|ส่งสินค้า|Delivery|นำส่ง|ส่งมอบ|รับของ|รับสินค้า|ใบขน/i.test(String(item.doc_type || '').trim());
        }

        // ทำเลขเอกสารให้เป็นรูปแบบเดียวกันก่อนเทียบ (ตัดช่องว่าง/ขีด/สแลช/เลข 0 นำหน้า แล้วใช้ตัวพิมพ์ใหญ่)
        function normDocNum(v) {
            return String(v === null || v === undefined ? '' : v)
                .replace(/[\s\-/\\.,():'"#]+/g, '')
                .replace(/^0+/, '')
                .toUpperCase();
        }

        // กัน string ที่จะไปฝังใน JS string แบบ '...' ภายใน onclick
        function jsStr(v) {
            return String(v === null || v === undefined ? '' : v).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
        }

        function buildLinkIndex() {
            const byPo = new Map();   // po_doc_key -> [linkDic...]
            const byLink = new Map(); // link_doc_key -> [link...]
            (Array.isArray(receiptLinks) ? receiptLinks : []).forEach(function (lk) {
                if (!lk || !lk.po_doc_key || !lk.link_doc_key) return;
                if (!byPo.has(lk.po_doc_key)) byPo.set(lk.po_doc_key, []);
                byPo.get(lk.po_doc_key).push(lk);
                if (!byLink.has(lk.link_doc_key)) byLink.set(lk.link_doc_key, []);
                byLink.get(lk.link_doc_key).push(lk);
            });
            return { byPo: byPo, byLink: byLink };
        }

        function canUpsertLinks() {
            return GAS_MODE || !!getScriptApiBase();
        }

        // โหลด receipt_links (อ่านจาก Supabase ตรงก่อน — ลอง GAS/REST ต่อถ้า RLS ยังไม่อนุญาต) + throttle 60 วิ
        // ถ้าเส้นทางตรงพลาด (เช่น ยังไม่รัน SQL/RLS) → จำ state ไว้ ใช้ scriptCall ต่อ ๆ ไป ไม่พยายามซ้ำ (กันสแปม 401)
        let supabaseLinksDirectBroken = false;
        function loadReceiptLinks(force) {
            if (!force && Date.now() - lastLinksFetchAt < 60000) return Promise.resolve(receiptLinks);
            lastLinksFetchAt = Date.now();
            const apply = function (rows) {
                let arr = [];
                try { arr = Array.isArray(rows) ? rows : []; } catch (e) { arr = []; }
                receiptLinks = arr.map(function (r) {
                    return {
                        po_doc_key: String(r.po_doc_key || ''),
                        po_label: r.po_label || '',
                        po_store_name: r.po_store_name || '',
                        link_doc_key: String(r.link_doc_key || ''),
                        link_label: r.link_label || '',
                        link_store_name: r.link_store_name || '',
                        link_type: r.link_type || '',
                        google_drive_file_id: r.google_drive_file_id || '',
                        link_scale_net: (r.link_scale_net === null || r.link_scale_net === undefined) ? '' : r.link_scale_net,
                        link_vehicle: r.link_vehicle || '',
                        match_type: r.match_type || '',
                        confidence_score: r.confidence_score || 0,
                        confirmed_at: r.confirmed_at || '',
                        status: String(r.status || 'pending').toLowerCase() === 'confirmed' ? 'confirmed' : 'pending'
                    };
                });
                updateTabBadges();
                return receiptLinks;
            };
            if (supabaseClient && supabaseReady && !supabaseLinksDirectBroken) {
                return supabaseClient.from('receipt_links').select('*')
                    .then(function (res) {
                        if (res && Array.isArray(res.data)) {
                            supabaseLinksDirectBroken = false; // สำเร็จ — ใช้เส้นทางตรงได้ต่อไป
                            return apply(res.data);
                        }
                        // RLS ยังไม่อนุญาตให้ anon อ่าน → เลี่ยงเส้นทางตรง ถอยไป GAS/REST (จำ state กันสแปม 401)
                        supabaseLinksDirectBroken = true;
                        return scriptCall('getReceiptLinks', {}).then(apply).catch(function () { return apply([]); });
                    })
                    .catch(function () {
                        supabaseLinksDirectBroken = true; // อ่านตรงไม่ได้ (เช่นยังไม่รัน SQL/RLS) — ใช้ GAS/REST ต่อไป
                        return scriptCall('getReceiptLinks', {}).then(apply).catch(function () { return apply([]); });
                    });
            }
            return scriptCall('getReceiptLinks', {}).then(apply).catch(function () { return apply([]); });
        }

        // อัปเดตจำนวนบนแถบทั้ง 3 ตัว: จำนวนรายการ + งานค้าง (รอตรวจ needs_review / รอตรวจสอบ pending link)
        function updateTabBadges() {
            const links = Array.isArray(receiptLinks) ? receiptLinks : [];
            const linkIdx = buildLinkIndex();
            const data = Array.isArray(allData) ? allData : [];
            const otherList = data.filter(function (it) { return !isPOItem(it) && !linkIdx.byLink.has(matchingKey(it)); });
            const poList = data.filter(isPOItem);
            const pendingLinks = links.filter(function (l) { return l.status === 'pending'; }).length;
            const confirmedLinks = links.length - pendingLinks;
            const setChip = function (countId, reviewId, countLabel, reviewLabel, reviewCount) {
                const c = document.getElementById(countId);
                const r = document.getElementById(reviewId);
                if (c) c.textContent = countLabel;
                if (r) {
                    r.textContent = reviewCount > 0 ? (reviewLabel + ' ' + reviewCount) : '';
                    r.classList.toggle('hidden', !(reviewLabel && reviewCount > 0));
                }
            };
            setChip('tabBadgeOtherCount', 'tabBadgeOtherReview',
                otherList.length + ' รายการ', 'รอตรวจ', otherList.filter(function (it) { return it.needs_review === true; }).length);
            setChip('tabBadgePoCount', 'tabBadgePoPending',
                poList.length + ' รายการ', 'รอตรวจสอบ', pendingLinks);
            setChip('tabBadgeMatchedCount', 'tabBadgeMatchedPending',
                confirmedLinks + ' คู่', 'รอตรวจสอบ', pendingLinks);
        }

        function setBillTab(tab) {
            billTab = tab;
            // v3.15.6: ย้ายไปใช้แท็บมาตรฐานกลาง .ui-tab (เดิมเป็น activeCls/idleCls แยกต่างหาก)
            const activeCls = 'ui-tab is-active';
            const idleCls = 'ui-tab';
            const btnOther = document.getElementById('billTabBtnOther');
            const btnPo = document.getElementById('billTabBtnPo');
            const btnMatched = document.getElementById('billTabBtnMatched');
            if (btnOther) btnOther.className = idleCls;
            if (btnPo) btnPo.className = idleCls;
            if (btnMatched) btnMatched.className = idleCls;
            const hint = document.getElementById('billTabHint');
            if (tab === 'po') {
                if (btnPo) btnPo.className = activeCls;
                if (hint) hint.textContent = 'ใบสั่งซื้อ (PO) — กด "ดูบิลเต็ม" แล้วเข้าแท็บ "จับคู่" เพื่อเลือกบิลรับของมารับของตามสั่งซื้อ';
            } else if (tab === 'matched') {
                if (btnMatched) btnMatched.className = activeCls;
                const mBtn = document.getElementById('btnAutoMatch');
                if (mBtn) mBtn.classList.remove('hidden');
                if (hint) hint.textContent = 'คู่ใบสั่งซื้อ + บิลที่จับคู่แล้ว — ระบบจับให้อัตโนมัติแต่ต้องรอตรวจสอบก่อนยืนยัน';
                applyFilters();                                    // วาดทันทีจากข้อมูลที่ auto-refresh ให้สดอยู่ก่อนแล้ว
                loadReceiptLinks(true).then(function () { applyFilters(); }); // โหลดล่าสุดฉากหลังให้สดที่สุด (ไม่กั้นหน้าจอ)
                return;
            } else {
                if (btnOther) btnOther.className = activeCls;
                const mBtn = document.getElementById('btnAutoMatch');
                if (mBtn) mBtn.classList.add('hidden');
                if (hint) hint.textContent = 'บิลทั้งหมด ยกเว้น ใบสั่งซื้อ และบิลที่ถูกเลือกจับคู่แล้ว — ใช้รวมกับ วิเคราะห์ร้านค้า / ติดตามราคา ได้ตามปกติ';
            }
            applyFilters();
        }

        // วาดแท็บ "บิลที่จับคู่แล้ว" — กลุ่มคู่ (PO + รายการบิลที่จับ) มีปุ่ม ดูบิล / ยืนยัน / ลบ
        function renderMatchedView() {
            const listEl = document.getElementById('matchedGroupsList');
            const emptyEl = document.getElementById('matchedEmptyState');
            if (!listEl || !emptyEl) return;
            const links = Array.isArray(receiptLinks) ? receiptLinks : [];
            if (!links.length) {
                listEl.innerHTML = '';
                listEl.classList.add('hidden');
                emptyEl.classList.remove('hidden');
                return;
            }
            const idx = buildLinkIndex();
            const groups = allData.filter(isPOItem).map(function (po) {
                return { po: po, links: idx.byPo.get(matchingKey(po)) || [] };
            }).filter(function (g) { return g.links.length > 0; }).sort(function (a, b) {
                return (parseDateKey(b.po.date, b.po.timestamp) || 0) - (parseDateKey(a.po.date, a.po.timestamp) || 0);
            });
            if (!groups.length) {
                listEl.innerHTML = '';
                listEl.classList.add('hidden');
                emptyEl.classList.remove('hidden');
                return;
            }
            listEl.classList.remove('hidden');
            emptyEl.classList.add('hidden');
            if (shownPOs < groups.length) shownPOs = Math.max(maxShownPOs, shownPOs);
            const showable = groups.slice(0, shownPOs);
            let html = showable.map(function (g) {
                const po = g.po;
                const pendingCount = g.links.filter(function (l) { return l.status === 'pending'; }).length;
                const confirmedCount = g.links.length - pendingCount;
                const linkRows = g.links.map(function (lk) {
                    const linkedItem = allData.find(function (it) { return matchingKey(it) === lk.link_doc_key; });
                    let html = renderMatchedLinkRow(lk, linkedItem);
                    // โซ่ขั้น 3: ถ้าบิลที่จับเป็นใบส่งของ/ใบรับของ → วาดใบชั่งที่จับกับมันต่อท้ายแถว (กลุ่มเดียวกับ PO นั้น)
                    if (linkedItem && isDeliveryLike(linkedItem)) html += renderScaleChainRows(linkedItem, idx);
                    return html;
                }).join('');
                const poAmount = Number(po.total_amount || 0);
                return '<div class="border border-slate-200 rounded-xl overflow-hidden shadow-sm bg-white">' +
                    '<div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 ' +
                    (pendingCount ? 'bg-amber-50/70 border-b border-amber-200' : 'bg-emerald-50/80 border-b border-emerald-200') + '">' +
                    '<div class="flex items-center gap-2 min-w-0 flex-wrap">' +
                    '<span class="bg-emerald-700 text-white text-[10px] font-bold px-2 py-0.5 rounded whitespace-nowrap">ใบสั่งซื้อหลัก</span>' +
                    '<span class="text-xs font-bold text-slate-800 truncate">' + escapeAttr(po.store_name || '-') + '</span>' +
                    '<span class="text-[11px] text-slate-500 font-mono truncate">' + escapeAttr(docLabel(po)) + '</span>' +
                    '<span class="text-[10px] text-slate-500">ยอดรวม ' + formatMoney(poAmount) + '</span>' +
                    '</div>' +
                    '<div class="flex items-center gap-1.5 shrink-0 flex-wrap">' +
                    (pendingCount ? '<span class="ui-badge ui-badge--pending border-amber-300">⏳ รอตรวจสอบ ' + pendingCount + '</span>' : '') +
                    (confirmedCount ? '<span class="ui-badge ui-badge--ok border-emerald-300">✓ จับคู่แล้ว ' + confirmedCount + '</span>' : '') +
                    '<button onclick="openMatchedDetail(\'' + jsStr(matchingKey(po)) + '\')" class="px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 text-slate-600 text-xs font-semibold rounded-lg transition whitespace-nowrap"><i class="fa-solid fa-up-right-from-square text-[10px] mr-1"></i>ดู PO</button>' +
                    '</div>' +
                    '</div>' +
                    '<div class="p-3 bg-slate-50 border-b border-slate-200">' +
                    '<div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">โซ่จับคู่ 3 ขั้น — บิลที่จับคู่แล้วสำหรับใบสั่งซื้อนี้</div>' +
                    '</div>' +
                    '<div class="p-3 space-y-2 bg-white">' +
                    (linkRows || '<div class="text-xs text-slate-400 text-center py-3">ยังไม่มีบิลที่จับคู่</div>') +
                    '</div>' +
                    '</div>';
            }).join('');
            if (groups.length > shownPOs) {
                html += '<div class="text-center"><button onclick="shownPOs += ' + maxShownPOs + '; renderMatchedView();" class="px-4 py-2 bg-white hover:bg-slate-50 border border-slate-200 text-slate-600 text-xs font-semibold rounded-lg transition">แสดงเพิ่มเติม (' + (groups.length - shownPOs) + ' คู่ที่เหลือ)</button></div>';
            }
            listEl.innerHTML = html;
        }

        function matchTypeChip(lk) {
            const mt = String((lk && lk.match_type) || '');
            const conf = Number((lk && lk.confidence_score) || 0);
            const pct = conf > 0 ? ' ' + Math.round(conf * 100) + '%' : '';
            if (mt === 'AUTO_EXACT') return '<span class="ui-badge ui-badge--info"><i class="fa-solid fa-bolt-lightning mr-0.5"></i>ตรงอัตโนมัติ' + pct + '</span>';
            if (mt === 'AUTO_SUGGESTED') return '<span class="ui-badge ui-badge--role"><i class="fa-solid fa-wand-magic-sparkles mr-0.5"></i>[แนะนำการจับคู่]' + pct + '</span>';
            return '';
        }

        function runAutoMatchNow() {
            const btn = document.getElementById('btnAutoMatch');
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin mr-1"></i>กำลังหาคู่...'; }
            scriptCall('runAutoMatcher', {}).then(function (res) {
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles mr-1"></i>หาคู่ให้อัตโนมัติ'; }
                if (res && res.success) {
                    showToast('🔍 เจอคู่แนะนำใหม่ ' + (res.suggested || 0) + ' คู่ (ตรงอัตโนมัติ ' + (res.exact || 0) + ' / แนะนำ ' + (res.soft || 0) + ')');
                } else {
                    showToast('⚠️ ' + ((res && res.message) || 'หาคู่อัตโนมัติไม่สำเร็จ'));
                }
                applyFilters();
            }).catch(function (err) {
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles mr-1"></i>หาคู่ให้อัตโนมัติ'; }
                showToast('⚠️ ' + (err && err.message ? err.message : 'หาคู่อัตโนมัติไม่สำเร็จ'));
            });
        }

        function renderMatchedLinkRow(lk, linkedItem) {
            const pending = lk.status === 'pending';
            const title = linkedItem ? (escapeAttr(docLabel(linkedItem))) : escapeAttr(lk.link_label || lk.link_doc_key);
            const dateText = linkedItem ? fmtDate(linkedItem.date) : '-';
            const storeText = linkedItem ? escapeAttr(linkedItem.store_name || '-') : escapeAttr(lk.link_store_name || '-');
            const typeText = linkedItem ? escapeAttr(linkedItem.doc_type || 'บิล') : '-';
            const totalText = linkedItem ? '฿' + Number(linkedItem.total_amount || 0).toLocaleString('th-TH', { minimumFractionDigits: 2 }) : '-';
            const thumb = linkedItem && linkedItem.image_url
                ? '<img src="' + linkedItem.image_url + '" onerror="fallbackImg(this)" alt="รูปบิล" class="w-10 h-10 rounded-lg object-cover border border-slate-200 bg-slate-50 shrink-0">'
                : '<div class="w-10 h-10 rounded-lg bg-slate-100 text-slate-400 flex items-center justify-center shrink-0"><i class="fa-regular fa-file-lines text-sm"></i></div>';
            const btnOpen = linkedItem
                ? '<button onclick="openMatchedDetail(\'' + jsStr(matchingKey(linkedItem)) + '\')" class="px-2.5 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 text-slate-600 text-[11px] font-semibold rounded-lg transition">ดูบิล</button>' : '';
            const btnConfirm = pending
                ? '<button onclick="confirmLink(\'' + jsStr(lk.po_doc_key) + '\',\'' + jsStr(lk.link_doc_key) + '\',this)" class="ui-btn ui-btn--sm ui-btn--primary">ยืนยันจับคู่</button>' : '';
            const btnRemove = '<button onclick="removeLink(\'' + jsStr(lk.po_doc_key) + '\',\'' + jsStr(lk.link_doc_key) + '\',this)" class="px-2.5 py-1.5 bg-white hover:bg-red-50 border border-slate-200 text-red-500 text-[11px] font-semibold rounded-lg transition">ลบ</button>';
            return '<div class="flex flex-wrap items-center gap-3 border border-slate-200 rounded-xl p-2.5 bg-white ' + (pending ? 'bg-amber-50/40' : 'bg-emerald-50/40') + '">' +
                thumb +
                '<div class="flex-1 min-w-0">' +
                '<div class="flex items-center gap-2 flex-wrap">' +
                '<span class="text-xs font-semibold text-slate-800">' + title + '</span>' +
                '<span class="ui-badge ' + (pending ? 'ui-badge--pending' : 'ui-badge--ok') + '">' + (pending ? 'รอตรวจสอบ' : 'จับคู่แล้ว') + '</span>' +
                renderMatchRoleCell(linkedItem) +
                matchTypeChip(lk) +
                (linkedItem && isScaleLike(linkedItem)
                    ? '<span class="ui-badge ui-badge--orange border" title="ใบชั่งต้องจับคู่กับใบส่งของ (โซ่ 3 ขั้น) ไม่ใช่ติด PO ตรง — ลบออกแล้วจับผ่านใบส่งของแทน">⚠️ ใบชั่งติด PO ตรง</span>'
                    : '') +
                (linkedItem && isDeliveryLike(linkedItem)
                    ? '<span class="ui-badge ui-badge--info border">ขั้น 2 · ใบส่งของ</span>'
                    : '') +
                renderWeightVarianceChip(lk.link_doc_key) +
                '</div>' +
                '<div class="text-[11px] text-slate-500 mt-0.5">' + dateText + ' · ' + typeText + ' · ' + storeText + ' · <span class="font-semibold text-slate-700">' + totalText + '</span></div>' +
                '</div>' +
                '<div class="flex items-center gap-1.5 shrink-0">' + btnOpen + btnConfirm + btnRemove + '</div>' +
                '</div>';
        }

        function applyFilters() {
            Promise.all([loadReceiptLinks(), loadWeightVariances()]).then(function () { runFilters(); });
        }

        // ============================================================
        // PAGE: ตรวจวางบิล 3-Way (BULK / UNIT / ORPHAN)
        // อินเทอร์เฟซตาม demo ทดสอบ.html — ใช้ข้อมูลจริงจาก receipts + receipt_links + weight_variances
        // ============================================================
        let threeWayTab = 'BULK';            // 'BULK' | 'UNIT' | 'ORPHAN'
        let threeWayStatusFilter = 'ALL';    // ALL | MATCHED | TOLERANCE_EXCEEDED | WRONG_MATCH | QTY_MISMATCH
        let threeWayBulkMode = {};           // po_key -> 'DO' | 'TICKET' (โหมดคิดเงินที่เลือกชั่วคราวฝั่ง UI)
        let threeWayData = { bulk: [], unit: [], orphan: [] };
        const THREE_WAY_TOLERANCE = 0.5;     // เกณฑ์ ±0.5% (ตาม demo)

        function set3WayTab(tab) {
            threeWayTab = (tab === 'UNIT' || tab === 'ORPHAN') ? tab : 'BULK';
            render3WayView();
        }

        function set3WayStatusFilter(status) {
            threeWayStatusFilter = status || 'ALL';
            document.querySelectorAll('.threeway-status-btn').forEach(function (b) { b.className = 'threeway-status-btn px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white border border-slate-200 text-slate-600 hover:bg-slate-100'; });
            const activeBtn = document.getElementById('twFilter' + threeWayStatusFilter);
            if (activeBtn) activeBtn.className = 'threeway-status-btn px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-slate-800 text-white shadow';
            render3WayView();
        }

        function refresh3WayData() {
            render3WayView(true);
        }

        // รวมยอด qty จาก items ของ receipt (สำหรับเปรียบเทียบ PO vs ส่งจริง)
        function sumItemsQty(item) {
            if (!item || !Array.isArray(item.items) || !item.items.length) return 0;
            return item.items.reduce(function (s, it) {
                const q = parseFloat(it && it.quantity);
                return s + (isNaN(q) ? 0 : q);
            }, 0);
        }

        // ราคา/หน่วยแรกจาก PO items (ถ้ามี — ใช้ประกอบข้อมูล ไม่เดา)
        function firstUnitPrice(item) {
            if (!item || !Array.isArray(item.items)) return 0;
            for (let i = 0; i < item.items.length; i++) {
                const p = parseFloat(item.items[i] && item.items[i].price_per_unit);
                if (!isNaN(p) && p > 0) return p;
            }
            return 0;
        }

        function fmtTons(v) {
            const n = Number(v);
            if (v === null || v === undefined || v === '' || isNaN(n)) return '-';
            return n.toLocaleString('th-TH', { maximumFractionDigits: 3 }) + ' ตัน';
        }

        function fmtQty(v) {
            const n = Number(v);
            if (v === null || v === undefined || v === '' || isNaN(n)) return '-';
            return n.toLocaleString('th-TH', { maximumFractionDigits: 0 });
        }

        // สร้างชุดข้อมูล 3-Way จากข้อมูลจริง:
        //  - bulk  : PO (ใบสั่งซื้อ) ที่มีโซ่จับคู่ → DO (ใบส่งของ/ใบรับของ) + Ticket (ใบชั่ง) สำหรับเปรียบเทียบ ±0.5%
        //  - unit  : PO วัสดุนับชิ้น + บิลที่จับ (ใบส่งของ/ใบกำกับ) เทียบยอด qty จาก items
        //  - orphan: เอกสารที่ยังไม่ถูกจับคู่ (ไม่มีลิงก์ใน receipt_links)
        function build3WayData() {
            const data = Array.isArray(allData) ? allData : [];
            const idx = buildLinkIndex();
            const wvm = weightVariancesMap || {};
            const TOL = THREE_WAY_TOLERANCE;
            const bulk = [];
            const unit = [];
            const orphan = [];

            data.forEach(function (it) {
                if (!it) return;
                const key = matchingKey(it);
                const poKey = String(it.doc_key || '');

                // --- ORPHAN: บิล/ใบชั่ง/ใบกำกับ ที่ยังไม่จับคู่กับ PO ใด   ---
                if (!isPOItem(it) && !idx.byLink.has(key)) {
                    const desc = (Array.isArray(it.items) && it.items.length)
                        ? it.items.map(function (s) { return s.name || ''; }).filter(Boolean).slice(0, 2).join(', ')
                        : String(it.category || '');
                    const suggested = data.filter(isPOItem).find(function (po) {
                        return po.store_name && it.store_name && String(po.store_name).trim() === String(it.store_name).trim();
                    });
                    orphan.push({
                        key: key,
                        docType: it.doc_type || 'บิล',
                        docNo: it.doc_no || it.running_number || '-',
                        docDate: fmtDate(it.date),
                        supplier: it.store_name || '-',
                        description: desc || (it.ref_label ? it.ref_label + ' ' + it.ref_no : ''),
                        amountOrQty: isScaleLike(it) ? fmtTons(it.scale_weight_net) : (Number(it.total_amount) ? formatMoney(it.total_amount) : '-'),
                        issue: isScaleLike(it) ? 'ใบชั่งลอย ยังไม่มี PO/DO ในระบบ 3-Way' : 'ไม่พบเลขที่ใบสั่งซื้อ (PO) อ้างอิงในระบบ',
                        suggestedPo: suggested ? (suggested.doc_no || suggested.po_number || matchingKey(suggested)) : ''
                    });
                    return;
                }

                // --- เฉพาะ PO เท่านั้นที่เป็นหัวแถว bulk / unit ---
                if (!isPOItem(it)) return;
                const links = idx.byPo.get(key) || [];
                if (!links.length) return;

                // แยกบิลที่จับ ตามบทบาทโซ่
                const linkedItems = links.map(function (lk) {
                    return { lk: lk, item: data.find(function (d) { return matchingKey(d) === lk.link_doc_key; }) };
                }).filter(function (x) { return x.item; });

                const scaleLike = linkedItems.filter(function (x) { return isScaleLike(x.item); });
                const deliverLike = linkedItems.filter(function (x) { return isDeliveryLike(x.item) && !isScaleLike(x.item); });
                const otherLike = linkedItems.filter(function (x) { return !isScaleLike(x.item) && !isDeliveryLike(x.item); });

                // จับคู่ DO→Ticket (ขั้น 3) ถ้าใบชั่งมีลิงก์เอง ให้หาใบส่งของตัวเดียวกัน
                const doPick = deliverLike[0] || linkedItems.find(function (x) { return !isScaleLike(x.item); });
                let ticketPick = scaleLike[0] || null;
                // ใบชั่งในระบบจริงจับกับใบส่งของ (โซ่ขั้น 3) ไม่ใช่ติด PO ตรง — ดึงตาม chain ของ DO ถ้ามี
                if (!ticketPick && doPick) {
                    const doChainScales = (idx.byPo.get(matchingKey(doPick.item)) || []).map(function (l2) {
                        return { lk: l2, item: data.find(function (d) { return matchingKey(d) === l2.link_doc_key; }) };
                    }).filter(function (x) { return x.item && isScaleLike(x.item); });
                    if (doChainScales.length) ticketPick = doChainScales[0];
                }
                const wrongChain = scaleLike.length > 0 && !doPick;

                if (scaleLike.length > 0 || (doPick && (doPick.item.scale_weight_net !== null && doPick.item.scale_weight_net !== undefined))) {
                    // ===== BULK: นับเป็นกลุ่มชั่งน้ำหนัก =====
                    const doItem = doPick ? doPick.item : null;
                    const tkItem = ticketPick ? ticketPick.item : null;
                    const doNet = doItem ? Number(doItem.scale_weight_net) : null;
                    const tkNet = tkItem ? Number(tkItem.scale_weight_net) : null;
                    const doNetV = (doNet && !isNaN(doNet)) ? doNet : null;
                    const tkNetV = (tkNet && !isNaN(tkNet)) ? tkNet : null;

                    let diffPct = null;
                    if (doNetV && tkNetV && doNetV !== 0) diffPct = ((tkNetV - doNetV) / doNetV) * 100;
                    const isFlagged = diffPct !== null && Math.abs(diffPct) > TOL;

                    // สถานะ (จากข้อมูลจริง ไม่เดา)
                    let status = 'MATCHED';
                    const wv = wvm[key] || wvm[String(doPick ? doPick.lk.link_doc_key : '')] || wvm[String(ticketPick ? ticketPick.lk.link_doc_key : '')];
                    if (wrongChain) status = 'WRONG_MATCH';
                    else if (isFlagged) status = 'TOLERANCE_EXCEEDED';
                    else if (wv && wv.severity && wv.severity !== 'ok') status = 'TOLERANCE_EXCEEDED';

                    const hasPending = links.some(function (l) { return l.status === 'pending'; });
                    const billingMode = threeWayBulkMode[key] || (doNetV ? 'DO' : 'TICKET'); // ใบชั่งลอยไม่มี DO → บังคับยึดตาม Ticket
                    const billingWeight = (billingMode === 'TICKET') ? tkNetV : doNetV;
                    const up = firstUnitPrice(it);
                    let billingAmount = 0;
                    if (up > 0 && billingWeight) billingAmount = up * billingWeight;
                    else billingAmount = doItem ? Number(doItem.total_amount || 0) : (tkItem ? Number(tkItem.total_amount || 0) : 0);

                    bulk.push({
                        key: key,
                        status: (hasPending && status === 'MATCHED') ? 'PENDING' : status, // รอตรวจสอบ overshadow ผ่านสินค้า? แสดง pending แยก
                        hasPending: hasPending,
                        wrongChain: wrongChain,
                        poNo: it.doc_no || it.po_number || key,
                        poDate: fmtDate(it.date),
                        poSupplier: it.store_name || '-',
                        poItem: (Array.isArray(it.items) && it.items[0]) ? (it.items[0].name || '') : String(it.category || ''),
                        do: doItem ? {
                            no: doItem.doc_no || '-', date: fmtDate(doItem.date),
                            truck: doItem.vehicle_registration || '-',
                            tare: doItem.scale_weight_out, gross: doItem.scale_weight_in, net: doNetV
                        } : null,
                        ticket: tkItem ? {
                            no: tkItem.doc_no || '-',
                            gross: tkItem.scale_weight_in, tare: tkItem.scale_weight_out, net: tkNetV
                        } : null,
                        diffPct: diffPct,
                        billingMode: billingMode,
                        billingAmount: billingAmount,
                        remark: wrongChain
                            ? 'จับคู่ผิดโซ่ ใบชั่งติด PO ตรง (ควรจับผ่านใบส่งของ ไม่ใช่ติด PO ตรง)'
                            : (isFlagged && diffPct !== null ? 'ส่วนต่างน้ำหนักเกินเกณฑ์ ±' + TOL + '% (' + (diffPct > 0 ? '+' : '') + diffPct.toFixed(2) + '%)' : 'ตรงตามเกณฑ์ ±' + TOL + '%')
                    });
                } else {
                        // ===== UNIT: วัสดุนับชิ้น =====
                        const delItem = doPick ? doPick.item : (otherLike[0] ? otherLike[0].item : null);
                        const poQty = sumItemsQty(it);
                        const delQty = delItem ? sumItemsQty(delItem) : 0;
                        const up_u = firstUnitPrice(it);
                        const wv2 = wvm[key] || (delItem ? wvm[matchingKey(delItem)] : null);
                        let status = 'MATCHED';
                        if (wv2 && wv2.severity && wv2.severity !== 'ok') status = 'QTY_MISMATCH';
                        else if (poQty > 0 && delQty > 0 && poQty !== delQty) status = 'QTY_MISMATCH';
                        const hasPending2 = links.some(function (l) { return l.status === 'pending'; });
                        unit.push({
                            key: key,
                            status: (hasPending2 && status === 'MATCHED') ? 'PENDING' : status,
                            hasPending: hasPending2,
                            poNo: it.doc_no || it.po_number || key,
                            poDate: fmtDate(it.date),
                            supplier: it.store_name || '-',
                            poItem: (Array.isArray(it.items) && it.items[0]) ? (it.items[0].name || '') : String(it.category || ''),
                            poQty: poQty,
                            invNo: delItem ? (delItem.doc_no || '-') : (otherLike[0] ? otherLike[0].item.doc_no || '-' : '-'),
                            invDate: delItem ? fmtDate(delItem.date) : '-',
                            doItem: (delItem && Array.isArray(delItem.items) && delItem.items[0]) ? (delItem.items[0].name || '') : '',
                            deliveredQty: delQty,
                            unit: 'รายการ',
                            pricePerUnit: up_u,
                            totalAmount: (up_u && up_u > 0 && delQty > 0) ? up_u * delQty : (Number(delItem && delItem.total_amount) || 0),
                        remark: (status === 'QTY_MISMATCH' && poQty > 0 && delQty > 0 && poQty !== delQty)
                            ? 'ส่งของไม่ครบ ขาด ' + fmtQty(poQty - delQty) + ' หน่วย' : 'ตรงตามมาตรฐาน PO'
                    });
                }
            });

            return { bulk: bulk, unit: unit, orphan: orphan };
        }

        // สรุป KPI จากข้อมูล 3-Way (เหมือน demo 5 ใบ)
        function compute3WayKpis(dt) {
            const bulkVal = dt.bulk.reduce(function (s, r) { return s + (Number(r.billingAmount) || 0); }, 0);
            const unitVal = dt.unit.reduce(function (s, r) { return s + (Number(r.totalAmount) || 0); }, 0);
            const totalItems = dt.bulk.length + dt.unit.length;
            const matched = dt.bulk.filter(function (r) { return r.status === 'MATCHED'; }).length +
                dt.unit.filter(function (r) { return r.status === 'MATCHED'; }).length;
            return {
                grandTotal: bulkVal + unitVal,
                matchedRate: totalItems ? Math.round((matched / totalItems) * 100) : 0,
                toleranceAlerts: dt.bulk.filter(function (r) { return r.status === 'TOLERANCE_EXCEEDED' || r.status === 'WRONG_MATCH'; }).length,
                mismatchAlerts: dt.unit.filter(function (r) { return r.status === 'QTY_MISMATCH'; }).length + dt.bulk.filter(function (r) { return r.status === 'WRONG_MATCH'; }).length,
                orphanCount: dt.orphan.length,
                pendingCount: dt.bulk.filter(function (r) { return r.status === 'PENDING'; }).length + dt.unit.filter(function (r) { return r.status === 'PENDING'; }).length
            };
        }

        // ป้ายสถานะตาม demo (ถูกต้อง / เกินเกณฑ์ / จับคู่ผิด PO / ขาดส่ง / รอตรวจสอบ)
        function threeWayStatusChip(row, isBulk) {
            if (row.status === 'WRONG_MATCH') {
                return '<span class="inline-flex items-center gap-1 bg-red-100 text-red-800 text-xs px-2.5 py-1 rounded-full font-bold shadow-sm" title="' + escapeHtml(row.remark || '') + '"><i class="fa-solid fa-circle-xmark text-red-600"></i> จับคู่ผิด PO</span>';
            }
            if (row.status === 'TOLERANCE_EXCEEDED' && isBulk) {
                const pct = (row.diffPct === null || row.diffPct === undefined) ? '' : ((row.diffPct > 0 ? '+' : '') + row.diffPct.toFixed(2) + '%');
                return '<span class="inline-flex items-center gap-1 bg-amber-100 text-amber-900 text-xs px-2.5 py-1 rounded-full font-bold shadow-sm" title="' + escapeHtml(row.remark || '') + '"><i class="fa-solid fa-triangle-exclamation text-amber-600"></i> เกินเกณฑ์' + (pct ? ' (' + pct + ')' : '') + '</span>';
            }
            if (row.status === 'QTY_MISMATCH') {
                return '<span class="inline-flex items-center gap-1 bg-amber-100 text-amber-900 text-xs px-2.5 py-1 rounded-full font-bold shadow-sm" title="' + escapeHtml(row.remark || '') + '"><i class="fa-solid fa-box-open text-amber-600"></i> ขาดส่ง</span>';
            }
            if (row.status === 'PENDING') {
                return '<span class="inline-flex items-center gap-1 bg-slate-100 text-slate-700 text-xs px-2.5 py-1 rounded-full font-bold shadow-sm"><i class="fa-solid fa-hourglass-half text-slate-500"></i> รอตรวจสอบ</span>';
            }
            return '<span class="ui-badge ui-badge--ok inline-flex items-center gap-1 text-xs"><i class="fa-solid fa-circle-check text-emerald-600"></i> ถูกต้อง</span>';
        }

        // เปิดดูบิล/Operational action: ใช้ openMatchedDetail เดิม (ไปที่ detail ของบิลจริง)
        function threeWayOpenDoc(itemRow, kind) {
            const key = kind === 'orphan' ? itemRow.key : itemRow.key;
            const item = allData.find(function (d) { return matchingKey(d) === String(key); });
            if (item) openMatchedDetail(key);
            else showToast('ไม่พบข้อมูลบิลในระบบ', 'error');
        }

        // เลือก PO ใหม่ → เปิด detail ของ PO เพื่อใช้ matchPanel เดิม (เลือกบิลที่ถูกต้อง)
        function threeWayOpenMatch(key) {
            const item = allData.find(function (d) { return matchingKey(d) === String(key || ''); });
            if (!item) { showToast('ไม่พบข้อมูลบิลในระบบ', 'error'); return; }
            if (isPOItem(item)) {
                openMatchedDetail(key);
                showToast('เปิดใบสั่งซื้อนี้ — ไปที่แท็บ "จับคู่" เพื่อแก้การจับคู่เอกสาร', 'info');
            } else {
                // บิลที่ลอย (orphan) — เปิด detail ของบิลเพื่อดู แล้วแนะนำเชื่อมโยงผ่านแท็บใบสั่งซื้อ
                openMatchedDetail(key);
                showToast('เอกสารนี้ยังไม่จับคู่ — เปิดใบสั่งซื้อที่เกี่ยวข้อง แล้วเลือกบิลนี้ในแท็บ "จับคู่"', 'info');
            }
        }

        // เปลี่ยนโหมดคิดเงิน BULK (DO/Ticket) — เก็บ state ฝั่ง UI แล้ว re-render
        function threeWaySwitchMode(poKey, mode) {
            threeWayBulkMode[String(poKey || '')] = (mode === 'TICKET') ? 'TICKET' : 'DO';
            render3WayView();
            const lbl = (mode === 'TICKET') ? 'ยึดตาม Ticket ใบชั่งจริง' : 'ยึดตาม DO ใบส่งสินค้า';
            showToast('อัปเดตโหมดวางบิลเป็น: ' + lbl, 'info');
        }

        // Render รายการกรองตาม search + status filter (เหมือน filter ของ demo)
        function threeWayFilterRows(rows) {
            const term = (document.getElementById('threeWaySearch') ? document.getElementById('threeWaySearch').value : '').toLowerCase().trim();
            const st = threeWayStatusFilter;
            return rows.filter(function (r) {
                const hay = (r.poNo + ' ' + r.poSupplier + ' ' + r.poItem + ' ' + (r.do ? r.do.no : '') + ' ' + (r.ticket ? r.ticket.no : '') + ' ' + r.invNo + ' ' + r.doItem + ' ' + r.docNo + ' ' + r.supplier + ' ' + r.description).toLowerCase();
                const okSearch = !term || hay.indexOf(term) !== -1;
                let okStatus = true;
                if (st === 'MATCHED') okStatus = r.status === 'MATCHED';
                else if (st === 'TOLERANCE_EXCEEDED') okStatus = r.status === 'TOLERANCE_EXCEEDED';
                else if (st === 'WRONG_MATCH') okStatus = r.status === 'WRONG_MATCH';
                else if (st === 'QTY_MISMATCH') okStatus = r.status === 'QTY_MISMATCH';
                return okSearch && okStatus;
            });
        }

        // ==== ตาราง BULK: 4 ส่วน PO / DO / Ticket / Audit (ตาม demo) ====
        function renderBulkTable(rows) {
            if (!rows.length) {
                return '<div class="p-12 text-center text-slate-500 font-medium"><i class="fa-regular fa-folder-open text-4xl block mb-2"></i>ไม่พบรายการกลุ่มชั่งน้ำหนักที่ตรงเงื่อนไข</div>';
            }
            const body = rows.map(function (r) {
                let rowBg = 'hover:bg-slate-50';
                if (r.status === 'WRONG_MATCH') rowBg = 'bg-red-50/70 hover:bg-red-50';
                else if (r.status === 'TOLERANCE_EXCEEDED') rowBg = 'bg-amber-50/70 hover:bg-amber-50';
                const modeSel = '<select onchange="threeWaySwitchMode(\'' + jsStr(r.key) + '\',this.value)" class="w-full p-1.5 text-xs font-bold border border-purple-300 rounded-lg focus:ring-2 focus:ring-purple-400 bg-white text-purple-900 shadow-sm">' +
                    '<option value="DO"' + (r.billingMode === 'DO' ? ' selected' : '') + '>ยึดตาม DO (' + (r.do ? fmtTons(r.do.net) : '-') + ')</option>' +
                    '<option value="TICKET"' + (r.billingMode === 'TICKET' ? ' selected' : '') + '>ยึดตาม Ticket (' + (r.ticket ? fmtTons(r.ticket.net) : '-') + ')</option>' +
                    '</select>';
                const doDate = r.do ? fmtDate(r.do.date) : '-';
                return '<tr class="border-b border-slate-200 transition-colors ' + rowBg + '">' +
                    '<td class="p-3 border-r border-blue-100 font-bold text-blue-900 bg-blue-50/30">' + escapeHtml(r.poNo) + '</td>' +
                    '<td class="p-3 border-r border-blue-100 bg-blue-50/30 font-semibold text-slate-800">' + escapeHtml(r.poSupplier) + '</td>' +
                    '<td class="p-3 border-r border-slate-300 bg-blue-50/50 font-bold text-blue-950">' + escapeHtml(r.poItem || '-') + '<div class="text-[10px] text-slate-400 font-normal mt-0.5">' + escapeHtml(r.poDate) + '</div></td>' +
                    '<td class="p-3 border-r border-slate-100 bg-amber-50/20 font-mono text-slate-800">' + (r.do ? escapeHtml(r.do.no) : '-') + '</td>' +
                    '<td class="p-3 border-r border-slate-100 bg-amber-50/20 text-slate-600">' + doDate + '</td>' +
                    '<td class="p-3 border-r border-slate-100 bg-amber-50/20 font-medium text-slate-800">' + (r.do ? escapeHtml(r.do.truck) : '-') + '</td>' +
                    '<td class="p-3 border-r border-slate-100 bg-amber-50/20 text-right text-slate-600">' + (r.do ? fmtTons(r.do.tare) : '-') + '</td>' +
                    '<td class="p-3 border-r border-slate-100 bg-amber-50/20 text-right text-slate-600">' + (r.do ? fmtTons(r.do.gross) : '-') + '</td>' +
                    '<td class="p-3 border-r border-slate-300 bg-amber-100/40 text-right font-bold text-amber-900">' + (r.do ? fmtTons(r.do.net) : '-') + '</td>' +
                    '<td class="p-3 border-r border-slate-100 bg-emerald-50/20 font-mono text-slate-800">' + (r.ticket ? escapeHtml(r.ticket.no) : '-') + '</td>' +
                    '<td class="p-3 border-r border-slate-100 bg-emerald-50/20 text-right text-slate-600">' + (r.ticket ? fmtTons(r.ticket.gross) : '-') + '</td>' +
                    '<td class="p-3 border-r border-slate-100 bg-emerald-50/20 text-right text-slate-600">' + (r.ticket ? fmtTons(r.ticket.tare) : '-') + '</td>' +
                    '<td class="p-3 border-r border-slate-300 bg-emerald-100/40 text-right font-bold text-emerald-900">' + (r.ticket ? fmtTons(r.ticket.net) : '-') + '</td>' +
                    '<td class="p-3 border-r border-slate-200 text-center">' + threeWayStatusChip(r, true) + '</td>' +
                    '<td class="p-3 border-r border-slate-200 bg-purple-50/50 text-center">' + modeSel + '</td>' +
                    '<td class="p-3 border-r border-slate-200 text-right font-extrabold text-slate-900 bg-slate-50">' + (Number(r.billingAmount) ? formatMoney(r.billingAmount) : '-') + '</td>' +
                    '<td class="p-3 text-center"><div class="flex items-center justify-center gap-1.5">' +
                    '<button onclick="threeWayOpenDoc(\'' + jsStr(r.key) + '\',\'' + jsStr('bulk') + '\')" class="p-1.5 bg-slate-200 hover:bg-slate-300 text-slate-800 rounded-lg text-xs font-medium transition-all" title="ดูรายละเอียด/รูปบิล"><i class="fa-solid fa-eye text-base"></i></button>' +
                    '<button onclick="threeWayOpenMatch(\'' + jsStr(r.key) + '\')" class="px-2.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg shadow transition-all">เลือก PO</button>' +
                    '</div></td>' +
                    '</tr>';
            }).join('');
            return '<div class="bg-blue-50/80 border-b border-blue-200 p-3 px-6 text-xs text-blue-900"><span class="flex items-center gap-1.5"><i class="fa-solid fa-circle-info text-blue-600"></i><strong>การเปรียบเทียบ 3 ทาง:</strong> ตรวจสอบส่วนต่างน้ำหนักระหว่างใบส่งสินค้า (DO) กับใบชั่งปลายทาง (Ticket) เกณฑ์มาตรฐาน ±' + THREE_WAY_TOLERANCE + '%</span></div>' +
                '<div class="overflow-x-auto"><table class="w-full text-sm text-left border-collapse min-w-[1600px]"><thead>' +
                '<tr>' +
                '<th colspan="3" class="bg-blue-700 text-white p-3 text-center border-r border-blue-800 font-bold tracking-wide">ส่วนที่ 1: ใบสั่งซื้อ (PO) Baseline</th>' +
                '<th colspan="6" class="bg-amber-600 text-white p-3 text-center border-r border-amber-700 font-bold tracking-wide">ส่วนที่ 2: ใบส่งสินค้า (DO ต้นทาง)</th>' +
                '<th colspan="4" class="bg-emerald-600 text-white p-3 text-center border-r border-emerald-700 font-bold tracking-wide">ส่วนที่ 3: ใบชั่งน้ำหนัก (Ticket ปลายทาง)</th>' +
                '<th colspan="4" class="bg-slate-800 text-white p-3 text-center font-bold tracking-wide">ส่วนที่ 4: ตรวจสอบและจัดการเคส (Audit &amp; Billing)</th>' +
                '</tr>' +
                '<tr class="bg-slate-100 border-b border-slate-200 text-xs">' +
                '<th class="p-3 border-r border-slate-200 text-blue-900 bg-blue-100/70 font-bold">เลขที่ PO</th><th class="p-3 border-r border-slate-200 text-blue-900 bg-blue-100/70 font-bold">ผู้ขาย</th><th class="p-3 border-r border-slate-300 text-blue-900 bg-blue-100/70 font-bold">รายการสินค้า (PO Baseline)</th>' +
                '<th class="p-3 border-r border-slate-200 text-amber-900 bg-amber-50 font-bold">เลขที่ DO</th><th class="p-3 border-r border-slate-200 text-amber-900 bg-amber-50 font-bold">วันที่</th><th class="p-3 border-r border-slate-200 text-amber-900 bg-amber-50 font-bold">ทะเบียนรถ</th><th class="p-3 border-r border-slate-200 text-amber-900 bg-amber-50 text-right">ชั่งเข้า (Tare)</th><th class="p-3 border-r border-slate-200 text-amber-900 bg-amber-50 text-right">ชั่งออก (Gross)</th><th class="p-3 border-r border-slate-300 text-amber-900 bg-amber-50 text-right font-bold">นน.สุทธิส่ง</th>' +
                '<th class="p-3 border-r border-slate-200 text-emerald-900 bg-emerald-50 font-bold">เลขที่ใบชั่ง</th><th class="p-3 border-r border-slate-200 text-emerald-900 bg-emerald-50 text-right">ชั่งเข้า (Gross)</th><th class="p-3 border-r border-slate-200 text-emerald-900 bg-emerald-50 text-right">ชั่งออก (Tare)</th><th class="p-3 border-r border-slate-300 text-emerald-900 bg-emerald-50 text-right font-bold">นน.สุทธิจริง</th>' +
                '<th class="p-3 border-r border-slate-200 text-slate-800 bg-slate-200 text-center font-bold">สถานะตรวจสอบ</th><th class="p-3 border-r border-slate-200 text-purple-900 bg-purple-100 text-center font-bold">โหมดการคิดเงิน</th><th class="p-3 border-r border-slate-200 text-slate-800 bg-slate-200 text-right font-bold">มูลค่าวางบิล</th><th class="p-3 text-center text-slate-800 bg-slate-200 font-bold">จัดการ / ส่องเอกสาร</th>' +
                '</tr></thead><tbody>' + body + '</tbody></table></div>';
        }

        // ==== ตาราง UNIT: 3 ส่วน PO / DO·Invoice / Audit (ตาม demo) ====
        function renderUnitTable(rows) {
            if (!rows.length) {
                return '<div class="p-12 text-center text-slate-500 font-medium"><i class="fa-regular fa-folder-open text-4xl block mb-2"></i>ไม่พบรายการกลุ่มวัสดุนับชิ้นที่ตรงเงื่อนไข</div>';
            }
            const body = rows.map(function (r) {
                const isWrong = r.status === 'WRONG_MATCH';
                const isMis = r.status === 'QTY_MISMATCH';
                let rowBg = 'hover:bg-slate-50';
                if (isWrong) rowBg = 'bg-red-50/70 hover:bg-red-50';
                else if (isMis) rowBg = 'bg-amber-50/70 hover:bg-amber-50';
                const qtyCol = '<td class="p-3 border-r border-slate-300 bg-amber-50/30 text-right font-bold ' + (isMis ? 'text-amber-700' : 'text-amber-950') + '">' + (r.deliveredQty ? fmtQty(r.deliveredQty) : '-') + ' ' + escapeHtml(r.unit) + '</td>';
                return '<tr class="border-b border-slate-200 transition-colors ' + rowBg + '">' +
                    '<td class="p-3 border-r border-blue-100 font-bold text-blue-900 bg-blue-50/30">' + escapeHtml(r.poNo) + '</td>' +
                    '<td class="p-3 border-r border-blue-100 bg-blue-50/30 text-slate-600">' + escapeHtml(r.poDate) + '</td>' +
                    '<td class="p-3 border-r border-blue-100 bg-blue-50/30 font-semibold text-slate-800">' + escapeHtml(r.supplier) + '</td>' +
                    '<td class="p-3 border-r border-blue-100 bg-blue-50/30 font-bold text-slate-900">' + escapeHtml(r.poItem || '-') + '</td>' +
                    '<td class="p-3 border-r border-slate-300 bg-blue-50/50 text-right font-bold text-blue-950">' + (r.poQty ? fmtQty(r.poQty) : '-') + ' ' + escapeHtml(r.unit) + '</td>' +
                    '<td class="p-3 border-r border-slate-100 bg-amber-50/20 font-mono font-medium text-slate-800">' + escapeHtml(r.invNo) + '</td>' +
                    '<td class="p-3 border-r border-slate-100 bg-amber-50/20 text-slate-600">' + escapeHtml(r.invDate) + '</td>' +
                    '<td class="p-3 border-r border-slate-100 bg-amber-50/20 font-medium text-slate-900">' + escapeHtml(r.doItem || '-') + '</td>' +
                    qtyCol +
                    '<td class="p-3 border-r border-slate-200 bg-slate-50 text-right font-extrabold text-slate-900">' + (Number(r.totalAmount) ? formatMoney(r.totalAmount) : '-') + '</td>' +
                    '<td class="p-3 border-r border-slate-200 text-center">' + threeWayStatusChip(r, false) + '</td>' +
                    '<td class="p-3 text-center"><div class="flex items-center justify-center gap-1.5">' +
                    '<button onclick="threeWayOpenDoc(\'' + jsStr(r.key) + '\',\'' + jsStr('unit') + '\')" class="p-1.5 bg-slate-200 hover:bg-slate-300 text-slate-800 rounded-lg text-xs font-medium transition-all" title="ดูรายละเอียด/รูปบิล"><i class="fa-solid fa-eye text-base"></i></button>' +
                    '<button onclick="threeWayOpenMatch(\'' + jsStr(r.key) + '\')" class="px-2.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg shadow transition-all">เลือก PO</button>' +
                    '</div></td>' +
                    '</tr>';
            }).join('');
            return '<div class="bg-indigo-50/80 border-b border-indigo-200 p-3 px-6 text-xs text-indigo-900"><span class="flex items-center gap-1.5"><i class="fa-solid fa-circle-info text-indigo-600"></i><strong>การตรวจสอบวัสดุนับชิ้น:</strong> ตรวจสอบจำนวนส่งจริงเทียบกับใบสั่งซื้อ (PO) และใบแจ้งหนี้ (Invoice)</span></div>' +
                '<div class="overflow-x-auto"><table class="w-full text-sm text-left border-collapse min-w-[1500px]"><thead>' +
                '<tr>' +
                '<th colspan="5" class="bg-blue-700 text-white p-3 text-center border-r border-blue-800 font-bold tracking-wide">ส่วนที่ 1: ใบสั่งซื้อ (PO)</th>' +
                '<th colspan="4" class="bg-amber-600 text-white p-3 text-center border-r border-amber-700 font-bold tracking-wide">ส่วนที่ 2: ใบส่งสินค้า / ใบแจ้งหนี้ (DO / Invoice)</th>' +
                '<th colspan="3" class="bg-slate-800 text-white p-3 text-center font-bold tracking-wide">ส่วนที่ 3: ตรวจสอบและจัดการเคส (Audit &amp; Action)</th>' +
                '</tr>' +
                '<tr class="bg-slate-100 border-b border-slate-200 text-xs">' +
                '<th class="p-3 border-r border-slate-200 text-blue-900 bg-blue-100/70 font-bold">เลขที่ PO</th><th class="p-3 border-r border-slate-200 text-blue-900 bg-blue-100/70 font-bold">วันที่ PO</th><th class="p-3 border-r border-slate-200 text-blue-900 bg-blue-100/70 font-bold">ผู้จำหน่าย</th><th class="p-3 border-r border-slate-200 text-blue-900 bg-blue-100/70 font-bold">รายการสินค้า (PO Item)</th><th class="p-3 border-r border-slate-300 text-blue-900 bg-blue-100/70 text-right font-bold">จำนวนสั่ง</th>' +
                '<th class="p-3 border-r border-slate-200 text-amber-900 bg-amber-50 font-bold">เลขที่ใบแจ้งหนี้</th><th class="p-3 border-r border-slate-200 text-amber-900 bg-amber-50 font-bold">วันที่ส่ง</th><th class="p-3 border-r border-slate-200 text-amber-900 bg-amber-50 font-bold">รายการตามใบส่ง</th><th class="p-3 border-r border-slate-300 text-amber-900 bg-amber-50 text-right font-bold">จำนวนส่งจริง</th>' +
                '<th class="p-3 border-r border-slate-200 text-slate-800 bg-slate-200 text-right font-bold">ยอดเงินวางบิล</th><th class="p-3 border-r border-slate-200 text-slate-800 bg-slate-200 text-center font-bold">สถานะตรวจสอบ</th><th class="p-3 text-center text-slate-800 bg-slate-200 font-bold">จัดการ / ส่องเอกสาร</th>' +
                '</tr></thead><tbody>' + body + '</tbody></table></div>';
        }

        // ==== ตาราง ORPHAN: เอกสารไร้การอ้างอิง (ตาม demo) ====
        function renderOrphanTable(rows) {
            if (!rows.length || !threeWayData.orphan.length) {
                return '<div class="p-12 text-center text-slate-500 font-medium"><i class="fa-solid fa-circle-check text-emerald-500 text-4xl block mb-2"></i>ไม่มีเอกสารไร้การอ้างอิงค้างในระบบ</div>';
            }
            const body = rows.map(function (r) {
                return '<tr class="border-b border-slate-100 hover:bg-amber-50/40 transition-colors">' +
                    '<td class="p-3.5 font-bold text-slate-800"><span class="bg-amber-100 text-amber-900 px-2.5 py-1 rounded-md text-xs font-bold">' + escapeHtml(r.docType) + '</span></td>' +
                    '<td class="p-3.5 font-mono font-bold text-blue-900">' + escapeHtml(r.docNo) + '</td>' +
                    '<td class="p-3.5 text-slate-600">' + escapeHtml(r.docDate) + '</td>' +
                    '<td class="p-3.5 font-semibold text-slate-800">' + escapeHtml(r.supplier) + '</td>' +
                    '<td class="p-3.5 text-slate-900">' + escapeHtml(r.description || '-') + '</td>' +
                    '<td class="p-3.5 text-right font-bold text-slate-900">' + escapeHtml(r.amountOrQty) + '</td>' +
                    '<td class="p-3.5 text-red-600 text-xs font-semibold">' + escapeHtml(r.issue) + '</td>' +
                    '<td class="p-3.5">' + (r.suggestedPo
                        ? '<span class="inline-flex items-center gap-1 bg-purple-100 text-purple-900 px-2.5 py-1 rounded-md text-xs font-bold border border-purple-200"><i class="fa-solid fa-wand-magic-sparkles text-purple-600"></i>' + escapeHtml(r.suggestedPo) + '</span>'
                        : '<span class="text-slate-400 text-xs font-medium">-</span>') + '</td>' +
                    '<td class="p-3.5 text-center"><button onclick="threeWayOpenMatch(\'' + jsStr(r.key) + '\')" class="px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-xl shadow transition-all flex items-center gap-1.5 mx-auto"><i class="fa-solid fa-link"></i>เชื่อมโยงกับ PO</button></td>' +
                    '</tr>';
            }).join('');
            return '<div class="m-4 bg-amber-50 border border-amber-200 rounded-2xl p-4 flex items-start gap-3">' +
                '<div class="p-2 bg-amber-100 text-amber-700 rounded-xl"><i class="fa-solid fa-triangle-exclamation text-xl"></i></div>' +
                '<div><h3 class="font-bold text-amber-900 text-sm">จัดการเอกสารไร้การอ้างอิง (Orphan &amp; Unlinked Documents)</h3>' +
                '<p class="text-amber-800 text-xs mt-1">เอกสารที่ส่งมอบเข้ามาแต่ไม่มีการระบุเลข PO อ้างอิง — กด "เชื่อมโยงกับ PO" เพื่อเปิดใบสั่งซื้อที่เกี่ยวข้องแล้วเลือกจับคู่ในแท็บ "จับคู่"</p></div></div>' +
                '<div class="m-4 overflow-x-auto bg-white rounded-xl border border-slate-200 shadow-sm"><table class="w-full text-sm text-left border-collapse"><thead>' +
                '<tr class="text-left">' +
                '<th class="ui-th text-center">ประเภทเอกสาร</th><th class="ui-th">เลขที่เอกสาร</th><th class="ui-th">วันที่</th><th class="ui-th">ผู้จำหน่าย</th><th class="ui-th">รายละเอียด</th><th class="ui-th text-right">จำนวน / มูลค่า</th><th class="ui-th">สาเหตุ</th><th class="ui-th">AI PO แนะนำ</th><th class="ui-th text-center">จัดการ</th></tr></thead>' +
                '<tbody>' + body + '</tbody></table></div>';
        }

        // Render หน้า 3-Way ทั้งหมด (KPI + tabs + ตารางที่เลือก)
        function render3WayView(force) {
            const host = document.getElementById('page3Way');
            if (!host) return;
            if (!Array.isArray(allData) || !allData.length) {
                const content = document.getElementById('threeWayContent');
                if (content) content.innerHTML = '<div class="p-12 text-center text-slate-500 font-medium"><i class="fa-regular fa-hourglass-half text-3xl block mb-2"></i>ยังไม่มีข้อมูลบิล — รอข้อมูลจากระบบ...</div>';
                return;
            }
            Promise.all(
                force ? [loadReceiptLinks(true), loadWeightVariances()] : [loadReceiptLinks(), loadWeightVariances()]
            ).then(function () {
                threeWayData = build3WayData();
                const kpis = compute3WayKpis(threeWayData);

                // KPI cards
                const kpiEl = document.getElementById('threeWayKpis');
                if (kpiEl) {
                    kpiEl.innerHTML =
                        '<div class="ui-card p-3 flex items-center justify-between">' +
                        '<div><p class="text-xs font-medium text-slate-400">มูลค่าวางบิลรวมที่ตรวจสอบ</p><h3 class="text-2xl font-extrabold text-slate-900 mt-1">' + formatMoney(kpis.grandTotal) + '</h3><span class="text-[11px] text-emerald-600 font-semibold flex items-center gap-0.5"><i class="fa-solid fa-check"></i> รวมหมวดชั่ง + นับชิ้น</span></div>' +
                        '<div class="p-3 bg-blue-50 text-blue-600 rounded-xl"><i class="fa-solid fa-money-bill-wave text-xl"></i></div></div>' +
                        '<div class="ui-card p-3 flex items-center justify-between">' +
                        '<div><p class="text-xs font-medium text-slate-400">อัตราการจับคู่ถูกต้อง (Matched Rate)</p><h3 class="text-2xl font-extrabold text-emerald-600 mt-1">' + kpis.matchedRate + '%</h3><span class="text-[11px] text-slate-500 font-medium">' + (kpis.pendingCount ? '⏳ รอตรวจ ' + kpis.pendingCount + ' รายการ' : 'จากรายการทั้งหมด') + '</span></div>' +
                        '<div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl"><i class="fa-solid fa-shield-check text-xl"></i></div></div>' +
                        '<div class="ui-card p-3 flex items-center justify-between">' +
                        '<div><p class="text-xs font-medium text-slate-400">น้ำหนักเกินเกณฑ์ (Variance)</p><h3 class="text-2xl font-extrabold mt-1 ' + (kpis.toleranceAlerts > 0 ? 'text-amber-600' : 'text-slate-700') + '">' + kpis.toleranceAlerts + ' รายการ</h3><span class="text-[11px] text-amber-700 font-medium">เกิน ±' + THREE_WAY_TOLERANCE + '% ของ DO</span></div>' +
                        '<div class="p-3 bg-amber-50 text-amber-600 rounded-xl"><i class="fa-solid fa-weight-scale text-xl"></i></div></div>' +
                        '<div class="ui-card p-3 flex items-center justify-between">' +
                        '<div><p class="text-xs font-medium text-slate-400">จับคู่ผิดพลาด / ขาดส่ง</p><h3 class="text-2xl font-extrabold mt-1 ' + (kpis.mismatchAlerts > 0 ? 'text-red-600' : 'text-slate-700') + '">' + kpis.mismatchAlerts + ' รายการ</h3><span class="text-[11px] text-red-600 font-medium">ระงับหรือปรับยอดวางบิล</span></div>' +
                        '<div class="p-3 bg-red-50 text-red-600 rounded-xl"><i class="fa-solid fa-triangle-exclamation text-xl"></i></div></div>' +
                        '<div class="ui-card p-3 flex items-center justify-between">' +
                        '<div><p class="text-xs font-medium text-slate-400">เอกสารไร้การอ้างอิง (Orphans)</p><h3 class="text-2xl font-extrabold mt-1 ' + (kpis.orphanCount > 0 ? 'text-indigo-600 animate-pulse' : 'text-slate-700') + '">' + kpis.orphanCount + ' รายการ</h3><span class="text-[11px] text-indigo-600 font-medium">รอผูกโยงกับ PO</span></div>' +
                        '<div class="p-3 bg-indigo-50 text-indigo-600 rounded-xl"><i class="fa-solid fa-file-circle-question text-xl"></i></div></div>';
                }

                // Tab counts
                const tbc = document.getElementById('twTabBulkCount');
                if (tbc) tbc.textContent = ' ' + threeWayData.bulk.length;
                const tuc = document.getElementById('twTabUnitCount');
                if (tuc) tuc.textContent = ' ' + threeWayData.unit.length;
                const toc = document.getElementById('twTabOrphanCount');
                if (toc) toc.textContent = ' ' + threeWayData.orphan.length;

                // Tab active state
                ['BULK', 'UNIT', 'ORPHAN'].forEach(function (t) {
                    const btn = document.getElementById('twTab' + t);
                    if (!btn) return;
                    const active = threeWayTab === t;
                    btn.className = 'threeway-tab flex items-center gap-2 px-4 py-2 rounded-t-lg text-xs font-semibold transition-all ' +
                        (active ? 'bg-white text-slate-800 border border-b-0 border-slate-200 shadow-sm' : 'bg-white text-slate-500 border border-slate-200 hover:bg-slate-100');
                    btn.style.marginBottom = active ? '-1px' : '';
                });

                // Content
                const content = document.getElementById('threeWayContent');
                if (!content) return;
                if (threeWayTab === 'BULK') {
                    content.innerHTML = renderBulkTable(threeWayFilterRows(threeWayData.bulk));
                } else if (threeWayTab === 'UNIT') {
                    content.innerHTML = renderUnitTable(threeWayFilterRows(threeWayData.unit));
                } else {
                    content.innerHTML = renderOrphanTable(threeWayFilterRows(threeWayData.orphan));
                }
            }).catch(function () {
                const content = document.getElementById('threeWayContent');
                if (content) content.innerHTML = '<div class="p-12 text-center text-slate-500 font-medium"><i class="fa-solid fa-triangle-exclamation text-3xl block mb-2"></i>โหลดข้อมูลไม่สำเร็จ — ลองรีเฟรชใหม่อีกครั้ง</div>';
            });
        }

        // โหลดผล Weight & Unit Variance Engine (weight_variances) — ใช้โชว์ยางธง ⚖️ หน้าแท็บจับคู่
        function loadWeightVariances() {
            if (Date.now() - weightVariancesLoadedAt < 120000) return Promise.resolve();
            weightVariancesLoadedAt = Date.now();
            const direct = function () {
                if (supabaseClient && supabaseReady) {
                    return supabaseClient.from('weight_variances').select('*').then(function (res) {
                        return (res && Array.isArray(res.data)) ? res.data : [];
                    }).catch(function () { return []; });
                }
                return Promise.resolve([]);
            };
            return direct().then(function (rows) {
                if (Array.isArray(rows) && rows.length > 0) return rows;
                if (typeof scriptCall === 'function') {
                    return scriptCall('getWeightVariances', {}).then(function (res) {
                        return Array.isArray(res) ? res : [];
                    }).catch(function () { return []; });
                }
                return [];
            }).then(function (list) {
                const m = {};
                (Array.isArray(list) ? list : []).forEach(function (r) {
                    if (r && r.bill_doc_key) m[r.bill_doc_key] = r;
                });
                weightVariancesMap = m;
            }).catch(function () { weightVariancesMap = {}; });
        }

        // ยางธง ⚖️ น้ำหนัก/จำนวนเพี้ยน (จาก Weight & Unit Variance Engine) — keyed by bill_doc_key
        function renderWeightVarianceChip(docKey) {
            const v = weightVariancesMap[String(docKey || '')];
            if (!v || !v.severity || v.severity === 'ok') return '';
            const pct = (v.qty_variance_pct === null || v.qty_variance_pct === undefined) ? '' : Math.abs(Number(v.qty_variance_pct)).toFixed(1) + '%';
            const wt = v.scale_weight_kg ? (' · ' + (Number(v.scale_weight_kg) / 1000) + ' ตัน') : '';
            const high = v.severity === 'high';
            return '<span class="ui-badge ui-badge--pending ' + (high ? ' border-red-300' : ' border-amber-300') + ' border" title="น้ำหนัก/จำนวนต่างจาก PO เกินเกณฑ์ — ตรวจสอบหน้างาน">⚖️ ' + (high ? 'เพี้ยนมาก' : 'เพี้ยน') + (pct ? ' ' + pct : '') + wt + '</span>';
        }

        // === ป้ายสถานะการจับคู่ของบิล (หลักการ demo: ทุกแถวดูว่าจับกับ Master PO ตัวไหน/สถานะอะไร) ===
        // ข้อมูลจริงจาก receipt_links (via buildLinkIndex().byLink) — ใช้ในตารางหลักเพื่อให้เห็นเป้า PO ทันที
        function renderBillMatchStatus(item) {
            if (!item) return '';
            const key = matchingKey(item);
            if (isPOItem(item)) {
                // ฝั่งใบสั่งซื้อ: โชว์ว่าเป็น Master PO + จำนวนบิลที่จับ (เลียนแบบคอลัมน์ masterPOs ของ demo)
                const pl = buildLinkIndex().byPo.get(key) || [];
                if (!pl.length) return '';
                const pendingN = pl.filter(function (l) { return l.status === 'pending'; }).length;
                const confN = pl.length - pendingN;
                return '<div class="mt-1 flex flex-wrap items-center gap-1">' +
                    '<span class="ui-badge ui-badge--ok"><i class="fa-solid fa-clipboard-list"></i> Master PO</span>' +
                    (confN ? '<span class="ui-badge ui-badge--ok">จับแล้ว ' + confN + '</span>' : '') +
                    (pendingN ? '<span class="ui-badge ui-badge--pending">⏳ รอตรวจ ' + pendingN + '</span>' : '') +
                    '</div>';
            }
            // ฝั่งบิล/ใบชั่ง/ใบส่งของ: หาคู่ใน receipt_links → จับคู่แล้ว / รอตรวจสอบ / ยังไม่จับ
            const ls = buildLinkIndex().byLink.get(key) || [];
            if (!ls.length) {
                const role = isScaleLike(item) ? 'ใบชั่ง' : (isDeliveryLike(item) ? 'ใบส่งของ/ใบรับของ' : 'บิล');
                return '<div class="mt-1"><span class="ui-badge ui-badge--muted"><i class="fa-regular fa-circle-question"></i> ยังไม่จับคู่ · ' + role + '</span></div>';
            }
            const parts = ls.map(function (lk) {
                const conf = lk.status === 'confirmed';
                const poStore = lk.po_store_name || 'PO';
                const mt = matchTypeChip(lk);
                return '<span class="ui-badge ' + (conf ? 'ui-badge--ok' : 'ui-badge--pending') + '">' +
                    (conf ? '<i class="fa-solid fa-circle-check"></i> จับคู่แล้ว' : '<i class="fa-solid fa-hourglass-half"></i> รอตรวจสอบ') +
                    ' ↗ ' + escapeHtml(poStore) + '</span>' + mt;
            }).join(' ');
            return '<div class="mt-1 flex flex-wrap items-center gap-1">' + parts + '</div>';
        }

        // === แถวของตาราง: รวมป้ายสถานะการจับคู่ + match type + ยางธง ⚖️ ต่อท้ายป้ายสถานะ ===
        function renderMatchStatusCell(item) {
            if (!item) return '';
            return renderBillMatchStatus(item) + renderWeightVarianceChip(matchingKey(item));
        }

        // === บทบาทเอกสารในโซ่จับคู่ (หลักการ demo แยก BULK/UNIT/ORPHAN): PO / ใบส่งของ·ใบรับของ / ใบชั่ง / บิลอื่น ===
        function renderMatchRoleCell(item) {
            if (!item) return '';
            if (isPOItem(item)) return '<span class="ui-badge ui-badge--ok whitespace-nowrap"><i class="fa-solid fa-clipboard-list"></i> Master PO</span>';
            if (isScaleLike(item)) return '<span class="ui-badge ui-badge--scale whitespace-nowrap"><i class="fa-solid fa-weight-scale"></i> ใบชั่งน้ำหนัก (BULK)</span>';
            if (isDeliveryLike(item)) return '<span class="ui-badge ui-badge--info whitespace-nowrap"><i class="fa-solid fa-truck-ramp-box"></i> ใบส่งของ/ใบรับของ</span>';
            return '<span class="ui-badge ui-badge--muted whitespace-nowrap"><i class="fa-regular fa-file-lines"></i> บิลอื่น</span>';
        }

        // แท็บ "บิลที่จับคู่แล้ว": กรองเอาเฉพาะใบสั่งซื้อที่มีลิงก์ (confirmed หรือรอตรวจสอบ) และวาดมุมมองกลุ่มคู่
        function runMatchedFilters() {
            const linkIdx = buildLinkIndex();
            filteredData = allData.filter(function (it) {
                return isPOItem(it) && (linkIdx.byPo.get(matchingKey(it)) || []).length > 0;
            });
            updateKPIs();
            renderView();
            renderOverviewCharts();
        }

        // กรองรายการตามแท็บที่เลือก (รองลงมาจากการค้นหาปกติ): 'po' = เฉพาะใบสั่งซื้อ / 'other' = ไม่ใช่ PO และยังไม่ถูกจับ
        function filterByBillTab(list) {
            if (billTab === 'po') return list.filter(isPOItem);
            if (billTab === 'other') {
                const linkIdx = buildLinkIndex();
                return list.filter(function (it) {
                    return !isPOItem(it) && !linkIdx.byLink.has(matchingKey(it));
                });
            }
            return list;
        }

        // v3.15.5: ตรวจว่าบิลนี้วันที่เป็น "ตัวเติม" (AI อ่านวันที่ไม่ชัด → ระบบเติมเดือน/ปีปัจจุบันแทน)
        // ตรวจจาก review_reason ที่ฝั่ง backend ประทับไว้เสมอ (ข้อความ "ระบบเติมเดือน/ปีปัจจุบัน") — ทำงานได้ทั้งชีตและ Supabase
        function isDateFallbackItem(item) {
            if (!item) return false;
            return /เติมเดือน\/ปีปัจจุบัน/.test(String(item.review_reason || ''));
        }

        function runFilters() {
            const search = document.getElementById('searchInput').value.toLowerCase().trim();
            const category = document.getElementById('categoryFilter').value;
            const docType = document.getElementById('docTypeFilter').value;
            const dateRange = document.getElementById('dateFilter').value;
            const lc = v => (v === null || v === undefined) ? '' : String(v).toLowerCase();

            const now = new Date();

            const showAttachments = document.getElementById('showAttachmentsCb') && document.getElementById('showAttachmentsCb').checked;
            const attachMap = buildAttachmentMap();

            filteredData = allData.filter(item => {
                const itemList = Array.isArray(item.items) ? item.items : [];
                const matchItems = itemList.some(sub =>
                    lc(sub && sub.name).includes(search) ||
                    lc(sub && sub.unit).includes(search)
                );

                const matchSearch =
                    lc(item.po_number).includes(search) ||
                    lc(item.store_name).includes(search) ||
                    lc(item.sender_name).includes(search) ||
                    lc(item.doc_type).includes(search) ||
                    lc(item.book_no).includes(search) ||
                    lc(item.doc_no).includes(search) ||
                    lc(item.tax_invoice_no).includes(search) ||
                    lc(item.ref_no).includes(search) ||
                    lc(item.ref_label).includes(search) ||
                    lc(docLabel(item)).includes(search) ||
                    matchItems;

            const matchCat = category === "" || item.category === category;
            const matchDocType = docType === "" || item.doc_type === docType;

                // สถานะการจับคู่ (หลักการ demo): unmatched / pending / confirmed — ใช้ receipt_links จริง
                const matchStatusSel = document.getElementById('matchStatusFilter') ? document.getElementById('matchStatusFilter').value : '';
                if (matchStatusSel) {
                    const lsSel = buildLinkIndex().byLink.get(matchingKey(item)) || [];
                    const poLinksSel = buildLinkIndex().byPo.get(matchingKey(item)) || [];
                    const hasPending = lsSel.some(function (l) { return l.status === 'pending'; }) || poLinksSel.some(function (l) { return l.status === 'pending'; });
                    const hasConfirmed = lsSel.some(function (l) { return l.status === 'confirmed'; }) || poLinksSel.some(function (l) { return l.status === 'confirmed'; });
                    if (matchStatusSel === 'unmatched' && (hasConfirmed || hasPending)) return false;
                    if (matchStatusSel === 'pending' && !hasPending) return false;
                    if (matchStatusSel === 'confirmed' && !hasConfirmed) return false;
                }

                // บทบาทการจับคู่ (filter ตามคอลัมน์ renderMatchRoleCell — เหมือน demo แยก BULK/UNIT/ORPHAN)
                const matchRoleSel = document.getElementById('matchRoleFilter') ? document.getElementById('matchRoleFilter').value : '';
                if (matchRoleSel) {
                    if (matchRoleSel === 'po' && !isPOItem(item)) return false;
                    if (matchRoleSel === 'scale' && (isPOItem(item) || !isScaleLike(item))) return false;
                    if (matchRoleSel === 'delivery' && (isPOItem(item) || isScaleLike(item) || !isDeliveryLike(item))) return false;
                    if (matchRoleSel === 'other' && (isPOItem(item) || isScaleLike(item) || isDeliveryLike(item))) return false;
                }

                let matchDate = true;
                if (item.date && item.date !== '-') {
                    const itemDate = new Date(item.date);
                    if (!isNaN(itemDate.getTime())) {
                        if (dateRange === 'today') {
                            matchDate = itemDate.toDateString() === now.toDateString();
                        } else if (dateRange === 'month') {
                            matchDate = itemDate.getMonth() === now.getMonth() && itemDate.getFullYear() === now.getFullYear();
                        } else if (dateRange === 'year') {
                            matchDate = itemDate.getFullYear() === now.getFullYear();
                        }
                    }
                }

                // บิลแนบ (ใบรับของที่จับคู่กับบิลส่งของแล้ว) ซ่อนจากตารางปกติ — เห็นเมื่อติ๊ก "แสดงบิลแนบ"
                if (!showAttachments && isAttachmentItem(item, attachMap)) return false;

                // v3.15.5: ฟิลเตอร์ "วันที่รอตรวจ" — บิลที่ระบบเติมเดือน/ปีปัจจุบันแทนวันที่ที่อ่านไม่ชัด
                const dateFallbackSel = document.getElementById('dateFallbackFilter') ? document.getElementById('dateFallbackFilter').value : '';
                if (dateFallbackSel === 'fallback' && !isDateFallbackItem(item)) return false;

                return matchSearch && matchCat && matchDocType && matchDate;
            });

            filteredData = filteredData.map(item => {
                    const tk = Date.parse(item.timestamp || '');
                    return { item, sortKey: parseDateKey(item.date, item.timestamp) * 1e9 + (isNaN(tk) ? 0 : tk) };
                })
                // บิลติดธง "รอตรวจ" ขึ้นบนสุดของตารางก่อนเสมอ (booleans: true มาก่อน false) — ภายในกลุ่มเรียงใหม่→เก่าตามเดิม
                .sort((a, b) => ((b.item.needs_review === true) - (a.item.needs_review === true)) || (b.sortKey - a.sortKey))
                .map(x => x.item);

            filteredData = filterByBillTab(filteredData); // กรองตามแท็บตารางบิล (po/other) — ทำหลังค้นหาเรียงลำดับ

            updateKPIs();
            renderView();
            renderOverviewCharts(); // กราฟภาพรวม (ข้อมูลชุดเดียวกับ KPI — อัปเดตตามตัวกรอง)
            if (currentPage === 'supplier') renderSupplierAnalysis();
            else if (currentPage === 'price') renderPriceTracker();
            updateTabBadges(); // ตัวเลขแถบแท็บสดเสมอ (จำนวนรายการ + รอตรวจ/รอตรวจสอบ)
        }

        // === กราฟภาพรวม: แนวโน้มรายเดือน (line) + สัดส่วนหมวดหมู่ (doughnut) — ใช้ filteredData ชุดเดียวกับ KPI ===
        let monthlyTrendChart = null;
        let categoryPieChart = null;
        const CHART_COLORS = ['#27AE60', '#1e3a8a', '#f59e0b', '#8b5cf6', '#ef4444', '#0ea5e9', '#ec4899', '#84cc16', '#f97316', '#64748b'];

        function renderOverviewCharts() {
            if (typeof Chart === 'undefined') return; // CDN โหลดไม่ได้ (เช่นเน็ตพัง) — ข้ามเงียบ ๆ ไม่พังหน้า

            // ---- แนวโน้มรายเดือน: กลุ่มตามเดือนจากวันที่ในบิล (ใช้ parseDateKey เดิม รองรับทุกรูปแบบวันที่) ----
            const monthlyMap = {};
            filteredData.forEach(item => {
                const key = parseDateKey(item.date, item.timestamp);
                if (!key) return;
                const d = new Date(key);
                const mk = d.getUTCFullYear() + '-' + ('0' + (d.getUTCMonth() + 1)).slice(-2);
                monthlyMap[mk] = (monthlyMap[mk] || 0) + (item.total_amount || 0);
            });
            const monthlyKeys = Object.keys(monthlyMap).sort();
            const thMonths = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
            const monthlyLabels = monthlyKeys.map(mk => {
                const [y, m] = mk.split('-');
                return thMonths[Number(m) - 1] + ' ' + (Number(y) + 543);
            });
            const monthlyValues = monthlyKeys.map(mk => monthlyMap[mk]);

            // เตือนตัวเอง: เดือนล่าสุดอาจยังไม่ครบเดือน — แสดงหมายเหตุกันเข้าใจผิดว่ายอดตก
            const lastNote = document.getElementById('monthlyChartNote');
            if (lastNote) {
                lastNote.textContent = monthlyKeys.length
                    ? 'เดือนล่าสุด (' + monthlyLabels[monthlyLabels.length - 1] + ') อาจยังไม่ครบเดือน'
                    : '';
            }

            const trendCtx = document.getElementById('monthlyTrendChart');
            if (trendCtx) {
                if (monthlyTrendChart) { monthlyTrendChart.destroy(); monthlyTrendChart = null; }
                if (monthlyKeys.length) {
                    monthlyTrendChart = new Chart(trendCtx, {
                        type: 'line',
                        data: {
                            labels: monthlyLabels,
                            datasets: [{
                                label: 'ยอดจัดซื้อ (บาท)',
                                data: monthlyValues,
                                borderColor: '#27AE60',
                                backgroundColor: 'rgba(39, 174, 96, 0.12)',
                                fill: true,
                                tension: 0.35,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                pointBackgroundColor: '#27AE60'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: { callbacks: { label: (c) => ' ' + Number(c.parsed.y).toLocaleString('th-TH', { maximumFractionDigits: 2 }) + ' บาท' } }
                            },
                            scales: {
                                y: { ticks: { callback: (v) => Number(v).toLocaleString('th-TH') } }
                            }
                        }
                    });
                } else {
                    trendCtx.getContext('2d').clearRect(0, 0, trendCtx.width, trendCtx.height);
                }
            }

            // ---- สัดส่วนหมวดหมู่: รวมยอดตาม category (ตรงกับ catMap ใน updateKPIs) ----
            const catTotals = {};
            filteredData.forEach(item => {
                if (item.category) catTotals[item.category] = (catTotals[item.category] || 0) + (item.total_amount || 0);
            });
            const catKeys = Object.keys(catTotals).sort((a, b) => catTotals[b] - catTotals[a]);
            const catLabels = catKeys;
            const catValues = catKeys.map(k => catTotals[k]);

            const pieCtx = document.getElementById('categoryPieChart');
            if (pieCtx) {
                if (categoryPieChart) { categoryPieChart.destroy(); categoryPieChart = null; }
                if (catKeys.length) {
                    categoryPieChart = new Chart(pieCtx, {
                        type: 'doughnut',
                        data: {
                            labels: catLabels,
                            datasets: [{
                                data: catValues,
                                backgroundColor: catLabels.map((_, i) => CHART_COLORS[i % CHART_COLORS.length]),
                                borderColor: '#ffffff',
                                borderWidth: 2
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '58%',
                            plugins: {
                                legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } },
                                tooltip: { callbacks: { label: (c) => ' ' + c.label + ': ' + Number(c.parsed).toLocaleString('th-TH', { maximumFractionDigits: 2 }) + ' บาท' } }
                            }
                        }
                    });
                } else {
                    pieCtx.getContext('2d').clearRect(0, 0, pieCtx.width, pieCtx.height);
                }
            }
        }

        function updateKPIs() {
            const totalAmount = filteredData.reduce((sum, item) => sum + (item.total_amount || 0), 0);
            const totalCount = filteredData.length;
            const totalItemsCount = filteredData.reduce((sum, item) => sum + (item.items ? item.items.length : 0), 0);

            const catMap = {};
            const supplierSet = new Set();
            const senderMap = {};

            filteredData.forEach(item => {
                if (item.category) {
                    catMap[item.category] = (catMap[item.category] || 0) + (item.total_amount || 0);
                }
                if (item.store_name) {
                    supplierSet.add(item.store_name);
                }
                // นับจำนวนผู้ส่งบิลจาก LINE (Sender Name) และจำนวนบิลที่แต่ละคนส่ง
                const sName = (item.sender_name && item.sender_name !== '-') ? item.sender_name : '';
                if (sName) {
                    senderMap[sName] = (senderMap[sName] || 0) + 1;
                }
            });

            let topCat = "-";
            let maxCatAmount = 0;
            Object.keys(catMap).forEach(cat => {
                if (catMap[cat] > maxCatAmount) {
                    maxCatAmount = catMap[cat];
                    topCat = cat;
                }
            });

            document.getElementById('statTotalAmount').innerText = '฿' + totalAmount.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('statTotalCount').innerText = totalCount + ' ใบ';
            document.getElementById('statTotalItemCount').innerText = `รวม ${totalItemsCount} รายการสินค้า`;
            document.getElementById('statTopCategory').innerText = topCat;
            document.getElementById('statSupplierCount').innerText = supplierSet.size + ' ร้าน';

            // สรุปผู้ส่งบิลจาก LINE: จำนวนคน + คนที่ส่งบิลมากที่สุด (จาก senderMap ที่นับไว้ด้านบน)
            document.getElementById('statSenderCount').innerText = Object.keys(senderMap).length + ' คน';
            let topSender = '-';
            let maxSenderCount = 0;
            Object.keys(senderMap).forEach(name => {
                if (senderMap[name] > maxSenderCount) {
                    maxSenderCount = senderMap[name];
                    topSender = name;
                }
            });
            document.getElementById('statSenderSub').innerText = (topSender !== '-')
                ? `ส่งมากสุด: ${topSender} (${maxSenderCount} ใบ)`
                : 'ยังไม่มีข้อมูลผู้ส่ง';
        }

        // ข้อความสถานะว่าง: ถ้ายังไม่มีบิลในระบบเลย (ตรงเงื่อนไขแท็บ) → บอก "ยังไม่พบรายการบิลใหม่";
        // มีบิลอยู่แต่โดนค้นหา/กรองหมด → คงข้อความเดิมแนะนำปรับตัวกรอง
        function emptyStateForTab(emptyStateEl) {
            if (!emptyStateEl) return;
            const idx = buildLinkIndex();
            const universe = billTab === 'po'
                ? allData.filter(isPOItem)
                : allData.filter(function (it) { return !isPOItem(it) && !idx.byLink.has(matchingKey(it)); });
            const titleEl = document.getElementById('emptyStateTitle');
            const descEl = document.getElementById('emptyStateDesc');
            if (universe.length === 0) {
                if (titleEl) titleEl.textContent = 'ยังไม่พบรายการบิลใหม่';
                if (descEl) descEl.textContent = billTab === 'po'
                    ? 'เมื่อส่งใบสั่งซื้อผ่าน LINE เข้ามา ระบบจะนำมาแสดงที่นี่ — กด "ดูบิลเต็ม" เพื่อจับคู่กับบิลรับของ'
                    : 'เมื่อส่งบิลรับของ/ใบเสร็จผ่าน LINE เข้ามา ระบบจะนำมาแสดงที่นี่ — ทดลองส่งบิลแรกได้เลย';
            } else {
                if (titleEl) titleEl.textContent = 'ไม่พบรายการเอกสารบิลจัดซื้อ';
                if (descEl) descEl.textContent = 'ลองเปลี่ยนคำค้นหา หรือกรองตามช่วงเวลาและหมวดใหม่อีกครั้ง';
            }
        }

        function renderView() {
            const gridContainer = document.getElementById('gridViewContainer');
            const tableBody = document.getElementById('tableBody');
            const emptyState = document.getElementById('emptyState');
            const matchedContainer = document.getElementById('matchedViewContainer');

            // แท็บ "บิลที่จับคู่แล้ว" → แสดงมุมมองกลุ่มคู่แทนตาราง/การ์ด
            if (billTab === 'matched') {
                gridContainer.classList.add('hidden');
                document.getElementById('tableViewContainer').classList.add('hidden');
                emptyState.classList.add('hidden');
                if (matchedContainer) {
                    matchedContainer.classList.remove('hidden');
                    renderMatchedView();
                }
                return;
            }
            if (matchedContainer) matchedContainer.classList.add('hidden');

            if (filteredData.length === 0) {
                gridContainer.classList.add('hidden');
                document.getElementById('tableViewContainer').classList.add('hidden');
                emptyState.classList.remove('hidden');
                emptyStateForTab(emptyState);
                return;
            }

            emptyState.classList.add('hidden');

            if (currentView === 'grid') {
                gridContainer.classList.remove('hidden');
                document.getElementById('tableViewContainer').classList.add('hidden');
                renderCards(gridContainer);
            } else {
                gridContainer.classList.add('hidden');
                document.getElementById('tableViewContainer').classList.remove('hidden');
                renderTableRows(tableBody);
            }
        }

        function renderTableRows(tbody) {
            let html = '';

            filteredData.forEach((item, index) => {
                const amount = item.total_amount.toLocaleString('th-TH', { minimumFractionDigits: 2 });
                const categoryBadgeColor = getCategoryColor(item.category);
                const isExpanded = expandedRowIds.has(item.id);
                const itemCount = item.items.length;

                const itemsSummaryShort = item.items.map(i => `${i.name} (${i.quantity} ${i.unit})`).join(', ');

                html += `
                <tr id="main-row-${item.id}" class="hover:bg-slate-50/80 transition border-b border-slate-100 ${isExpanded ? 'bg-emerald-50/20' : ''}">
                    <td class="p-3 text-center align-middle">
                        <button onclick="toggleExpandRow('${escJsAttr(String(item.id || ''))}')" 
                            class="w-7 h-7 rounded-lg text-slate-500 hover:text-btc-green hover:bg-emerald-100/80 transition flex items-center justify-center border border-slate-200">
                            <i class="fa-solid ${isExpanded ? 'fa-chevron-up text-btc-green' : 'fa-chevron-down'} text-xs"></i>
                        </button>
                    </td>
                    <td class="p-3 text-xs whitespace-nowrap align-top">
                        <div class="flex items-center gap-1.5 text-slate-700 font-semibold">
                            <i class="fa-regular fa-file-lines text-[10px] text-btc-green"></i>
                            <span>${fmtDate(item.date)}</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-[10px] text-slate-500 mt-1" title="ผู้ส่งบิล (จาก LINE) — บันทึกเมื่อ: ${escapeAttr(formatRecordDateTime(item.timestamp))}">
                            <i class="fa-solid fa-user text-[10px] text-btc-green"></i>
                            <span>${item.sender_name}</span>
                        </div>
                    </td>
                    <td class="p-3 text-xs whitespace-nowrap align-top">
                        <div class="mb-1">${docTypeBadge(item.doc_type)}</div>
                        <span class="inline-block bg-slate-100 px-2 py-1 rounded-md text-slate-700 font-mono">${docLabel(item)}</span>
                        ${item.system_record_no || item.running_number ? `<span class="inline-flex align-middle items-center text-[10px] font-bold px-2 py-0.5 rounded border bg-sky-50 text-sky-700 border-sky-200" title="${item.running_number ? 'เลขที่บิล (TR) — เลขที่คนใช้พูดถึง/ค้นหาจริง' : 'เลขที่รายการที่สร้างจากระบบ (เลขอ้างอิงยืนยันตัวตนบิล — ห้ามใช้ซ้ำ ใช้แก้ไข/ลบ)'}">${item.running_number ? escapeAttr(item.running_number) : '#' + String(item.system_record_no).padStart(6, '0')}</span>` : ''}
                        <div class="text-[10px] text-slate-400 mt-1">PO: <span class="font-mono text-slate-600">${item.po_number}</span></div>
                        ${renderMatchStatusCell(item)}
                        ${item.needs_review ? `<div class="mt-1"><span class="ui-badge ui-badge--pending inline-flex items-center gap-1 border-amber-300" title="${escapeAttr(item.review_reason)}"><i class="fa-solid fa-triangle-exclamation"></i> รอตรวจ</span></div>` : ''}
                        ${(typeof isDateFallbackItem === 'function' && isDateFallbackItem(item)) ? `<div class="mt-1"><span class="ui-badge ui-badge--orange inline-flex items-center gap-1 border-orange-300" title="AI อ่านวันที่ในบิลไม่ชัด — ระบบเติมเดือน/ปีปัจจุบันแทน (วันที่จริงต้องอ่านจากใบ) กรุณาเปิดแก้ไขและแก้วันที่ให้ตรงใบ"><i class="fa-regular fa-calendar"></i> วันที่รอตรวจ</span></div>` : ''}
                        ${(typeof isAttachmentItem === 'function' && isAttachmentItem(item)) ? `<div class="mt-1"><span class="inline-flex items-center gap-1 bg-sky-50 text-sky-700 border border-sky-200 text-[10px] font-semibold px-2 py-0.5 rounded-full" title="ใบรับของแนบกับบิลส่งของ เลขที่ ${escapeAttr(item.ref_no)}"><i class="fa-solid fa-link"></i> บิลแนบ</span></div>` : ''}
                    </td>
                    <td class="p-3 font-bold text-slate-800 max-w-[180px] align-top">
                        ${item.store_name || '<span class="text-slate-500 font-semibold">— ไม่ระบุร้าน —</span>'}
                    </td>
                    <td class="p-3 whitespace-nowrap align-top">
                        ${renderMatchRoleCell(item)}
                    </td>
                    <td class="p-3 whitespace-nowrap align-top">
                        <span class="px-2.5 py-0.5 text-xs font-semibold rounded-md border ${categoryBadgeColor}">
                            ${item.category}
                        </span>
                        ${item.company_name ? `<div class="text-[10px] text-slate-500 mt-1 max-w-[160px] truncate" title="ชื่อบริษัท (ผู้สั่งซื้อ): ${escapeAttr(item.company_name)}">🏢 ${escapeHtml(item.company_name)}</div>` : ''}
                    </td>

                    <td class="p-3 text-xs text-slate-700 max-w-xs align-top cursor-pointer" onclick="toggleExpandRow('${escJsAttr(String(item.id || ''))}')">
                        <div class="line-clamp-2 text-slate-700 font-normal leading-relaxed mb-1">
                            ${itemsSummaryShort || '-'}
                        </div>
                        <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-btc-green hover:underline">
                            <i class="fa-solid fa-list text-[10px]"></i> ดูรายละเอียด (${itemCount} รายการ) <i class="fa-solid ${isExpanded ? 'fa-chevron-up' : 'fa-chevron-down'} text-[9px]"></i>
                        </span>
                    </td>

                    <td class="p-3 text-right font-bold text-btc-green text-base whitespace-nowrap align-top">
                        ฿${amount}
                    </td>
                    <td class="p-3 text-center whitespace-nowrap align-top">
                        <a href="${item.image_original_url || item.image_url}" target="_blank"
                            class="inline-block w-14 h-16 rounded-lg overflow-hidden border border-slate-200 bg-slate-50 hover:ring-2 hover:ring-btc-green transition shadow-sm"
                            title="เปิดรูปบิลในแท็บใหม่">
                            <img src="${item.image_url || imgPlaceholderSmall()}" alt="รูปบิล ${item.po_number}"
                                loading="lazy" onerror="fallbackImg(this)" class="w-full h-full object-cover">
                        </a>
                    </td>
                    <td class="p-3 text-center whitespace-nowrap align-top">
                        <div class="flex items-center justify-center gap-2">
                            <!-- ปุ่มเดียว: ดูบิลเต็ม (แก้ไขข้อมูล/รูป ทำจากข้างในหน้าดูบิลเต็ม) -->
                            <button onclick="deleteReceiptConfirm(${index})" title="ลบบิลนี้ (พร้อมรูปใน Drive)"
                                class="w-8 h-8 rounded-lg bg-red-50 hover:bg-red-100 text-red-500 hover:text-red-600 inline-flex items-center justify-center transition border border-red-200">
                                <i class="fa-solid fa-trash-can text-xs"></i>
                            </button>
                            <button onclick="openDetailModal(${index})" class="px-3 py-1.5 bg-slate-50 hover:bg-slate-100 text-slate-600 text-xs font-semibold rounded-lg transition border border-slate-200">
                                ดูบิลเต็ม
                            </button>
                        </div>
                    </td>
                </tr>

                <tr id="expand-row-${item.id}" class="${isExpanded ? '' : 'hidden'} bg-slate-50/90 border-b-2 border-slate-200">
                    <td colspan="10" class="p-3 pl-10 pr-4">
                        <div class="bg-white rounded-xl border border-slate-200 p-4 space-y-3">
                            <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                                <h6 class="text-xs font-bold text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-boxes-stacked text-btc-green"></i>
                                    ตารางแสดงสินค้า / วัสดุทั้งหมดในบิลนี้ (${itemCount} รายการ)
                                </h6>
                                <span class="text-[11px] text-slate-400">เอกสาร: <strong class="text-slate-700">${docLabel(item)}</strong> | เลขที่ PO: <strong class="text-slate-700">${item.po_number}</strong> | ผู้ส่งบิล: <strong class="text-slate-700">${item.sender_name}</strong></span>
                            </div>

                            <div class="overflow-x-auto max-h-60 overflow-y-auto custom-scrollbar border border-slate-100 rounded-lg">
                                <table class="w-full text-left text-xs border-collapse">
                                    <thead class="sticky top-0 bg-slate-50 text-slate-600 text-xs font-semibold">
                                        <tr>
                                            <th class="p-2.5 w-10 text-center">#</th>
                                            <th class="p-2.5">รายการสินค้า / วัสดุ</th>
                                            <th class="p-2.5 text-center">จำนวน</th>
                                            <th class="p-2.5 text-center">หน่วย</th>
                                            <th class="p-2.5 text-right">ราคา / หน่วย (บาท)</th>
                                            <th class="p-2.5 text-right">ราคารวม (บาท)</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100 text-slate-800 bg-white">
                                        ${item.items.map((sub, i) => `
                                            <tr class="hover:bg-slate-50">
                                                <td class="p-2.5 text-center text-slate-400 font-mono">${i + 1}</td>
                                                <td class="p-2.5 font-medium text-slate-800">${sub.name}</td>
                                                <td class="p-2.5 text-center font-bold text-slate-900">${sub.quantity}</td>
                                                <td class="p-2.5 text-center"><span class="bg-slate-100 px-2 py-0.5 rounded-md text-slate-600">${sub.unit}</span></td>
                                                <td class="p-2.5 text-right font-mono text-slate-600">${sub.price_per_unit > 0 ? '฿' + sub.price_per_unit.toLocaleString('th-TH', { minimumFractionDigits: 2 }) : '-'}</td>
                                                <td class="p-2.5 text-right font-bold text-emerald-700 font-mono">${sub.total > 0 ? '฿' + sub.total.toLocaleString('th-TH', { minimumFractionDigits: 2 }) : '-'}</td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                    <tfoot class="sticky bottom-0 bg-slate-50 font-bold border-t border-slate-200">
                                        <tr>
                                            <td colspan="5" class="p-2 text-right text-slate-600">ราคารวมสุทธิในบิลนี้:</td>
                                            <td class="p-2 text-right text-btc-green font-mono text-sm">฿${amount}</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </td>
                </tr>
                `;
            });

            tbody.innerHTML = html;
        }

        window.addEventListener('DOMContentLoaded', function () {
            const scrollArea = document.getElementById('tableScrollArea');
            const btnScrollTop = document.getElementById('btnScrollTopTable');
            if (scrollArea && btnScrollTop) {
                scrollArea.addEventListener('scroll', function () {
                    if (scrollArea.scrollTop > 180) {
                        btnScrollTop.classList.remove('hidden');
                    } else {
                        btnScrollTop.classList.add('hidden');
                    }
                });
            }
        });

        function scrollTopTable() {
            const scrollArea = document.getElementById('tableScrollArea');
            if (scrollArea) {
                scrollArea.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function renderCards(container) {
            container.innerHTML = filteredData.map((item, index) => {
                const amount = item.total_amount.toLocaleString('th-TH', { minimumFractionDigits: 2 });
                const categoryBadgeColor = getCategoryColor(item.category);

                return `
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col group">
                    <div class="relative h-44 bg-slate-100 overflow-hidden cursor-pointer" onclick="openDetailModal(${index})">
                        <img src="${item.image_url || imgPlaceholderSmall()}" alt="${item.store_name}" 
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                            loading="lazy" onerror="fallbackImg(this)">
                        <div class="absolute top-3 left-3 flex items-center gap-1.5 flex-wrap">
                            <span class="px-2.5 py-1 text-xs font-semibold rounded-lg shadow-sm border ${categoryBadgeColor}">
                                ${item.category}
                            </span>
                            ${docTypeBadge(item.doc_type)}
                        </div>
                        ${item.needs_review ? `<div class="absolute top-3 right-3"><span class="inline-flex items-center gap-1 bg-amber-100 text-amber-800 border border-amber-300 text-[10px] font-semibold px-2 py-0.5 rounded-lg shadow-sm" title="${escapeAttr(item.review_reason)}"><i class="fa-solid fa-triangle-exclamation"></i> รอตรวจ</span></div>` : ''}
                        ${(typeof isDateFallbackItem === 'function' && isDateFallbackItem(item)) ? `<div class="absolute top-12 right-3"><span class="inline-flex items-center gap-1 bg-orange-100 text-orange-800 border border-orange-300 text-[10px] font-semibold px-2 py-0.5 rounded-lg shadow-sm" title="AI อ่านวันที่ในบิลไม่ชัด — ระบบเติมเดือน/ปีปัจจุบันแทน กรุณาแก้วันที่ให้ตรงใบ"><i class="fa-regular fa-calendar"></i> วันที่รอตรวจ</span></div>` : ''}
                        ${renderMatchStatusCell(item) ? `<div class="absolute bottom-2 left-2 flex flex-wrap items-center gap-1 max-w-[85%]">${renderMatchStatusCell(item)}</div>` : ''}
                        ${(typeof isAttachmentItem === 'function' && isAttachmentItem(item)) ? `<div class="absolute top-3 left-3"><span class="inline-flex items-center gap-1 bg-sky-50 text-sky-700 border border-sky-200 text-[10px] font-semibold px-2 py-0.5 rounded-lg shadow-sm" title="ใบรับของแนบกับบิลส่งของ เลขที่ ${escapeAttr(item.ref_no)}"><i class="fa-solid fa-link"></i> บิลแนบ</span></div>` : ''}
                        <div class="absolute bottom-2 right-2 bg-white/90 backdrop-blur-sm text-slate-700 text-xs px-2 py-0.5 rounded-md font-mono border border-slate-200">
                            ${docLabel(item)}
                        </div>
                    </div>

                    <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
                        <div>
                            <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
                                <span title="วันที่ในบิล"><i class="fa-regular fa-file-lines mr-1"></i>${fmtDate(item.date)}</span>
                                <span class="capitalize bg-slate-100 px-2 py-0.5 rounded-md">${item.source === 'group' ? 'กลุ่ม LINE' : 'ส่วนตัว'}</span>
                            </div>
                            <div class="flex items-center gap-1.5 text-[10px] text-slate-500 mb-1.5" title="ผู้ส่งบิล (จาก LINE) — บันทึกเมื่อ: ${escapeAttr(formatRecordDateTime(item.timestamp))}">
                                <i class="fa-solid fa-user-pen text-btc-green"></i>
                                <span>ผู้ส่ง: <strong class="text-slate-600">${item.sender_name}</strong></span>
                            </div>
                            <h4 class="font-bold text-slate-800 text-base line-clamp-1 group-hover:text-btc-green transition mb-2">
                                ${item.store_name || '—'}
                            </h4>
                            <div class="mb-2">${renderMatchRoleCell(item)}</div>
                            ${item.company_name ? `<div class="text-[11px] text-slate-500 mb-2 flex items-center gap-1" title="ชื่อบริษัท (ผู้สั่งซื้อ)"><i class="fa-solid fa-building text-btc-green"></i> ${escapeAttr(item.company_name)}</div>` : ''}
                            
                            <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-200 text-xs space-y-1.5 max-h-[120px] overflow-y-auto custom-scrollbar">
                                <div class="text-[10px] font-bold text-btc-green uppercase tracking-wide flex justify-between items-center border-b border-slate-200 pb-1">
                                    <span>รายการสินค้า (${item.items.length})</span>
                                    <span>จำนวน/หน่วย</span>
                                </div>
                                ${item.items.map(sub => `
                                    <div class="flex justify-between items-center text-[11px] text-slate-700">
                                        <span class="truncate max-w-[170px]">${sub.name}</span>
                                        <span class="font-semibold text-slate-900 whitespace-nowrap">${sub.quantity} ${sub.unit}</span>
                                    </div>
                                `).join('')}
                            </div>
                        </div>

                        <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
                            <div>
                                <span class="text-[10px] uppercase font-bold text-slate-400 block">ยอดรวมสุทธิ</span>
                                <span class="text-lg font-bold text-btc-green">฿${amount}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <!-- ปุ่มเดียว: ดูบิลเต็ม (แก้ไขข้อมูล/รูป ทำจากข้างในหน้าดูบิลเต็ม) -->
                                <button onclick="deleteReceiptConfirm(${index})" class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-500 hover:text-red-600 text-xs font-semibold rounded-lg transition border border-red-200">
                                    <i class="fa-solid fa-trash-can mr-1"></i>ลบ
                                </button>
                                <button onclick="openDetailModal(${index})" class="px-3 py-1.5 bg-white hover:bg-btc-green hover:text-white text-slate-600 text-xs font-semibold rounded-lg transition border border-slate-200">
                                    ดูบิลเต็ม
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                `;
            }).join('');
        }

        function toggleExpandRow(id) {
            const isCurrentlyExpanded = expandedRowIds.has(id);
            expandedRowIds.clear();

            if (!isCurrentlyExpanded) {
                expandedRowIds.add(id);
            }

            renderView();

            if (!isCurrentlyExpanded) {
                setTimeout(() => {
                    const targetElement = document.getElementById(`main-row-${id}`);
                    if (targetElement) {
                        targetElement.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                }, 50);
            }
        }

        function toggleExpandAllRows() {
            const btnText = document.getElementById('btnExpandAllText');
            if (expandedRowIds.size === filteredData.length && filteredData.length > 0) {
                expandedRowIds.clear();
                btnText.innerText = "ขยายทุกรายการ";
            } else {
                filteredData.forEach(item => expandedRowIds.add(item.id));
                btnText.innerText = "ย่อทุกรายการ";
            }
            renderView();
        }

        function getCategoryColor(cat) {
            switch (cat) {
                case 'วัสดุก่อสร้าง': return 'bg-emerald-100 text-emerald-800 border-emerald-200';
                case 'น้ำมันเชื้อเพลิง': return 'bg-blue-100 text-blue-800 border-blue-200';
                case 'อุปกรณ์ช่าง': return 'bg-amber-100 text-amber-800 border-amber-200';
                case 'ค่าแรง/บริการ': return 'bg-purple-100 text-purple-800 border-purple-200';
                default: return 'bg-slate-100 text-slate-700 border-slate-200';
            }
        }

        // ============================================================
        // PAGE NAVIGATION: Sidebar (ภาพรวม / วิเคราะห์ร้านค้า / ติดตามราคา)
        // ============================================================
        let currentPage = 'overview'; // 'overview' | 'table' | 'supplier' | 'price' | 'aitemplates' | 'vendor'

        function switchPage(page) {
            if (!page) page = 'overview';
            currentPage = page;

            const isDesktop = !!window.matchMedia && window.matchMedia('(min-width: 768px)').matches;
            const overview = document.getElementById('pageOverview');
            const tablePage = document.getElementById('pageTable');
            const supplierPanel = document.getElementById('supplierAnalysisPanel');
            const pricePanel = document.getElementById('priceTrackerPanel');
            const aiPanel = document.getElementById('pageAITemplates');
            const vendorPanel = document.getElementById('pageVendorBilling');
            const threeWayPanel = document.getElementById('page3Way');

            // ปิดทุกหน้า ยกเว้นหน้าที่เลือก — บังคับด้วย inline style (ชนะ CSS class ทั้งหมด ไม่มีทางแสดงซ้อนกัน)
            overview.classList.toggle('hidden', page !== 'overview');
            tablePage.classList.toggle('hidden', page !== 'table');
            supplierPanel.classList.toggle('hidden', page !== 'supplier');
            pricePanel.classList.toggle('hidden', page !== 'price');
            aiPanel.classList.toggle('hidden', page !== 'aitemplates');
            vendorPanel.classList.toggle('hidden', page !== 'vendor');
            if (threeWayPanel) threeWayPanel.classList.toggle('hidden', page !== '3way');

            overview.style.display = (page === 'overview') ? '' : 'none';
            tablePage.style.display = (page === 'table') ? (isDesktop ? 'flex' : 'block') : 'none';
            supplierPanel.style.display = (page === 'supplier') ? (isDesktop ? 'flex' : 'block') : 'none';
            pricePanel.style.display = (page === 'price') ? (isDesktop ? 'flex' : 'block') : 'none';
            aiPanel.style.display = (page === 'aitemplates') ? (isDesktop ? 'flex' : 'block') : 'none';
            vendorPanel.style.display = (page === 'vendor') ? (isDesktop ? 'flex' : 'block') : 'none';
            if (threeWayPanel) threeWayPanel.style.display = (page === '3way') ? (isDesktop ? 'flex' : 'block') : 'none';

            // sidebar active state
            document.querySelectorAll('.sidebar-item').forEach(el => {
                const active = el.getAttribute('data-page') === page;
                el.className = active
                    ? 'sidebar-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-900 bg-emerald-50 border-l-4 border-btc-green transition text-left'
                    : 'sidebar-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition border-l-4 border-transparent text-left';
            });

            // mobile button active state
            document.querySelectorAll('.mobile-page-btn').forEach(el => {
                const active = el.getAttribute('data-page') === page;
                el.className = active
                    ? 'mobile-page-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-btc-green text-white whitespace-nowrap transition'
                    : 'mobile-page-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 whitespace-nowrap transition';
            });

            if (page === 'supplier') renderSupplierAnalysis();
            else if (page === 'price') renderPriceTracker();
            else if (page === 'table') applyFilters(); // เข้าหน้าตารางครั้งแรกให้วาดรายการเลย (ข้อมูลอาจเพิ่งโหลด) — เรียกซ้ำไม่มีผลเสีย
            else if (page === 'aitemplates') loadAITemplates(); // เข้าหน้าแม่แบบครั้งแรกให้โหลดทันที
            else if (page === 'vendor') loadVendorBilling();
            else if (page === '3way') render3WayView(); // หน้าใหม่ตรวจวางบิล 3-Way — ดึง data ล่าสุดแล้ววาด

            window.scrollTo({ top: 0 });
        }

        // --- AI Template Library (Prompt Sets + Samples) ---
        let aiMode = 'prompts';
        let aiPromptList = [];

        function setAIMode(mode) {
            // v3.17.4: รองรับ 2 โหมด — prompts (รวม Matrix เทียบค่า) / taxonomy (แท็บ Matrix เดิมรวมเข้า prompts แล้ว)
            aiMode = (mode === 'taxonomy') ? 'taxonomy' : 'prompts';
            const btnIds = { prompts: 'aiModePrompts', taxonomy: 'aiModeTaxonomy' };
            const viewIds = { prompts: 'aiModePromptsView', taxonomy: 'aiModeTaxonomyView' };
            Object.keys(btnIds).forEach(function (key) {
                const btn = document.getElementById(btnIds[key]);
                const view = document.getElementById(viewIds[key]);
                if (btn) btn.className = (aiMode === key) ? 'ui-tab is-active' : 'ui-tab';
                if (view) view.style.display = (aiMode === key) ? '' : 'none';
            });
            if (aiMode === 'prompts') {
                if (!aiPromptList.length) loadAIPrompts(true);
                else renderFieldMatrixTable(); // ค่า field_config อาจเพิ่งถูกแก้ — วาดเทียบใหม่
            }
            else if (aiMode === 'taxonomy') { renderTaxonomyTable(); }
        }


        // 🎯 v3.17.2: ตารางประเภทเอกสาร & สิทธิ์ภาษี (แท็บ taxonomy) — รูปแบบตารางตาม prompt_builder.md
        function renderTaxonomyTable() {
            const tbody = document.getElementById('taxonomyTableBody');
            if (!tbody) return;
            const search = String((document.getElementById('taxonomySearch') || {}).value || '').trim().toLowerCase();
            const vatFilter = String((document.getElementById('taxonomyVatFilter') || {}).value || 'ALL');
            const rows = ACCOUNTING_DOC_TYPES.filter(function (item) {
                const hay = [item.code, item.name, item.display_name || '', item.group || '', item.vat, item.legal || ''].join(' ').toLowerCase();
                if (search && hay.indexOf(search) === -1) return false;
                if (vatFilter === 'ALL') return true;
                const taxLike = /เครดิตภาษีซื้อ|ปรับลดภาษีซื้อ|ปรับเพิ่มภาษีซื้อ/.test(item.vat);
                const cond = /พิจารณา/.test(item.vat);
                if (vatFilter === 'YES') return taxLike && !cond;
                if (vatFilter === 'COND') return cond;
                if (vatFilter === 'NO') return !taxLike;
                return true;
            });
            if (!rows.length) {
                tbody.innerHTML = '<tr><td colspan="5" class="py-8 text-center text-slate-400">ไม่พบประเภทเอกสารที่ตรงกับการค้นหา</td></tr>';
                return;
            }
            tbody.innerHTML = rows.map(function (item) {
                const taxLike = /เครดิตภาษีซื้อ|ปรับลดภาษีซื้อ|ปรับเพิ่มภาษีซื้อ/.test(item.vat);
                const cond = /พิจารณา/.test(item.vat);
                const badgeCls = cond ? 'bg-amber-50 text-amber-800 border-amber-200' : (taxLike ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-rose-50 text-rose-700 border-rose-200');
                return '<tr class="hover:bg-slate-50 transition">' +
                    '<td class="py-2.5 px-3 font-mono font-bold text-emerald-700">[' + escapeHtml(item.code) + ']</td>' +
                    '<td class="py-2.5 px-3"><div class="font-semibold text-slate-800">' + escapeHtml(item.display_name || item.name) + '</div>' +
                    (item.scale ? '<span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-sky-50 text-sky-700 border border-sky-200 mt-0.5 inline-block">ใช้ช่องใบชั่ง</span>' : '') + '</td>' +
                    '<td class="py-2.5 px-3 text-[11px] text-slate-600">' + escapeHtml(item.group || '-') + '</td>' +
                    '<td class="py-2.5 px-3"><span class="px-2 py-0.5 rounded text-[11px] font-medium inline-block border ' + badgeCls + '">' + escapeHtml(item.vat) + '</span></td>' +
                    '<td class="py-2.5 px-3 text-slate-600 font-mono text-[11px]">' + escapeHtml(item.legal || '-') + '</td>' +
                    '</tr>';
            }).join('');
        }

        // 🎯 v3.17.4: Matrix เทียบเกณฑ์มาตรฐาน (●/○/–) กับค่าจริงที่ระบบใช้ (field_config ของชุด Prompt นั้น: ✓/✗/·)
        function renderFieldMatrixTable() {
            const tbody = document.getElementById('matrixTableBody');
            if (!tbody) return;
            // field ที่เทียบได้กับ field_config: [กลุ่ม, ชื่อโชว์, key ใน field_config, เกณฑ์ต่อประเภท fn(meta) -> 'M'|'O'|'N']
            const fields = [
                ['ตัวตนเอกสาร', 'ประเภท (doc_type)', 'doc_type', function () { return 'M'; }],
                ['ตัวตนเอกสาร', 'เลขที่ (doc_no)', 'doc_no', function () { return 'M'; }],
                ['ตัวตนเอกสาร', 'วันที่ (date)', 'date', function () { return 'M'; }],
                ['ตัวตนเอกสาร', 'เลขใบกำกับ (tax_invoice_no)', 'tax_invoice_no', function (t) {
                    return ['TAX', 'REC/TAX', 'CN', 'DN', 'DO/TAX', 'CUSTOMS'].indexOf(t.code) >= 0 ? 'M' : (['ABB', 'DO', 'INV/BILL', 'PO'].indexOf(t.code) >= 0 ? 'N' : 'O');
                }],
                ['การสั่งซื้อ', 'เลขที่ PO (po_number)', 'po_number', function (t) { return ['PO', 'PR', 'DO', 'DO/TAX', 'WT', 'WR'].indexOf(t.code) >= 0 ? 'M' : 'O'; }],
                ['ร้านค้า/ผู้ขาย', 'ชื่อร้าน (store_name)', 'store_name', function () { return 'M'; }],
                ['รายการสินค้า', 'รายการ (items)', 'items', function (t) { return ['PO', 'PR', 'QT', 'DO', 'DO/TAX', 'INV/BILL'].indexOf(t.code) >= 0 ? 'M' : 'O'; }],
                ['การเงิน', 'ยอดรวม (total_amount)', 'total_amount', function (t) { return t.money_doc !== false && /เอกสารภาษี|จัดซื้อ|บัญชีภายใน/.test(t.group || '') ? 'M' : 'O'; }],
                ['งานก่อสร้าง', 'บริษัท/งาน/ผู้เบิก/ผู้สั่งจ่าย', 'company_name', function (t) { return ['PO', 'PR'].indexOf(t.code) >= 0 ? 'M' : 'O'; }],
                ['การชั่งน้ำหนัก', 'น้ำหนักสุทธิ (scale_weight_net)', 'scale_weight_net', function (t) { return t.scale ? 'M' : (['DO', 'DO/TAX', 'WR'].indexOf(t.code) >= 0 ? 'O' : 'N'); }],
                ['การชั่งน้ำหนัก', 'ทะเบียนรถ (vehicle_registration)', 'vehicle_registration', function (t) { return t.scale ? 'M' : (['DO', 'DO/TAX', 'WR'].indexOf(t.code) >= 0 ? 'O' : 'N'); }]
            ];
            const types = ACCOUNTING_DOC_TYPES;
            // map field_config จริงจากชุด prompt (doc_type -> config)
            const cfgByType = {};
            aiPromptList.forEach(function (p) { cfgByType[String(p.doc_type || '').trim()] = p.field_config || {}; });

            const rowsHtml = fields.map(function (f) {
                const cells = types.map(function (t) {
                    const std = f[3](t); // เกณฑ์มาตรฐาน M/O/N
                    const cfg = cfgByType[t.name] || {};
                    const hasCfg = Object.keys(cfg).length > 0;
                    const actual = hasCfg ? (cfg[f[2]] === true) : null; // true/false/null(ไม่ได้ตั้ง)
                    // สถานะเซลล์: เทียบเกณฑ์กับค่าจริง
                    let cellHtml, cellCls = '';
                    const sym = std === 'M' ? '●' : (std === 'O' ? '○' : '–');
                    if (actual === null) {
                        cellHtml = '<div class=\"font-bold\">' + sym + '</div><div class=\"text-[9px] text-slate-300\">·</div>';
                    } else if (actual === true) {
                        // เปิดใช้ — ตรวจว่าเกินเกณฑ์ไหม (เกณฑ์ N แต่เปิด)
                        if (std === 'N') { cellHtml = '<div>' + sym + '</div><div class=\"text-[10px] font-bold text-rose-700\">✓</div>'; cellCls = 'bg-rose-50'; }
                        else { cellHtml = '<div>' + sym + '</div><div class=\"text-[10px] font-bold text-emerald-700\">✓</div>'; }
                    } else {
                        // ปิดใช้ — เกณฑ์บังคับแต่ยังไม่เปิด = ขอบเข้ม
                        if (std === 'M') { cellHtml = '<div class=\"text-slate-400\">' + sym + '</div><div class=\"text-[10px] font-bold text-slate-600\">✗</div>'; cellCls = 'ring-1 ring-slate-400'; }
                        else { cellHtml = '<div class=\"text-slate-400\">' + sym + '</div><div class=\"text-[10px] text-slate-400\">✗</div>'; }
                    }
                    return '<td class="py-2 px-2 text-center ' + cellCls + '" title="' + escapeAttr((t.display_name || t.name) + ' — เกณฑ์: ' + (std === 'M' ? 'บังคับ' : std === 'O' ? 'เมื่อพบ' : 'ไม่เกี่ยว') + (hasCfg ? ' / ตั้งค่าแล้ว' : ' / ยังไม่ได้ตั้งค่าชุด prompt')) + '">' + cellHtml + '</td>';
                }).join('');
                return '<tr class="hover:bg-slate-50 transition"><td class="py-2 px-3 text-[11px] text-slate-500 font-medium whitespace-nowrap">' + escapeHtml(f[0]) + '</td>' +
                    '<td class="py-2 px-3 text-slate-800 font-medium whitespace-nowrap">' + escapeHtml(f[1]) + '</td>' + cells + '</tr>';
            }).join('');
            const headCells = types.map(function (t) {
                return '<th class="py-2 px-2 text-center font-mono text-[10px]" title="' + escapeAttr(t.display_name || t.name) + '">' + escapeHtml(t.code) + '</th>';
            }).join('');
            const headRow = tbody.closest('table').querySelector('thead tr');
            if (headRow) {
                headRow.innerHTML = '<th class="py-2.5 px-3">กลุ่ม</th><th class="py-2.5 px-3">ฟิลด์ (Field)</th>' + headCells;
            }
            tbody.innerHTML = rowsHtml;
        }

        function loadAIPage(force) {
            return loadAIPrompts(force);
        }
        // alias สำหรับ switchPage (เดิม) — เข้าหน้าครั้งแรกโหลดชุด prompt
        function loadAITemplates(force) { return loadAIPage(force); }

        function loadAIPrompts(force) {
            const body = document.getElementById('aiPromptList');
            const noticeEl = document.getElementById('aiPromptNotice');
            if (body) body.innerHTML = '<div class="p-10 text-center text-slate-400 text-sm"><i class="fa-solid fa-circle-notch fa-spin mr-2"></i>กำลังโหลดชุด Prompt...</div>';
            return scriptCall('getAIPrompts', {})
                .then(function (res) {
                    const ok = !!(res && res.success);
                    aiPromptList = (ok && Array.isArray(res.prompts)) ? res.prompts : [];
                    renderPromptCards();
                    renderFieldMatrixTable(); // v3.17.4: มี field_config ใหม่แล้ว — วาดตารางเทียบใหม่
                    if (noticeEl) {
                        if (res && res.notice) {
                            noticeEl.style.display = '';
                            noticeEl.classList.remove('hidden');
                            noticeEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation mr-1"></i>' + escapeHtml(res.notice) +
                                ' <button type="button" onclick="this.parentElement.style.display=\'none\'; this.parentElement.classList.add(\'hidden\')" class="float-right text-slate-500 hover:text-slate-700"><i class="fa-solid fa-xmark"></i></button>';
                        } else if (!ok) {
                            noticeEl.style.display = '';
                            noticeEl.classList.remove('hidden');
                            noticeEl.innerHTML = '<i class="fa-solid fa-circle-exclamation mr-1"></i>' + escapeHtml((res && res.message) || 'โหลดชุด Prompt ไม่สำเร็จ') +
                                ' <button type="button" onclick="this.parentElement.style.display=\'none\'; this.parentElement.classList.add(\'hidden\')" class="float-right text-slate-500 hover:text-slate-700"><i class="fa-solid fa-xmark"></i></button>';
                        } else {
                            noticeEl.style.display = 'none';
                            noticeEl.classList.add('hidden');
                        }
                    }
                })
                .catch(function (err) {
                    if (body) body.innerHTML = '<div class="p-10 text-center text-slate-400 text-sm">โหลดไม่สำเร็จ — ' + (err && err.message ? err.message : 'ลองใหม่') + '</div>';
                });
        }

        


        


        

        

        

        


        function statusChipPrompt(p, hasGenerate) {
            const st = String(p.status || '');
            if (st === 'ready') return '<span class="bg-emerald-100 text-emerald-700 border-emerald-300"><i class="fa-solid fa-circle-check mr-0.5"></i>พร้อมใช้' + (p.version ? ' v' + p.version : '') + '</span>';
            if (st === 'generating') return '<span class="bg-sky-100 text-sky-700 border-sky-300"><i class="fa-solid fa-circle-notch fa-spin mr-0.5"></i>AI กำลังเขียน...</span>';
            return hasGenerate
                ? '<span class="bg-amber-100 text-amber-800 border-amber-300"><i class="fa-solid fa-hourglass-half mr-0.5"></i>รอ AI เขียน</span>'
                : '<span class="ui-badge ui-badge--muted">รอ AI เขียน</span>';
        }

        function renderPromptFieldBuilder(prompt, docType) {
            const fields = [
                ['doc_type', 'ประเภท'], ['doc_no', 'เลขที่'], ['tax_invoice_no', 'เลขกำกับ'], ['po_number', 'PO'],
                ['date', 'วันที่'], ['store_name', 'ร้านค้า'], ['items', 'รายการ'], ['total_amount', 'ยอดรวม'],
                ['company_name', 'บริษัท'], ['job_name', 'งาน'], ['requester', 'ผู้เบิก'], ['pay_approver', 'ผู้สั่งจ่าย'],
                ['scale_weight_net', 'น้ำหนักสุทธิ'], ['vehicle_registration', 'ทะเบียนรถ']
            ];
            const selected = prompt.field_config || {};
            return '<div class="prompt-fields flex flex-wrap gap-x-3 gap-y-1" data-prompt-doc-type="' + escapeAttr(docType) + '">' +
                fields.map(function (f) {
                    const on = selected[f[0]] === true;
                    return '<label class="inline-flex items-center gap-1 text-[10px] ' + (on ? 'text-emerald-700 font-semibold' : 'text-slate-500') + '"><input type="checkbox" data-prompt-field="' + f[0] + '" onchange="savePromptFields(this)" ' + (on ? 'checked' : '') + '> ' + f[1] + '</label>';
                }).join('') + '</div>';
        }

        // v3.17.4: ตารางชุด Prompt (แถวเดียวต่อประเภท — แทนการ์ด)
        function renderPromptCards() {
            const body = document.getElementById('aiPromptList');
            const badge = document.getElementById('aiTemplateBadge');
            if (!body) return;
            const needsN = aiPromptList.filter(function (p) { return String(p.status) !== 'ready'; }).length;
            if (badge) {
                const hasKb = aiPromptList.some(function (p) { return String(p.base_knowledge || '').trim() !== ''; });
                if (needsN > 0 || !hasKb) {
                    badge.style.display = '';
                    badge.textContent = (needsN > 0) ? needsN + ' รอ AI เขียน' : 'โหลดหมวดฐานแล้ว';
                } else badge.style.display = 'none';
            }
            if (!aiPromptList.length) {
                body.innerHTML = '<div class="p-10 text-center text-slate-400 text-sm">ยังไม่มีชุด Prompt — กด <b>+ สร้างชุด Prompt</b> หรือกดรีเฟรชเพื่อโหลดหมวดบัญชีมาตรฐาน</div>';
                return;
            }
            body.innerHTML = '<div class="overflow-x-auto custom-scrollbar border border-slate-200 rounded-xl">' +
                '<table class="w-full text-left border-collapse text-xs bg-white">' +
                '<thead><tr class="bg-slate-100 text-slate-700 font-semibold border-b border-slate-200">' +
                '<th class="py-2.5 px-3">ประเภทเอกสาร</th>' +
                '<th class="py-2.5 px-3 w-32">สถานะชุด</th>' +
                '<th class="py-2.5 px-3">ฟิลด์ที่ให้ AI อ่าน (ติ๊กเพื่อแก้ — บันทึกทันที)</th>' +
                '<th class="py-2.5 px-3 w-36">จัดการ</th>' +
                '</tr></thead><tbody class="divide-y divide-slate-200">' +
                aiPromptList.map(function (p, i) {
                    const st = String(p.status || '');
                    const custom = String(p.kind || '') === 'custom';
                    const hasReadyPrompt = st === 'ready';
                    const docType = String(p.doc_type || '');
                    const meta = getAccountingDocTypeLoose(docType);
                    const chip = statusChipPrompt(p, true);
                    return '<tr class="hover:bg-slate-50 transition align-top">' +
                        '<td class="py-2.5 px-3"><div class="font-semibold text-slate-800 whitespace-nowrap">' + (meta ? '<span class="font-mono text-emerald-700">[' + escapeHtml(meta.code) + ']</span> ' : '') + escapeHtml((meta && meta.display_name) ? meta.display_name : (p.title || docType)) + '</div>' +
                        '<div class="flex items-center gap-1 mt-1">' + (custom ? '<span class="ui-badge ui-badge--info">custom</span>' : '<span class="ui-badge ui-badge--muted">มาตรฐาน</span>') + '<span class="text-[9px] font-mono text-slate-300">#' + escapeHtml(String(p.id || '').substring(0, 8)) + '</span></div></td>' +
                        '<td class="py-2.5 px-3">' + chip + '</td>' +
                        '<td class="py-2.5 px-3">' + renderPromptFieldBuilder(p, docType) + '</td>' +
                        '<td class="py-2.5 px-3"><div class="flex flex-col gap-1.5">' +
                        '<button type="button" onclick="generatePromptAction(\'' + escJsAttr(docType) + '\')" class="ui-btn ui-btn--sm ' + (st === 'generating' ? 'ui-btn--ghost cursor-wait' : 'ui-btn--primary') + '">' +
                        (st === 'generating' ? '<i class="fa-solid fa-circle-notch fa-spin mr-1"></i>กำลังเขียน...' : '<i class="fa-solid fa-wand-magic-sparkles mr-1"></i>' + (hasReadyPrompt ? 'ปรับชุด prompt' : 'AI เขียน')) + '</button>' +
                        (custom ? '<button type="button" onclick="deletePromptAction(\'' + escJsAttr(p.id) + '\')" title="ลบชุดนี้" class="px-2.5 py-1.5 rounded-lg text-[11px] font-semibold text-red-400 hover:text-red-600 border border-slate-200 hover:bg-red-50 transition"><i class="fa-solid fa-trash mr-1"></i>ลบ</button>' : '') +
                        '</div></td></tr>';
                }).join('') + '</tbody></table></div>';
        }

        function savePromptFields(input) {
            const wrap = input && input.closest ? input.closest('.prompt-fields') : null;
            if (!wrap) return;
            const fields = {};
            wrap.querySelectorAll('[data-prompt-field]').forEach(function (el) {
                fields[el.getAttribute('data-prompt-field')] = !!el.checked;
            });
            scriptCall('updateAIPromptFields', { docType: wrap.getAttribute('data-prompt-doc-type') || '', fields: fields })
                .then(function (res) {
                    if (!res || !res.success) throw new Error((res && res.message) || 'บันทึกฟิลด์ไม่สำเร็จ');
                    showToast('บันทึกฟิลด์สำหรับ Prompt แล้ว');
                })
                .catch(function (err) { showToast(err && err.message ? err.message : err, 'error'); });
        }

        function safeText(value, fallback) {
            const raw = value == null ? '' : String(value);
            const cleaned = raw.replace(/[\u0000-\u001F\u007F]/g, '').replace(/[\r\n\t]+/g, ' ').trim();
            return cleaned || (fallback == null ? '' : String(fallback));
        }
        function escJsAttr(s) {
            return String(s == null ? '' : safeText(s, ''))
                .replace(/&/g, '&amp;')
                .replace(/\\/g, '\\\\')
                .replace(/'/g, "\\'")
                .replace(/"/g, '&quot;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/\r/g, '\\r')
                .replace(/\n/g, '\\n')
                .replace(/\u2028/g, '\\u2028')
                .replace(/\u2029/g, '\\u2029');
        }
        function escapeHtml(s) {
            return String(s == null ? '' : safeText(s, '')).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }


        // --- AI สร้าง/ปรับชุด prompt ---
        function generatePromptAction(docType) {
            if (!docType) { showToast('⚠️ ยังไม่มี doc_type ของหมวดนี้'); return; }
            if (!confirm('ให้ AI เขียน/ปรับชุดคำสั่งอ่านบิลหมวด "' + docType + '" ใหม่ (จากความรู้บัญชีฐาน) ?')) return;
            scriptCall('generateAIPrompt', { docType: docType }).then(function (res) {
                if (res && res.success) showToast('✨ AI เขียนชุด prompt เรียบร้อย (' + res.title + ' v' + res.version + ')');
                else showToast('⚠️ ' + ((res && res.message) || 'AI เขียนชุด prompt ไม่สำเร็จ'));
                loadAIPrompts(true);
            }).catch(function (err) {
                showToast('⚠️ ' + (err && err.message ? err.message : 'AI เขียนชุด prompt ไม่สำเร็จ'));
                loadAIPrompts(true);
            });
        }

        function deletePromptAction(promptId) {
            if (!confirm('ลบชุด prompt นี้?')) return;
            scriptCall('deletePromptSet', { promptId: promptId }).then(function (res) {
                showToast(res && res.success ? '🗑 ลบชุด prompt แล้ว' : '⚠️ ' + (res && res.message ? res.message : 'ลบไม่สำเร็จ'));
                loadAIPrompts(true);
            }).catch(function (err) { showToast('⚠️ ' + (err && err.message ? err.message : 'ลบไม่สำเร็จ')); });
        }

        // --- Create / Upload / View modals ---
        function openCreatePromptModal() {
            const m = document.getElementById('createPromptModal');
            if (m) m.classList.remove('hidden');
        }
        function closeCreatePromptModal() {
            const m = document.getElementById('createPromptModal');
            if (m) m.classList.add('hidden');
        }
        function createPromptAction() {
            const title = (document.getElementById('createPromptTitle') || {}).value || '';
            const btn = document.getElementById('btnCreatePrompt');
            if (btn) { btn.disabled = true; }
            scriptCall('createCustomPromptSet', { title: title }).then(function (res) {
                if (btn) { btn.disabled = false; }
                if (res && res.success) {
                    showToast('✅ สร้างชุด Prompt แล้ว — กด "✨ AI เขียนชุด prompt" ได้เลย');
                    closeCreatePromptModal();
                    document.getElementById('createPromptTitle').value = '';
                    setAIMode('prompts');
                    loadAIPrompts(true);
                } else showToast('⚠️ ' + (res && res.message ? res.message : 'สร้างไม่สำเร็จ'));
            }).catch(function (err) {
                if (btn) { btn.disabled = false; }
                showToast('⚠️ ' + (err && err.message ? err.message : 'สร้างไม่สำเร็จ'));
            });
        }

        
        
        

        

        

        

        // --- Vendor Billing: ใบวางบิลจากบิลที่จับคู่แล้วเท่านั้น ---
        let vendorBillingNotes = [];
        let vendorBillingCandidates = [];

        function loadVendorBilling(force) {
            const list = document.getElementById('vendorBillingList');
            const candidates = document.getElementById('vendorBillingCandidates');
            if (list && !vendorBillingNotes.length) list.innerHTML = '<div class="p-8 text-center text-slate-400 text-sm"><i class="fa-solid fa-circle-notch fa-spin mr-2"></i>กำลังโหลดใบวางบิล...</div>';
            return Promise.all([scriptCall('getVendorBillingNotes', {}), scriptCall('getVendorBillingCandidates', {})])
                .then(function (results) {
                    vendorBillingNotes = (results[0] && Array.isArray(results[0].notes)) ? results[0].notes : [];
                    vendorBillingCandidates = (results[1] && Array.isArray(results[1].candidates)) ? results[1].candidates : [];
                    renderVendorBillingCandidates();
                    renderVendorBillingNotes();
                })
                .catch(function (err) {
                    if (list) list.innerHTML = '<div class="p-8 text-center text-red-500 text-sm">โหลดระบบวางบิลไม่สำเร็จ: ' + escapeHtml(err && err.message ? err.message : err) + '</div>';
                });
        }

        function renderVendorBillingCandidates() {
            const body = document.getElementById('vendorBillingCandidates');
            if (!body) return;
            if (!vendorBillingCandidates.length) {
                body.innerHTML = '<div class="text-xs text-slate-400">ยังไม่มีบิลสถานะจับคู่แล้ว (MATCHED) สำหรับนำไปวางบิล</div>';
                return;
            }
            body.innerHTML = '<div class="text-[11px] font-semibold text-slate-600 mb-2">เลือกบิลที่จับคู่แล้วเพื่อสร้างใบวางบิล</div>' +
                vendorBillingCandidates.map(function (item) {
                    return '<label class="flex items-center gap-2 py-1.5 text-xs cursor-pointer border-b border-slate-100 last:border-0">' +
                        '<input type="checkbox" class="vendorBillingCandidate rounded border-slate-400 text-btc-green" value="' + escapeAttr(item.doc_key) + '">' +
                        '<span class="flex-1 truncate">' + escapeHtml(docLabel(item)) + ' · ' + escapeHtml(item.store_name || '-') + '</span>' +
                        '<span class="font-semibold text-slate-700">฿' + Number(item.total_amount || 0).toLocaleString('th-TH', { minimumFractionDigits: 2 }) + '</span>' +
                        '</label>';
                }).join('');
        }

        function renderVendorBillingNotes() {
            const body = document.getElementById('vendorBillingList');
            const badge = document.getElementById('vendorBillingBadge');
            if (badge) badge.textContent = vendorBillingNotes.length + ' ใบ';
            if (!body) return;
            if (!vendorBillingNotes.length) {
                body.innerHTML = '<div class="p-8 text-center text-slate-400 text-sm">ยังไม่มีใบวางบิล</div>';
                return;
            }
            body.innerHTML = vendorBillingNotes.map(function (note) {
                const ok = note.validation_ok === true;
                const canPay = ok && note.status !== 'paid';
                return '<div class="border border-slate-200 rounded-xl p-3 bg-white shadow-sm">' +
                    '<div class="flex flex-wrap items-center justify-between gap-2">' +
                    '<div><div class="text-sm font-bold text-slate-800">' + escapeHtml(note.vendor_name || '-') + '</div>' +
                    '<div class="text-[11px] text-slate-500">เลขที่ ' + escapeHtml(note.billing_no || '-') + ' · ยอดใบวางบิล ฿' + Number(note.claimed_amount || 0).toLocaleString('th-TH', { minimumFractionDigits: 2 }) + '</div></div>' +
                    '<span class="ui-badge ui-badge--pending border ' + (ok ? ' border-emerald-300' : ' border-amber-300') + '">' + escapeHtml(note.status || 'draft') + '</span>' +
                    '</div>' +
                    '<div class="text-[11px] mt-2 ' + (ok ? 'text-emerald-700' : 'text-amber-700') + '">' + escapeHtml(note.validation_message || 'ยังไม่ได้ตรวจสอบยอด') + ' · จับคู่แล้ว ฿' + Number(note.matched_amount || 0).toLocaleString('th-TH', { minimumFractionDigits: 2 }) + '</div>' +
                    '<div class="flex flex-wrap items-center gap-2 mt-2">' +
                    '<input type="file" accept="image/*,.pdf" class="text-[10px] max-w-48" onchange="uploadVendorTaxInvoiceAction(\'' + jsStr(note.id) + '\',this)">' +
                    (canPay ? '<button type="button" onclick="updateVendorBillingStatusAction(\'' + jsStr(note.id) + '\',\'paid\')" class="ui-btn ui-btn--sm ui-btn--primary">อนุมัติจ่าย</button>' : '') +
                    (note.webview_link ? '<a href="' + escapeAttr(note.webview_link) + '" target="_blank" class="text-[11px] text-btc-green hover:underline">เปิดใบกำกับภาษี</a>' : '') +
                    '</div></div>';
            }).join('');
        }

        function createVendorBillingAction() {
            const keys = Array.from(document.querySelectorAll('.vendorBillingCandidate:checked')).map(function (el) { return el.value; });
            const vendor = (document.getElementById('vendorBillingVendor') || {}).value || '';
            const amount = Number((document.getElementById('vendorBillingAmount') || {}).value || 0);
            if (!vendor.trim() || !keys.length || isNaN(amount)) { showToast('กรอกชื่อร้าน ยอดใบวางบิล และเลือกบิลก่อน', 'error'); return; }
            scriptCall('createVendorBillingNote', {
                vendor_name: vendor.trim(),
                billing_no: (document.getElementById('vendorBillingNo') || {}).value || '',
                billing_date: (document.getElementById('vendorBillingDate') || {}).value || null,
                claimed_amount: amount,
                receipt_doc_keys: keys
            }).then(function (res) {
                if (!res || !res.success) throw new Error((res && res.message) || 'สร้างใบวางบิลไม่สำเร็จ');
                showToast(res.note && res.note.validation_ok ? 'สร้างใบวางบิลและตรวจยอดผ่านแล้ว' : 'สร้างใบวางบิลแล้ว แต่ยอดยังไม่ตรง');
                loadVendorBilling(true);
            }).catch(function (err) { showToast(err && err.message ? err.message : err, 'error'); });
        }

        function updateVendorBillingStatusAction(id, status) {
            scriptCall('updateVendorBillingStatus', { id: id, status: status }).then(function (res) {
                if (!res || !res.success) throw new Error((res && res.message) || 'เปลี่ยนสถานะไม่สำเร็จ');
                showToast('เปลี่ยนสถานะใบวางบิลแล้ว');
                loadVendorBilling(true);
            }).catch(function (err) { showToast(err && err.message ? err.message : err, 'error'); });
        }

        function uploadVendorTaxInvoiceAction(noteId, input) {
            const file = input && input.files && input.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function () {
                scriptCall('uploadVendorTaxInvoice', { billing_note_id: noteId, file_name: file.name, mime_type: file.type, file_base64: reader.result })
                    .then(function (res) {
                        if (!res || !res.success) throw new Error((res && res.message) || 'อัปโหลดไม่สำเร็จ');
                        showToast('อัปโหลดใบกำกับภาษีและบันทึกลิงก์แล้ว');
                        loadVendorBilling(true);
                    }).catch(function (err) { showToast(err && err.message ? err.message : err, 'error'); });
            };
            reader.readAsDataURL(file);
        }

        // --- Supplier Analysis ---
        function renderSupplierAnalysis() {
            const body = document.getElementById('supplierAnalysisBody');
            const badge = document.getElementById('supplierCountBadge');
            if (!filteredData.length) {
                body.innerHTML = '<div class="p-8 text-center text-slate-400 text-sm">ไม่มีข้อมูลสำหรับวิเคราะห์</div>';
                badge.textContent = '0 ร้าน';
                return;
            }

            const supplierMap = {};
            filteredData.forEach(item => {
                const name = (item.store_name || '').trim();
                if (!name) return;
                if (!supplierMap[name]) supplierMap[name] = { name: name, total: 0, count: 0, items: 0 };
                supplierMap[name].total += item.total_amount || 0;
                supplierMap[name].count += 1;
                supplierMap[name].items += (item.items ? item.items.length : 0);
            });

            const sorted = Object.values(supplierMap).sort((a, b) => b.total - a.total);
            const grandTotal = sorted.reduce((s, x) => s + x.total, 0);
            badge.textContent = sorted.length + ' ร้าน';

            const barColors = ['bg-btc-green'];

            let html = '<table class="w-full text-left border-collapse text-xs"><thead class="ui-th border-b border-slate-200"><tr>' +
                '<th class="p-2.5 w-12 text-center">#</th>' +
                '<th class="p-2.5">ร้านค้า / ซัพพลายเออร์</th>' +
                '<th class="p-2.5 text-center">จำนวนบิล</th>' +
                '<th class="p-2.5 text-center">จำนวนรายการ</th>' +
                '<th class="p-2.5 text-right">ยอดรวม</th>' +
                '<th class="p-2.5 text-right">เฉลี่ยต่อบิล</th>' +
                '<th class="p-2.5 w-48">% ของยอดรวม</th>' +
                '</tr></thead><tbody class="divide-y divide-slate-100">';

            sorted.forEach((s, i) => {
                const pct = grandTotal > 0 ? (s.total / grandTotal * 100) : 0;
                const avg = s.count > 0 ? s.total / s.count : 0;
                const color = barColors[i % barColors.length];
                html += `<tr class="hover:bg-slate-50/80 transition">
                    <td class="p-2.5 text-center font-mono text-slate-400">${i + 1}</td>
                    <td class="p-2.5 font-semibold text-slate-800">${s.name}</td>
                    <td class="p-2.5 text-center">${s.count} ใบ</td>
                    <td class="p-2.5 text-center">${s.items} รายการ</td>
                    <td class="p-2.5 text-right font-bold text-btc-green">฿${s.total.toLocaleString('th-TH', { minimumFractionDigits: 2 })}</td>
                    <td class="p-2.5 text-right text-slate-600">฿${avg.toLocaleString('th-TH', { minimumFractionDigits: 2 })}</td>
                    <td class="p-2.5">
                        <div class="flex items-center gap-2">
                            <div class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="${color} h-full rounded-full transition-all duration-500" style="width: ${Math.max(pct, 2)}%"></div>
                            </div>
                            <span class="text-[11px] font-semibold text-slate-600 w-12 text-right">${pct.toFixed(1)}%</span>
                        </div>
                    </td>
                </tr>`;
            });

            html += '</tbody></table>';
            body.innerHTML = html;
        }

        // --- Material Unit Price Tracker ---
        function renderPriceTracker() {
            const body = document.getElementById('priceTrackerBody');
            const badge = document.getElementById('priceMaterialBadge');
            const showAll = document.getElementById('priceShowAllCb').checked;

            if (!filteredData.length) {
                body.innerHTML = '<div class="p-8 text-center text-slate-400 text-sm">ไม่มีข้อมูลสำหรับวิเคราะห์</div>';
                badge.textContent = '0 วัสดุ';
                return;
            }

            // รวบรวมรายการสินค้าทั้งหมดจากทุกบิล
            const materialMap = {};
            filteredData.forEach(item => {
                if (!item.items || !item.items.length) return;
                item.items.forEach(sub => {
                    const name = (sub.name || '').trim();
                    if (!name) return;
                    if (!materialMap[name]) materialMap[name] = { name: name, unit: sub.unit || '-', records: [] };
                    materialMap[name].records.push({
                        date: item.date,
                        po: item.po_number,
                        store: item.store_name,
                        qty: sub.quantity,
                        price: sub.price_per_unit,
                        total: sub.total
                    });
                });
            });

            const materials = Object.values(materialMap);
            badge.textContent = materials.length + ' วัสดุ';

            if (!materials.length) {
                body.innerHTML = '<div class="p-8 text-center text-slate-400 text-sm">ไม่มีรายการสินค้าให้วิเคราะห์</div>';
                return;
            }

            // คำนวณสถิติแต่ละวัสดุ
            const stats = materials.map(m => {
                const prices = m.records.map(r => r.price).filter(p => p > 0);
                const avg = prices.length ? prices.reduce((s, p) => s + p, 0) / prices.length : 0;
                const min = prices.length ? Math.min(...prices) : 0;
                const max = prices.length ? Math.max(...prices) : 0;
                const latest = m.records.sort((a, b) => (b.date || '').localeCompare(a.date || ''))[0];
                const latestPrice = latest ? latest.price : 0;
                const overpriced = latestPrice > 0 && avg > 0 && latestPrice > avg * 1.15; // แพงกว่าเฉลี่ย >15%
                const underpriced = latestPrice > 0 && avg > 0 && latestPrice < avg * 0.85;
                return {
                    ...m,
                    avg, min, max, latest, latestPrice, overpriced, underpriced,
                    count: prices.length,
                    totalQty: m.records.reduce((s, r) => s + (r.qty || 0), 0)
                };
            });

            // เรียงตามความสำคัญ: overpriced ก่อน, แล้วตามจำนวนครั้ง
            stats.sort((a, b) => {
                if (a.overpriced && !b.overpriced) return -1;
                if (!a.overpriced && b.overpriced) return 1;
                return b.count - a.count;
            });

            // ซ่อนรายการปกติถ้าไม่ showAll
            const filtered = showAll ? stats : stats.filter(s => s.overpriced || s.underpriced);

            let html = '';
            if (!filtered.length) {
                html = '<div class="p-6 text-center space-y-2"><div class="w-12 h-12 bg-emerald-50 text-emerald-500 rounded-full flex items-center justify-center mx-auto"><i class="fa-solid fa-check text-lg"></i></div><p class="text-sm font-semibold text-slate-700">ราคาวัสดุปกติทั้งหมด</p><p class="text-xs text-slate-400">ไม่พบรายการที่แพงกว่าค่าเฉลี่ยเกิน 15%</p></div>';
            } else {
                html = '<table class="w-full text-left border-collapse text-xs"><thead class="ui-th border-b border-slate-200"><tr>' +
                    '<th class="p-2.5">วัสดุ / วัสดุก่อสร้าง</th>' +
                    '<th class="p-2.5 text-center">หน่วย</th>' +
                    '<th class="p-2.5 text-right">ราคาล่าสุด</th>' +
                    '<th class="p-2.5 text-right">ราคาเฉลี่ย</th>' +
                    '<th class="p-2.5 text-right">ต่ำสุด</th>' +
                    '<th class="p-2.5 text-right">สูงสุด</th>' +
                    '<th class="p-2.5 text-center">จำนวนครั้ง</th>' +
                    '<th class="p-2.5 text-center">สถานะ</th>' +
                    '<th class="p-2.5 text-center">รายละเอียด</th>' +
                    '</tr></thead><tbody class="divide-y divide-slate-100">';

                stats.forEach((s, idx) => {
                    const statusHtml = s.overpriced
                        ? '<span class="ui-badge ui-badge--danger border-red-200"><i class="fa-solid fa-arrow-trend-up mr-1"></i>แพงเกินจริง</span>'
                        : s.underpriced
                            ? '<span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-blue-100 text-blue-700 border border-blue-200"><i class="fa-solid fa-arrow-trend-down mr-1"></i>ต่ำกว่าเฉลี่ย</span>'
                            : '<span class="ui-badge ui-badge--ok"><i class="fa-solid fa-check mr-1"></i>ปกติ</span>';

                    const priceDiff = s.avg > 0 && s.latestPrice > 0
                        ? ((s.latestPrice - s.avg) / s.avg * 100).toFixed(1)
                        : null;

                    html += `<tr class="hover:bg-slate-50/80 transition">
                        <td class="p-2.5 font-semibold text-slate-800 max-w-[200px] truncate" title="${s.name}">${s.name}</td>
                        <td class="p-2.5 text-center text-slate-500">${s.unit}</td>
                        <td class="p-2.5 text-right font-bold ${s.overpriced ? 'text-red-600' : 'text-slate-800'}">
                            ${s.latestPrice > 0 ? '฿' + s.latestPrice.toLocaleString('th-TH', { minimumFractionDigits: 2 }) : '-'}
                            ${priceDiff ? `<span class="text-[10px] ml-1 ${s.overpriced ? 'text-red-400' : 'text-emerald-400'}">${priceDiff > 0 ? '+' : ''}${priceDiff}%</span>` : ''}
                        </td>
                        <td class="p-2.5 text-right text-slate-600">฿${s.avg.toLocaleString('th-TH', { minimumFractionDigits: 2 })}</td>
                        <td class="p-2.5 text-right text-emerald-600">฿${s.min.toLocaleString('th-TH', { minimumFractionDigits: 2 })}</td>
                        <td class="p-2.5 text-right text-red-500">฿${s.max.toLocaleString('th-TH', { minimumFractionDigits: 2 })}</td>
                        <td class="p-2.5 text-center text-slate-600">${s.count} ครั้ง</td>
                        <td class="p-2.5 text-center">${statusHtml}</td>
                        <td class="p-2.5 text-center">
                            <button onclick="expandMaterialDetail('${escJsAttr(String(s.name || ''))}', this)" 
                                class="px-2 py-1 text-[10px] font-semibold bg-white hover:bg-slate-50 text-slate-600 rounded-lg transition border border-slate-200">
                                <i class="fa-solid fa-clock-rotate-left mr-1"></i>ประวัติ
                            </button>
                        </td>
                    </tr>`;

                    // Row detail (hidden by default)
                    html += `<tr id="mat-detail-${idx}" class="hidden"><td colspan="9" class="p-0">
                        <div class="bg-slate-50 border-t border-b border-slate-200 p-3">
                            <div class="text-[11px] font-bold text-slate-600 mb-2">ประวัติการซื้อทั้งหมด</div>
                            <table class="w-full text-[11px] border-collapse">
                                <thead><tr class="text-slate-500 font-semibold">
                                    <th class="p-1.5 text-left">วันที่</th>
                                    <th class="p-1.5 text-left">PO</th>
                                    <th class="p-1.5 text-left">ร้านค้า</th>
                                    <th class="p-1.5 text-center">จำนวน</th>
                                    <th class="p-1.5 text-right">ราคา/หน่วย</th>
                                    <th class="p-1.5 text-right">รวม</th>
                                </tr></thead>
                                <tbody class="divide-y divide-slate-200">${s.records.map(r => `
                                    <tr class="${r.price === s.max && r.price > s.avg ? 'bg-red-50' : r.price === s.min ? 'bg-emerald-50' : ''}">
                                        <td class="p-1.5 text-slate-600">${fmtDate(r.date)}</td>
                                        <td class="p-1.5 font-mono text-slate-700">${r.po || '-'}</td>
                                        <td class="p-1.5 text-slate-600">${r.store || '-'}</td>
                                        <td class="p-1.5 text-center">${r.qty} ${s.unit}</td>
                                        <td class="p-1.5 text-right font-semibold ${r.price === s.max ? 'text-red-600' : r.price === s.min ? 'text-emerald-600' : 'text-slate-700'}">
                                            ${r.price > 0 ? '฿' + r.price.toLocaleString('th-TH', { minimumFractionDigits: 2 }) : '-'}
                                            ${r.price === s.max ? ' <span class="text-red-400 text-[9px]">แพงสุด</span>' : ''}
                                            ${r.price === s.min && s.min !== s.max ? ' <span class="text-emerald-400 text-[9px]">ถูกสุด</span>' : ''}
                                        </td>
                                        <td class="p-1.5 text-right">${r.total > 0 ? '฿' + r.total.toLocaleString('th-TH', { minimumFractionDigits: 2 }) : '-'}</td>
                                    </tr>`).join('')}
                                </tbody>
                            </table>
                        </div>
                    </td></tr>`;
                });

                html += '</tbody></table>';
            }

            body.innerHTML = html;
        }

        function expandMaterialDetail(materialName, btn) {
            // หา index ของแถว detail จากปุ่ม
            const row = btn.closest('tr');
            const nextRow = row ? row.nextElementSibling : null;
            if (nextRow && nextRow.id && nextRow.id.startsWith('mat-detail-')) {
                nextRow.classList.toggle('hidden');
                const icon = btn.querySelector('i');
                if (icon) icon.className = nextRow.classList.contains('hidden')
                    ? 'fa-solid fa-clock-rotate-left mr-1' : 'fa-solid fa-chevron-up mr-1';
            }
        }

        function switchView(view) {
            // รูปการ์ด ถอดออกแล้ว (User ไม่ได้ใช้) — บังคับใช้มุมมองตารางอย่างเดียว
            currentView = 'table';
            const btnGrid = document.getElementById('btnGridView');
            const btnTable = document.getElementById('btnTableView');
            if (btnTable) btnTable.className = "ui-tab is-active";
            if (btnGrid) btnGrid.className = "ui-tab";
            renderView();
        }

        // สลับช่องข้อมูลใบชั่ง (ทะเบียน/น้ำหนัก) ตามประเภทเอกสารที่เลือกในฟอร์มแก้ไข
        // + ประเภทองค์กรที่ติ๊ก "ใช้ช่องใบชั่ง" (customScaleDocTypes) ก็แสดงช่องเดียวกัน
        let customScaleDocTypes = [];

        function toggleScaleFields(docType) {
            const box = document.getElementById('editScaleFields');
            const addBox = document.getElementById('editDocTypeAddBox');
            if (box) box.classList.toggle('hidden', docType !== 'ใบชั่ง' && customScaleDocTypes.indexOf(docType) === -1);
            if (addBox) addBox.classList.toggle('hidden', docType !== '__ADD_NEW__');
            if (docType === '__ADD_NEW__' && box) box.classList.add('hidden');
        }

        // เติมประเภทเอกสารขององค์กร (doc_types จาก Supabase) เข้า dropdown หน้าแก้ไข — เรียกตอนโหลดหน้า
        function loadCustomDocTypes() {
            return scriptCall('getCustomDocTypesList', {})
                .then(function (list) {
                    if (!Array.isArray(list) || !list.length) return;
                    const sel = document.getElementById('editDocTypeSelect');
                    if (!sel) return;
                    const beforeAdd = sel.querySelector('option[value="__ADD_NEW__"]');
                    list.forEach(function (t) {
                        if (!t || !t.name) return;
                        if (Array.from(sel.options).some(opt => opt.value === t.name)) return; // มีอยู่แล้ว (รวม option ชั่วคราว) — ข้าม
                        const opt = document.createElement('option');
                        opt.value = t.name;
                        opt.text = t.name + (t.treat_as_scale ? ' ⚖️' : '');
                        sel.insertBefore(opt, beforeAdd); // แทรกก่อนตัวเลือก "+ เพิ่มประเภทใหม่…"
                        if (t.treat_as_scale) customScaleDocTypes.push(t.name);
                    });
                })
                .catch(function () { /* ยังไม่รัน SQL/ออฟไลน์ — dropdown ใช้รายการมาตรฐานตามเดิม */ });
        }

        // บันทึกประเภทเอกสารใหม่ขององค์กรจากฟอร์ม inline — สำเร็จแล้วใช้ได้ทันทีใน dropdown นี้ + AI อ่านบิลถัดไป
        function submitNewDocType() {
            const nameEl = document.getElementById('newDocTypeName');
            const aliasEl = document.getElementById('newDocTypeAliases');
            const scaleEl = document.getElementById('newDocTypeScale');
            const name = (nameEl.value || '').trim();
            if (!name) { showToast('กรุณาพิมพ์ชื่อประเภทเอกสารก่อน', 'error'); return; }
            const btn = document.querySelector('#editDocTypeAddBox button');
            if (btn) btn.disabled = true;
            scriptCall('addCustomDocType', {
                name: name,
                aliases: (aliasEl.value || '').trim(),
                treat_as_scale: scaleEl ? scaleEl.checked : false
            })
                .then(function (res) {
                    if (res && res.success === false) { showToast(res.message || 'เพิ่มไม่สำเร็จ', 'error'); return; }
                    showToast((res && res.message) || ('เพิ่มประเภทเอกสาร "' + name + '" เรียบร้อย'));
                    // เติมเข้า dropdown ทันที + เลือกให้เลย (บันทึกบิลนี้ด้วยประเภทใหม่ได้ทันที)
                    const sel = document.getElementById('editDocTypeSelect');
                    if (!Array.from(sel.options).some(opt => opt.value === name)) {
                        const opt = document.createElement('option');
                        opt.value = name;
                        opt.text = name + (scaleEl && scaleEl.checked ? ' ⚖️' : '');
                        const beforeAdd = sel.querySelector('option[value="__ADD_NEW__"]');
                        sel.insertBefore(opt, beforeAdd);
                    }
                    sel.value = name;
                    nameEl.value = ''; aliasEl.value = ''; if (scaleEl) scaleEl.checked = false;
                    toggleScaleFields(name);
                    applyEditDocTypeVisibility(name);
                })
                .catch(function (err) { showToast('เพิ่มประเภทเอกสารไม่สำเร็จ: ' + err.message, 'error'); })
                .finally(function () { if (btn) btn.disabled = false; });
        }

        function openDetailModal(index) {
            const item = filteredData[index];
            if (!item) return;
            openDetailItem(item, index);
        }

        // เปิดหน้าต่างรายละเอียดจากตัว item โดยตรง (รองรับบิลที่ไม่อยู่ใน filteredData เช่น มุมมองจับคู่)
        function openDetailItem(item, index) {
            if (!item) return;
            currentDetailIndex = (index === undefined || index === null || index < 0) ? -1 : index;
            currentDetailItem = item;

            document.getElementById('modalSupplierTitle').innerText = item.store_name;
            document.getElementById('modalPoNumber').innerText = item.po_number;
            const srnEl = document.getElementById('modalSystemRecordNo');
            if (srnEl) srnEl.innerText = item.running_number || ((item.system_record_no === undefined || item.system_record_no === null || item.system_record_no === '') ? '-' : '#' + String(item.system_record_no).padStart(6, '0'));
            const docLabelEl = document.getElementById('modalDocLabel');
            if (docLabelEl) docLabelEl.innerText = docLabel(item);
            renderDetailAccountingInfo(item.doc_type, item);
            // 🎯 v3.15.1: โชว์/ซ่อนตามประเภทเอกสาร (แถวเลข PO + การ์ดข้อมูลสั่งซื้อ) — ค่าที่มีอยู่แล้วโชว์เสมอ
            const dtKeys = docTypeRelevantFieldKeys(item.doc_type);
            const poBlock = document.getElementById('modalPoRowBlock');
            if (poBlock) poBlock.classList.toggle('hidden', !String(item.po_number || '').trim() || item.po_number === '-');
            // ค่าเอกสารที่มีแต่ไม่มีช่องโชว์ในหน้านี้ (เช่น เล่มที่ล้วน ๆ / เลขอ้างอิงเมื่อมีเลขที่เอกสารแยกอยู่) — แจ้งไว้ไม่ให้หายจากสายตา
            // v3.15.2: ถ้า doc_no เป็นแบบรวม "เล่มที่/เลขที่" แล้ว ถือว่าเล่มที่โชว์แล้วในตัว — ไม่ต้องแจ้งซ้ำ
            const extraNosEl = document.getElementById('modalHiddenDocNos');
            if (extraNosEl) {
                const book = String(item.book_no || '').trim();
                const no = String(item.doc_no || '').trim();
                const tax = String(item.tax_invoice_no || '').trim();
                const ref = String(item.ref_no || '').trim();
                const bookInNo = !!(book && no && no.indexOf(book + '/') === 0);
                const parts = [];
                if (book && !no && !bookInNo) parts.push('เล่มที่ ' + book);
                if (ref && (tax || no)) parts.push(String(item.ref_label || 'เลขอ้างอิง') + ' ' + ref);
                extraNosEl.textContent = parts.length ? ('บันทึกเพิ่ม: ' + parts.join(' · ')) : '';
                extraNosEl.classList.toggle('hidden', !parts.length);
            }
            document.getElementById('modalDate').innerText = fmtDate(item.date);
            // v3.15.5: ป้าย "วันที่รอตรวจ" ในดูบิลเต็ม — โชว์เมื่อวันที่เป็นตัวเติม (ระบบเติมเดือน/ปีปัจจุบันแทน)
            const dateFallbackBadge = document.getElementById('modalDateFallbackBadge');
            if (dateFallbackBadge) dateFallbackBadge.classList.toggle('hidden', !isDateFallbackItem(item));
            document.getElementById('modalCategory').innerText = item.category;
            document.getElementById('modalSource').innerText = item.source === 'group' ? 'กลุ่ม LINE ฝ่ายจัดซื้อ' : 'แชทส่วนตัว';
            // แสดงชื่อผู้ส่งบิลจาก LINE (ดึงผ่าน LINE Profile API ตอนรับรูปใน doPost)
            const senderEl = document.getElementById('modalSender');
            if (senderEl) {
                const senderName = (item.sender_name && item.sender_name !== '-') ? item.sender_name : 'ไม่ทราบชื่อ';
                const senderIdText = item.sender_id ? '\nID: ' + item.sender_id : '';
                senderEl.title = senderName + senderIdText;
                senderEl.innerHTML = '<i class="fa-solid fa-user text-btc-green text-[10px]"></i><span>' + senderName + '</span>';
            }
            const tsText = 'วันที่ในบิล: ' + fmtDate(item.date) + ' | วันที่บันทึกข้อมูล: ' + formatRecordDateTime(item.timestamp)
                + (item.needs_review ? ' | ⚠️ รอตรวจ: ' + (item.review_reason || 'ข้อมูลไม่ครบ') : '');
            const tsEl = document.getElementById('modalTimestamp');
            tsEl.innerText = tsText;
            tsEl.title = tsText; // ข้อความเต็มเมื่อชี้เมาส์ (ปกติถูก truncate กันบีบปุ่ม)

            // แถบข้อมูลใบชั่ง (แสดงเฉพาะเอกสารประเภทใบชั่ง)
            const scaleBox = document.getElementById('modalScaleInfo');
            if (scaleBox) {
                if (item.doc_type === 'ใบชั่ง') {
                    // หน่วย ตัน (ตามหลักการเก็บค่าเดียวกันกับตัวอย่างระบบรับของ)
                    const fmtW = (v) => (v === null || v === undefined || v === '') ? '-' : Number(v).toLocaleString('th-TH', { maximumFractionDigits: 3 }) + ' ตัน';
                    const netText = (item.scale_weight_net === null || item.scale_weight_net === undefined || item.scale_weight_net === '')
                        ? ((item.scale_weight_in !== null && item.scale_weight_in !== undefined && item.scale_weight_in !== '' && item.scale_weight_out !== null && item.scale_weight_out !== undefined && item.scale_weight_out !== '')
                            ? Number(item.scale_weight_in - item.scale_weight_out).toLocaleString('th-TH', { maximumFractionDigits: 3 }) + ' ตัน (คำนวณ)' : '-')
                        : Number(item.scale_weight_net).toLocaleString('th-TH', { maximumFractionDigits: 3 }) + ' ตัน';
                    document.getElementById('modalVehicle').innerText = item.vehicle_registration || '-';
                    document.getElementById('modalWeightIn').innerText = fmtW(item.scale_weight_in);
                    document.getElementById('modalWeightOut').innerText = fmtW(item.scale_weight_out);
                    document.getElementById('modalWeightNet').innerText = netText;
                    scaleBox.classList.remove('hidden');
                } else {
                    scaleBox.classList.add('hidden');
                }
            }

            // แถบข้อมูลสั่งซื้อ/งาน (ชื่อบริษัท/งาน/ผู้เบิก/ผู้สั่งจ่าย) — โชว์เมื่อเป็นใบสั่งซื้อ หรือมีค่าอ่านจากใบจริงอย่างน้อย 1 ช่อง
            const poFieldsBox = document.getElementById('modalPoFields');
            if (poFieldsBox) {
                const fVals = {
                    company_name: (item.company_name || '').trim(),
                    job_name: (item.job_name || '').trim(),
                    requester: (item.requester || '').trim(),
                    pay_approver: (item.pay_approver || '').trim()
                };
                const anyVal = fVals.company_name || fVals.job_name || fVals.requester || fVals.pay_approver;
                if (dtKeys.po || anyVal) {
                    document.getElementById('modalCompanyName').innerText = item.company_name || '-';
                    document.getElementById('modalPoStoreName').innerText = item.store_name || '-';
                    document.getElementById('modalJobName').innerText = item.job_name || '-';
                    document.getElementById('modalRequester').innerText = item.requester || '-';
                    document.getElementById('modalPayApprover').innerText = item.pay_approver || '-';
                    poFieldsBox.classList.remove('hidden');
                } else {
                    poFieldsBox.classList.add('hidden');
                }
            }

            // สรุป "มีเอกสารที่จับคู่มาแล้ว" — โชว์เฉพาะ PO ที่มีลิงก์ (จับคู่แล้ว / รอตรวจสอบ) + ปุ่มไปแถบจับคู่
            const matchSumBox = document.getElementById('modalMatchSummary');
            if (matchSumBox) {
                if (isPOItem(item)) {
                    const pl = (buildLinkIndex().byPo.get(matchingKey(item)) || []);
                    if (pl && pl.length) {
                        const pendingN = pl.filter(function (l) { return l.status === 'pending'; }).length;
                        const confN = pl.length - pendingN;
                        document.getElementById('modalMatchSummaryText').innerHTML =
                            '📎 มีเอกสารที่จับคู่ <b>' + pl.length + '</b> ใบ' +
                            (confN ? ' <span class="ui-badge ui-badge--ok border-emerald-300">จับคู่แล้ว ' + confN + '</span>' : '') +
                            (pendingN ? ' <span class="ui-badge ui-badge--pending border-amber-300">รอตรวจสอบ ' + pendingN + '</span>' : '');
                        matchSumBox.classList.remove('hidden');
                    } else {
                        matchSumBox.classList.add('hidden');
                    }
                } else {
                    matchSumBox.classList.add('hidden');
                }
            }

            // กล่องเทียบน้ำหนัก: บิลส่งของที่มีใบรับของ/ใบชั่งแนบ (จับคู่ด้วย ref_no ↔ doc_no) — ดูส่วนต่างน้ำหนักสินค้า (ตัน)
            const cmpBox = document.getElementById('modalCompareBox');
            if (cmpBox) {
                const attachMap = buildAttachmentMap();
                const key = String(item.id) + '|' + String(item.timestamp || '');
                const attached = attachMap[key] || [];
                if (attached.length) {
                    // น้ำหนักสินค้าตามบิล (total_amount ต่อ kg ไม่มี — ใช้ scale_weight_net ของใบบิลถ้ามี ไม่งั้นคิดจากใบแนบ)
                    const billNet = (item.scale_weight_net !== null && item.scale_weight_net !== undefined && item.scale_weight_net !== '') ? Number(item.scale_weight_net) : null;
                    const receivedNet = attached.reduce((sum, a) => sum + ((a.scale_weight_net !== null && a.scale_weight_net !== undefined && a.scale_weight_net !== '') ? Number(a.scale_weight_net) : 0), 0);
                    const hasReceived = attached.some(a => a.scale_weight_net !== null && a.scale_weight_net !== undefined && a.scale_weight_net !== '');
                    const fmtT = v => (v === null || v === undefined) ? '-' : Number(v).toLocaleString('th-TH', { maximumFractionDigits: 3 }) + ' ตัน';
                    let diffHtml = '<span class="text-slate-400">-</span>';
                    if (billNet !== null && hasReceived) {
                        const diff = receivedNet - billNet;
                        const pct = billNet !== 0 ? (diff / billNet * 100) : 0;
                        const cls = Math.abs(diff) < 0.001 ? 'text-emerald-600' : (diff > 0 ? 'text-amber-600' : 'text-red-600');
                        diffHtml = '<span class="font-bold ' + cls + '">' + (diff >= 0 ? '+' : '') + diff.toLocaleString('th-TH', { maximumFractionDigits: 3 }) + ' ตัน (' + (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%)</span>';
                    }
                    const attachedRows = attached.map(a => '<div class="text-[11px] text-slate-600 flex items-center justify-between gap-2"><span>' + escapeAttr(a.doc_type || 'ใบรับของ') + (a.vehicle_registration ? ' · ' + escapeAttr(a.vehicle_registration) : '') + ' · ' + fmtDate(a.date) + '</span><span class="font-semibold text-slate-800">' + ((a.scale_weight_net !== null && a.scale_weight_net !== undefined && a.scale_weight_net !== '') ? Number(a.scale_weight_net).toLocaleString('th-TH', { maximumFractionDigits: 3 }) + ' ตัน' : '-') + '</span></div>').join('');
                    cmpBox.innerHTML = `
                        <div class="bg-white border border-amber-200 rounded-xl p-4">
                            <div class="flex items-center justify-between gap-2 mb-1">
                                <h5 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2"><i class="fa-solid fa-scale-balanced text-amber-500"></i> เทียบน้ำหนักตอนรับของจริง (${attached.length} ใบแนบ)</h5>
                                <span class="text-[10px] text-slate-400">จับคู่อัตโนมัติจากหมายเหตุ (เลขที่เอกสาร)</span>
                            </div>
                            <div class="space-y-1 mb-2">
                                ${attachedRows}
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-center text-xs">
                                <div class="bg-slate-50 rounded-lg p-2">
                                    <div class="text-[10px] text-slate-400 mt-1">น้ำหนักสินค้าตามบิล</div>
                                    <div class="font-bold text-slate-800">${fmtT(billNet)}</div>
                                </div>
                                <div class="bg-amber-50 rounded-lg p-2">
                                    <div class="text-[10px] text-slate-400 mt-1">ชั่งตอนรับจริง (รวมทุกใบแนบ)</div>
                                    <div class="font-bold text-slate-800">${hasReceived ? fmtT(receivedNet) : '-'}</div>
                                </div>
                                <div class="bg-slate-50 rounded-lg p-2">
                                    <div class="text-[10px] text-slate-400 mt-1">ส่วนต่าง</div>
                                    <div class="mt-1">${diffHtml}</div>
                                </div>
                            </div>
                            ${(!billNet && hasReceived) ? '<div class="text-[10px] text-amber-600 mt-2">บิลนี้ยังไม่มีน้ำหนักสินค้าบันทึกไว้ — เติมช่อง "น้ำหนักสินค้า (ตัน)" ในฟอร์มแก้ไขเพื่อดูส่วนต่าง</div>' : ''}
                        </div>`;
                    cmpBox.classList.remove('hidden');
                } else {
                    cmpBox.classList.add('hidden');
                    cmpBox.innerHTML = '';
                }
            }

            const tableBody = document.getElementById('modalItemsTableBody');
            document.getElementById('modalItemBadge').innerText = `${item.items.length} รายการ`;

            tableBody.innerHTML = item.items.map((sub, i) => `
                <tr class="hover:bg-slate-50 transition">
                    <td class="p-3 text-center text-slate-400 font-mono">${i + 1}</td>
                    <td class="p-3 font-semibold text-slate-800 text-xs">${sub.name}</td>
                    <td class="p-3 text-center font-bold text-slate-900">${sub.quantity}</td>
                    <td class="p-3 text-center"><span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded">${sub.unit}</span></td>
                    <td class="p-3 text-right font-mono text-slate-600">${sub.price_per_unit > 0 ? '฿' + sub.price_per_unit.toLocaleString('th-TH', { minimumFractionDigits: 2 }) : '-'}</td>
                    <td class="p-3 text-right font-bold text-btc-green font-mono">${sub.total > 0 ? '฿' + sub.total.toLocaleString('th-TH', { minimumFractionDigits: 2 }) : '-'}</td>
                </tr>
            `).join('');

            const formattedTotal = '฿' + item.total_amount.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('modalTotalAmountTable').innerText = formattedTotal;

            const imgEl = document.getElementById('modalImage');
            // v3.15.7: ใช้ URL สดที่สุด — เทียบ image_url กับ image_original_url (และแถวเดียวกันใน allData ที่อาจถูก emApplySavedImage อัปเดต v= ใหม่กว่า)
            //     กัน "ดูบิลเต็มโชว์ภาพเก่า" ขณะแผงแก้ไขโหลดสดจากไฟล์จริงเห็นภาพใหม่ = สองจุดไม่ตรงกัน
            const rowSameFile = allData.find(function (y) { return y && y.id === item.id && y !== item; });
            const freshUrl = freshestImageUrl(freshestImageUrl(item.image_url, item.image_original_url), rowSameFile ? (rowSameFile.image_url || rowSameFile.image_original_url) : '');
            if (freshUrl !== item.image_url) { item.image_url = freshUrl; item.image_original_url = freshestImageUrl(item.image_original_url, freshUrl); }
            imgEl.src = item.image_url || imgPlaceholderSmall();
            imgEl.onload = function () { if (detailImageZoom) detailImageZoom.fitNow(); };
            imgEl.onerror = function () { fallbackImg(imgEl); };
            document.getElementById('modalImageExternal').href = item.image_original_url || item.image_url;

            // แท็บในหน้าดูบิลเต็ม: ข้อมูล (หลัก) / จับคู่ (เฉพาะใบสั่งซื้อ) — ปัดค่าให้กลับไปแท็บข้อมูลเสมอ
            const isPo = isPOItem(item);
            const matchBtn = document.getElementById('detailTabMatch');
            // โชว์แท็บจับคู่ทุกใบ: PO = เลือกบิลมาจับคู่ / บิลทั่วไป = ดูว่าถูกจับคู่กับ PO ใดแล้ว (ก่อนหน้านี้ซ่อนทั้งแท็บทำบิลทั่วไปเห็นว่าง)
            if (matchBtn) {
                matchBtn.classList.remove('hidden');
                matchBtn.textContent = isPo ? 'จับคู่' : (isDeliveryLike(item) ? 'จับคู่ใบชั่ง' : 'จับคู่');
            }
            const hintEl = document.getElementById('matchTabHint');
            if (hintEl) {
                hintEl.classList.remove('hidden');
                hintEl.textContent = isPo ? 'จับบิลรับของมารับของตามใบสั่งซื้อนี้' : (isDeliveryLike(item) ? 'จับคู่ใบชั่ง/ใบรับของกับใบส่งของนี้ (โซ่ขั้น 3) + ดูสถานะที่จับกับ PO' : 'ดูสถานะการจับคู่ของบิลนี้');
            }
            showDetailTab('info');

            document.getElementById('detailModal').classList.remove('hidden');
        }

        // === จับคู่บิลตามใบสั่งซื้อ: แผงเลือกบิลรับของ + สถานะ รอตรวจสอบ / จับคู่แล้ว ===
        function showDetailTab(tab) {
            detailTab = tab;
            const activeCls = 'ui-tab is-active';
            const idleCls = 'ui-tab';
            const btnInfo = document.getElementById('detailTabInfo');
            const btnMatch = document.getElementById('detailTabMatch');
            const dataPanel = document.getElementById('modalTabData');
            const matchPanel = document.getElementById('modalTabMatch');
            if (btnInfo) btnInfo.className = tab === 'info' ? activeCls : idleCls;
            if (btnMatch) btnMatch.className = tab === 'match' ? activeCls : idleCls;
            if (dataPanel) dataPanel.classList.toggle('hidden', tab !== 'info');
            if (matchPanel) matchPanel.classList.toggle('hidden', tab !== 'match');
            if (tab === 'match' && matchPanel) {
                // สำคัญ: ต้องเขียนโหลดลง matchPanelContent (ลูกของ matchPanel) — ห้ามเขียนทับ
                // matchPanel.innerHTML เพราะจะลบ element #matchPanelContent ทิ้ง → แผงว่าง/ค้างเงียบ
                // หลักการ: ทุกกรณีต้องแสดงข้อความอธิบายเสมอ ห้ามว่างเปล่าเงียบ ๆ (บั๊กแผงจับคู่ไม่แสดงรายการ)
                const contentEl = document.getElementById('matchPanelContent');
                if (!currentDetailItem) {
                    if (contentEl) contentEl.innerHTML = '<div class="text-xs text-slate-500 text-center py-6">ไม่พบข้อมูลบิลที่เปิดอยู่ — ปิดหน้าต่างแล้วกด "ดูบิลเต็ม" ใหม่อีกครั้ง</div>';
                    return;
                }
                if (contentEl) contentEl.innerHTML = '<div class="text-xs text-slate-400 text-center py-6">กำลังโหลดรายการบิล...</div>';
                try {
                    if (isPOItem(currentDetailItem)) renderMatchPanel(currentDetailItem);
                    else if (isDeliveryLike(currentDetailItem)) renderScaleMatchPanel(currentDetailItem);
                    else renderMatchStatusForBill(currentDetailItem);
                } catch (renderErr) {
                    if (contentEl) contentEl.innerHTML = '<div class="bg-red-50 border border-red-200 rounded-xl p-3 text-xs text-red-700"><b>แสดงแผงจับคู่ไม่สำเร็จ</b> — คัดลอกข้อความนี้ส่งให้ผู้ดูแลระบบ: ' + escapeHtml(String(renderErr && renderErr.message ? renderErr.message : renderErr)) + '</div>';
                }
            }
        }

        function openMatchedDetail(docKey) {
            const item = allData.find(function (it) { return matchingKey(it) === String(docKey || ''); });
            if (!item) { showToast('ไม่พบข้อมูลบิลในระบบ (อาจถูกลบไปแล้ว)', 'error'); return; }
            const idx = filteredData.indexOf(item);
            openDetailItem(item, idx);
        }

        function renderMatchPanel(poItem) {
            const content = document.getElementById('matchPanelContent');
            if (!content) return;
            const po = poItem;
            const poKey = matchingKey(po);
            const idx = buildLinkIndex();
            const existingLinks = idx.byPo.get(poKey) || [];
            const poDocNo = String(po.doc_no || po.po_number || '').trim();
            const poNumber = String(po.po_number || '').trim();

            const candidatePool = allData.filter(function (it) {
                if (!it || isPOItem(it)) return false;
                return !existingLinks.some(function (lk) { return lk.link_doc_key === matchingKey(it); });
            });
            const storeList = [];
            candidatePool.forEach(function (c) {
                const s = String(c.store_name || '').trim();
                if (s && storeList.indexOf(s) === -1) storeList.push(s);
            });
            if (String(po.store_name || '').trim() && storeList.indexOf(po.store_name) === -1) storeList.unshift(String(po.store_name || ''));
            if (matchSupplierFilter && storeList.indexOf(matchSupplierFilter) === -1) storeList.unshift(matchSupplierFilter);

            const candidates = matchSupplierFilter
                ? candidatePool.filter(function (c) {
                    const okS = String(c.store_name || '').trim() === matchSupplierFilter;
                    return okS && !isScaleLike(c);
                  })
                : candidatePool.filter(function (c) { return !isScaleLike(c); });

            const scoreOf = function (c) {
                const linkedElsewhere = idx.byLink.has(matchingKey(c));
                const strong = !linkedElsewhere && (
                    (c.ref_no && poDocNo && normDocNum(c.ref_no) === normDocNum(poDocNo)) ||
                    (c.ref_no && poNumber && normDocNum(c.ref_no) === normDocNum(poNumber)) ||
                    (c.po_number && poDocNo && normDocNum(c.po_number) === normDocNum(poDocNo)) ||
                    (c.po_number && poNumber && normDocNum(c.po_number) === normDocNum(poNumber)) ||
                    (c.doc_no && poDocNo && normDocNum(c.doc_no) === normDocNum(poDocNo)) ||
                    (c.doc_no && poNumber && normDocNum(c.doc_no) === normDocNum(poNumber))
                );
                const medium = !linkedElsewhere && !strong &&
                    String(c.store_name || '').trim() === String(po.store_name || '').trim() &&
                    c.date === po.date;
                return { c: c, strong: strong, medium: medium, linkedElsewhere: linkedElsewhere };
            };
            const filtered = candidates.map(scoreOf).sort(function (a, b) {
                return (b.strong ? 1 : 0) - (a.strong ? 1 : 0) || (b.medium ? 1 : 0) - (a.medium ? 1 : 0) || (a.linkedElsewhere ? 1 : 0) - (b.linkedElsewhere ? 1 : 0);
            });
            const strongCount = filtered.filter(function (s) { return s.strong; }).length;
            const noCandidatesAtAll = candidates.length === 0;

            const canSave = canUpsertLinks();
            const rowHtml = filtered.map(function (s) {
                const c = s.c;
                const key = matchingKey(c);
                const linkedElsewhere = s.linkedElsewhere;
                const strong = s.strong;
                const medium = s.medium;
                const cbId = 'matchCb-' + String(key).replace(/[^A-Za-z0-9_-]/g, '_');
                const thumb = c.image_url
                    ? '<img src="' + c.image_url + '" onerror="fallbackImg(this)" alt="รูปบิล" class="w-10 h-10 rounded-lg object-cover border border-slate-200 bg-slate-50 shrink-0">'
                    : '<div class="w-10 h-10 rounded-lg bg-slate-100 text-slate-400 flex items-center justify-center shrink-0"><i class="fa-regular fa-file-lines text-sm"></i></div>';
                return '<label class="flex items-start gap-3 border border-slate-200 rounded-xl p-3 bg-white hover:bg-slate-50 transition cursor-pointer ' + (linkedElsewhere ? 'opacity-50' : '') + '">' +
                    '<div class="pt-0.5 shrink-0">' +
                    '<input type="checkbox" id="' + cbId + '" data-mkey="' + jsStr(key) + '" class="rounded border-slate-400 text-btc-green focus:ring-btc-green" ' + (strong ? 'checked' : '') + (linkedElsewhere || !canSave ? ' disabled' : '') + '>' +
                    '</div>' +
                    thumb +
                    '<div class="flex-1 min-w-0">' +
                    '<div class="flex items-center gap-2 flex-wrap">' +
                    '<span class="text-xs font-semibold text-slate-800">' + escapeAttr(docLabel(c)) + '</span>' +
                    (strong ? '<span class="ui-badge ui-badge--info border-sky-200">แนะนำอัตโนมัติ (เลขอ้างอิงตรงกัน)</span>' : '') +
                    (medium ? '<span class="ui-badge ui-badge--muted border-slate-200">ร้าน/วันตรงกัน</span>' : '') +
                    (linkedElsewhere ? '<span class="ui-badge ui-badge--muted border-slate-200">จับคู่กับใบสั่งซื้ออื่นแล้ว</span>' : '') +
                    '</div>' +
                    '<div class="text-[11px] text-slate-500 mt-0.5 break-words">' + escapeAttr(c.store_name || '-') + ' · ' + fmtDate(c.date) +
                    (c.doc_no ? ' · เลขที่ ' + escapeAttr(c.doc_no) : '') +
                    (c.ref_no ? ' · อ้างอิง ' + escapeAttr(c.ref_no) : '') + '</div>' +
                    '<div class="text-[11px] mt-0.5 text-slate-600">' + escapeAttr(c.doc_type || 'บิล') + ' · <span class="font-bold text-slate-700">฿' + Number(c.total_amount || 0).toLocaleString('th-TH', { minimumFractionDigits: 2 }) + '</span></div>' +
                    '</div>' +
                    '<button type="button" onclick="event.preventDefault(); event.stopPropagation(); openDetailItem(findDataItemByKey(\'' + jsStr(key) + '\'), ' + allData.indexOf(c) + ');" class="shrink-0 px-2.5 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-600 text-[11px] font-semibold rounded-lg transition">ดูบิล</button>' +
                    '</label>';
            }).join('');

            content.innerHTML =
                '<div class="bg-sky-50/70 border border-sky-200 rounded-xl p-3 text-xs text-sky-800">' +
                '<div class="font-semibold mb-1"><i class="fa-solid fa-link mr-1"></i>จับคู่บิลรับของตามใบสั่งซื้อ</div>' +
                '<div class="text-[11px] text-sky-700">PO: <span class="font-mono font-bold">' + escapeAttr(docLabel(po)) + '</span> · ' + escapeAttr(po.store_name || '-') + ' · ' + fmtDate(po.date) + '</div>' +
                '<div class="text-[11px] text-sky-700 mt-0.5">ระบบติ๊กให้อัตโนมัติเมื่อเลขเอกสาร/PO อ้างอิงตรงกัน — ตรวจให้ถูกต้อง แล้วกด "บันทึกการจับคู่" บิลจะขึ้นแท็บ <b>รอตรวจสอบ</b> จนกว่าจะยืนยัน</div>' +
                '</div>' +
                '<div>' +
                '<label class="flex items-center gap-2 text-xs font-semibold text-slate-700 mb-2"><i class="fa-solid fa-store text-btc-green"></i> กรองตามร้านค้า</label>' +
                '<select onchange="matchFilterChanged(this.value)" class="w-full bg-white border border-slate-200 rounded-lg text-sm px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-btc-green">' +
                '<option value="" ' + (!matchSupplierFilter ? 'selected' : '') + '>ทุกร้านค้า</option>' +
                storeList.map(function (s) { return '<option value="' + escapeAttr(s) + '" ' + (s === matchSupplierFilter ? 'selected' : '') + '>' + escapeAttr(s) + '</option>'; }).join('') +
                '</select>' +
                '</div>' +
                '<div class="flex items-center justify-between gap-2">' +
                '<span class="text-[11px] text-slate-500">' + filtered.length + ' บิลที่เลือกได้' + (filtered.length !== candidates.length ? ' (จากทั้งหมด ' + candidates.length + ')' : '') + (strongCount ? ' · <b class="text-sky-700">แนะนำ ' + strongCount + ' รายการ (เรียงบนสุด)</b>' : '') + '</span>' +
                '<span class="text-[11px] text-slate-400">ติ๊กที่ต้องการ → บันทึก = รอตรวจสอบ</span>' +
                '</div>' +
                '<div class="space-y-2">' +
                (rowHtml || (noCandidatesAtAll
                    ? '<div class="text-xs text-slate-400 text-center py-3">ยังไม่มีบิลรับของในระบบที่เลือกได้<br>ตรวจว่าได้กดแท็บ "บิลทั้งหมด" แล้วมีบิลที่ไม่ใช่ใบสั่งซื้อเข้าระบบ</div>'
                    : '<div class="text-xs text-slate-400 text-center py-3">ยังไม่มีบิลของร้านนี้ที่เลือกได้</div>')) +
                '</div>' +
                '<div class="flex items-center gap-2 pt-1">' +
                '<button onclick="saveMatchSelections(\'' + jsStr(poKey) + '\')" ' + (canSave ? '' : 'disabled') +
                ' class="ui-btn ui-btn--primary' + (canSave ? '' : ' ui-btn--disabled') + ' flex items-center gap-1.5">' +
                '<i class="fa-solid fa-link"></i> บันทึกการจับคู่</button>' +
                '<span id="matchSaveStatus" class="text-[11px] text-slate-400"></span>' +
                (canSave ? '' : '<span class="text-[11px] text-slate-400">ต้องตั้งค่า Apps Script URL ก่อน (การตั้งค่า → API)</span>') +
                '</div>' +
                (existingLinks.length ? ('<div class="pt-2 border-t border-slate-100">' +
                    '<div class="text-[11px] font-semibold text-slate-500 mb-2">บิลที่จับคู่ไว้แล้วกับใบสั่งซื้อนี้ (' + existingLinks.length + ')</div>' +
                    '<div class="space-y-2">' + existingLinks.map(function (lk) {
                        const linkedItem = allData.find(function (it) { return matchingKey(it) === lk.link_doc_key; });
                        const pending = lk.status === 'pending';
                        return '<div class="flex items-center gap-2 border border-slate-200 rounded-xl p-2 bg-white ' + (pending ? 'bg-amber-50/40' : 'bg-emerald-50/40') + '">' +
                            '<i class="fa-solid ' + (pending ? 'fa-hourglass-half text-amber-500' : 'fa-circle-check text-emerald-600') + ' shrink-0"></i>' +
                            '<div class="flex-1 min-w-0 text-[11px] text-slate-700">' +
                            '<span class="font-semibold">' + escapeAttr(linkedItem ? docLabel(linkedItem) : (lk.link_label || lk.link_doc_key)) + '</span>' +
                            '<span class="text-slate-400"> · ' + escapeAttr(linkedItem ? (linkedItem.store_name || '-') : (lk.link_store_name || '-')) + ' · ' + (linkedItem ? fmtDate(linkedItem.date) : '-') + '</span>' +
                            '</div>' +
                            '<span class="ui-badge ' + (pending ? 'ui-badge--pending' : 'ui-badge--ok') + '">' + (pending ? 'รอตรวจสอบ' : 'จับคู่แล้ว') + '</span>' +
                                matchTypeChip(lk) +
                                (pending ? '<button onclick="confirmLink(\'' + jsStr(lk.po_doc_key) + '\',\'' + jsStr(lk.link_doc_key) + '\',this)" class="ui-btn ui-btn--sm ui-btn--primary">ยืนยัน</button>' : '') +
                            '<button onclick="removeLink(\'' + jsStr(lk.po_doc_key) + '\',\'' + jsStr(lk.link_doc_key) + '\',this)" class="px-2.5 py-1.5 bg-white hover:bg-red-50 border border-slate-200 text-red-500 text-[11px] font-semibold rounded-lg transition">ลบ</button>' +
                            '</div>';
                    }).join('') + '</div></div>') : '');

            if (!filtered.length) updateTabBadges();
        }

        // มุมมองแท็บจับคู่สำหรับบิลทั่วไป (ไม่ใช่ PO): แสดงสถานะว่าบิลนี้ถูกจับคู่กับใบสั่งซื้อใดแล้ว + ปุ่มเปิด PO
        // (เดิมแท็บจับคู่ถูกซ่อนทั้งหมดเมื่อเปิดบิลทั่วไป → ผู้ใช้ไม่เห็นว่าบิลถูกจับคู่แล้วหรือยัง)
        function renderMatchStatusForBill(item) {
            const content = document.getElementById('matchPanelContent');
            if (!content) return;
            const key = matchingKey(item);
            const idx = buildLinkIndex();
            const links = idx.byLink.get(key) || [];
            let html = '<div class="bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-600">' +
                '<div class="font-semibold mb-1"><i class="fa-solid fa-link mr-1 text-btc-green"></i>สถานะการจับคู่ของบิลนี้</div>' +
                '<div class="text-[11px] text-slate-500">' + escapeHtml(docLabel(item)) + ' · ' + escapeHtml(item.store_name || '-') + ' · ' + fmtDate(item.date) + '</div>' +
                '</div>';
            if (!links.length) {
                html += '<div class="text-xs text-slate-500 text-center py-6 border border-dashed border-slate-300 rounded-xl">' +
                    '<i class="fa-regular fa-circle-question mr-1"></i>บิลนี้ยังไม่ถูกจับคู่กับใบสั่งซื้อใด<br>' +
                    '<span class="text-[11px]">การจับคู่ทำจากฝั่งใบสั่งซื้อ — เปิดใบสั่งซื้อที่เกี่ยวข้องแล้วกดแท็บ "จับคู่" เพื่อเลือกบิลนี้' +
                    (item.po_number && item.po_number !== '-' ? '<br>บิลนี้ระบุ PO: <b class="font-mono text-slate-700">' + escapeHtml(item.po_number) + '</b>' : '') +
                    '</span></div>';
            } else {
                html += '<div class="space-y-2">' + links.map(function (lk) {
                    const poItem = findDataItemByKey(lk.po_doc_key);
                    const pending = lk.status === 'pending';
                    return '<div class="flex items-center gap-2 border border-slate-200 rounded-xl p-3 bg-white">' +
                        '<i class="fa-solid ' + (pending ? 'fa-hourglass-half text-amber-500' : 'fa-circle-check text-emerald-600') + '"></i>' +
                        '<div class="flex-1 min-w-0 text-xs text-slate-700">' +
                        '<div class="font-semibold">' + escapeHtml(poItem ? docLabel(poItem) : (lk.po_label || lk.po_doc_key)) + '</div>' +
                        '<div class="text-[11px] text-slate-500">' + escapeHtml((poItem && poItem.store_name) || lk.po_store_name || '-') + (poItem ? ' · ' + fmtDate(poItem.date) : '') + '</div>' +
                        '</div>' +
                        '<span class="ui-badge ' + (pending ? 'ui-badge--pending' : 'ui-badge--ok') + '">' + (pending ? 'รอตรวจสอบ' : 'จับคู่แล้ว') + '</span>' +
                        (poItem ? '<button type="button" onclick="openDetailItem(findDataItemByKey(\'' + jsStr(lk.po_doc_key) + '\'), ' + allData.indexOf(poItem) + ');" class="px-2.5 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-600 text-[11px] font-semibold rounded-lg transition">เปิดใบสั่งซื้อ</button>' : '') +
                        '</div>';
                }).join('') + '</div>';
            }
            content.innerHTML = html;
        }

        // === แผงจับคู่ "ใบชั่ง" กับใบส่งของ (โซ่ขั้น 3): ใบส่งของ/ใบรับของ = ตัวเชื่อมระหว่าง PO กับใบชั่ง ===
        // หัวใจ: ใบชั่ง (scale-like) ห้ามจับติด PO ตรง — แผงนี้เปิดจากแท็บ "จับคู่ใบชั่ง" ของใบส่งของ
        function renderScaleMatchPanel(item) {
            const content = document.getElementById('matchPanelContent');
            if (!content) return;
            const key = matchingKey(item);
            const idx = buildLinkIndex();
            const existingSlips = idx.byPo.get(key) || [];
            const poLinks = idx.byLink.get(key) || []; // ใบส่งของนี้ติดกับ PO ตัวไหน (ขั้น 2)
            const poLink = poLinks[0] || null;
            const poItem = poLink ? findDataItemByKey(poLink.po_doc_key) : null;

            // ใบชั่งที่พร้อมจับ: scale-like ที่ยังไม่ได้จับกับใบส่งของใบอื่น และไม่ใช่ตัวเราเอง
            const candidatePool = allData.filter(function (it) {
                if (!it || !isScaleLike(it)) return false;
                if (matchingKey(it) === key) return false;
                const used = idx.byLink.get(matchingKey(it)) || [];
                const usedByOtherDelivery = used.some(function (u) { return u.po_doc_key !== key; });
                return !usedByOtherDelivery;
            });

            const scoreOf = function (c) {
                const alreadyHere = existingSlips.some(function (l) { return l.link_doc_key === matchingKey(c); });
                const docNo = String(item.doc_no || '').trim();
                const strong = !alreadyHere && docNo !== '' && c.ref_no && normDocNum(c.ref_no) === normDocNum(docNo);
                const vehicleOk = !!(c.vehicle_registration && item.vehicle_registration &&
                    normDocNum(c.vehicle_registration) === normDocNum(item.vehicle_registration));
                const medium = !strong && !alreadyHere && !vehicleOk &&
                    String(c.store_name || '').trim() === String(item.store_name || '').trim();
                return { c: c, strong: strong, medium: medium, vehicleOk: vehicleOk, alreadyHere: alreadyHere };
            };
            const filtered = candidatePool.map(scoreOf)
                .sort(function (a, b) {
                    return (b.strong ? 1 : 0) - (a.strong ? 1 : 0) || (b.vehicleOk ? 1 : 0) - (a.vehicleOk ? 1 : 0) || (b.medium ? 1 : 0) - (a.medium ? 1 : 0);
                });

            const canSave = canUpsertLinks();
            const rowHtml = filtered.map(function (s) {
                const c = s.c;
                const ck = matchingKey(c);
                const cbId = 'scaleCb-' + String(ck).replace(/[^A-Za-z0-9_-]/g, '_');
                const thumb = c.image_url
                    ? '<img src="' + c.image_url + '" onerror="fallbackImg(this)" alt="รูปใบชั่ง" class="w-10 h-10 rounded-lg object-cover border border-slate-200 bg-slate-50 shrink-0">'
                    : '<div class="w-10 h-10 rounded-lg bg-slate-100 text-slate-400 flex items-center justify-center shrink-0"><i class="fa-regular fa-file-lines text-sm"></i></div>';
                const weightText = (c.scale_weight_net !== null && c.scale_weight_net !== undefined && c.scale_weight_net !== '')
                    ? 'น้ำหนักชั่ง ' + Number(c.scale_weight_net).toLocaleString('th-TH', { maximumFractionDigits: 3 }) + ' ตัน' : '';
                return '<label class="flex items-start gap-3 border border-slate-200 rounded-xl p-3 bg-white hover:bg-slate-50 transition cursor-pointer ' + (s.alreadyHere ? 'opacity-50' : '') + '">' +
                    '<div class="pt-0.5 shrink-0">' +
                    '<input type="checkbox" id="' + cbId + '" data-mkey="' + jsStr(ck) + '" class="rounded border-slate-400 text-btc-green focus:ring-btc-green" ' + (s.strong ? 'checked' : '') + (s.alreadyHere || !canSave ? ' disabled' : '') + '>' +
                    '</div>' +
                    thumb +
                    '<div class="flex-1 min-w-0">' +
                    '<div class="flex items-center gap-2 flex-wrap">' +
                    '<span class="text-xs font-semibold text-slate-800">' + escapeAttr(docLabel(c)) + '</span>' +
                    (s.strong ? '<span class="ui-badge ui-badge--info border-sky-200">แนะนำอัตโนมัติ (เลขอ้างอิงตรงกัน)</span>' : '') +
                    (s.vehicleOk ? '<span class="text-[10px] bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded-full border border-indigo-200 font-semibold">ทะเบียนรถตรงกัน</span>' : '') +
                    (s.medium ? '<span class="ui-badge ui-badge--muted border-slate-200">ร้านเดียวกัน</span>' : '') +
                    (s.alreadyHere ? '<span class="ui-badge ui-badge--ok border-emerald-200">จับกับใบส่งของนี้แล้ว</span>' : '') +
                    '</div>' +
                    '<div class="text-[11px] text-slate-500 mt-0.5 break-words">' + escapeAttr(c.store_name || '-') + ' · ' + fmtDate(c.date) +
                    (c.doc_no ? ' · เลขที่ ' + escapeAttr(c.doc_no) : '') +
                    (c.ref_no ? ' · อ้างอิง ' + escapeAttr(c.ref_no) : '') +
                    (c.vehicle_registration ? ' · ทะเบียน ' + escapeAttr(c.vehicle_registration) : '') +
                    (weightText ? ' · ' + weightText : '') + '</div>' +
                    '</div>' +
                    '<button type="button" onclick="event.preventDefault(); event.stopPropagation(); openDetailItem(findDataItemByKey(\'' + jsStr(ck) + '\'), ' + allData.indexOf(c) + ');" class="shrink-0 px-2.5 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-600 text-[11px] font-semibold rounded-lg transition">ดูบิล</button>' +
                    '</label>';
            }).join('');

            // ใบชั่งที่จับกับใบส่งของนี้แล้ว (สถานะ รอตรวจสอบ / จับคู่แล้ว)
            const existingHtml = existingSlips.map(function (lk) {
                const slip = findDataItemByKey(lk.link_doc_key);
                const pending = lk.status === 'pending';
                return '<div class="flex items-center gap-2 border border-slate-200 rounded-xl p-2 bg-white ' + (pending ? 'bg-amber-50/40' : 'bg-emerald-50/40') + '">' +
                    '<i class="fa-solid ' + (pending ? 'fa-hourglass-half text-amber-500' : 'fa-circle-check text-emerald-600') + ' shrink-0"></i>' +
                    '<div class="flex-1 min-w-0 text-[11px] text-slate-700">' +
                    '<span class="font-semibold">' + escapeAttr(slip ? docLabel(slip) : (lk.link_label || lk.link_doc_key)) + '</span>' +
                    '<span class="text-slate-400"> · ' + escapeAttr(slip ? (slip.store_name || '-') : (lk.link_store_name || '-')) + ' · ' + (slip ? fmtDate(slip.date) : '-') + '</span>' +
                    '</div>' +
                    '<span class="ui-badge ' + (pending ? 'ui-badge--pending' : 'ui-badge--ok') + '">' + (pending ? 'รอตรวจสอบ' : 'จับคู่แล้ว') + '</span>' +
                    matchTypeChip(lk) +
                    (pending ? '<button onclick="confirmLink(\'' + jsStr(lk.po_doc_key) + '\',\'' + jsStr(lk.link_doc_key) + '\',this)" class="ui-btn ui-btn--sm ui-btn--primary">ยืนยัน</button>' : '') +
                    '<button onclick="removeLink(\'' + jsStr(lk.po_doc_key) + '\',\'' + jsStr(lk.link_doc_key) + '\',this)" class="px-2.5 py-1.5 bg-white hover:bg-red-50 border border-slate-200 text-red-500 text-[11px] font-semibold rounded-lg transition">ลบ</button>' +
                    '</div>';
            }).join('');

            const poChip = poLink
                ? '<div class="text-[11px] text-emerald-700"><i class="fa-solid fa-circle-check mr-1"></i>ใบส่งของนี้ถูกจับคู่กับใบสั่งซื้อแล้ว: ' +
                    '<span class="font-mono font-bold">' + escapeAttr(poItem ? docLabel(poItem) : (poLink.po_label || poLink.po_doc_key)) + '</span>' +
                    (poItem ? ' (' + escapeAttr(poItem.store_name || '-') + ' · ' + fmtDate(poItem.date) + ')' : '') +
                    (poItem ? ' <button type="button" onclick="openDetailItem(findDataItemByKey(\'' + jsStr(poLink.po_doc_key) + '\'), ' + allData.indexOf(poItem) + ');" class="ml-1 px-2 py-1 bg-white hover:bg-emerald-50 border border-emerald-200 text-emerald-700 text-[10px] font-semibold rounded-lg transition">เปิดใบสั่งซื้อ</button>' : '') +
                    '</div>'
                : '<div class="text-[11px] text-slate-400"><i class="fa-regular fa-circle-question mr-1"></i>ใบส่งของนี้ยังไม่ถูกจับกับใบสั่งซื้อ — จับใบชั่งมาได้ก่อน แล้วค่อยจับใบส่งของกับ PO (ขอแนะนำ: เปิดแท็บ "จับคู่" จากฝั่งใบสั่งซื้อเพื่อจับทั้งโซ่)</div>';

            content.innerHTML =
                '<div class="bg-sky-50/70 border border-sky-200 rounded-xl p-3 text-xs text-sky-800">' +
                '<div class="font-semibold mb-1"><i class="fa-solid fa-scale-balanced mr-1"></i>จับคู่ใบชั่ง/ใบรับของกับใบส่งของนี้ (โซ่ขั้น 3)</div>' +
                '<div class="text-[11px] text-sky-700">ใบส่งของ: <span class="font-mono font-bold">' + escapeAttr(docLabel(item)) + '</span> · ' + escapeAttr(item.store_name || '-') + ' · ' + fmtDate(item.date) + '</div>' +
                '<div class="text-[11px] text-sky-700 mt-0.5">ใบชั่งจะถูกเก็บบันทึกเป็น <b>ขั้น 3</b> ของโซ่ PO → ใบส่งของ → ใบชั่ง (ห้ามจับใบชั่งติด PO ตรง) — ระบบติ๊กให้อัตโนมัติเมื่อเลขอ้างอิง/ทะเบียนรถตรงกัน</div>' +
                poChip +
                '</div>' +
                '<div class="text-[11px] text-slate-500">' + filtered.length + ' ใบชั่งที่เลือกได้ (จากทั้งหมด ' + candidatePool.length + ')' +
                (filtered.some(function (s) { return s.strong; }) ? ' · <b class="text-sky-700">แนะนำอัตโนมัติ (เรียงบนสุด)</b>' : '') +
                '</div>' +
                '<div class="space-y-2">' +
                (rowHtml || '<div class="text-xs text-slate-400 text-center py-3">ยังไม่มีใบชั่งในระบบที่เลือกได้<br><span class="text-[11px]">ใบชั่งต้องถูกอ่านเข้าระบบก่อน (แท็บ "บิลทั้งหมด") จึงจะมาปรากฏที่นี่</span></div>') +
                '</div>' +
                '<div class="flex items-center gap-2 pt-1">' +
                '<button onclick="saveScaleMatchSelections(\'' + jsStr(key) + '\')" ' + (canSave ? '' : 'disabled') +
                ' class="ui-btn ui-btn--primary' + (canSave ? '' : ' ui-btn--disabled') + ' flex items-center gap-1.5">' +
                '<i class="fa-solid fa-scale-balanced"></i> บันทึกจับคู่ใบชั่ง</button>' +
                '<span id="scaleSaveStatus" class="text-[11px] text-slate-400"></span>' +
                (canSave ? '' : '<span class="text-[11px] text-slate-400">ต้องตั้งค่า Apps Script URL ก่อน (การตั้งค่า → API)</span>') +
                '</div>' +
                (existingSlips.length ? ('<div class="pt-2 border-t border-slate-100">' +
                    '<div class="text-[11px] font-semibold text-slate-500 mb-2">ใบชั่งที่จับกับใบส่งของนี้แล้ว (' + existingSlips.length + ')</div>' +
                    '<div class="space-y-2">' + existingHtml + '</div></div>') : '');
        }

        // บันทึกการจับ (ใบชั่ง ↔ ใบส่งของ) — เขียน po_doc_key = ใบส่งของ / link_doc_key = ใบชั่ง (โมเดลโซ่ 3 ขั้น)
        function saveScaleMatchSelections(deliveryKey) {
            if (!canUpsertLinks()) { showToast('ต้องตั้งค่า Google Apps Script URL ก่อน (การตั้งค่า → API)', 'error'); openApiModal(); return; }
            if (linkSaving) { showToast('กำลังบันทึกอยู่...', 'info'); return; }
            const delivery = allData.find(function (it) { return matchingKey(it) === deliveryKey; });
            if (!delivery) return;
            const chosen = [];
            const content = document.getElementById('matchPanelContent');
            if (content) content.querySelectorAll('input[type=checkbox]:checked').forEach(function (el) {
                if (el.id && el.id.indexOf('scaleCb-') === 0) {
                    const k = el.getAttribute('data-mkey');
                    if (k) chosen.push(k);
                }
            });
            if (!chosen.length) { showToast('ยังไม่ได้เลือกใบชั่งใบใด', 'error'); return; }
            const statusEl = document.getElementById('scaleSaveStatus');
            linkSaving = true;
            if (statusEl) statusEl.textContent = 'กำลังบันทึก ' + chosen.length + ' รายการ...';
            const makePayload = function (cKey) {
                const c = allData.find(function (it) { return matchingKey(it) === cKey; });
                return {
                    po_doc_key: deliveryKey,
                    po_label: docLabel(delivery),
                    po_store_name: delivery.store_name || '',
                    link_doc_key: cKey,
                    link_label: c ? docLabel(c) : '',
                    link_store_name: c ? (c.store_name || '') : '',
                    link_type: c ? (c.doc_type || '') : '',
                    google_drive_file_id: c ? (c.google_drive_file_id || '') : '',
                    link_scale_net: c ? ((c.scale_weight_net === null || c.scale_weight_net === undefined) ? '' : c.scale_weight_net) : '',
                    link_vehicle: c ? (c.vehicle_registration || '') : ''
                };
            };
            Promise.all(chosen.map(function (cKey) { return scriptCall('upsertReceiptLink', makePayload(cKey)); }))
                .then(function (resList) {
                    const failed = resList.filter(function (r) { return !r || r.success === false; });
                    if (failed.length) throw new Error((failed[0] && failed[0].message) || 'บันทึกไม่สำเร็จบางรายการ');
                    if (statusEl) statusEl.textContent = '';
                    return loadReceiptLinks(true);
                })
                .then(function () {
                    applyFilters();
                    rerenderCurrentMatchPanel();
                    showToast('จับคู่ใบชั่งแล้ว (สถานะ รอตรวจสอบ)');
                })
                .catch(function (err) { handleLinkError(err); })
                .finally(function () { linkSaving = false; });
        }

        // วาดโซ่ขั้น 3 (ใบชั่งที่จับกับใบส่งของ) ในมุมมองกลุ่ม — วาดใต้แถวใบส่งของที่จับกับ PO แล้ว
        function renderScaleChainRows(deliveryItem, idx) {
            if (!deliveryItem) return '';
            const key = matchingKey(deliveryItem);
            const slips = idx.byPo.get(key) || [];
            if (!slips.length) return '';
            const rows = slips.map(function (lk) {
                const st = findDataItemByKey(lk.link_doc_key);
                const pending = lk.status === 'pending';
                const title = st ? escapeAttr(docLabel(st)) : escapeAttr(lk.link_label || lk.link_doc_key);
                const thumb = st && st.image_url
                    ? '<img src="' + st.image_url + '" onerror="fallbackImg(this)" alt="รูปใบชั่ง" class="w-8 h-8 rounded-lg object-cover border border-slate-200 bg-slate-50 shrink-0">'
                    : '<div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-400 flex items-center justify-center shrink-0"><i class="fa-regular fa-file-lines text-[11px]"></i></div>';
                const meta = [fmtDate(st ? st.date : '-')];
                if (lk.link_vehicle || (st && st.vehicle_registration)) meta.push('ทะเบียน ' + escapeAttr(lk.link_vehicle || st.vehicle_registration));
                if (lk.link_scale_net !== null && lk.link_scale_net !== undefined && lk.link_scale_net !== '') meta.push('น้ำหนักชั่ง ' + Number(lk.link_scale_net).toLocaleString('th-TH', { maximumFractionDigits: 3 }) + ' ตัน');
                const btnOpen = st ? '<button onclick="openMatchedDetail(\'' + jsStr(matchingKey(st)) + '\')" class="px-2 py-1 bg-white hover:bg-slate-50 border border-slate-200 text-slate-600 text-[10px] font-semibold rounded-lg transition">ดูบิล</button>' : '';
                const btnConfirm = pending ? '<button onclick="confirmLink(\'' + jsStr(lk.po_doc_key) + '\',\'' + jsStr(lk.link_doc_key) + '\',this)" class="ui-btn ui-btn--sm ui-btn--primary">ยืนยัน</button>' : '';
                const btnRemove = '<button onclick="removeLink(\'' + jsStr(lk.po_doc_key) + '\',\'' + jsStr(lk.link_doc_key) + '\',this)" class="px-2 py-1 bg-white hover:bg-red-50 border border-slate-200 text-red-500 text-[10px] font-semibold rounded-lg transition">ลบ</button>';
                return '<div class="flex flex-wrap items-center gap-2.5 border border-slate-200 rounded-lg p-2 bg-white ' + (pending ? 'bg-amber-50/50' : 'bg-emerald-50/50') + '">' +
                    thumb +
                    '<div class="flex-1 min-w-0">' +
                    '<div class="flex items-center gap-1.5 flex-wrap">' +
                    '<span class="text-[11px] font-semibold text-slate-700">' + title + '</span>' +
                    '<span class="ui-badge ' + (pending ? 'ui-badge--pending' : 'ui-badge--ok') + '">' + (pending ? 'รอตรวจสอบ' : 'จับคู่แล้ว') + '</span>' +
                    matchTypeChip(lk) +
                    '</div>' +
                    '<div class="text-[10px] text-slate-500 mt-0.5">' + meta.join(' · ') + '</div>' +
                    '</div>' +
                    '<div class="flex items-center gap-1 shrink-0">' + btnOpen + btnConfirm + btnRemove + '</div>' +
                    '</div>';
            }).join('');
            return '<div class="ml-9 sm:ml-12 mt-1.5 pl-3 border-l-2 border-dashed border-emerald-300 space-y-1.5 pb-0.5">' +
                '<div class="text-[10px] uppercase tracking-wide text-emerald-600 font-semibold"><i class="fa-solid fa-scale-balanced mr-1"></i>ขั้น 3 · ใบชั่ง/ใบรับของที่จับกับใบส่งของนี้ (' + slips.length + ')</div>' +
                rows +
                '</div>';
        }

        // วาดแผงจับคู่ปัจจุบันใหม่ (รองรับทั้ง PO / ใบส่งของ / บิลทั่วไป) — ใช้หลัง ยืนยัน/ลบ/บันทึก เพื่อไม่ให้แผงค้าง
        function rerenderCurrentMatchPanel() {
            if (!currentDetailItem || detailTab !== 'match') return;
            const contentEl = document.getElementById('matchPanelContent');
            if (!contentEl) return;
            if (isPOItem(currentDetailItem)) renderMatchPanel(currentDetailItem);
            else if (isDeliveryLike(currentDetailItem)) renderScaleMatchPanel(currentDetailItem);
            else renderMatchStatusForBill(currentDetailItem);
        }

        function findDataItemByKey(key) {
            return allData.find(function (it) { return matchingKey(it) === String(key || ''); }) || null;
        }

        function matchFilterChanged(val) {
            matchSupplierFilter = val;
            rerenderCurrentMatchPanel();
        }

        function saveMatchSelections(poKey) {
            if (!canUpsertLinks()) { showToast('ต้องตั้งค่า Google Apps Script URL ก่อน (การตั้งค่า → API)', 'error'); openApiModal(); return; }
            if (linkSaving) { showToast('กำลังบันทึกอยู่...', 'info'); return; }
            const po = allData.find(function (it) { return matchingKey(it) === poKey; });
            if (!po) return;
            const chosen = [];
            const content = document.getElementById('matchPanelContent');
            if (content) content.querySelectorAll('input[type=checkbox]:checked').forEach(function (el) {
                if (el.id && el.id.indexOf('matchCb-') === 0) {
                    const k = el.getAttribute('data-mkey');
                    if (k) chosen.push(k);
                }
            });
            if (!chosen.length) { showToast('ยังไม่ได้เลือกบิลใด\nบันทึก', 'error'); return; }
            const statusEl = document.getElementById('matchSaveStatus');
            linkSaving = true;
            if (statusEl) statusEl.textContent = 'กำลังบันทึก ' + chosen.length + ' รายการ...';
            const makePayload = function (key) {
                const c = allData.find(function (it) { return matchingKey(it) === key; });
                return {
                    po_doc_key: poKey,
                    po_label: docLabel(po),
                    po_store_name: po.store_name || '',
                    link_doc_key: key,
                    link_label: c ? docLabel(c) : '',
                    link_store_name: c ? (c.store_name || '') : '',
                    link_type: c ? (c.doc_type || '') : '',
                    google_drive_file_id: c ? (c.google_drive_file_id || '') : '',
                    link_scale_net: c ? ((c.scale_weight_net === null || c.scale_weight_net === undefined) ? '' : c.scale_weight_net) : '',
                    link_vehicle: c ? (c.vehicle_registration || '') : ''
                };
            };
            Promise.all(chosen.map(function (key) { return scriptCall('upsertReceiptLink', makePayload(key)); }))
                .then(function (resList) {
                    const failed = resList.filter(function (r) { return !r || r.success === false; });
                    if (failed.length) throw new Error((failed[0] && failed[0].message) || 'บันทึกไม่สำเร็จบางรายการ');
                    if (statusEl) statusEl.textContent = '';
                    return loadReceiptLinks(true);
                })
                .then(function () {
                    bumpImageEpoch('match-save'); // v3.15.8: DB เปลี่ยน → รูปทุกรูปโหลดใหม่รอบหน้า
                    applyFilters();
                    rerenderCurrentMatchPanel();
                    showToast('บันทึกการจับคู่แล้ว (สถานะ รอตรวจสอบ)');
                })
                .catch(function (err) { handleLinkError(err); })
                .finally(function () { linkSaving = false; });
        }

        function confirmLink(poKey, linkKey, btn) {
            if (!canUpsertLinks()) { showToast('ต้องตั้งค่า Google Apps Script URL ก่อน (การตั้งค่า → API)', 'error'); openApiModal(); return; }
            if (linkSaving) return;
            linkSaving = true;
            if (btn) { btn.disabled = true; btn.textContent = '...'; }
            scriptCall('setReceiptLinkStatus', { po_doc_key: poKey, link_doc_key: linkKey, status: 'confirmed' })
                .then(function (res) {
                    if (!res || res.success === false) throw new Error((res && res.message) || 'ยืนยันไม่สำเร็จ');
                    return loadReceiptLinks(true);
                })
                .then(function () {
                    applyFilters();
                    rerenderCurrentMatchPanel();
                    showToast('ยืนยันการจับคู่เรียบร้อย');
                })
                .catch(function (err) { handleLinkError(err); })
                .finally(function () { linkSaving = false; });
        }

        function removeLink(poKey, linkKey, btn) {
            if (!canUpsertLinks()) { showToast('ต้องตั้งค่า Google Apps Script URL ก่อน (การตั้งค่า → API)', 'error'); openApiModal(); return; }
            if (linkSaving) return;
            if (!confirm('ลบการจับคู่นี้ (ใบสั่งซื้อ ↔ บิล) ออกจากระบบ? ตัวบิลยังคงอยู่เหมือนเดิม')) return;
            linkSaving = true;
            if (btn) { btn.disabled = true; btn.textContent = '...'; }
            scriptCall('removeReceiptLink', { po_doc_key: poKey, link_doc_key: linkKey })
                .then(function (res) {
                    if (!res || res.success === false) throw new Error((res && res.message) || 'ลบไม่สำเร็จ');
                    return loadReceiptLinks(true);
                })
                .then(function () {
                    applyFilters();
                    rerenderCurrentMatchPanel();
                    showToast('ลบการจับคู่เรียบร้อย');
                })
                .catch(function (err) { handleLinkError(err); })
                .finally(function () { linkSaving = false; });
        }

        function handleLinkError(err) {
            const msg = (err && err.message) ? err.message : String(err);
            if (msg.indexOf('SESSION_EXPIRED') !== -1) { handleSessionExpired('จับคู่บิลใหม่', null); return; }
            showToast('ไม่สำเร็จ: ' + msg, 'error');
        }

        function closeModal() {
            detailTab = 'info';
            currentDetailItem = null;
            document.getElementById('detailModal').classList.add('hidden');
        }

        // === EDIT RECEIPT: แก้ไขข้อมูลบิลที่ AI อ่านไม่ตรง (เขียนทับข้อมูลเดิมในชีต) ===
        function escapeAttr(str) {
            return String(str === null || str === undefined ? '' : str)
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/\r/g, '\\r')
                .replace(/\n/g, '\\n')
                .replace(/\u2028/g, '\\u2028')
                .replace(/\u2029/g, '\\u2029');
        }

        function openEditModal(index) {
            const item = filteredData[index];
            if (!item) return;
            openEditModalItem(item);
        }

        function openEditModalItem(item) {
            if (!item) return;

            editModalItemRef = item; // 🖼️ จำบิลตัวจริงที่กำลังแก้ (ให้ปุ่มแก้ไขรูปหาเจอเสมอ ไม่ว่าเปิดมาจากแท็บ/มุมมองไหน)
            editTarget = { id: item.id, timestamp: item.timestamp, old_po_number: item.po_number, doc_key: item.doc_key || '', system_record_no: item.system_record_no || '', image_url: item.image_original_url || item.image_url || '' }; // doc_key = ตัวตนบิล ส่งให้ backend จับคู่แถวชีตได้แม้ข้อมูลมาจาก Supabase (timestamp คนละรูปแบบ) system_record_no = เลขอ้างอิงยืนยันตัวตนที่แม่นสุด
            editTotalManual = false; // เปิดหน้าต่างใหม่ → ให้ระบบคำนวณยอดรวมจากรายการก่อน
            loadEditSuggestions(); // 💡 โหลดตัวเลือกจากประวัติจริง (ครั้งแรกเดียวแล้วแคช — ไม่บล็อกการเปิดฟอร์ม)

            // รูปบิลอ้างอิงฝั่งซ้ายของหน้าต่างแก้ไข + โหลดเข้าแผงแก้ไขรูปทันที (v3.14.4: แก้รูปได้พร้อมกับฟอร์ม)
            editModalImageUrl = item.image_original_url || item.image_url || '';
            emLoadImageForEdit();

            document.getElementById('editPoInput').value = (item.po_number && item.po_number !== '-') ? item.po_number : '';
            document.getElementById('editStoreInput').value = item.store_name || '';
            document.getElementById('editDateInput').value = (item.date && /^\d{4}-\d{2}-\d{2}$/.test(item.date)) ? item.date : '';

            // ตัวตนบิล: เติมค่าลงฟอร์ม (ประเภทเอกสารเพิ่มตัวเลือกชั่วคราวถ้าไม่มีในรายการ)
            const docTypeSelect = document.getElementById('editDocTypeSelect');
            const hasDocType = Array.from(docTypeSelect.options).some(opt => opt.value === (item.doc_type || ''));
            if (!hasDocType && item.doc_type) {
                const opt = document.createElement('option');
                opt.value = item.doc_type;
                opt.text = item.doc_type;
                // แทรกก่อนตัวเลือก "+ เพิ่มประเภทใหม่…" (กัน option ชั่วคราวไปอยู่ท้ายสุด)
                docTypeSelect.insertBefore(opt, docTypeSelect.querySelector('option[value="__ADD_NEW__"]'));
            }
            docTypeSelect.value = item.doc_type || '';
            if (item.doc_type && docTypeSelect.value !== item.doc_type) {
                // ประเภทเดิมที่ไม่อยู่ในชุดมาตรฐานบัญชี (เช่น อื่นๆ หรือประเภทองค์กรที่โหลดไม่ทัน) — แทรก option ชั่วคราวกันค่าหายตอนบันทึก
                let adhoc = docTypeSelect.querySelector('option[data-adhoc="1"]');
                if (!adhoc) {
                    adhoc = document.createElement('option');
                    adhoc.setAttribute('data-adhoc', '1');
                    docTypeSelect.insertBefore(adhoc, docTypeSelect.querySelector('option[value="__ADD_NEW__"]'));
                }
                adhoc.value = item.doc_type;
                adhoc.text = item.doc_type;
                docTypeSelect.value = item.doc_type;
            }
            updateEditDocTypeTaxHint(docTypeSelect.value);
            // ช่องใบชั่ง (ทะเบียน/น้ำหนัก) — แสดงเฉพาะเมื่อประเภทเอกสารเป็นใบชั่ง
            const isScale = (item.doc_type === 'ใบชั่ง');
            const scaleBox = document.getElementById('editScaleFields');
            if (scaleBox) scaleBox.classList.toggle('hidden', !isScale);
            document.getElementById('editVehicleInput').value = item.vehicle_registration || '';
            document.getElementById('editWeightInInput').value = (item.scale_weight_in === null || item.scale_weight_in === undefined) ? '' : item.scale_weight_in;
            document.getElementById('editWeightOutInput').value = (item.scale_weight_out === null || item.scale_weight_out === undefined) ? '' : item.scale_weight_out;
            document.getElementById('editWeightNetInput').value = (item.scale_weight_net === null || item.scale_weight_net === undefined) ? '' : item.scale_weight_net;
            document.getElementById('editBookInput').value = item.book_no || '';
            document.getElementById('editDocNoInput').value = item.doc_no || '';
            document.getElementById('editTaxInvoiceInput').value = item.tax_invoice_no || '';
            document.getElementById('editRefNoInput').value = item.ref_no || '';
            document.getElementById('editRefLabelInput').value = item.ref_label || '';
            document.getElementById('editCompanyInput').value = item.company_name || '';
            document.getElementById('editJobInput').value = item.job_name || '';
            document.getElementById('editRequesterInput').value = item.requester || '';
            document.getElementById('editPayApproverInput').value = item.pay_approver || '';
            // 🎯 ปรับส่วนโชว์ตามประเภทเอกสาร — เรียกหลังเติมค่าครบทุกช่อง (กฎ: มีค่า = โชว์เสมอ)
            applyEditDocTypeVisibility(docTypeSelect.value);

            // หมวดหมู่: ถ้าค่าที่ AI อ่านมาไม่อยู่ในตัวเลือก ให้เพิ่มเป็นตัวเลือกชั่วคราว
            const catSelect = document.getElementById('editCategorySelect');
            const hasOption = Array.from(catSelect.options).some(opt => opt.value === item.category);
            if (!hasOption && item.category) {
                const opt = document.createElement('option');
                opt.value = item.category;
                opt.text = item.category;
                catSelect.appendChild(opt);
            }
            catSelect.value = item.category || 'ทั่วไป';

            renderEditItemRows(item.items || []);
            document.getElementById('editTotalInput').value = Number(item.total_amount || 0).toFixed(2);

            // ตัวตนบิลในกริดข้อมูลหลัก (เหมือน ดูบิลเต็ม) — เลขที่รายการระบบ / ผู้ส่งบิล / แหล่งที่มา
            const editSrnEl = document.getElementById('editSystemRecordNo');
            if (editSrnEl) editSrnEl.innerText = item.running_number || ((item.system_record_no === undefined || item.system_record_no === null || item.system_record_no === '') ? '-' : '#' + String(item.system_record_no).padStart(6, '0'));
            const editSrcEl = document.getElementById('editSource');
            if (editSrcEl) editSrcEl.innerText = item.source === 'group' ? 'กลุ่ม LINE ฝ่ายจัดซื้อ' : 'แชทส่วนตัว';
            const editSndEl = document.getElementById('editSender');
            if (editSndEl) {
                const sndName = (item.sender_name && item.sender_name !== '-') ? item.sender_name : 'ไม่ทราบชื่อ';
                const sndIdText = item.sender_id ? '\nID: ' + item.sender_id : '';
                editSndEl.title = sndName + sndIdText;
                editSndEl.innerHTML = '<i class="fa-solid fa-user text-btc-green text-[10px]"></i><span>' + sndName + '</span>';
            }

            document.getElementById('editOriginInfo').innerText = 'แก้ไขบิล' + (item.running_number || (item.system_record_no ? ' #' + String(item.system_record_no).padStart(6, '0') : '')) + ': PO ' + (item.po_number || '-') + ' | วันที่ในบิล: ' + fmtDate(item.date) + ' | วันที่บันทึกข้อมูล: ' + (item.timestamp || '-');

            document.getElementById('editModal').classList.remove('hidden');
        }

        function openEditModalFromDetail() {
            const item = currentDetailItem || (currentDetailIndex !== null && currentDetailIndex !== undefined ? filteredData[currentDetailIndex] : null);
            if (!item) return;
            closeModal();            // ปิดหน้าต่างรายละเอียด แล้วเปิดหน้าต่างแก้ไขแทน
            openEditModalItem(item);
        }

        // URL รูปบิลปัจจุบันในหน้าต่างแก้ไข (สำหรับปุ่มขยายรูป)
        let editModalImageUrl = '';
        let editModalItemRef = null; // 🖼️ บิลที่เปิดอยู่ในหน้าต่างแก้ไข (อ้างอิงตรง — ไม่ต้องค้นหา filteredData ซึ่งอาจไม่มีบิลนี้ เช่นเปิดจากมุมมอง 3-Way)

        // ==========================================
// 🔍 ซูมเข้าออกบนรูปโดยตรง (Inline — ไม่เปิดหน้าต่างใหม่) ใช้ร่วมกันทั้ง "ดูบิลเต็ม" และ "แก้ไขข้อมูลบิล"
//   - ล้อเมาส์ซูมเข้าออกล็อคจุดเมาส์บนรูปเดิม · ลากเพื่อเลื่อน (ลากได้เมื่อซูมเข้าแล้ว)
//   - ดับเบิลคลิกหรือกด "พอดีจอ" เพื่อคืนขนาดพอดีกล่อง
//   - ตัวแก้ไข (แก้ไขข้อมูลบิล): ปิดการซูมช่วงเปิดโหมดครอป (วงครอปอ้างพ.ก. display ไม่ใช่ transform)
// ==========================================
        function createInlineImageZoom(stage, el, opts) {
            opts = opts || {};
            const z = { scale: 1, tx: 0, ty: 0, fit: 1, dragging: null, ready: false, baseW: 1, baseH: 1 };

            const baseSize = function () {
                return { w: Math.max(1, el.clientWidth || el.width || 1), h: Math.max(1, el.clientHeight || el.height || 1) };
            };
            const apply = function () {
                if (!z.ready) return;
                el.style.transformOrigin = 'center center';
                el.style.transform = 'translate(' + z.tx + 'px,' + z.ty + 'px) scale(' + z.scale + ')';
                el.style.cursor = z.scale > z.fit * 1.001 ? 'grab' : 'default';
            };
            const fitNow = function () {
                const s = baseSize();
                z.baseW = s.w; z.baseH = s.h;
                const W = stage.clientWidth || 50, H = stage.clientHeight || 50;
                z.fit = Math.max(0.02, Math.min(W / z.baseW, H / z.baseH) * 0.97);
                z.scale = z.fit; z.tx = 0; z.ty = 0;
                z.ready = true;
                apply();
            };
            const zoomAt = function (cx, cy, factor) {
                if (!z.ready) return;
                const r = stage.getBoundingClientRect();
                const ns = Math.min(Math.max(z.scale * factor, z.fit), Math.max(z.fit * 16, 0.02));
                if (ns === z.fit) { z.scale = z.fit; z.tx = 0; z.ty = 0; apply(); return; }
                const wx = (cx - r.left - r.width / 2 - z.tx) / z.scale;
                const wy = (cy - r.top - r.height / 2 - z.ty) / z.scale;
                z.scale = ns;
                z.tx = (cx - r.left) - r.width / 2 - wx * ns;
                z.ty = (cy - r.top) - r.height / 2 - wy * ns;
                apply();
            };
            const busy = function () { return !z.ready || (opts.disabled && opts.disabled()); };

            stage.addEventListener('wheel', function (e) {
                if (busy()) return;
                e.preventDefault();
                zoomAt(e.clientX, e.clientY, e.deltaY < 0 ? 1.18 : 1 / 1.18);
            }, { passive: false });
            stage.addEventListener('mousedown', function (e) {
                if (busy()) return;
                if (z.scale <= z.fit * 1.001) return;
                z.dragging = { mx: e.clientX, my: e.clientY, tx: z.tx, ty: z.ty };
                el.style.cursor = 'grabbing';
                e.preventDefault();
            });
            window.addEventListener('mousemove', function (e) {
                if (!z.dragging) return;
                z.tx = z.dragging.tx + (e.clientX - z.dragging.mx);
                z.ty = z.dragging.ty + (e.clientY - z.dragging.my);
                apply();
            });
            window.addEventListener('mouseup', function () {
                if (!z.dragging) return;
                z.dragging = null;
                apply();
            });
            stage.addEventListener('dblclick', function (e) {
                if (!z.ready) return;
                e.preventDefault();
                fitNow();
            });
            return { fitNow: fitNow, reset: fitNow };
        }

        let detailImageZoom = null;  // ซูมบนรูปใน "ดูบิลเต็ม"
        let emImageZoom = null;      // ซูมบนรูปใน "แก้ไขข้อมูลบิล"

        (function initInlineImageZoom() {
            const dStage = document.getElementById('detailImageStage');
            const dImg = document.getElementById('modalImage');
            if (dStage && dImg) detailImageZoom = createInlineImageZoom(dStage, dImg);
            const eStage = document.getElementById('emImageStage');
            const eCanvas = document.getElementById('editModalCanvas');
            if (eStage && eCanvas) emImageZoom = createInlineImageZoom(eStage, eCanvas, { disabled: function () { return !!emCropMode; } });
        })();

        function detailImageZoomReset() {
            if (detailImageZoom) detailImageZoom.fitNow();
        }

        function emZoomReset() {
            if (emImageZoom) emImageZoom.fitNow();
        }

        // แก้ไขรูปบิลจากหน้าต่างแก้ไขข้อมูล (เปิด Image Editor ด้วยบิลตัวเดียวกับที่กำลังแก้)
        // 🖼️ v3.14.3: ใช้บิลอ้างอิงตรงจากฟอร์มที่เปิดอยู่ก่อน → ถอยไปค้นหาใน allData/filteredData
        //    (เดิมค้นเฉพาะ filteredData → บิลที่เปิดจากมุมมอง 3-Way/แท็บอื่น จะขึ้น "ไม่พบข้อมูลบิลสำหรับแก้ไขรูป")
        function openImageEditorFromEditModal() {
            if (!editTarget) { showToast('ยังไม่ได้เลือกบิลที่จะแก้ไข', 'error'); return; }
            const match = function (x) { return x && x.id === editTarget.id && x.timestamp === editTarget.timestamp; };
            const item = editModalItemRef
                || (Array.isArray(allData) ? allData.find(match) : null)
                || (Array.isArray(filteredData) ? filteredData.find(match) : null);
            if (!item) { showToast('ไม่พบข้อมูลบิลสำหรับแก้ไขรูป', 'error'); return; }
            openImageEditor(item); // เปิดทับหน้าต่างแก้ไข — ฟอร์มที่กรอกค้างไว้ไม่หาย
        }

        // ==========================================
        // 🖼️ v3.14.4: แผงแก้ไขรูปในหน้าต่าง "แก้ไขข้อมูลบิล" (ใช้พร้อมฟอร์มข้อมูล — หมุน/พลิก/ครอป/ความสว่าง/บันทึกทับ)
        //   - ต่างจาก imageEditorModal (ครอป) ตรงที่ทำงานในหน้าต่างนี้เลย ไม่ปิดฟอร์ม ไม่เสียข้อมูลที่กรอก
        //   - v3.14.6: เพิ่มครอปในแผงแก้ไข (emToggleCrop/emApplyCrop + แผ่น emCropOverlay)
        //   - v3.14.7: ซูมเข้าออกบนรูปโดยตรง (inline — ล้อเมาส์+ลาก) ทั้งดูบิลเต็มและฟอร์มแก้ไข ไม่เปิดหน้าต่างใหม่
        //   - v3.14.8: ลบปุ่ม "แก้ไขรูปบิล" จากหน้าต่าง "ดูบิลเต็ม" + เลิกปุ่ม "บันทึกรูป" แยกในแผง
        //               → "บันทึกการแก้ไข" ปุ่มเดียว บันทึกทั้งรูปที่แก้ (emSaveImage ⇒ saveEditedReceiptImage) และข้อมูล (updateReceipt) พร้อมกัน
        //   - บันทึกผ่าน backend เดิม saveEditedReceiptImage (เขียนทับไฟล์ใน Drive) แล้วซิงก์รูปกลับทุกมุมมอง
        // ==========================================
        let emSource = null;   // Image ต้นฉบับของบิลที่เปิดแก้
        let emWork = null;     // canvas ที่ผ่านการหมุน/พลิก (ก่อนใส่ความสว่าง)
        let emBrightness = 0;
        let emDirty = false;   // v3.14.8: มีการแก้รูปค้างไว้ในแผงหรือไม่ (บันทึกการแก้ไขจะรวมส่งรูปไปด้วย)

        function emSetStatus(msg) {
            const el = document.getElementById('emStatus');
            if (el) el.textContent = msg || '';
        }

        // โหลดรูปบิลเข้าแผงแก้ไข (เรียกตอนเปิดหน้าต่างแก้ไข และตอนรูปถูกอัปเดต)
        function emLoadImageForEdit() {
            const canvas = document.getElementById('editModalCanvas');
            const ph = document.getElementById('emPlaceholder');
            if (!canvas) return;
emSource = null; emWork = null; emBrightness = 0;
            emDirty = false;
            emCropMode = false;
            const emOv = document.getElementById('emCropOverlay');
            if (emOv) emOv.classList.add('hidden');
            const emLb = document.getElementById('emCropToggleLabel');
            if (emLb) emLb.textContent = 'ครอป';
            const rng = document.getElementById('emBrightness');
            if (rng) rng.value = 0;
            const item = editModalItemRef;
            const srcUrl = item ? (item.image_original_url || item.image_url) : '';
            if (!srcUrl) {
                canvas.classList.add('hidden');
                if (ph) { ph.classList.remove('hidden'); ph.textContent = 'บิลนี้ไม่มีรูปให้แก้ไข'; }
                emSetStatus('ไม่มีรูป');
                return;
            }
            canvas.classList.add('hidden');
            if (ph) { ph.classList.remove('hidden'); ph.textContent = 'กำลังโหลดรูปบิล...'; }
            emSetStatus('กำลังโหลด...');
            scriptCall('getReceiptImageData', { url: srcUrl })
                .then(function (res) {
                    if (!res || !res.success) {
                        emSetStatus('โหลดไม่สำเร็จ');
                        if (ph) ph.textContent = (res && res.message) || 'โหลดรูปไม่สำเร็จ';
                        return;
                    }
                    const img = new Image();
                    img.onload = function () {
                        emSource = img;
                        emWork = document.createElement('canvas');
                        emWork.width = img.width; emWork.height = img.height;
                        emWork.getContext('2d').drawImage(img, 0, 0);
                        if (ph) ph.classList.add('hidden');
                        canvas.classList.remove('hidden');
                        emDraw();
                        emSetStatus('พร้อมแก้ไข');
                    };
                    img.onerror = function () {
                        emSetStatus('แสดงรูปไม่สำเร็จ');
                        if (ph) ph.textContent = 'แสดงรูปไม่สำเร็จ (ไฟล์อาจเสียหาย)';
                    };
                    img.src = res.data_url;
                })
                .catch(function (err) {
                    if (err && err.message === 'SESSION_EXPIRED') {
                        handleSessionExpired('โหลดรูปบิล', function () { emLoadImageForEdit(); });
                        return;
                    }
                    emSetStatus('โหลดไม่สำเร็จ');
                    if (ph) ph.textContent = 'โหลดรูปไม่สำเร็จ: ' + ((err && err.message) || err);
                });
        }

        function emDraw() {
            const canvas = document.getElementById('editModalCanvas');
            if (!canvas || !emWork) return;
            canvas.width = emWork.width;
            canvas.height = emWork.height;
            const ctx = canvas.getContext('2d');
            ctx.filter = 'brightness(' + (1 + emBrightness / 100) + ')';
            ctx.drawImage(emWork, 0, 0);
            if (emCropMode) emResetCropRect();
            if (emImageZoom) emImageZoom.fitNow();
        }

        function emRotate(dir) {
            if (!emWork) { showToast('ยังไม่มีรูปให้หมุน', 'error'); return; }
            const src = emWork;
            const nc = document.createElement('canvas');
            nc.width = src.height; nc.height = src.width;
            const c = nc.getContext('2d');
            c.translate(nc.width / 2, nc.height / 2);
            c.rotate(dir === 'left' ? -Math.PI / 2 : Math.PI / 2);
            c.drawImage(src, -src.width / 2, -src.height / 2);
            emWork = nc;
            emDirty = true;
            emDraw();
        }

        function emFlip(axis) {
            if (!emWork) { showToast('ยังไม่มีรูปให้พลิก', 'error'); return; }
            const src = emWork;
            const nc = document.createElement('canvas');
            nc.width = src.width; nc.height = src.height;
            const c = nc.getContext('2d');
            c.translate(axis === 'h' ? nc.width : 0, axis === 'v' ? nc.height : 0);
            c.scale(axis === 'h' ? -1 : 1, axis === 'v' ? -1 : 1);
            c.drawImage(src, 0, 0);
            emWork = nc;
            emDirty = true;
            emDraw();
        }

        function emSetBrightness(v) {
            const nv = Number(v) || 0;
            if (nv !== emBrightness) emDirty = true;
            emBrightness = nv;
            emDraw();
        }

        function emReset() { emLoadImageForEdit(); }

        // ==========================================
        // ✂️ ครอปในแผงแก้ไข (วงลากเลือกพื้นที่แบบเดียวกับตัวแก้ไขเต็มรูปแบบ) — ครอปแล้วกด "บันทึกการแก้ไข" ได้เลย (บันทึกทั้งรูปและข้อมูล)
        // ==========================================
        let emCropMode = false;
        let emCropRect = { x: 0, y: 0, w: 0, h: 0 };
        let emCropDrag = null;

        function emToggleCrop() {
            if (!emWork) { showToast('ยังไม่มีรูปให้ครอป', 'error'); return; }
            if (emCropMode) emApplyCrop();
            else emSetCropMode(true);
        }

        function emSetCropMode(on) {
            emCropMode = !!on;
            const ov = document.getElementById('emCropOverlay');
            if (ov) ov.classList.toggle('hidden', !emCropMode);
            const lb = document.getElementById('emCropToggleLabel');
            if (lb) lb.textContent = emCropMode ? 'ยืนยัน' : 'ครอป';
            if (emCropMode) {
                if (emImageZoom) emImageZoom.fitNow(); // เริ่มครอป → คืนรูปพอดีกล่อง (วงครอปอ้างพิกัดจอปกติ ไม่ซูม)
                emResetCropRect();
            }
        }

        function emResetCropRect() {
            const ov = document.getElementById('emCropOverlay');
            if (!ov) return;
            const W = ov.clientWidth || 1, H = ov.clientHeight || 1;
            emCropRect = { x: W * 0.1, y: H * 0.1, w: W * 0.8, h: H * 0.8 };
            emApplyCropRect();
        }

        function emApplyCropRect() {
            const box = document.getElementById('emCropBox');
            if (!box) return;
            box.style.left = emCropRect.x + 'px';
            box.style.top = emCropRect.y + 'px';
            box.style.width = emCropRect.w + 'px';
            box.style.height = emCropRect.h + 'px';
        }

        function emApplyCrop() {
            if (!emWork) return;
            const ov = document.getElementById('emCropOverlay');
            const W = ov.clientWidth || 1, H = ov.clientHeight || 1;
            const sx = Math.max(0, Math.min(Math.round(emCropRect.x * emWork.width / W), emWork.width - 1));
            const sy = Math.max(0, Math.min(Math.round(emCropRect.y * emWork.height / H), emWork.height - 1));
            const sw = Math.max(1, Math.min(Math.round(emCropRect.w * emWork.width / W), emWork.width - sx));
            const sh = Math.max(1, Math.min(Math.round(emCropRect.h * emWork.height / H), emWork.height - sy));
            if (sw < 10 || sh < 10) { showToast('พื้นที่ครอปเล็กเกินไป', 'error'); return; }
            const nc = document.createElement('canvas');
            nc.width = sw; nc.height = sh;
            nc.getContext('2d').drawImage(emWork, sx, sy, sw, sh, 0, 0, sw, sh);
            emWork = nc;
            emDirty = true;
            emSetCropMode(false);
            emDraw();
        }

        (function bindEmCropDrag() {
            const overlay = document.getElementById('emCropOverlay');
            const box = document.getElementById('emCropBox');
            if (!overlay || !box) return;

            const start = function (e) {
                if (!emCropMode) return;
                const handle = (e.target && e.target.getAttribute) ? e.target.getAttribute('data-handle') : null;
                const oRect = overlay.getBoundingClientRect();
                emCropDrag = {
                    mode: handle ? 'resize' : 'move',
                    handle: handle,
                    startX: e.clientX, startY: e.clientY,
                    rect: { x: emCropRect.x, y: emCropRect.y, w: emCropRect.w, h: emCropRect.h },
                    W: oRect.width, H: oRect.height
                };
                e.preventDefault();
            };
            const move = function (e) {
                if (!emCropDrag) return;
                const d = emCropDrag;
                const dx = e.clientX - d.startX, dy = e.clientY - d.startY;
                const MIN = 24;
                let r;
                if (d.mode === 'move') {
                    r = {
                        x: Math.max(0, Math.min(d.rect.x + dx, d.W - d.rect.w)),
                        y: Math.max(0, Math.min(d.rect.y + dy, d.H - d.rect.h)),
                        w: d.rect.w, h: d.rect.h
                    };
                } else {
                    let left = d.rect.x, top = d.rect.y;
                    let right = d.rect.x + d.rect.w, bottom = d.rect.y + d.rect.h;
                    if (d.handle.indexOf('w') !== -1) left = Math.max(0, Math.min(d.rect.x + dx, right - MIN));
                    if (d.handle.indexOf('e') !== -1) right = Math.min(d.W, Math.max(d.rect.x + d.rect.w + dx, left + MIN));
                    if (d.handle.indexOf('n') !== -1) top = Math.max(0, Math.min(d.rect.y + dy, bottom - MIN));
                    if (d.handle.indexOf('s') !== -1) bottom = Math.min(d.H, Math.max(d.rect.y + d.rect.h + dy, top + MIN));
                    r = { x: left, y: top, w: right - left, h: bottom - top };
                }
                emCropRect = r;
                emApplyCropRect();
                e.preventDefault();
            };
            const end = function () { emCropDrag = null; };

            box.addEventListener('pointerdown', start);
            overlay.addEventListener('pointerdown', function (e) { if (e.target === overlay) start(e); });
            window.addEventListener('pointermove', move);
            window.addEventListener('pointerup', end);
            window.addEventListener('pointercancel', end);
        })();

        // บันทึกรูปที่แก้ (หมุน/พลิก/ครอป/ความสว่าง) ทับไฟล์เดิม แล้วอัปเดตรูปในหน้าจอทันที
        // สร้าง dataURL ของรูปที่แก้ค้างในแผง (หมุน/พลิก/ครอป/ความสว่าง ทั้งหมดรวมอยู่) → null ถ้ารูปใหญ่เกินไป
        function emRenderImageDataUrl() {
            if (!emWork) return null;
            if (emCropMode) emApplyCrop();
            const out = document.createElement('canvas');
            out.width = emWork.width; out.height = emWork.height;
            const ctx = out.getContext('2d');
            ctx.filter = 'brightness(' + (1 + emBrightness / 100) + ')';
            ctx.drawImage(emWork, 0, 0);
            const dataUrl = out.toDataURL('image/jpeg', 0.9);
            return dataUrl.length > 12 * 1024 * 1024 ? null : dataUrl;
        }

        // บันทึกรูปที่แก้ผ่าน backend เดิม (saveEditedReceiptImage → ไฟล์ใหม่ใน Drive + อัปเดต URL ชีต/Supabase)
        // คืน Promise: resolve({ success, new_image_url, message }) | reject({ message })
        function emSaveImage() {
            return new Promise(function (resolve, reject) {
                const item = editModalItemRef;
                if (!emWork || !item) { reject({ message: 'ยังไม่มีรูปสำหรับบันทึก' }); return; }
                const dataUrl = emRenderImageDataUrl();
                if (!dataUrl) {
                    reject({ message: 'รูปใหญ่เกินไปหลังแก้ไข — ใช้ "ตัวแก้ไขเต็มรูปแบบ" เพื่อครอปให้เล็กลงแล้วลองใหม่' });
                    return;
                }
                const srcUrl = item.image_original_url || item.image_url;
                scriptCall('saveEditedReceiptImage', {
                    image_url: srcUrl,
                    id: item.id,
                    timestamp: item.timestamp,
                    po_number: item.po_number,
                    doc_key: item.doc_key || (editTarget && editTarget.doc_key) || '', // ตัวตนแถว Supabase สำหรับ sync URL รูปใหม่
                    system_record_no: item.system_record_no || '',
                    image_base64: dataUrl,
                    filename: 'receipt_edit_' + Date.now() + '.jpg'
                }).then(function (res) {
                    resolve({ success: !!(res && res.success), new_image_url: (res && res.new_image_url) || srcUrl, message: res && res.message });
                }).catch(function (err) {
                    if (err && err.message === 'SESSION_EXPIRED') {
                        handleSessionExpired('บันทึกรูป', function () { emSaveImage().then(resolve).catch(reject); });
                    } else {
                        reject({ message: (err && err.message) || err });
                    }
                });
            });
        }

        // v3.14.8: เลิกใช้ปุ่ม "บันทึกรูป" แยก — บันทึกการแก้ไข (ปุ่มล่าง) บันทึกทั้งรูปและข้อมูลด้วยปุ่มเดียวผ่าน emSaveImage()

        // ซิงก์รูปใหม่หลังบันทึก (แผงแก้ไข + ตาราง/การ์ด + ปุ่มขยายรูป)
        function emApplySavedImage(newUrl) {
            const item = editModalItemRef;
            if (!item) return;
            // v3.15.7: ใช้ withCacheBust — v= ตัวเดียวเสมอ (เดิมต่อทับ backend มี v= แล้ว → v=...&v=... ทำ 3 จุดโชว์ไม่ตรงกัน)
            const bust = withCacheBust(newUrl);
            const upd = function (arr) {
                const x = Array.isArray(arr) ? arr.find(function (y) { return y && y.id === item.id; }) : null;
                if (x) { x.image_original_url = bust; x.image_url = toDirectImageUrl(bust) || bust; }
            };
            upd(filteredData); upd(allData);
            item.image_original_url = bust;
            item.image_url = toDirectImageUrl(bust) || bust;
            editModalImageUrl = bust;
            if (editTarget) editTarget.image_url = bust;
            // v3.15.7: ถ้า "ดูบิลเต็ม" เปิดค้างอยู่ → รีเฟรชรูป/ลิงก์ในหน้าต่างนั้นทันทีด้วย (เดิมลืม — เปิดค้างไว้จะเห็นภาพเก่า)
            if (currentDetailItem && currentDetailItem.id === item.id) {
                currentDetailItem.image_original_url = bust;
                currentDetailItem.image_url = toDirectImageUrl(bust) || bust;
                const imgEl = document.getElementById('modalImage');
                if (imgEl && !document.getElementById('detailModal').classList.contains('hidden')) {
                    imgEl.src = currentDetailItem.image_url || imgPlaceholderSmall();
                    const ext = document.getElementById('modalImageExternal');
                    if (ext) ext.href = currentDetailItem.image_original_url || currentDetailItem.image_url;
                }
            }
            renderView();
            emLoadImageForEdit();
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
            editTarget = null;
            editModalItemRef = null;
            emSource = null; emWork = null; emBrightness = 0;
            emDirty = false;
            emCropMode = false; emCropDrag = null;
            const emOv = document.getElementById('emCropOverlay');
            if (emOv) emOv.classList.add('hidden');
            const emLb = document.getElementById('emCropToggleLabel');
            if (emLb) emLb.textContent = 'ครอป';
        }

        // === IMAGE EDITOR: หมุน / พลิก / ครอป / ปรับความสว่าง รูปบิล (เขียนทับไฟล์เดิมใน Drive) ===
        let editorSource = null;      // Image ต้นฉบับ (โหลดจาก data URL ของ Drive)
        let editorWork = null;        // canvas ที่ผ่านการหมุน/พลิก/ครอปแล้ว
        let editorBrightness = 0;
        let editorCropMode = false;
        let editorCropRect = { x: 0, y: 0, w: 0, h: 0 };
        let editorCropDrag = null;
        let editorTarget = null;

        function openImageEditor(item) {
            if (!GAS_MODE && !getScriptApiBase()) {
                showToast('การแก้ไขรูปเปิดได้เฉพาะผ่าน Web App หรือเมื่อตั้งค่า API URL แล้ว', 'error');
                return;
            }
            const srcUrl = item.image_original_url || item.image_url;
            if (!srcUrl) { showToast('บิลนี้ไม่มีรูปให้แก้ไข', 'error'); return; }

            editorTarget = { id: item.id, timestamp: item.timestamp, po_number: item.po_number, image_url: srcUrl };
            editorSource = null; editorWork = null; editorBrightness = 0;
            document.getElementById('brightnessRange').value = 0;
            document.getElementById('brightnessValue').innerText = '0';
            editorSetCropMode(false);
            document.getElementById('imageEditorModal').classList.remove('hidden');
            document.getElementById('editorHint').innerText = 'กำลังโหลดรูป...';

            scriptCall('getReceiptImageData', { url: srcUrl })
                .then(function (res) {
                    if (!res || !res.success) {
                        showToast((res && res.message) || 'โหลดรูปไม่สำเร็จ', 'error');
                        closeImageEditor();
                        return;
                    }
                    const img = new Image();
                    img.onload = function () {
                        editorSource = img;
                        buildWorkFromSource();
                        document.getElementById('editorHint').innerText = 'หมุน/พลิก/ปรับความสว่างได้ทันที — กด "เริ่มครอป" เพื่อเลือกพื้นที่ที่ต้องการเก็บ';
                    };
                    img.onerror = function () {
                        showToast('แสดงรูปไม่สำเร็จ (ไฟล์อาจเสียหาย)', 'error');
                        closeImageEditor();
                    };
                    img.src = res.data_url;
                })
                .catch(function (err) {
                    showToast('โหลดรูปไม่สำเร็จ: ' + ((err && err.message) || err), 'error');
                    closeImageEditor();
                });
        }

        function closeImageEditor() {
            document.getElementById('imageEditorModal').classList.add('hidden');
            editorSource = null; editorWork = null; editorTarget = null;
            editorSetCropMode(false);
        }

        function buildWorkFromSource() {
            if (!editorSource) return;
            const MAXDIM = 2400; // ย่อรูปยักษ์ก่อน เพื่อลดขนาดตอนส่งกลับ
            let w = editorSource.naturalWidth || editorSource.width;
            let h = editorSource.naturalHeight || editorSource.height;
            const scale = Math.min(1, MAXDIM / Math.max(w, h));
            w = Math.max(1, Math.round(w * scale));
            h = Math.max(1, Math.round(h * scale));
            const c = document.createElement('canvas');
            c.width = w; c.height = h;
            c.getContext('2d').drawImage(editorSource, 0, 0, w, h);
            editorWork = c;
            renderEditorCanvas();
        }

        function renderEditorCanvas() {
            if (!editorWork) return;
            const canvas = document.getElementById('editorCanvas');
            canvas.width = editorWork.width;
            canvas.height = editorWork.height;
            const ctx = canvas.getContext('2d');
            ctx.filter = 'brightness(' + (1 + editorBrightness / 100) + ')';
            ctx.drawImage(editorWork, 0, 0);
            if (editorCropMode) resetCropRect();
        }

        function editorRotate(dir) {
            if (!editorWork) return;
            const src = editorWork;
            const nc = document.createElement('canvas');
            nc.width = src.height; nc.height = src.width;
            const ctx = nc.getContext('2d');
            if (dir === 'right') { ctx.translate(nc.width, 0); ctx.rotate(Math.PI / 2); }
            else { ctx.translate(0, nc.height); ctx.rotate(-Math.PI / 2); }
            ctx.drawImage(src, 0, 0);
            editorWork = nc;
            renderEditorCanvas();
        }

        function editorFlip(axis) {
            if (!editorWork) return;
            const src = editorWork;
            const nc = document.createElement('canvas');
            nc.width = src.width; nc.height = src.height;
            const ctx = nc.getContext('2d');
            if (axis === 'h') { ctx.translate(nc.width, 0); ctx.scale(-1, 1); }
            else { ctx.translate(0, nc.height); ctx.scale(1, -1); }
            ctx.drawImage(src, 0, 0);
            editorWork = nc;
            renderEditorCanvas();
        }

        function editorSetBrightness(v) {
            editorBrightness = Number(v) || 0;
            document.getElementById('brightnessValue').innerText = String(editorBrightness);
            if (editorWork) renderEditorCanvas();
        }

        function editorReset() {
            editorBrightness = 0;
            document.getElementById('brightnessRange').value = 0;
            document.getElementById('brightnessValue').innerText = '0';
            editorSetCropMode(false);
            buildWorkFromSource();
        }

        function editorToggleCrop() {
            if (!editorWork) return;
            if (editorCropMode) applyEditorCrop();
            else editorSetCropMode(true);
        }

        function editorSetCropMode(on) {
            editorCropMode = !!on;
            const overlay = document.getElementById('cropOverlay');
            const label = document.getElementById('cropToggleLabel');
            if (overlay) overlay.classList.toggle('hidden', !editorCropMode);
            if (label) label.innerText = editorCropMode ? 'ยืนยันครอป' : 'เริ่มครอป';
            if (editorCropMode) resetCropRect();
        }

        function resetCropRect() {
            const overlay = document.getElementById('cropOverlay');
            if (!overlay) return;
            const W = overlay.clientWidth || 1, H = overlay.clientHeight || 1;
            editorCropRect = { x: W * 0.1, y: H * 0.1, w: W * 0.8, h: H * 0.8 };
            applyCropRect();
        }

        function applyCropRect() {
            const box = document.getElementById('cropBox');
            if (!box) return;
            box.style.left = editorCropRect.x + 'px';
            box.style.top = editorCropRect.y + 'px';
            box.style.width = editorCropRect.w + 'px';
            box.style.height = editorCropRect.h + 'px';
        }

        function applyEditorCrop() {
            if (!editorWork) return;
            const overlay = document.getElementById('cropOverlay');
            const W = overlay.clientWidth || 1, H = overlay.clientHeight || 1;
            const scaleX = editorWork.width / W, scaleY = editorWork.height / H;
            let sx = Math.round(editorCropRect.x * scaleX);
            let sy = Math.round(editorCropRect.y * scaleY);
            let sw = Math.round(editorCropRect.w * scaleX);
            let sh = Math.round(editorCropRect.h * scaleY);
            sx = Math.max(0, Math.min(sx, editorWork.width - 1));
            sy = Math.max(0, Math.min(sy, editorWork.height - 1));
            sw = Math.max(1, Math.min(sw, editorWork.width - sx));
            sh = Math.max(1, Math.min(sh, editorWork.height - sy));
            if (sw < 10 || sh < 10) { showToast('พื้นที่ครอปเล็กเกินไป', 'error'); return; }
            const nc = document.createElement('canvas');
            nc.width = sw; nc.height = sh;
            nc.getContext('2d').drawImage(editorWork, sx, sy, sw, sh, 0, 0, sw, sh);
            editorWork = nc;
            editorSetCropMode(false);
            renderEditorCanvas();
        }

        (function bindCropDrag() {
            const overlay = document.getElementById('cropOverlay');
            const box = document.getElementById('cropBox');
            if (!overlay || !box) return;

            const start = function (e) {
                if (!editorCropMode) return;
                const handle = (e.target && e.target.getAttribute) ? e.target.getAttribute('data-handle') : null;
                const oRect = overlay.getBoundingClientRect();
                editorCropDrag = {
                    mode: handle ? 'resize' : 'move',
                    handle: handle,
                    startX: e.clientX, startY: e.clientY,
                    rect: { x: editorCropRect.x, y: editorCropRect.y, w: editorCropRect.w, h: editorCropRect.h },
                    W: oRect.width, H: oRect.height
                };
                e.preventDefault();
            };
            const move = function (e) {
                if (!editorCropDrag) return;
                const d = editorCropDrag;
                const dx = e.clientX - d.startX, dy = e.clientY - d.startY;
                const MIN = 24;
                let r;
                if (d.mode === 'move') {
                    r = {
                        x: Math.max(0, Math.min(d.rect.x + dx, d.W - d.rect.w)),
                        y: Math.max(0, Math.min(d.rect.y + dy, d.H - d.rect.h)),
                        w: d.rect.w, h: d.rect.h
                    };
                } else {
                    let left = d.rect.x, top = d.rect.y;
                    let right = d.rect.x + d.rect.w, bottom = d.rect.y + d.rect.h;
                    if (d.handle.indexOf('w') !== -1) left = Math.max(0, Math.min(d.rect.x + dx, right - MIN));
                    if (d.handle.indexOf('e') !== -1) right = Math.min(d.W, Math.max(d.rect.x + d.rect.w + dx, left + MIN));
                    if (d.handle.indexOf('n') !== -1) top = Math.max(0, Math.min(d.rect.y + dy, bottom - MIN));
                    if (d.handle.indexOf('s') !== -1) bottom = Math.min(d.H, Math.max(d.rect.y + d.rect.h + dy, top + MIN));
                    r = { x: left, y: top, w: right - left, h: bottom - top };
                }
                editorCropRect = r;
                applyCropRect();
                e.preventDefault();
            };
            const end = function () { editorCropDrag = null; };

            box.addEventListener('pointerdown', start);
            overlay.addEventListener('pointerdown', function (e) { if (e.target === overlay) start(e); });
            window.addEventListener('pointermove', move);
            window.addEventListener('pointerup', end);
            window.addEventListener('pointercancel', end);
        })();

        function saveImageEdit() {
            if (!editorWork || !editorTarget) { showToast('ยังไม่มีรูปสำหรับบันทึก', 'error'); return; }
            if (editorCropMode) applyEditorCrop();
            const btn = document.getElementById('btnEditorSave');
            const original = btn.innerHTML;

            const out = document.createElement('canvas');
            out.width = editorWork.width; out.height = editorWork.height;
            const ctx = out.getContext('2d');
            ctx.filter = 'brightness(' + (1 + editorBrightness / 100) + ')';
            ctx.drawImage(editorWork, 0, 0);
            const dataUrl = out.toDataURL('image/jpeg', 0.9);

            if (dataUrl.length > 12 * 1024 * 1024) {
                showToast('รูปใหญ่เกินไปหลังแก้ไข กรุณาครอปให้เล็กลงแล้วลองใหม่', 'error');
                return;
            }

            const payload = {
                image_url: editorTarget.image_url,
                id: editorTarget.id,
                timestamp: editorTarget.timestamp,
                po_number: editorTarget.po_number,
                image_base64: dataUrl,
                filename: 'receipt_edit_' + Date.now() + '.jpg'
            };

            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังบันทึก...';

            const done = function () { btn.disabled = false; btn.innerHTML = original; };

            scriptCall('saveEditedReceiptImage', payload)
                .then(function (res) {
                    done();
                    if (res && res.success) {
                        showToast(res.message || 'บันทึกรูปเรียบร้อยแล้ว');
                        applyEditedImageLocally(res.new_image_url || editorTarget.image_url);
                        closeImageEditor();
                    } else {
                        showToast((res && res.message) || 'บันทึกรูปไม่สำเร็จ', 'error');
                    }
                })
                .catch(function (err) {
                    done();
                    if (err && err.message === 'SESSION_EXPIRED') {
                        handleSessionExpired('บันทึกรูป', function () { saveImageEdit(); });
                    } else {
                        showToast('บันทึกรูปไม่สำเร็จ: ' + ((err && err.message) || err), 'error');
                    }
                });
        }

        function applyEditedImageLocally(newUrl) {
            if (!editorTarget) return;
            const bust = withCacheBust(newUrl); // v3.15.7: v= ตัวเดียวเสมอ
            const upd = function (arr) {
                const it = arr.find(x => x.id === editorTarget.id);
                if (it) {
                    it.image_original_url = bust;
                    it.image_url = toDirectImageUrl(bust) || bust;
                }
            };
            upd(filteredData); upd(allData);
            renderView();
            // Cascading Sync: ถ้าหน้าต่างแก้ไขข้อมูลเปิดค้างอยู่ → โหลดรูปใหม่เข้าแผงแก้ไขรูปในหน้าต่างนั้นทันที
            if (!document.getElementById('editModal').classList.contains('hidden')) {
                editModalImageUrl = bust;
                if (editTarget) editTarget.image_url = bust;
                if (typeof emLoadImageForEdit === 'function') emLoadImageForEdit();
            }
        }

        // === SETTINGS: ตั้งค่าระบบผ่านหน้าเว็บ (ต้องรหัสผ่านก่อน + กดดูค่าที่บันทึกไว้ได้) ===
        let cfgPassword = '';
        let cfgRevealed = false;

        // ปุ่มลูกตา: แสดง/ซ่อนค่าที่อยู่ในช่อง (สลับ type + ไอคอน)
        function toggleCfgVisibility(inputId, btn) {
            const inp = document.getElementById(inputId);
            const show = inp.type === 'password';
            inp.type = show ? 'text' : 'password';
            btn.innerHTML = show ? '<i class="fa-solid fa-eye-slash"></i>' : '<i class="fa-solid fa-eye"></i>';
        }

        // ปุ่ม 'แสดงค่าจริง': ขอค่าเต็มจากเซิร์ฟเวอร์ (ต้องยืนยันรหัสผ่านแล้ว) แล้วเติมลงช่อง
        function toggleRevealConfig() {
            cfgRevealed = !cfgRevealed;
            loadSettingsConfig(cfgRevealed);
        }

        function updateRevealButton() {
            const lbl = document.getElementById('btnRevealCfgLabel');
            const btn = document.getElementById('btnRevealCfg');
            if (!lbl || !btn) return;
            lbl.innerText = cfgRevealed ? 'ซ่อนค่า (masked)' : 'แสดงค่าจริง';
            btn.querySelector('i').className = cfgRevealed ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
        }

        function openSettingsModal() {
            if (!GAS_MODE && !getScriptApiBase()) {
                showToast('ตั้งค่าระบบเปิดได้เฉพาะผ่าน Web App หรือเมื่อตั้งค่า API URL ของระบบแล้ว', 'error');
                return;
            }
            cfgPassword = '';
            cfgRevealed = false;
            document.getElementById('settingsModal').classList.remove('hidden');
            document.getElementById('cfgLoginPanel').classList.remove('hidden');
            document.getElementById('cfgFormPanel').classList.add('hidden');
            document.getElementById('cfgTitleBadge').innerText = '(ต้องใช้รหัสผ่าน)';
            document.getElementById('cfgPasswordInput').value = '';
            document.getElementById('cfgNewPasswordInput').value = '';
            document.getElementById('cfgLoadedNotice').classList.add('hidden');
            ['cfgLineTokenInput', 'cfgGeminiInput', 'cfgSheetIdInput', 'cfgSupabaseKeyInput'].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) el.type = 'password';
            });
            document.querySelectorAll('#cfgFormPanel button[title="แสดง/ซ่อนค่า"] i').forEach(function (ic) {
                ic.className = 'fa-solid fa-eye';
            });
            updateRevealButton();
            setTimeout(function () { document.getElementById('cfgPasswordInput').focus(); }, 50);
        }

        function closeSettingsModal() {
            document.getElementById('settingsModal').classList.add('hidden');
            cfgPassword = '';
            cfgRevealed = false;
        }

        function resetSettingsToLogin() {
            document.getElementById('cfgFormPanel').classList.add('hidden');
            document.getElementById('cfgLoginPanel').classList.remove('hidden');
            document.getElementById('cfgTitleBadge').innerText = '(ต้องใช้รหัสผ่าน)';
            cfgPassword = '';
            cfgRevealed = false;
            updateRevealButton();
            document.getElementById('cfgPasswordInput').value = '';
            setTimeout(function () { document.getElementById('cfgPasswordInput').focus(); }, 50);
        }

        // ขั้นตอนที่ 1: ตรวจรหัสผ่านก่อน — ผ่านแล้วค่อยแสดงฟอร์มตั้งค่า
        // โหมด GAS: ยืนยันรหัสผ่านตรง ๆ | โหมด REST (GitHub Pages): แลกรหัสผ่าน → session token (2 ชม.)
        function loginSettings() {
            const pw = document.getElementById('cfgPasswordInput').value;
            if (!pw) { showToast('กรุณากรอกรหัสผ่านก่อน', 'error'); return; }
            const btn = document.querySelector('#cfgLoginPanel button');
            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังตรวจสอบ...';

            // 🛡️ v3.13.0: ล็อกอินใช้ createApiSession ทั้งสองโหมด (GAS/REST) → ได้ session token จากเซิร์ฟเวอร์
            //    ยกเลิกวิธีเดิมที่โหมด GAS ส่งรหัสผ่านไปทุกครั้ง และยกเลิกการใช้ธง _alreadyAuthed ฝั่งเซิร์ฟเวอร์
            const doLogin = function () {
                return scriptCall('createApiSession', { password: pw }).then(function (res) {
                    if (!res || !res.success) throw new Error((res && res.message) || 'รหัสผ่านไม่ถูกต้อง');
                    apiToken = res.token;
                    sessionStorage.setItem('btc_api_token', apiToken);
                    cfgPassword = '*session*'; // ธงฝั่งหน้าเว็บว่ายืนยันตัวตนแล้ว (ใช้เปิดฟอร์มตั้งค่าเท่านั้น ไม่ได้ส่งไปตรวจที่เซิร์ฟเวอร์)
                    return true;
                });
            };

            doLogin().then(function () {
                btn.disabled = false;
                btn.innerHTML = orig;
                // 🔄 มีงานค้างจาก session หมดอายุ → ปิดหน้าตั้งค่าแล้วทำรายการนั้นต่อทันที (ผู้ใช้ไม่ต้องกดซ้ำ)
                if (postLoginRetry) {
                    const nextAction = postLoginRetry;
                    postLoginRetry = null;
                    closeSettingsModal();
                    showToast('✅ เข้าสู่ระบบใหม่แล้ว — กำลังทำรายการที่ค้างต่อให้อัตโนมัติ');
                    setTimeout(function () { try { nextAction(); } catch (e) { /* retry ล้มเหลว = ผู้ใช้ทำเองได้ตามปกติ */ } }, 200);
                    return;
                }
                document.getElementById('cfgLoginPanel').classList.add('hidden');
                document.getElementById('cfgFormPanel').classList.remove('hidden');
                document.getElementById('cfgTitleBadge').innerText = '(เข้าสู่ระบบแล้ว)';
                loadSettingsConfig(); // โหลดค่าปัจจุบันอัตโนมัติ
            }).catch(function (err) {
                btn.disabled = false;
                btn.innerHTML = orig;
                showToast('ตรวจรหัสผ่านไม่สำเร็จ: ' + ((err && err.message) || err), 'error');
                document.getElementById('cfgPasswordInput').value = '';
                document.getElementById('cfgPasswordInput').focus();
            });
        }

        // ขั้นตอนที่ 2: โหลดค่า (ใช้รหัสผ่านที่ยืนยันแล้ว — ค่าเริ่มต้น masked, reveal=true คือขอค่าเต็ม)
        function loadSettingsConfig(reveal) {
            if (!cfgPassword) { showToast('กรุณาเข้าระบบด้วยรหัสผ่านก่อน', 'error'); return; }
            const wantReveal = (reveal === true);
            const btn = document.getElementById('btnReloadCfg');
            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>...';
            document.getElementById('cfgLoadedNotice').classList.add('hidden');

            // 🛡️ v3.13.0: ส่งแค่ reveal — session token แนบที่ชั้น transport แล้ว (เซิร์ฟเวอร์ตรวจที่ handleApiRequest)
            scriptCall('getAppConfig', { reveal: wantReveal })
                .then(function (res) {
                    btn.disabled = false;
                    btn.innerHTML = orig;
                    if (res && res.success) {
                        document.getElementById('cfgLineTokenInput').value = res.data.LINE_CHANNEL_ACCESS_TOKEN || '';
                        document.getElementById('cfgGeminiInput').value = res.data.GEMINI_API_KEY || '';
                        document.getElementById('cfgFolderInput').value = res.data.DRIVE_FOLDER_NAME || '';
                        document.getElementById('cfgSheetIdInput').value = res.data.SPREADSHEET_ID || '';
                        document.getElementById('cfgSupabaseUrlInput').value = res.data.SUPABASE_URL || '';
                        document.getElementById('cfgSupabaseKeyInput').value = res.data.SUPABASE_SERVICE_KEY || '';
                        document.getElementById('cfgSupabaseAnonInput').value = res.data.SUPABASE_ANON_KEY || '';
                        // 🗑️ v3.14.0: ไม่โหลดค่า API URL เดิมมาเติมแล้ว (เลิกใช้โฮสต์ภายนอก) — กันค่าค้างเก่ามาบล็อกการบันทึกตั้งค่า
                        document.getElementById('cfgApiUrlInput').value = '';
                        cfgRevealed = !!res.revealed;
                        updateRevealButton();
                        document.getElementById('cfgLoadedMsg').innerHTML = cfgRevealed
                            ? '<strong>กำลังแสดงค่าเต็ม</strong> — โปรดตรวจสอบก่อนกดบันทึก (ถ้าไม่แก้ ระบบจะคงค่าเดิม)'
                            : 'โหลดค่าปัจจุบันแล้ว — ช่องที่เป็น <span class="font-mono">••••</span> แปลว่าไม่ได้แก้ ระบบจะคงค่าเดิมไว้';
                        document.getElementById('cfgLoadedNotice').classList.remove('hidden');
                    } else {
                        cfgRevealed = false;
                        updateRevealButton();
                        showToast((res && res.message) || 'ไม่สามารถโหลดค่าได้ รหัสผ่านอาจไม่ถูกต้อง', 'error');
                    }
                })
                .catch(function (err) {
                    btn.disabled = false;
                    btn.innerHTML = orig;
                    showToast('โหลดค่าไม่สำเร็จ: ' + ((err && err.message) || err), 'error');
                });
        }

        // ตรวจ role ของ Supabase key ฝั่งหน้าเว็บ (ถอด JWT) — เตือนก่อนกดบันทึก ไม่ต้องเดิกรอบเว็บ
        function supabaseKeyRoleClient(key) {
            if (!key) return null;
            const parts = String(key).trim().split('.');
            if (parts.length < 2) return 'invalid';
            let payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');
            while (payload.length % 4) payload += '=';
            try {
                return (JSON.parse(decodeURIComponent(escape(atob(payload)))).role || 'unknown');
            } catch (e) { return 'invalid'; }
        }

        // ขั้นตอนที่ 3: บันทึกค่า
        function saveSettingsConfig() {
            if (!cfgPassword) { showToast('กรุณาเข้าระบบด้วยรหัสผ่านก่อน', 'error'); return; }
            const sbKey = document.getElementById('cfgSupabaseKeyInput').value;
            if (sbKey && sbKey.indexOf('••') === -1 && sbKey.trim() !== '') {
                const role = supabaseKeyRoleClient(sbKey);
                if (role !== 'service_role') {
                    showToast('Supabase Service Key ไม่ถูกต้อง (role = "' + role + '") — ต้องใช้ service_role (SECRET) ไม่ใช่ anon public\nเปิด Supabase > Settings > API แล้ว copy ตัวที่กด reveal เป็น secret', 'error');
                    return;
                }
            }
            // 🔐 v3.12.0 กันพลาด: ห้ามเอา service_role key ใส่ช่อง Anon Key — ค่าในช่องนี้ถูกฝังหน้าเว็บสาธารณะ (ใส่ผิด = key ลับรั่วทันที)
            const anonKeyVal = document.getElementById('cfgSupabaseAnonInput').value;
            if (anonKeyVal && anonKeyVal.indexOf('••') === -1 && anonKeyVal.trim() !== '') {
                if (supabaseKeyRoleClient(anonKeyVal) === 'service_role') {
                    showToast('ช่อง Supabase Anon Key ห้ามใส่ service_role key เด็ดขาด — ค่านี้จะถูกฝังในหน้าเว็บสาธารณะ ทำให้ key ลับรั่วทันที (ใช้ anon public เท่านั้น)', 'error');
                    return;
                }
            }
            // Google Sheets API URL (ย้ายจากหน้าหลักมาไว้ในหน้าตั้งค่าที่ต้องใช้รหัสผ่าน — เก็บฝั่งเบราว์เซอร์เหมือนเดิม)
            // 🗑️ v3.14.0: ใช้ GAS Web App เท่านั้น — ไม่รับ/ไม่บันทึก API URL ภายนอกแล้ว (ค่าค้างเดิมใน localStorage จะถูกล้างให้เอง)
            const apiUrlVal = GAS_MODE ? '' : document.getElementById('cfgApiUrlInput').value.trim();
            if (apiUrlVal && !/^https:\/\/script\.google\.com\/macros\/s\//.test(apiUrlVal)) {
                showToast('Google Sheets API URL ไม่ถูกต้อง — ต้องเป็นลิงก์ Web App รูปแบบ https://script.google.com/macros/s/.../exec', 'error');
                return;
            }
            const prevApiUrl = localStorage.getItem('btc_script_url') || '';
            const apiUrlChanged = (apiUrlVal !== prevApiUrl);
            if (apiUrlChanged) {
                if (apiUrlVal) localStorage.setItem('btc_script_url', apiUrlVal);
                else localStorage.removeItem('btc_script_url');
            }
            const payload = {
                // 🛡️ v3.13.0: ไม่ส่งรหัสผ่านไปกับทุกคำขออีก — session token ถูกแนบที่ชั้น transport (scriptCall)
                LINE_CHANNEL_ACCESS_TOKEN: document.getElementById('cfgLineTokenInput').value,
                GEMINI_API_KEY: document.getElementById('cfgGeminiInput').value,
                DRIVE_FOLDER_NAME: document.getElementById('cfgFolderInput').value,
                SPREADSHEET_ID: document.getElementById('cfgSheetIdInput').value,
                SUPABASE_URL: document.getElementById('cfgSupabaseUrlInput').value,
                SUPABASE_SERVICE_KEY: sbKey,
                SUPABASE_ANON_KEY: document.getElementById('cfgSupabaseAnonInput').value,
                new_password: document.getElementById('cfgNewPasswordInput').value
            };
            const btn = document.getElementById('btnSaveCfg');
            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังบันทึก...';

            // กัน "กำลังบันทึก..." ค้างตลอดกาล — ถ้า 30 วิยังไม่ตอบ คืนปุ่ม + แนะนำวิธี
            const watchdog = setTimeout(function () {
                btn.disabled = false;
                btn.innerHTML = orig;
                showToast('ระบบไม่ตอบสนองภายใน 30 วินาที — กด Ctrl+F5 แล้วลองใหม่ (ดูเส้นทาง: Apps Script > Executions ว่ามีค่าเข้าไหม)', 'error');
            }, 30000);

            scriptCall('saveAppConfig', payload)
                .then(function (res) {
                    clearTimeout(watchdog);
                    btn.disabled = false;
                    btn.innerHTML = orig;
                    if (res && res.success) {
                        showToast(res.message + (apiUrlChanged ? ' | บันทึก Google Sheets API URL เรียบร้อยแล้ว' : ''));
                        resetSettingsToLogin();
                        if (apiUrlChanged) refreshData(); // โหลดข้อมูลใหม่ตาม URL ที่เพิ่งเปลี่ยน (เหมือนพฤติกรรม saveApiUrl เดิม)
                    } else {
                        showToast((res && res.message) || 'บันทึกค่าไม่สำเร็จ', 'error');
                    }
                })
                .catch(function (err) {
                    clearTimeout(watchdog);
                    btn.disabled = false;
                    btn.innerHTML = orig;
                    // 🔐 หน้าตั้งค่าคือที่เดียวที่ยังต้องใช้รหัส — session หมดอายุให้พากลับไปล็อกอินใหม่ (ไม่ใช่ทำต่ออัตโนมัติแบบงานธุรกิจ)
                    if (err && err.message === 'SESSION_EXPIRED') {
                        apiToken = '';
                        sessionStorage.removeItem('btc_api_token');
                        resetSettingsToLogin();
                        showToast('⏰ เซสชันตั้งค่าระบบหมดอายุ — กรุณากรอกรหัสผ่านอีกครั้งเพื่อบันทึกค่า', 'error');
                    } else {
                        showToast('บันทึกค่าไม่สำเร็จ: ' + ((err && err.message) || err), 'error');
                    }
                });
        }

        // --- ตารางรายการสินค้าในหน้าต่างแก้ไข (เพิ่ม / ลบ / แก้ไขได้ทุกช่อง) ---
        function renderEditItemRows(items) {
            const body = document.getElementById('editItemsBody');
            body.innerHTML = (items && items.length > 0)
                ? items.map(sub => editItemRowHtml(sub)).join('')
                : editItemRowHtml(null); // บิลที่ AI อ่านรายการไม่ได้ → เปิดมาให้ 1 แถวว่างสำหรับกรอก
            updateEditItemIndexes();
            recalcEditTotal();
        }

        // 💡 v3.15.0: ตัวเลือกช่องกรอกจากประวัติจริงในฐานข้อมูล (autocomplete) — ลดภาระการคีย์
        //    และทำให้สินค้า/ข้อมูลเดียวกันสะกด/เว้นวรรคแบบเดียวกันทุกครั้ง (สะกดที่ใช้บ่อยลอยขึ้นบนสุดให้เลือก)
        let editSuggestions = null;
        let editSuggestionsLoading = false;

        function ensureEditSuggestDataList(id) {
            let dl = document.getElementById(id);
            if (!dl) {
                dl = document.createElement('datalist');
                dl.id = id;
                document.body.appendChild(dl);
            }
            return dl;
        }

        function fillEditSuggestDataList(id, arr) {
            const dl = ensureEditSuggestDataList(id);
            dl.innerHTML = '';
            (arr || []).forEach(function (s) {
                if (!s || !s.text) return;
                const opt = document.createElement('option');
                opt.value = s.text;
                if (s.count > 1) opt.label = s.text + ' (' + s.count + ' ครั้ง)'; // โชว์ความถี่ให้เลือกสะกดมาตรฐาน
                dl.appendChild(opt);
            });
        }

        function applyEditSuggestions(s) {
            if (!s) return;
            fillEditSuggestDataList('editItemList', s.items);           // รายการสินค้า/วัสดุ ทุกแถว
            fillEditSuggestDataList('editUnitList', s.units);           // หน่วยนับ
            fillEditSuggestDataList('editStoreList', s.stores);         // ชื่อร้านค้า/ผู้ขาย
            fillEditSuggestDataList('editVehicleList', s.vehicles);     // ทะเบียนรถ (ใบชั่ง)
            fillEditSuggestDataList('editCompanyList', s.companies);    // ชื่อบริษัท (PO)
            fillEditSuggestDataList('editJobList', s.jobs);             // งาน/โครงการ
            fillEditSuggestDataList('editRequesterList', s.requesters); // ผู้เบิก/ผู้ขอ
            fillEditSuggestDataList('editPayApproverList', s.pay_approvers); // ผู้สั่งจ่าย
        }

        function loadEditSuggestions(force) {
            if (editSuggestions && !force) { applyEditSuggestions(editSuggestions); return; }
            if (editSuggestionsLoading) return;
            editSuggestionsLoading = true;
            scriptCall('getEditFieldSuggestions', {})
                .then(function (res) {
                    editSuggestionsLoading = false;
                    if (res && res.success && res.suggestions) {
                        editSuggestions = res.suggestions;
                        applyEditSuggestions(editSuggestions);
                    }
                })
                .catch(function () { editSuggestionsLoading = false; }); // เงียบ ๆ — autocomplete ไม่ใช่ฟีเจอร์บังคับ
        }

        function editItemRowHtml(sub) {
            const it = sub || {};
            return `
                <tr class="hover:bg-slate-50 transition">
                    <td class="p-1.5 text-center text-slate-400 font-mono edit-row-no">-</td>
                    <td class="p-1.5">
                        <input type="text" list="editItemList" class="ui-input edit-name w-full"
                            placeholder="ชื่อสินค้า / วัสดุ" value="${escapeAttr(it.name)}">
                    </td>
                    <td class="p-1.5">
                        <input type="number" step="any" class="ui-input edit-qty w-full text-center"
                            value="${escapeAttr(it.quantity)}" oninput="recalcEditRowTotal(this)">
                    </td>
                    <td class="p-1.5">
                        <input type="text" list="editUnitList" class="ui-input edit-unit w-full text-center"
                            placeholder="หน่วย" value="${escapeAttr(it.unit)}">
                    </td>
                    <td class="p-1.5">
                        <input type="number" step="any" class="ui-input edit-price w-full text-right"
                            value="${escapeAttr(it.price_per_unit)}" oninput="recalcEditRowTotal(this)">
                    </td>
                    <td class="p-1.5">
                        <input type="number" step="any" class="ui-input edit-line-total w-full text-right font-semibold"
                            value="${escapeAttr(it.total)}" oninput="recalcEditTotal()">
                    </td>
                    <td class="p-1.5 text-center">
                        <button onclick="removeEditItemRow(this)" title="ลบรายการนี้"
                            class="w-7 h-7 rounded-lg bg-red-50 hover:bg-red-100 text-red-500 hover:text-red-600 inline-flex items-center justify-center transition border border-red-200">
                            <i class="fa-solid fa-minus text-[10px]"></i>
                        </button>
                    </td>
                </tr>`;
        }

        function addEditItemRow() {
            const body = document.getElementById('editItemsBody');
            body.insertAdjacentHTML('beforeend', editItemRowHtml(null));
            updateEditItemIndexes();
            const rows = body.querySelectorAll('tr');
            const lastRow = rows[rows.length - 1];
            if (lastRow) lastRow.querySelector('.edit-name').focus();
        }

        function removeEditItemRow(btn) {
            const body = document.getElementById('editItemsBody');
            const tr = btn.closest('tr');
            if (tr) tr.remove();
            if (body.querySelectorAll('tr').length === 0) {
                body.insertAdjacentHTML('beforeend', editItemRowHtml(null)); // ต้องเหลืออย่างน้อย 1 แถวไว้กรอก
            }
            updateEditItemIndexes();
            recalcEditTotal();
        }

        function updateEditItemIndexes() {
            const rows = document.querySelectorAll('#editItemsBody tr');
            rows.forEach((tr, i) => {
                const cell = tr.querySelector('.edit-row-no');
                if (cell) cell.innerText = i + 1;
            });
            document.getElementById('editItemBadge').innerText = rows.length + ' รายการ';
        }

        // จำนวน × ราคาต่อหน่วย → ราคารวมของแถวนั้น แล้วคิดยอดรวมใหม่ทั้งบิล
        function recalcEditRowTotal(input) {
            const tr = input.closest('tr');
            const qty = parseFloat(tr.querySelector('.edit-qty').value) || 0;
            const price = parseFloat(tr.querySelector('.edit-price').value) || 0;
            tr.querySelector('.edit-line-total').value = (qty * price).toFixed(2);
            recalcEditTotal();
        }

        function recalcEditTotal() {
            if (editTotalManual) return; // ผู้ใช้แก้ยอดรวมเองอยู่ → อย่าทับค่าที่พิมพ์ไว้
            let sum = 0;
            document.querySelectorAll('#editItemsBody .edit-line-total').forEach(inp => {
                sum += parseFloat(inp.value) || 0;
            });
            document.getElementById('editTotalInput').value = sum.toFixed(2);
        }

        // --- เก็บค่าจากฟอร์มแก้ไข + ส่งไปบันทึกที่ Google Sheets ---
        function collectEditPayload() {
            const items = Array.from(document.querySelectorAll('#editItemsBody tr')).map(tr => {
                const name = tr.querySelector('.edit-name').value.trim();
                const quantity = parseFloat(tr.querySelector('.edit-qty').value) || 0;
                const unit = tr.querySelector('.edit-unit').value.trim();
                const price_per_unit = parseFloat(tr.querySelector('.edit-price').value) || 0;
                const total = parseFloat(tr.querySelector('.edit-line-total').value) || 0;
                return { name: name, quantity: quantity, unit: unit, price_per_unit: price_per_unit, total: total };
            }).filter(x => x.name !== '' || x.total > 0);

            return {
                id: editTarget ? editTarget.id : null,
                timestamp: editTarget ? editTarget.timestamp : '',
                old_po_number: editTarget ? editTarget.old_po_number : '',
                doc_key: editTarget ? (editTarget.doc_key || '') : '',
                system_record_no: editTarget ? (editTarget.system_record_no === undefined || editTarget.system_record_no === '' || editTarget.system_record_no === null ? '' : Number(editTarget.system_record_no)) : '',
                image_url: editTarget ? (editTarget.image_url || editTarget.image_original_url || '') : '',
                po_number: document.getElementById('editPoInput').value.trim() || '-',
                date: document.getElementById('editDateInput').value || '',
                store_name: document.getElementById('editStoreInput').value.trim(),
                category: document.getElementById('editCategorySelect').value || 'ทั่วไป',
                doc_type: document.getElementById('editDocTypeSelect').value || '',
                vehicle_registration: document.getElementById('editVehicleInput') ? document.getElementById('editVehicleInput').value.trim() : '',
                scale_weight_in: document.getElementById('editWeightInInput') ? (document.getElementById('editWeightInInput').value === '' ? '' : Number(document.getElementById('editWeightInInput').value)) : '',
                scale_weight_out: document.getElementById('editWeightOutInput') ? (document.getElementById('editWeightOutInput').value === '' ? '' : Number(document.getElementById('editWeightOutInput').value)) : '',
                scale_weight_net: document.getElementById('editWeightNetInput') ? (document.getElementById('editWeightNetInput').value === '' ? '' : Number(document.getElementById('editWeightNetInput').value)) : '',
                book_no: document.getElementById('editBookInput').value.trim(),
                doc_no: document.getElementById('editDocNoInput').value.trim(),
                tax_invoice_no: document.getElementById('editTaxInvoiceInput').value.trim(),
                ref_no: document.getElementById('editRefNoInput').value.trim(),
                ref_label: document.getElementById('editRefLabelInput').value.trim(),
                company_name: document.getElementById('editCompanyInput').value.trim(),
                job_name: document.getElementById('editJobInput').value.trim(),
                requester: document.getElementById('editRequesterInput').value.trim(),
                pay_approver: document.getElementById('editPayApproverInput').value.trim(),
                items: items,
                items_summary: items.map(x => `${x.name} (${x.quantity} ${x.unit})`).join(', '),
                total_amount: parseFloat(document.getElementById('editTotalInput').value) || 0
            };
        }

        function saveEditReceipt() {
            if (!editTarget) {
                showToast('ไม่พบข้อมูลบิลเป้าหมาย กรุณาปิดหน้าต่างแล้วเปิดใหม่อีกครั้ง', 'error');
                return;
            }

            if (!GAS_MODE && !getScriptApiBase()) {
                showToast('การแก้ไขใช้ได้เฉพาะเมื่อเปิดผ่าน Web App หรือเมื่อตั้งค่า API URL ของระบบแล้ว', 'error');
                return;
            }

            const payload = collectEditPayload();
            if (!payload.store_name) {
                showToast('กรุณาระบุชื่อร้านค้า / ผู้ขาย', 'error');
                return;
            }
            if (!(payload.total_amount >= 0) || isNaN(payload.total_amount)) {
                showToast('ยอดรวมสุทธิไม่ถูกต้อง กรุณาตรวจสอบอีกครั้ง', 'error');
                return;
            }

            const btn = document.getElementById('btnSaveEdit');
            const originalHtml = btn.innerHTML;
            const restore = function () {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            };

            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังบันทึก...';

            // v3.14.8: ปุ่มเดียวบันทึกทั้งข้อมูลและรูป — ถ้ามีการแก้รูปค้างในแผง (emDirty) ให้ส่งรูปก่อนแล้วค่อยอัปเดตข้อมูล
            let savedNewImageUrl = '';
            const doUpdateReceipt = function () {
                const p2 = collectEditPayload();
                scriptCall('updateReceipt', p2)
                    .then(function (res) {
                        restore();
                        if (res && res.success) {
                            const oldItemId = editTarget ? editTarget.id : '';
                            const oldDocKey = editTarget ? (editTarget.doc_key || '') : '';
                            bumpImageEpoch('edit-save'); // v3.15.8: DB เปลี่ยน → รูปทุกรูปโหลดใหม่รอบหน้า
                            if (savedNewImageUrl) emApplySavedImage(savedNewImageUrl); // อัปเดตรูปทุกรายการในหน้าจอทันที (ไม่ต้องรอ refresh)
                            showToast(res.message);
                            closeEditModal();
                            refreshSingleReceipt(res, oldItemId, oldDocKey, savedNewImageUrl); // v3.14.9 รีเฟรชเฉพาะรายการนี้ ไม่โหลดตารางใหม่ทั้งก้อน
                        } else {
                            showToast((res && res.message) ? res.message : 'บันทึกการแก้ไขไม่สำเร็จ', 'error');
                        }
                    })
                    .catch(function (err) {
                        restore();
                        if (err && err.message === 'SESSION_EXPIRED') {
                            handleSessionExpired('บันทึกการแก้ไขบิล', function () { saveEditReceipt(); });
                        } else {
                            showToast('บันทึกการแก้ไขไม่สำเร็จ: ' + (err.message || err), 'error');
                        }
                    });
            };

            if (emDirty) {
                emSaveImage().then(function (r) {
                    if (!(r && r.success)) {
                        restore();
                        showToast((r && r.message) || 'บันทึกรูปไม่สำเร็จ', 'error');
                        return;
                    }
                    emDirty = false;
                    savedNewImageUrl = r.new_image_url; // รูปบันทึกแล้ว (ไฟล์ใหม่ใน Drive + URL อัปเดตชีต/Supabase) → บันทึกข้อมูลต่อ
                    doUpdateReceipt();
                }).catch(function (e) {
                    restore();
                    showToast((e && e.message) || 'บันทึกรูปไม่สำเร็จ', 'error');
                });
            } else {
                doUpdateReceipt();
            }
        }

        // v3.14.9: หลัง "บันทึกการแก้ไข" → รีเฟรชเฉพาะรายการนั้น (ไม่โหลดตารางทั้งก้อน) เพื่อความลื่นไหล
        //   ลำดับ: Supabase → ดึงรายการเดียวที่ระบุ | GAS (ชีต) → getSingleReceipt | เจอไม่ได้→โหลดเต็มเป็นตัวสำรอง
        function refreshSingleReceipt(res, oldItemId, oldDocKey, savedImageUrl) {
            const savedNewImageUrl = savedImageUrl || ''; // URL รูปใหม่ที่เพิ่งบันทึก (จาก saveEditReceipt) — ใช้กันรูปเก่าทับรูปใหม่
            const srn = (res && res.system_record_no !== undefined && res.system_record_no !== null && res.system_record_no !== '') ? Number(res.system_record_no) : '';
            const dk = String((res && res.doc_key) || oldDocKey || '').trim();
            if (srn === '' && !dk) { refreshData(); return; } // ไม่มีตัวตนพอจะหาแถว → โหลดเต็มไว้ก่อน

            const q = { system_record_no: srn, doc_key: dk };
            const applyItem = function (rawItem) {
                if (!rawItem) return false;
                const hooked = normalizeData([rawItem])[0];
                if (!hooked) return false;
                // 🛡️ กัน "รูปเก่ากลับมาทับรูปใหม่": ถ้าแถวจาก DB ยังมี URL เก่า (ไม่มี v= ใหม่) แต่รูปเพิ่งถูกแก้ (savedNewImageUrl)
                //     ให้เทียบ file ID — ไฟล์เดียวกัน = ใช้ URL ที่มี v= ใหม่กว่าเสมอ (DB เขียนช้ากว่าหน้าจอเป็นปกติ)
                try {
                    const savedId = savedNewImageUrl ? (String(savedNewImageUrl).match(/[?&]id=([\w-]+)/) || [])[1] : '';
                    const rowId = String(hooked.image_original_url || hooked.image_url || '').match(/[?&]id=([\w-]+)/);
                    if (savedId && (!rowId || rowId[1] === savedId)) {
                        hooked.image_original_url = savedNewImageUrl;
                        hooked.image_url = toDirectImageUrl(savedNewImageUrl) || savedNewImageUrl;
                    }
                } catch (e) { /* ไม่บล็อกการแสดงผล */ }
                if (!patchAllDataWith(hooked, oldItemId)) return false;
                lastDataSignature = computeDataSignature(allData); // เราแก้เองแล้ว → กัน auto-refresh toast ซ้ำ
                applyFilters();
                return true;
            };

            const fetchOne = function () {
                if (GAS_MODE || !supabaseClient) {
                    return scriptCall('getSingleReceipt', { system_record_no: q.system_record_no, doc_key: q.doc_key })
                        .then(function (rows) { return (Array.isArray(rows) && rows[0]) ? rows[0] : null; });
                }
                // (โหมด Supabase — ดึงแถวเดียวตรงจากฐานข้อมูล)
                let query = supabaseClient.from('receipts').select('*');
                if (q.system_record_no) {
                    const orExpr = 'system_record_no.eq.' + q.system_record_no + (q.doc_key ? ',doc_key.eq.' + encodeURIComponent(q.doc_key) : '');
                    query = query.or(orExpr);
                } else {
                    query = query.eq('doc_key', encodeURIComponent(q.doc_key));
                }
                return query.limit(1).then(function (sq) {
                    if (sq.error) throw new Error(sq.error.message || 'Supabase error');
                    return (sq.data && sq.data[0]) ? Object.assign({}, sq.data[0], { id: sq.data[0].doc_key || sq.data[0].id }) : null;
                });
            };

            fetchOne()
                .then(function (rawItem) { if (!applyItem(rawItem)) refreshData(); })
                .catch(function () { refreshData(); }); // กันพลาด: ดึงได้แต่ไม่ match / error → โหลดเต็มเพื่อความถูกต้อง
        }

        // เอาบิลที่แก้ใหม่ไป "แทรกแทน" รายการเดิมใน allData (เก็บตำแหน่งเดิม ไม่เลื่อนทั้งตาราง)
        function patchAllDataWith(normItem, oldId) {
            let idx = -1;
            if (oldId) idx = allData.findIndex(x => x.id === oldId);
            if (idx === -1 && normItem.doc_key) idx = allData.findIndex(x => x.doc_key === normItem.doc_key);
            if (idx === -1 && normItem.system_record_no) idx = allData.findIndex(x => x.system_record_no && String(x.system_record_no) === String(normItem.system_record_no));
            if (idx === -1) return false;
            const newId = normItem.id;
            if (newId && newId !== allData[idx].id) {
                const dup = allData.findIndex(function (x, i) { return i !== idx && x.id === newId; });
                if (dup !== -1) {
                    allData.splice(dup, 1);
                    if (dup < idx) idx--;
                }
            }
            allData.splice(idx, 1, normItem);
            return true;
        }

        function openApiModal() {
            document.getElementById('apiUrlInput').value = localStorage.getItem('btc_script_url') || '';
            document.getElementById('apiModal').classList.remove('hidden');
        }

        function closeApiModal() {
            document.getElementById('apiModal').classList.add('hidden');
        }

        function openCompanyModal() {
            document.getElementById('companyModal').classList.remove('hidden');
        }

        function closeCompanyModal() {
            document.getElementById('companyModal').classList.add('hidden');
        }

        function saveApiUrl() {
            const url = document.getElementById('apiUrlInput').value.trim();
            if (url) {
                localStorage.setItem('btc_script_url', url);
                showToast('บันทึก URL API เรียบร้อยแล้ว');
            } else {
                localStorage.removeItem('btc_script_url');
                showToast('ยกเลิกการใช้ API แล้ว — กรุณาเชื่อมต่อฐานข้อมูลเพื่อแสดงข้อมูล', 'error');
            }
            closeApiModal();
            refreshData();
        }

        function loadSavedApiUrl() {
            const url = localStorage.getItem('btc_script_url');
            if (url) {
                document.getElementById('apiUrlInput').value = url;
            }
        }

        // === AI RE-READ: อ่านภาพบิลเดิมใหม่ด้วย AI — แสดงผลให้ดู/ติ๊กช่องก่อนบันทึก (กัน AI อ่านใหม่ไม่ดีกว่าค่าเดิม) ===
        // runWithTimeout — กันปุ่มหมุนค้างเงียบตลอดไป: ถ้างานฝั่งหลังบ้านหรือ network ไม่จบในเวลาที่กำหนด
        //              จะตัดพอให้จบ + โชว์ Toast บอกตรงๆ ว่าต้องตรวจอะไร (แม้ฝั่งโค้ดจะถูกก็ตาม)
        function runWithTimeout(promise, ms, timeoutMsg) {
            return new Promise(function (resolve, reject) {
                const timer = setTimeout(function () {
                    reject(new Error(timeoutMsg || ('การทำงานยังไม่เสร็จภายใน ' + Math.round(ms / 1000) + ' วินาที')));
                }, ms);
                promise.then(function (v) { clearTimeout(timer); resolve(v); }, function (e) { clearTimeout(timer); reject(e); });
            });
        }

        function tryLog() {
            if (typeof console !== 'undefined' && console.log) console.log.apply(console, arguments);
        }

        let reanalyzePreviewSnapshot = null;  // เก็บผล PREVIEW (ข้อมูลใหม่ที่ AI อ่าน) รอ User กดบันทึก/ยกเลิก

        function reanalyzeCurrentBill(btn) {
            if (reanalyzeRunning) { showToast('ระบบกำลังอ่านใหม่บางรายการอยู่ กรุณารอให้เสร็จก่อน', 'error'); return; }
            const item = currentDetailItem || (currentDetailIndex !== null && filteredData[currentDetailIndex] ? filteredData[currentDetailIndex] : null);
            if (!item) { showToast('ไม่พบข้อมูลบิลที่เปิดอยู่', 'error'); return; }
            const doc_key = item.doc_key || item.docKey || '';
            if (!doc_key && !item.timestamp && !item.po_number && !(item.image_url || item.image_original_url)) {
                showToast('บิลนี้ไม่มีข้อมูลอ้างอิงเพียงพอสำหรับค้นหาแถว', 'error');
                return;
            }
            const orig = btn ? btn.innerHTML : '';
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> อ่านใหม่...'; }
            reanalyzeRunning = true;
            tryLog('[RE-READ] เริ่ม PREVIEW doc_key=' + doc_key, 'image_url=', item.image_url || item.image_original_url || '');
            runWithTimeout(
                scriptCall('reanalyzeReceipt', { doc_key: doc_key, system_record_no: item.system_record_no || '', image_url: item.image_url || item.image_original_url || '', timestamp: item.timestamp || item.submitted_at || '', old_po_number: item.po_number || '', total_amount: item.total_amount }),
                90000,
                'การอ่านภาพใหม่ยังไม่เสร็จใน 90 วินาที — เปิด Console (F12) แล้วดู Log สีแดง / เปิดช่อง Log ใน Apps Script ดูจุดที่หยุด แล้วกดปุ่มอีกครั้ง'
            )
                .then(function (res) {
                    if (res && res.preview) {
                        // รองรับทั้งเวอร์ชันใหม่ที่ส่ง preview + success=true และเวอร์ชันเก่า/compat ที่ส่ง preview แม้ success=false
                        reanalyzePreviewSnapshot = { doc_key: doc_key, system_record_no: item.system_record_no || '', image_url: item.image_url || item.image_original_url || '', timestamp: item.timestamp || item.submitted_at || '', old_po_number: item.po_number || '', total_amount: item.total_amount, data: res.data, items: res.items, changed: res.changed };
                        openReanalyzePreview(res);
                        if (res && res.success === false && res.message) {
                            tryLog('[RE-READ] backend ส่ง preview พร้อม warning แต่ยังมี message:', res.message);
                        }
                    } else if (res && res.success) {
                        // ฝั่งหลังบ้านยังเป็นเวอร์ชันเดิม (เขียนทับทันที) — แจ้งให้ Deploy ใหม่เพื่อได้ระบบเลือกรับ
                        showToast((res.message || 'อ่านภาพใหม่เรียบร้อยแล้ว') + (res.diff && res.diff.length ? ' / ' + res.diff.join(' · ') : ''), 'success');
                        refreshData();
                    } else {
                        tryLog('[RE-READ] ฝั่งหลังบ้านตอบไม่สำเร็จ', res);
                        showToast((res && res.message) || 'อ่านภาพใหม่ไม่สำเร็จ — ข้อมูลเดิมยังคงอยู่', 'error');
                    }
                })
                .catch(function (err) {
                    tryLog('[RE-READ] ผิดพลาด/หมดเวลา:', err && err.message ? err.message : err);
                    showToast('อ่านภาพใหม่ไม่สำเร็จ: ' + ((err && err.message) ? err.message : String(err)), 'error');
                })
                .then(function () {
                    reanalyzeRunning = false;
                    if (btn) { btn.disabled = false; btn.innerHTML = orig; }
                });
        }

        function openReanalyzePreview(res) {
            const modal = document.getElementById('reanalyzePreviewModal');
            if (!modal) { showToast('อ่านภาพใหม่เสร็จแล้ว — เปิดดูบิลเต็มแล้วกด อ่านใหม่ (AI) อีกครั้ง', 'success'); return; }
            const title = document.getElementById('reanalyzePreviewTitle');
            const body = document.getElementById('reanalyzePreviewBody');
            const diffs = (res && Array.isArray(res.diffs)) ? res.diffs : [];
            if (title) title.textContent = (res && res.label) ? res.label : 'ผลการอ่านภาพใหม่ (AI)';
            let html = '';
            if (diffs.length) {
                html += '<div class="text-[11px] text-slate-500 mb-2">อ่านแล้วต่างจากเดิม '
                    + diffs.length + ' จุด — ติ๊กเฉพาะช่องที่ต้องการใช้ค่าใหม่ (ค่าอื่นคงของเดิม) แล้วกด บันทึก</div><div class="space-y-1.5">';
                diffs.forEach(function (d, i) {
                    html += '<label class="flex items-start gap-2 border border-slate-200 rounded-lg px-2.5 py-2 cursor-pointer hover:bg-sky-50 transition">'
                        + '<input type="checkbox" class="reanalyzePick mt-0.5" data-key="' + escapeHtml(d.key) + '" checked>'
                        + '<span class="flex-1 min-w-0"><span class="text-xs font-semibold text-slate-700 block">' + escapeHtml(d.label) + '</span>'
                        + '<span class="text-[11px] text-slate-400 block">เดิม: ' + escapeHtml(d.old) + '</span>'
                        + '<span class="text-[11px] text-emerald-700 font-semibold block">ใหม่: ' + escapeHtml(d.new) + '</span></span></label>';
                });
                html += '</div>';
            } else {
                html += '<div class="text-sm text-slate-500 p-3 border border-slate-200 rounded-lg">AI อ่านภาพนี้แล้วได้ค่าตรงกับข้อมูลเดิมทั้งหมด — กดบันทึกได้ (ไม่เปลี่ยนอะไร) หรือยกเลิกก็ได้</div>';
            }
            if (body) body.innerHTML = html;
            modal.classList.remove('hidden');
        }

        function closeReanalyzePreview() {
            const modal = document.getElementById('reanalyzePreviewModal');
            if (modal) modal.classList.add('hidden');
            reanalyzePreviewSnapshot = null;
        }

        function saveReanalyzedData() {
            const snap = reanalyzePreviewSnapshot;
            if (!snap) { closeReanalyzePreview(); return; }
            const checked = [];
            document.querySelectorAll('#reanalyzePreviewBody input.reanalyzePick:checked').forEach(function (cb) {
                checked.push(cb.getAttribute('data-key') || '');
            });
            if (!checked.length) { showToast('ยังไม่ได้เลือกช่องที่จะบันทึก — ติ๊กอย่างน้อย 1 ช่อง หรือกดยกเลิก', 'error'); return; }
            const saveBtn = document.getElementById('reanalyzeSaveBtn');
            const orig = saveBtn ? saveBtn.innerHTML : '';
            if (saveBtn) { saveBtn.disabled = true; saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังบันทึก...'; }
            scriptCall('applyReanalyzedData', { doc_key: snap.doc_key, system_record_no: snap.system_record_no || '', image_url: snap.image_url || '', timestamp: snap.timestamp || '', old_po_number: snap.old_po_number || '', total_amount: snap.total_amount, data: snap.data, items: snap.items, selectedKeys: checked })
                .then(function (res) {
                    if (res && res.success) {
                        const dTxt = (Array.isArray(res.diff) && res.diff.length) ? ' / ' + res.diff.join(' · ') : '';
                        showToast((res.message || 'บันทึกข้อมูลใหม่เรียบร้อยแล้ว') + dTxt, 'success');
                        closeReanalyzePreview();
                        bumpImageEpoch('reanalyze'); // v3.15.8: DB เปลี่ยน → รูปทุกรูปโหลดใหม่รอบหน้า
                        refreshData();
                    } else {
                        showToast((res && res.message) || 'บันทึกข้อมูลใหม่ไม่สำเร็จ', 'error');
                    }
                })
                .catch(function (err) {
                    tryLog('[RE-READ-SAVE] ผิดพลาด:', err && err.message ? err.message : err);
                    showToast('บันทึกข้อมูลใหม่ไม่สำเร็จ: ' + ((err && err.message) ? err.message : String(err)), 'error');
                })
                .then(function () {
                    if (saveBtn) { saveBtn.disabled = false; saveBtn.innerHTML = orig; }
                });
        }

        function showToast(msg, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.innerText = msg;
            if (type === 'error') {
                toastIcon.className = "fa-solid fa-circle-exclamation text-amber-400 text-base";
            } else {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-base";
            }

            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }
    </script>
</body>

</html>
