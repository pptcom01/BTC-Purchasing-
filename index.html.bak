                </div>

                <!-- แจ้งสถานะเอกสารที่จับคู่มาแล้วกับใบสั่งซื้อนี้ (โชว์เฉพาะ PO ที่มีลิงก์ — ปุ่มพาไปแถบจับคู่ตรวจสอบ/ยืนยัน/ลบ) -->
                <div id="modalMatchSummary"
                    class="hidden bg-emerald-50/60 border border-emerald-200 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
                    <div class="flex items-start gap-2">
                        <i class="fa-solid fa-link mt-0.5 text-btc-green"></i>
                        <div>
                            <div id="modalMatchSummaryText" class="font-bold text-slate-800">-</div>
                            <div class="text-[11px] text-slate-500 mt-0.5">ตรวจสอบการจับคู่ แล้วยืนยันหรือลบในแถบ "จับคู่"</div>
                        </div>
                    </div>
                    <button onclick="showDetailTab('match')"
                        class="ui-btn ui-btn--primary shrink-0 flex items-center gap-1.5">
                        <i class="fa-solid fa-list-check"></i> ไปตรวจสอบที่แถบจับคู่
                    </button>
                </div>

                <!-- แถบข้อมูลใบชั่ง (โชว์เฉพาะ doc_type = ใบชั่ง) -->
