    <!-- Google Font: Kanit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Supabase JS Client (อ่านบิลจาก Supabase ตรงฝั่งเว็บ — anon key + RLS อ่านอย่างเดียว) -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.49.4"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

    <style>
        body {
            font-family: 'Kanit', 'Inter', sans-serif;
        }

        /* ♿ v3.12.2 Contrast fix: text-slate-300/400 (#cbd5e1/#94a3b8) บนพื้นขาว/พื้นอ่อน contrast ต่ำกว่ามาตรฐาน WCAG AA (ต้อง ≥4.5:1; 400 = ~2.9:1, 300 = ~1.9:1)
           ยกเป็นเทากลาง #64748b (slate-500 = ~4.76:1 ✅) ทีเดียวครอบคลุมทุกจุดโดยไม่ต้อง rebuild Tailwind
           — hover:text-* ยังทำงานปกติ (specificity .hover\:text-slate-900:hover สูงกว่า) และป้ายที่อยู่บนพื้นเข้ม (ถ้ามีในอนาคต) ให้ override ตรงจุดแทน */
        .text-slate-400 {
            color: #64748b;
        }

        .text-slate-300 {
            color: #64748b;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* หน้าในเมนูซ้าย: กัน .hidden ถูกกลบด้วย md:flex (มิฉะนั้นทุกหน้าจะแสดงซ้อนกันบนจอกว้าง) */
        #pageOverview.hidden,
        #pageTable.hidden,
        #supplierAnalysisPanel.hidden,
        #priceTrackerPanel.hidden,
        #matchedViewContainer.hidden,
        #gridViewContainer.hidden,
        #tableViewContainer.hidden {
            display: none !important;
        }
    /* === SUPPLEMENTARY UTILITIES — คลาสที่เพิ่มภายหลัง build ครั้งล่าสุด (append เท่านั้น ไม่แก้ของเดิม) === */
.max-w-6xl{max-width:72rem}.max-h-\[52vh\]{max-height:52vh}.min-w-\[1\.25rem\]{min-width:1.25rem}.cursor-zoom-in{cursor:zoom-in}.text-4xl{font-size:2.25rem;line-height:2.5rem}.mb-3{margin-bottom:.75rem}.mt-1\.5{margin-top:.375rem}.mr-0\.5{margin-right:.125rem}.p-3\.5{padding:.875rem}.px-1\.5{padding-left:.375rem;padding-right:.375rem}.py-3\.5{padding-top:.875rem;padding-bottom:.875rem}.z-\[60\]{z-index:60}.bg-sky-50{--tw-bg-opacity:1;background-color:rgb(240 249 255/var(--tw-bg-opacity,1))}.border-sky-200{--tw-border-opacity:1;border-color:rgb(186 230 253/var(--tw-border-opacity,1))}.text-sky-700{--tw-text-opacity:1;color:rgb(3 105 161/var(--tw-text-opacity,1))}
