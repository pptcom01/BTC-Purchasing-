-shadow:var(--tw-ring-offset-shadow),var(--tw-ring-shadow),var(--tw-shadow,0 0 #0000)}.ring-amber-300{--tw-ring-color:#fcd34d}.rounded-t-lg{border-top-left-radius:.5rem;border-top-right-radius:.5rem}.select-none{user-select:none}.shadow{box-shadow:0 1px 3px 0 rgb(0 0 0/.1),0 1px 2px -1px rgb(0 0 0/.1)}.text-amber-900{color:#78350f}.text-amber-950{color:#451a03}.text-blue-900{color:#1e3a8a}.text-blue-950{color:#172554}.text-emerald-900{color:#064e3b}.text-indigo-600{color:#4f46e5}.text-indigo-700{color:#4338ca}.text-indigo-900{color:#312e81}.text-orange-700{color:#c2410c}.text-purple-900{color:#581c87}.text-red-800{color:#991b1b}.text-sky-800{color:#075985}.top-1\/2{top:50%}.top-2{top:0.5rem}.transition-colors{transition-property:color,background-color,border-color,text-decoration-color,fill,stroke;transition-timing-function:cubic-bezier(.4,0,.2,1);transition-duration:150ms}
@media (min-width:640px){.sm\:ml-12{margin-left:3rem}.sm\:p-5{padding:1.25rem}.sm\:px-6{padding-left:1.5rem;padding-right:1.5rem}}
@media (min-width:768px){.md\:items-center{align-items:center}.md\:pb-0{padding-bottom:0px}}
@media (min-width:1024px){.lg\:w-1\/2{width:50%}}
</style>

<!-- === 🎨 UI STANDARD (Phase 1 — 2026-09-23): design tokens + components (CSS ล้วน ไม่พึ่ง Tailwind build — ของใหม่ใช้ class ui-* เท่านั้น) === -->
<style id="ui-standard">
    :root {
        /* สี — lock แบรนด์เดียว: ห้ามใช้ emerald-600 เป็น primary แทน btc-green */
        --ui-brand: #27AE60;
        --ui-brand-hover: #219653;
        --ui-ok: #059669;        /* สถานะสำเร็จ/จับคู่แล้ว */
        --ui-pending: #D97706;   /* สถานะรอตรวจสอบ */
        --ui-danger: #DC2626;    /* ลบ/ผิดพลาด */
        --ui-info: #0284C7;      /* ใบส่งของ/ข้อมูล */
        --ui-role: #7C3AED;      /* บทบาทโซ่ (3-Way) */
        --ui-muted: #64748B;     /* ข้อความรอง (จุดเดียวกับ patch .text-slate-400 เดิม) */
        /* radius — 3 ระดับเท่านั้น ห้ามปน */
        --ui-r-btn: 0.5rem;
        --ui-r-card: 0.75rem;
        --ui-r-pill: 9999px;
        /* ตัวอักษร — 5 ระดับเท่านั้น แทน text-[10px]/[11px] มั่ว */
        --ui-fs-xs: 0.6875rem;   /* 11px — caption ในตาราง */
        --ui-fs-sm: 0.75rem;     /* 12px — text มาตรฐาน UI */
        --ui-fs-md: 0.875rem;    /* 14px — ปุ่ม/หัวข้อเล็ก */
        --ui-fs-lg: 1rem;        /* 16px — หัวข้อ */
        --ui-fs-xl: 1.5rem;      /* 24px — ตัวเลข KPI */
    }

    /* ---- Button ---- */
    .ui-btn {
        display: inline-flex; align-items: center; gap: .375rem;
        font-size: var(--ui-fs-md); font-weight: 600;
        border-radius: var(--ui-r-btn); padding: .5rem 1rem;
        transition: .15s; border: 1px solid transparent; cursor: pointer;
    }
    .ui-btn--sm { font-size: var(--ui-fs-sm); padding: .375rem .625rem; }
    .ui-btn--primary { background: var(--ui-brand); color: #fff; }
    .ui-btn--primary:hover { background: var(--ui-brand-hover); }
    .ui-btn--ghost { background: #fff; color: #475569; border-color: #E2E8F0; }
    .ui-btn--ghost:hover { background: #F8FAFC; }
    .ui-btn--danger { background: #fff; color: var(--ui-danger); border-color: #FECACA; }
    .ui-btn--danger:hover { background: #FEF2F2; }
    .ui-btn--primary:disabled { background: #E2E8F0; color: #475569; cursor: not-allowed; }
    /* v3.15.6: ปุ่ม disabled แบบสลับ class ด้วย JS (ไม่ได้ใช้ attribute disabled) — สไตล์เดียวกับ :disabled */
    .ui-btn--disabled { background: #E2E8F0 !important; color: #475569 !important; cursor: not-allowed; }

    /* ---- Badge / Chip ---- */
    .ui-badge {
        display: inline-flex; align-items: center; gap: .25rem;
        font-size: var(--ui-fs-xs); font-weight: 600; padding: .125rem .5rem;
        border-radius: var(--ui-r-pill); border: 1px solid; white-space: nowrap;
    }
    .ui-badge--ok      { background: #D1FAE5; color: var(--ui-ok);      border-color: #6EE7B7; }
    .ui-badge--pending { background: #FEF3C7; color: #92400E;          border-color: #FCD34D; }
    .ui-badge--role    { background: #EDE9FE; color: #5B21B6;          border-color: #C4B5FD; }
    .ui-badge--muted   { background: #F1F5F9; color: var(--ui-muted);  border-color: #CBD5E1; }
    .ui-badge--danger  { background: #FEE2E2; color: #991B1B;          border-color: #FCA5A5; }
    .ui-badge--info    { background: #E0F2FE; color: var(--ui-info);   border-color: #7DD3FC; }
    .ui-badge--scale   { background: #FFEDD5; color: #C2410C;          border-color: #FDBA74; }
    .ui-badge--orange  { background: #FFEDD5; color: #9A3412;          border-color: #FED7AA; } /* v3.15.6: ป้ายวันที่รอตรวจ + สถานะกลาง */
    .ui-badge--muted-orange { background: #FFF7ED; color: #9A3412;    border-color: #FED7AA; } /* v3.15.6: ป้ายนับจำนวนบนพื้นอ่อน */

    /* v3.15.6: ขนาดเล็กพิเศษสำหรับ badge ซ้อนในแท็บ/การ์ดแน่น */
    .ui-badge--xs { font-size: 0.625rem; padding: 0.0625rem 0.375rem; }

    /* ---- Card / Table header ---- */
    .ui-card {
        background: #fff; border: 1px solid #E2E8F0;
        border-radius: var(--ui-r-card); box-shadow: 0 1px 2px rgb(0 0 0/.05);
    }
    .ui-th {
        background: #F8FAFC; color: #475569; font-size: var(--ui-fs-sm);
        font-weight: 600; padding: .75rem .875rem; text-align: left;
    }

    /* ---- Tab (กลาง — แทน activeCls/idleCls 4 จุดใน JS) ---- */
    .ui-tab {
        font-size: var(--ui-fs-sm); font-weight: 600; padding: .375rem .75rem;
        border-radius: var(--ui-r-btn); color: #475569; transition: .15s;
        background: transparent; border: 0; cursor: pointer;
    }
    .ui-tab:hover { color: #1E293B; }
    .ui-tab.is-active { background: #fff; color: #1E293B; box-shadow: 0 1px 2px rgb(0 0 0/.06); }

    /* ---- Input ---- */
    .ui-input {
        width: 100%; padding: .5rem .75rem; font-size: var(--ui-fs-sm);
        border: 1px solid #CBD5E1; border-radius: var(--ui-r-btn); background: #fff;
    }
    .ui-input:focus { outline: none; border-color: var(--ui-brand); box-shadow: 0 0 0 2px rgb(39 174 96/.25); }

    /* ---- 📖 READABILITY GUARD (2026-09-23): ห้ามช่องกรอกข้อมูล/placeholder มีสีกลืนพื้น บังคับทุกเมนูให้อ่านออกเท่ากัน ---- */
    input, select, textarea { color: #1E293B; }                       /* ตัวอักษรในช่องกรอก = เข้มเสมอ ไม่ว่าเมนูไหน */
    input::placeholder, textarea::placeholder { color: #64748B; }     /* placeholder อ่านออกบนพื้นขาว (≥4.5:1) */
    select option { color: #1E293B; background: #FFFFFF; }
</style>
</head>

<body class="h-full text-slate-800 bg-slate-100 flex flex-col custom-scrollbar md:overflow-hidden">

    <!-- Top Header Bar -->
    <header class="bg-white text-slate-800 sticky top-0 z-30 shadow-sm border-t-4 border-btc-green border-b border-slate-200 shrink-0">
        <div class="max-w-none w-full px-2 sm:px-4 lg:px-6 xl:px-8">
            <div class="flex items-center justify-between h-14">
                <!-- Brand & Logo -->
                <div class="flex items-center space-x-3">
                    <div
                        class="bg-white p-1 rounded-xl w-10 h-10 shadow-sm flex items-center justify-center overflow-hidden border border-slate-200">
                        <img src="https://img2.pic.in.th/pic/Screenshot-2025-03-03-132721e6cc77cbcea28f01.png"
                            alt="โลโก้ บุรีรัมย์ธงชัยก่อสร้าง" class="w-full h-full object-contain"
                            onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'bg-btc-green w-full h-full text-white font-bold text-sm flex items-center justify-center rounded-lg\'>BTC</div>';">
                    </div>
                    <div>
                        <h1 class="font-bold text-lg leading-tight text-slate-900 flex items-center gap-2">
                            ระบบตรวจสอบและสแกนบิลจัดซื้อ
                            <span id="versionBadge"
                                class="ui-badge ui-badge--muted">v3.17.4</span>
                        </h1>
                        <p class="text-xs text-slate-400">
                            <span>บริษัท บุรีรัมย์ธงชัยก่อสร้าง จำกัด</span>
                        </p>
                    </div>
                </div>

                <!-- Live Sync & API Status -->
                <div class="flex items-center space-x-3">
                    <button onclick="refreshData()"
                        class="flex items-center gap-2 bg-white hover:bg-slate-50 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium border border-slate-200 transition">
                        <i id="syncIcon" class="fa-solid fa-rotate"></i>
                        <span class="hidden sm:inline">รีเฟรชข้อมูล</span>
                    </button>
                    <!-- ปุ่ม "เชื่อมต่อ Google Sheets API" ถูกย้ายไปอยู่ใน ตั้งค่าระบบ (ต้องใช้รหัสผ่าน) — กันคนทั่วไปเปลี่ยนแหล่งข้อมูล -->
                </div>
            </div>
        </div>
    </header>

    <!-- Sidebar + Main Content Wrapper (ต่อเนื่องกับ header/footer = แอปเดียวกัน) -->
    <div class="flex flex-1 min-h-0 overflow-hidden">

        <!-- Left Sidebar Navigation (desktop) -->
        <aside class="hidden md:flex flex-col w-56 shrink-0 min-h-0 bg-slate-50 text-slate-700 border-r border-slate-200">
            <div class="px-4 py-3 text-[10px] font-bold uppercase tracking-widest text-slate-400 border-b border-slate-200">
                <i class="fa-solid fa-bars-staggered mr-1"></i> เมนู
            </div>
            <nav class="flex-1 min-h-0 py-2 space-y-1 overflow-y-auto custom-scrollbar">
            <button type="button" data-page="overview" onclick="switchPage('overview')"
                class="sidebar-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition border-l-4 border-transparent text-left">
                <i class="fa-solid fa-chart-pie w-5 text-center shrink-0"></i>
                <span>ภาพรวม</span>
            </button>
            <button type="button" data-page="table" onclick="switchPage('table')"
                class="sidebar-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition border-l-4 border-transparent text-left">
                <i class="fa-solid fa-table-list w-5 text-center shrink-0"></i>
                <span>ตารางบิล</span>
            </button>
                <button type="button" data-page="3way" onclick="switchPage('3way')"
                    class="sidebar-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition border-l-4 border-transparent text-left">
                    <i class="fa-solid fa-scale-balanced w-5 text-center shrink-0"></i>
                    <span>ตรวจวางบิล 3-Way</span>
                </button>
                <button type="button" data-page="supplier" onclick="switchPage('supplier')"
                    class="sidebar-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition border-l-4 border-transparent text-left">
                    <i class="fa-solid fa-store w-5 text-center shrink-0"></i>
                    <span>วิเคราะห์ร้านค้า</span>
                </button>
                <button type="button" data-page="price" onclick="switchPage('price')"
                    class="sidebar-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition border-l-4 border-transparent text-left">
                    <i class="fa-solid fa-tags w-5 text-center shrink-0"></i>
                    <span>ติดตามราคาวัสดุ</span>
                </button>
                <button type="button" data-page="vendor" onclick="switchPage('vendor')"
                    class="sidebar-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition border-l-4 border-transparent text-left">
                    <i class="fa-solid fa-file-invoice w-5 text-center shrink-0"></i>
                    <span>วางบิล / ใบกำกับ</span>
                </button>
            </nav>
            <!-- v3.15.10: กลุ่มล่าง — เอกสารสำหรับ AI ย้ายมารวมกับข้อมูลองค์กร/ตั้งค่าระบบ (ตาม User) -->
            <div class="px-2 py-2 border-t border-slate-200">
                <button type="button" data-page="aitemplates" onclick="switchPage('aitemplates')"
                    class="sidebar-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition border-l-4 border-transparent text-left">
                    <i class="fa-solid fa-book w-5 text-center shrink-0"></i>
                    <span>เอกสารสำหรับ AI</span>
                </button>
                <button type="button" onclick="openCompanyModal()"
                    class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition border-l-4 border-transparent text-left">
                    <i class="fa-solid fa-building-circle-check w-5 text-center shrink-0"></i>
                    <span>ข้อมูลองค์กร</span>
                </button>
                <button type="button" onclick="openSettingsModal()"
                    class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition border-l-4 border-transparent text-left">
                    <i class="fa-solid fa-gear w-5 text-center shrink-0"></i>
                    <span>ตั้งค่าระบบ</span>
                </button>
            </div>
            <div class="px-4 py-3 border-t border-slate-200 text-[10px] text-slate-500 leading-relaxed">
                <i class="fa-solid fa-circle-info mr-1"></i> ข้อมูลดึงจาก Google Sheets ผ่าน LINE + Gemini
            </div>
        </aside>

        <!-- Main Body Container -->
        <main class="flex-1 w-full min-w-0 bg-white px-3 sm:px-4 lg:px-6 xl:px-8 py-4 space-y-3 md:flex md:flex-col md:min-h-0">

        <!-- Mobile page switcher (collapsed sidebar) -->
        <div class="md:hidden flex items-center gap-1.5 overflow-x-auto custom-scrollbar pb-0.5">
            <button type="button" data-page="overview" onclick="switchPage('overview')"
                class="mobile-page-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-btc-green text-white whitespace-nowrap transition">
                <i class="fa-solid fa-chart-pie mr-1"></i>ภาพรวม
            </button>
            <button type="button" data-page="table" onclick="switchPage('table')"
                class="mobile-page-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 whitespace-nowrap transition">
                <i class="fa-solid fa-table-list mr-1"></i>ตารางบิล
            </button>
            <button type="button" data-page="3way" onclick="switchPage('3way')"
                class="mobile-page-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 whitespace-nowrap transition">
                <i class="fa-solid fa-scale-balanced mr-1"></i>ตรวจ 3-Way
            </button>
            <button type="button" data-page="supplier" onclick="switchPage('supplier')"
                class="mobile-page-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 whitespace-nowrap transition">
                <i class="fa-solid fa-store mr-1"></i>วิเคราะห์ร้านค้า
            </button>
            <button type="button" data-page="price" onclick="switchPage('price')"
                class="mobile-page-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 whitespace-nowrap transition">
                <i class="fa-solid fa-tags mr-1"></i>ติดตามราคา
            </button>
            <button type="button" data-page="vendor" onclick="switchPage('vendor')"
                class="mobile-page-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 whitespace-nowrap transition">
                <i class="fa-solid fa-file-invoice mr-1"></i>วางบิล
            </button>
            <button type="button" data-page="aitemplates" onclick="switchPage('aitemplates')"
                class="mobile-page-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 whitespace-nowrap transition">
                <i class="fa-solid fa-book mr-1"></i>เอกสาร AI
            </button>
            <button type="button" onclick="openCompanyModal()"
                class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 whitespace-nowrap transition">
                <i class="fa-solid fa-building-circle-check mr-1"></i>ข้อมูลองค์กร
            </button>
            <button type="button" onclick="openSettingsModal()"
                class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 whitespace-nowrap transition">
                <i class="fa-solid fa-gear mr-1"></i>ตั้งค่าระบบ
            </button>
        </div>

        <!-- Overview Page (KPI + Search + Table/Grid) -->
        <div id="pageOverview" class="space-y-4">

        <!-- KPI Cards Summary -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
            <!-- Total Amount -->
            <div
                class="ui-card p-3 border-l-4 border-l-btc-green flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-400">ยอดจัดซื้อรวมทั้งหมด</p>
                    <h3 id="statTotalAmount" class="text-3xl font-bold text-slate-900 mt-1">฿0.00</h3>
                    <p class="text-xs text-slate-400 mt-1 flex items-center gap-1">
                        <i class="fa-solid fa-chart-line"></i> คำนวณตามรายการสินค้าจริง
                    </p>
                </div>
                <div
                    class="w-11 h-11 bg-emerald-50 text-btc-green rounded-lg flex items-center justify-center text-lg">
                    <i class="fa-solid fa-wallet"></i>
                </div>
            </div>

            <!-- Total Receipts Count -->
            <div
                class="ui-card p-3 border-l-4 border-l-btc-green flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-400">จำนวนบิล / เอกสาร</p>
                    <h3 id="statTotalCount" class="text-3xl font-bold text-slate-900 mt-1">0 ใบ</h3>
                    <p id="statTotalItemCount" class="text-xs text-slate-500 mt-1">รวม 0 รายการสินค้า</p>
                </div>
                <div
                    class="w-11 h-11 bg-emerald-50 text-btc-green rounded-lg flex items-center justify-center text-lg">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>
            </div>

            <!-- Top Category -->
            <div
                class="ui-card p-3 border-l-4 border-l-btc-green flex items-center justify-between">
                <div>
<p class="text-xs font-medium text-slate-400">หมวดหมู่หลัก</p>
                        <h3 id="statTopCategory" class="text-3xl font-bold text-slate-900 mt-1 truncate max-w-[150px]">-</h3>
                    <p id="statTopCategorySub" class="text-xs text-slate-500 mt-1">ยอดจัดซื้อสูงสุด</p>
                </div>
                <div
                    class="w-11 h-11 bg-emerald-50 text-btc-green rounded-lg flex items-center justify-center text-lg">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
            </div>

            <!-- Suppliers Count -->
            <div
                class="ui-card p-3 border-l-4 border-l-btc-green flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-400">ร้านค้า / ซัพพลายเออร์</p>
                    <h3 id="statSupplierCount" class="text-3xl font-bold text-slate-900 mt-1">0 ร้าน</h3>
                    <p class="text-xs text-slate-500 mt-1">คู่ค้าฝ่ายจัดซื้อ</p>
                </div>
                <div
                    class="w-11 h-11 bg-emerald-50 text-btc-green rounded-lg flex items-center justify-center text-lg">
                    <i class="fa-solid fa-store"></i>
                </div>
            </div>

            <!-- Senders Count (ผู้ส่งบิลจาก LINE) -->
            <div
                class="ui-card p-3 border-l-4 border-l-btc-green flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-400">ผู้ส่งบิล (LINE)</p>
                    <h3 id="statSenderCount" class="text-3xl font-bold text-slate-900 mt-1">0 คน</h3>
                    <p id="statSenderSub" class="text-xs text-slate-500 mt-1 truncate max-w-[160px]">
                        ยังไม่มีข้อมูลผู้ส่ง</p>
                </div>
                <div
                    class="w-11 h-11 bg-emerald-50 text-btc-green rounded-lg flex items-center justify-center text-lg">
                    <i class="fa-solid fa-user-pen"></i>
                </div>
            </div>
        </div>

        <!-- Charts Summary (แนวโน้มรายเดือน + สัดส่วนหมวดหมู่ — ใช้ชุดข้อมูลเดียวกับ KPI) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-2.5">
            <div class="lg:col-span-2 bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-chart-line text-btc-green"></i> แนวโน้มยอดจัดซื้อรายเดือน
                    </h3>
                    <span id="monthlyChartNote" class="text-[10px] text-slate-400"></span>
                </div>
                <div class="relative" style="height: 260px;">
                    <canvas id="monthlyTrendChart"></canvas>
                </div>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2 mb-2">
                    <i class="fa-solid fa-chart-pie text-btc-green"></i> สัดส่วนตามหมวดหมู่
                </h3>
                <div class="relative" style="height: 260px;">
                    <canvas id="categoryPieChart"></canvas>
                </div>
            </div>
        </div>

        </div><!-- /pageOverview -->

        <!-- Table Page (แยกจากภาพรวม — ค้นหา/ตัวกรอง/ตาราง/การ์ด) -->
        <div id="pageTable" class="hidden md:flex md:flex-col md:flex-1 md:min-h-0" style="display:none">
        <!-- แท็บหน้าตารางบิล: บิลทั้งหมด / ใบสั่งซื้อ / บิลที่จับคู่แล้ว -->
        <div class="px-3 pt-3 flex flex-wrap items-center gap-2">
            <div class="bg-slate-100 p-1 rounded-lg border border-slate-200 flex items-center gap-1 flex-wrap gap-y-1">
                <button id="billTabBtnOther" onclick="setBillTab('other')"
                    class="ui-tab is-active">
                    <i class="fa-solid fa-file-lines mr-1"></i> บิลทั้งหมด
                    <span id="tabBadgeOtherCount" class="ml-1.5 ui-badge ui-badge--xs ui-badge--muted"></span>
                    <span id="tabBadgeOtherReview" class="ml-1 hidden ui-badge ui-badge--xs ui-badge--pending"></span>
                </button>
                <button id="billTabBtnPo" onclick="setBillTab('po')"
                    class="ui-tab">
                    <i class="fa-solid fa-clipboard-list mr-1"></i> ใบสั่งซื้อ
                    <span id="tabBadgePoCount" class="ml-1.5 ui-badge ui-badge--xs ui-badge--muted"></span>
                    <span id="tabBadgePoPending" class="ml-1 hidden ui-badge ui-badge--xs ui-badge--pending"></span>
                </button>
                <button id="billTabBtnMatched" onclick="setBillTab('matched')"
                    class="ui-tab">
                    <i class="fa-solid fa-link mr-1"></i> บิลที่จับคู่แล้ว
                    <span id="tabBadgeMatchedCount" class="ml-1.5 ui-badge ui-badge--xs ui-badge--muted"></span>
                    <span id="tabBadgeMatchedPending" class="ml-1 hidden ui-badge ui-badge--xs ui-badge--pending"></span>
                </button>
            </div>
            <div class="flex items-center gap-2 flex-wrap w-full md:w-auto">
                <span id="billTabHint" class="text-[11px] text-slate-400"></span>
                <button id="btnAutoMatch" onclick="runAutoMatchNow()" class="hidden text-[11px] font-semibold bg-sky-600 hover:bg-sky-700 text-white px-2.5 py-1 rounded-lg transition"><i class="fa-solid fa-wand-magic-sparkles mr-1"></i>หาคู่ให้อัตโนมัติ</button>
            </div>
        </div>
        <div class="p-3 space-y-3">
            <div class="flex flex-col md:flex-row gap-3 items-center justify-between">

                <!-- Search Input -->
                <div class="relative w-full md:flex-1 md:max-w-xl">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input type="text" id="searchInput" onkeyup="applyFilters()"
                        placeholder="ค้นหา เลข PO, ร้านค้า, รายการสินค้า, ผู้ส่งบิล..."
                        class="w-full pl-10 pr-4 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-btc-green focus:bg-white transition">
                </div>

                <!-- Filters & Controls -->
                <div class="flex flex-wrap items-center gap-2 w-full md:w-auto justify-end">

                    <!-- แสดงบิลแนบ (ใบรับของที่จับคู่กับบิลส่งของแล้ว — ถูกซ่อนจากตารางปกติ) -->
                    <label class="flex items-center gap-1.5 text-xs font-medium text-slate-600 cursor-pointer select-none">
                        <input type="checkbox" id="showAttachmentsCb" onchange="applyFilters()" class="rounded border-slate-400 text-btc-green focus:ring-btc-green">
                        แสดงบิลแนบ
                    </label>

                    <!-- Quick Expand / Collapse All Toggle -->
                    <button onclick="toggleExpandAllRows()" id="btnExpandAll"
                        class="bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold px-3 py-2 rounded-lg transition flex items-center gap-1.5 border border-slate-200">
                        <i class="fa-solid fa-angles-down"></i>
                        <span id="btnExpandAllText">ขยายทุกรายการ</span>
                    </button>

                    <!-- Category Filter -->
                    <select id="categoryFilter" onchange="applyFilters()"
                        class="bg-white border border-slate-200 rounded-lg text-sm px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-btc-green">
                        <option value="">ทุกหมวดหมู่สินค้า</option>
                        <option value="วัสดุก่อสร้าง">วัสดุก่อสร้าง</option>
                        <option value="น้ำมันเชื้อเพลิง">น้ำมันเชื้อเพลิง</option>
                        <option value="อุปกรณ์ช่าง">อุปกรณ์ช่าง</option>
                        <option value="ค่าแรง/บริการ">ค่าแรง/บริการ</option>
                        <option value="ทั่วไป">ทั่วไป</option>
                    </select>

                    <!-- Accounting Document Filter -->
                    <select id="docTypeFilter" onchange="applyFilters()"
                        class="bg-white border border-slate-200 rounded-lg text-sm px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-btc-green">
                        <option value="">ทุกประเภทเอกสาร</option>
                    </select>

                    <!-- Date Filter -->
                    <select id="dateFilter" onchange="applyFilters()"
                        class="bg-white border border-slate-200 rounded-lg text-sm px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-btc-green">
                        <option value="all">ทุกช่วงเวลา</option>
                        <option value="today">วันนี้</option>
                        <option value="month">เดือนนี้</option>
                        <option value="year">ปีนี้</option>
                    </select>

                    <!-- ป้ายวันที่รอตรวจ (v3.15.5: บิลที่ AI อ่านวันที่ไม่ชัดแล้วระบบเติมเดือน/ปีปัจจุบันแทน) -->
                    <select id="dateFallbackFilter" onchange="applyFilters()"
                        class="bg-white border border-amber-200 rounded-lg text-sm px-3 py-2 text-amber-700 focus:outline-none focus:ring-2 focus:ring-btc-green">
                        <option value="">ทุกสถานะวันที่</option>
                        <option value="fallback">📅 วันที่รอตรวจ (ระบบเติมเดือน/ปีแทน)</option>
                    </select>

                    <!-- สถานะการจับคู่ (ตามหลักการ demo: ทุก / ยังไม่จับ / รอตรวจสอบ / จับคู่แล้ว) -->
                    <select id="matchStatusFilter" onchange="applyFilters()"
                        class="bg-white border border-slate-200 rounded-lg text-sm px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-btc-green">
                        <option value="">ทุกสถานะการจับคู่</option>
                        <option value="unmatched">ยังไม่จับคู่</option>
                        <option value="pending">⏳ รอตรวจสอบ</option>
                        <option value="confirmed">✓ จับคู่แล้ว</option>
                    </select>

                    <!-- บทบาทการจับคู่ (แยกตามโซ่แบบ demo: Master PO / ใบชั่ง / ใบส่งของ·ใบรับของ / บิลอื่น) -->
                    <select id="matchRoleFilter" onchange="applyFilters()"
                        class="bg-white border border-slate-200 rounded-lg text-sm px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-btc-green">
                        <option value="">ทุกบทบาทการจับคู่</option>
                        <option value="po">Master PO</option>
                        <option value="scale">ใบชั่งน้ำหนัก (BULK)</option>
                        <option value="delivery">ใบส่งของ/ใบรับของ</option>
                        <option value="other">บิลอื่น</option>
                    </select>

                </div>
            </div>
        </div>

        <!-- Content Container -->
        <div id="contentSection" class="md:flex md:flex-col md:flex-1 md:min-h-0">
            <!-- Table View Container -->
            <div id="tableViewContainer"
                class="bg-white overflow-hidden relative md:flex md:flex-col md:flex-1 md:min-h-0 border-t border-slate-200">

                <div id="tableScrollArea"
                    class="flex-1 min-h-0 overflow-x-auto overflow-y-auto custom-scrollbar relative">
                    <table class="w-full text-left border-collapse">
                        <thead
                            class="sticky top-0 z-20 bg-slate-50 text-slate-600 text-xs font-semibold border-b border-slate-200">
                            <tr>
                                <th class="p-2.5 w-10 text-center"></th>
                                <th class="p-3">วันที่ในบิล / ผู้ส่งบิล</th>
                                <th class="p-3">เลขที่เอกสาร / PO</th>
                                <th class="p-3">ร้านค้า / ผู้ขาย</th>
                                <th class="p-3">บทบาทการจับคู่</th>
                                <th class="p-3">หมวดหมู่</th>
                                <th class="p-3">สรุปรายการสินค้า</th>
                                <th class="p-3 text-right">ยอดรวมสุทธิ</th>
                                <th class="p-3 text-center">รูปบิล</th>
                                <th class="p-3 text-center">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody" class="divide-y divide-slate-100 text-sm">
                            <!-- Populated by JS -->
                        </tbody>
                    </table>
                </div>

                <button id="btnScrollTopTable" onclick="scrollTopTable()"
                    class="hidden absolute bottom-4 right-4 z-30 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold px-3 py-2 rounded-xl shadow-md border border-slate-200 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-arrow-up"></i>
                    <span>กลับขึ้นบนสุด</span>
                </button>
            </div>

            <!-- Grid View Container -->
            <div id="gridViewContainer"
                class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 content-start md:flex-1 md:min-h-0 custom-scrollbar">
                <!-- Cards populated by JS -->
            </div>

            <!-- Empty State -->
            <div id="emptyState"
                class="hidden bg-white p-12 rounded-xl border border-dashed border-slate-300 text-center space-y-3 md:self-center">
                <div
                    class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto text-2xl">
                    <i class="fa-regular fa-folder-open"></i>
                </div>
                <h4 id="emptyStateTitle" class="text-base font-semibold text-slate-700">ไม่พบรายการเอกสารบิลจัดซื้อ</h4>
                <p id="emptyStateDesc" class="text-xs text-slate-500 max-w-sm mx-auto">ลองเปลี่ยนคำค้นหา
                    หรือกรองตามช่วงเวลาและหมวดใหม่อีกครั้ง</p>
            </div>

            <!-- Matched View Container (แท็บ "บิลที่จับคู่แล้ว" — กลุ่มคู่ PO + บิลรับของ) -->
            <div id="matchedViewContainer"
                class="hidden flex flex-col md:flex-1 md:min-h-0">
                <div id="matchedGroupsList" class="p-4 space-y-4 custom-scrollbar">
                    <!-- Populated by JS -->
                </div>
                <div id="matchedEmptyState" class="hidden p-12 text-center space-y-3">
                    <div
                        class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto text-2xl">
                        <i class="fa-solid fa-link"></i>
                    </div>
                    <h4 class="text-base font-semibold text-slate-700">ยังไม่มีคู่บิลที่จับคู่แล้ว</h4>
                    <p class="text-xs text-slate-500 max-w-sm mx-auto">เข้าแท็บ "ใบสั่งซื้อ" แล้วกด "ดูบิลเต็ม"
                        ของใบสั่งซื้อ → แถบ "จับคู่" เพื่อเลือกบิลรับของมารับของตามสั่งซื้อ</p>
                </div>
            </div>
        </div><!-- /contentSection -->
        </div><!-- /pageTable -->

        <!-- 3-Way Checking Panel (ตรวจวางบิล 3-Way — อินเทอร์เฟซแบบ demo: 5 KPI + แท็บ BULK/UNIT/ORPHAN + ตาราง 4 ส่วน PO/DO/Ticket) -->
        <div id="page3Way" class="hidden md:flex md:flex-col md:flex-1 md:min-h-0" style="display:none">
            <div class="bg-white overflow-hidden md:flex md:flex-col md:flex-1 md:min-h-0 border border-slate-200">

                <!-- Header -->
                <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-scale-balanced text-btc-green"></i>
                        <h2 class="text-sm font-bold text-slate-800">ตรวจวางบิล 3-Way (จับคู่เอกสาร &amp; ตัดสินข้อโต้แย้ง)</h2>
                    </div>
                    <button id="btn3WayRefresh" onclick="refresh3WayData()"
                        class="text-xs font-semibold bg-white hover:bg-slate-100 text-slate-600 border border-slate-200 px-3 py-1.5 rounded-lg transition flex items-center gap-1.5">
                        <i class="fa-solid fa-rotate"></i> รีเฟรชข้อมูล</button>
                </div>

                <!-- Search + Status Filter -->
                <div class="p-4 bg-slate-50 border-b border-slate-200 flex flex-col md:flex-row justify-between items-stretch md:items-center gap-3">
                    <div class="relative flex-1 max-w-md">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                        <input type="text" id="threeWaySearch" onkeyup="render3WayView()"
                            placeholder="ค้นหา PO, ผู้ขาย, เลขที่ DO, ใบชั่งน้ำหนัก, หรือชื่อสินค้า..."
                            class="w-full pl-10 pr-4 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-btc-green transition">
                    </div>
                    <div class="flex items-center gap-2 overflow-x-auto custom-scrollbar pb-1 md:pb-0">
                        <span class="text-xs text-slate-500 font-semibold whitespace-nowrap">กรองสถานะ:</span>
                        <button id="twFilterALL" onclick="set3WayStatusFilter('ALL')" class="threeway-status-btn px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-slate-800 text-white shadow">ทั้งหมด</button>
                        <button id="twFilterMATCHED" onclick="set3WayStatusFilter('MATCHED')" class="threeway-status-btn px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white border border-slate-200 text-slate-600 hover:bg-slate-100">✅ ถูกต้อง</button>
                        <button id="twFilterTOLERANCE" onclick="set3WayStatusFilter('TOLERANCE_EXCEEDED')" class="threeway-status-btn px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white border border-slate-200 text-slate-600 hover:bg-slate-100">⚠️ น้ำหนักเกินเกณฑ์</button>
                        <button id="twFilterWRONG" onclick="set3WayStatusFilter('WRONG_MATCH')" class="threeway-status-btn px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white border border-slate-200 text-slate-600 hover:bg-slate-100">❌ จับคู่ผิด PO</button>
                        <button id="twFilterQTY" onclick="set3WayStatusFilter('QTY_MISMATCH')" class="threeway-status-btn px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white border border-slate-200 text-slate-600 hover:bg-slate-100">📦 ส่งไม่ครบ</button>
                    </div>
                </div>

                <!-- KPI Dashboard -->
                <div id="threeWayKpis" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5 p-4 bg-slate-100/60 border-b border-slate-200">
                    <!-- Populated by JS -->
                </div>

                <!-- Tab Navigation: BULK / UNIT / ORPHAN -->
                <div class="px-4 pt-3 bg-slate-50 border-b border-slate-200 flex flex-wrap gap-2">
                    <button id="twTabBULK" onclick="set3WayTab('BULK')"
                        class="threeway-tab flex items-center gap-2 px-4 py-2 rounded-t-lg text-xs font-semibold transition-all bg-white text-slate-800 border border-b-0 border-slate-200 shadow-sm" style="margin-bottom:-1px">
                        <i class="fa-solid fa-truck text-blue-600"></i> 1.กลุ่มชั่งน้ำหนัก <span id="twTabBulkCount" class="ui-badge ui-badge--xs ui-badge--muted"></span>
                    </button>
                    <button id="twTabUNIT" onclick="set3WayTab('UNIT')"
                        class="threeway-tab flex items-center gap-2 px-4 py-2 rounded-t-lg text-xs font-semibold transition-all bg-white text-slate-500 border border-slate-200 text-slate-600">
                        <i class="fa-solid fa-box text-indigo-600"></i> 2.กลุ่มวัสดุนับชิ้น <span id="twTabUnitCount" class="ui-badge ui-badge--xs ui-badge--muted"></span>
                    </button>
                    <button id="twTabORPHAN" onclick="set3WayTab('ORPHAN')"
