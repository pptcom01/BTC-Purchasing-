        <!-- AI Template Library Page (เอกสารสำหรับ AI) -->
        <div id="pageAITemplates" class="hidden md:flex md:flex-col md:flex-1 md:min-h-0" style="display:none">
            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden flex flex-col min-h-0">
                <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between gap-2 flex-wrap">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-book text-emerald-600"></i>
                        <h3 class="text-sm font-bold text-slate-800">เอกสารสำหรับ AI</h3>
                        <span id="aiTemplateBadge" class="ui-badge ui-badge--pending hidden border-amber-300"></span>
                    </div>
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <button type="button" id="aiModePrompts" onclick="setAIMode('prompts')"
                            class="ui-tab is-active" title="ชุดคำสั่ง AI + ตารางเทียบเกณฑ์มาตรฐานกับค่าที่ระบบใช้จริง">
                            <i class="fa-solid fa-book mr-1"></i>ชุด Prompt & Matrix
                        </button>
                        <button type="button" id="aiModeTaxonomy" onclick="setAIMode('taxonomy')"
                            class="ui-tab" title="ตารางรหัสประเภทเอกสาร + สิทธิ์เครดิตภาษีซื้อ (VAT 7%) + อ้างอิงประมวลรัษฎากร">
                            <i class="fa-solid fa-book-bookmark mr-1"></i>ตารางประเภทเอกสาร & สิทธิ์ภาษี
                        </button>
                        <button type="button" onclick="openCreatePromptModal()"
                            class="ui-btn ui-btn--sm ui-btn--primary">
                            <i class="fa-solid fa-plus mr-1"></i>สร้างชุด Prompt
                        </button>
                        <button type="button" onclick="loadAIPage(true)" title="โหลดใหม่"
                            class="px-2.5 py-1 rounded-lg text-xs text-slate-500 hover:text-slate-800 border border-slate-200 transition">
                            <i class="fa-solid fa-rotate"></i>
                        </button>
                    </div>
                </div>
                <div id="aiTemplateBody" class="flex-1 min-h-0 overflow-y-auto custom-scrollbar p-3">
                    <!-- v3.17.5: ตารางเดียว — เทียบเกณฑ์มาตรฐาน vs ค่าจริง (คลิกเซลล์ค่าจริงเพื่อสลับ ✓/✗ ได้เลย) -->
                    <div id="aiModePromptsView">
                        <div class="text-[11px] text-slate-500 mb-2 leading-relaxed">
                            ตารางเทียบ <b>เกณฑ์มาตรฐาน</b> (สัญลักษณ์บน: ● บังคับ / ○ อ่านเมื่อพบ / – ไม่เกี่ยว) กับ <b>ค่าจริงที่ระบบใช้</b> (สัญลักษณ์ล่าง: ✓ เปิด / ✗ ปิด / · ยังไม่ได้ตั้งค่าชุด) —
                            <span class="text-rose-700 font-semibold">พื้นแดง</span> = เปิดเกินเกณฑ์ (ตรวจสอบ) / <span class="text-slate-700 font-semibold">ขอบเข้ม</span> = เกณฑ์บังคับแต่ยังไม่เปิด —
                            <b>คลิกที่เซลล์</b> (ยกเว้น ·) เพื่อสลับเปิด/ปิดฟิลด์ของชุดนั้น บันทึกทันที
                        </div>
                        <div id="aiPromptNotice" style="display:none" class="hidden text-[11px] mb-3 px-3 py-2 rounded-lg bg-amber-50 text-amber-800 border border-amber-200 leading-relaxed"></div>
                        <div class="overflow-x-auto custom-scrollbar border border-slate-200 rounded-xl">
                            <table class="w-full text-left border-collapse text-xs bg-white">
                                <thead>
                                    <tr class="bg-slate-100 text-slate-700 font-semibold border-b border-slate-200">
                                        <th class="py-2.5 px-3">กลุ่มข้อมูล</th>
                                        <th class="py-2.5 px-3">ฟิลด์ (Field)</th>
                                        <th class="py-2.5 px-3 text-center">ประเภทเอกสาร (คลิกเซลล์เพื่อสลับ ✓/✗)</th>
                                    </tr>
                                </thead>
                                <tbody id="matrixTableBody" class="divide-y divide-slate-200 text-slate-700"></tbody>
                            </table>
                        </div>
                    </div>
                    <!-- 🎯 v3.17.2: ตารางประเภทเอกสาร & สิทธิ์ภาษี (รูปแบบตารางตาม prompt_builder.md — แหล่งเดียว ACCOUNTING_DOC_TYPES) -->
                    <!-- v3.17.3: ดูดแท็บ "อ้างอิงบัญชี" เดิมมารวมที่นี่ (เพิ่มคอลัมน์หมวด + หมายเหตุกฎหมาย) แล้วลบแท็บเก่าทิ้ง -->
                    <div id="aiModeTaxonomyView" style="display:none">
                        <div class="text-[11px] text-slate-500 mb-3 leading-relaxed">
                            ตารางอ้างอิงสำหรับทีมจัดซื้อและฝ่ายบัญชี — รหัสประเภทเอกสารมาตรฐาน + สิทธิ์เครดิตภาษีซื้อ <b>(VAT 7%)</b> + อ้างอิงประมวลรัษฎากร
                            — AI ใช้ตารางนี้จำแนกเอกสารและประเมินสิทธิ์ภาษี หมายเหตุ: การเคลมภาษีจริงขึ้นกับตัวเอกสารและดุลยพินิจของผู้เชี่ยวชาญ
                        </div>
                        <div class="flex flex-wrap items-center gap-2 mb-3">
                            <input type="text" id="taxonomySearch" oninput="renderTaxonomyTable()" placeholder="ค้นหารหัส / ชื่อเอกสาร / มาตรา..."
                                class="ui-input flex-1 min-w-[200px] max-w-xs text-xs">
                            <select id="taxonomyVatFilter" onchange="renderTaxonomyTable()" class="ui-input text-xs">
                                <option value="ALL">สิทธิ์ภาษีซื้อทั้งหมด</option>
                                <option value="YES">ใช้เครดิตภาษีซื้อได้</option>
                                <option value="NO">ห้ามใช้/ไม่ใช่เครดิต VAT</option>
                                <option value="COND">พิจารณาเมื่อเอกสารครบถ้วน</option>
                            </select>
                        </div>
                        <div class="overflow-x-auto custom-scrollbar border border-slate-200 rounded-xl">
                            <table class="w-full text-left border-collapse text-xs bg-white">
                                <thead>
                                    <tr class="bg-slate-100 text-slate-700 font-semibold border-b border-slate-200">
                                        <th class="py-2.5 px-3 w-20">รหัส</th>
                                        <th class="py-2.5 px-3 w-52">ชื่อเอกสาร</th>
                                        <th class="py-2.5 px-3 w-44">หมวด</th>
                                        <th class="py-2.5 px-3 w-56">สิทธิ์เครดิตภาษีซื้อ (VAT 7%)</th>
                                        <th class="py-2.5 px-3 w-40">อ้างอิงประมวลรัษฎากร</th>
                                    </tr>
                                </thead>
                                <tbody id="taxonomyTableBody" class="divide-y divide-slate-200 text-slate-700"></tbody>
                            </table>
                        </div>
                    </div>
                    <!-- Vendor Billing Page (ใบวางบิล + ใบกำกับภาษี) -->
        <div id="pageVendorBilling" class="hidden md:flex md:flex-col md:flex-1 md:min-h-0" style="display:none">
            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden flex flex-col min-h-0">
                <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between gap-2 flex-wrap">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-file-invoice text-amber-600"></i>
                        <h3 class="text-sm font-bold text-slate-800">ระบบรับวางบิล &amp; แนบใบกำกับภาษี</h3>
                        <span id="vendorBillingBadge" class="ui-badge ui-badge--pending border-amber-300">0 ใบ</span>
